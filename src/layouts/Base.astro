<script is:inline>function placeRegion(){const btn=document.getElementById('rgn-btn'),home=document.getElementById('ftr-rgn'),slot=document.getElementById('nav-rgn'),bar=document.getElementById('ubar-rgn'),nav=document.getElementById('nav');if(!btn||!home||!slot||!nav)return;const desktop=innerWidth>1180,open=nav.classList.contains('open');(!desktop&&open?slot:desktop&&bar?bar:home).appendChild(btn);nav.style.top=open?document.querySelector('.hdr').getBoundingClientRect().bottom+'px':''}document.getElementById("nav").addEventListener("click",e=>{if(e.target.closest("a")){const n=document.getElementById("nav");n.classList.remove("open");document.querySelector(".burger").setAttribute("aria-expanded","false");n.querySelectorAll(".dd").forEach(d=>{d.classList.remove("open");const b=d.querySelector("button");if(b)b.setAttribute("aria-expanded","false")});placeRegion()}});document.addEventListener("click",e=>{if(!e.target.closest(".dd"))document.querySelectorAll(".dd.open").forEach(d=>{d.classList.remove("open");const b=d.querySelector("button");if(b)b.setAttribute("aria-expanded","false")})});function placeSearch(){const btn=document.getElementById("gs-open"),home=document.getElementById("hdr-search"),bar=document.getElementById("ubar-search");if(!btn||!home||!bar)return;(innerWidth>1180?bar:home).appendChild(btn)}function placeUtil(){const box=document.getElementById("site-util"),bar=document.getElementById("ubar-util"),nav=document.getElementById("nav");if(!box||!bar||!nav)return;if(innerWidth>1180)bar.appendChild(box);else (nav.querySelector(".nav-main")||nav).appendChild(box)}placeSearch();placeUtil();document.addEventListener("DOMContentLoaded",()=>{placeRegion();placeSearch();placeUtil()});addEventListener("resize",()=>{placeRegion();placeSearch();placeUtil()});</script>
</div></header>
