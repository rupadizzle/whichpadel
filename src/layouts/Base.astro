---
import '@fontsource-variable/inter';
import '../styles/site.css';
import '../styles/v4.css';
import '../styles/v5.css';
import '../styles/v6.css';
import '../styles/v7.css';
import '../styles/v8.css';
import '../styles/v9.css';
import '../styles/v10.css';
import '../styles/shoes.css';
import '../styles/search.css';
import { D } from '../i18n/index.js'; import GeoBanner from "../components/GeoBanner.astro"; import Region from '../components/Region.astro'; import NavL from '../components/NavL.astro'; import FooterL from '../components/FooterL.astro'; import SearchL from '../components/SearchL.astro'; import { alternates, LOCALE, LANG_NAME, OG_LOCALE, LANGS, url } from '../i18n/routes.js';
import { lists as L0 } from '../lib/data.js'; import { extraLists } from '../lib/seo-content.js';
const lists={...L0,...extraLists};
const { title, description = 'Compare 300+ padel rackets by shape, weight, balance, core and price.', jsonld = null, ogImage = null, noindex = false, preload = null, lang = 'en-GB', alt = null, focus = false, closeHref = null, region = null, usPage = false, navCta = true, newsletter = true } = Astro.props;
const L2 = LANGS.find(l=>l!=='en'&&lang.toLowerCase().startsWith(l))||'en';
const alts = alternates(Astro.url.pathname);
const LN=LANG_NAME;
const switcher = alts ? Object.entries(alts).filter(([l])=>l!==L2) : [];
const canon = new URL(Astro.url.pathname, Astro.site).href;
const bfHref = url('bf', L2);
const showBf = !focus && Astro.url.pathname !== bfHref;
const short = t => t.replace('Best padel rackets ','').replace('Best padel racket ','').replace('Best ','').replace(/ \(.*\)$/,'').replace(/^for /,'For ').replace(/^of (\d+)/,'Top picks $1').replace(/^./,c=>c.toUpperCase());
---
<html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title>{Astro.url.pathname==="/" && <script is:inline type="text/javascript" src="https://classic.avantlink.com/affiliate_app_confirm.php?mode=js&authResponse=a52e561e6375dd63575f8532b8eb75077321980b"></script>}<meta name="description" content={description}/>
{noindex ? <meta name="robots" content="noindex"/> : <link rel="canonical" href={canon}/>}
<meta property="og:url" content={canon}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{ogImage&&<meta property="og:image" content={ogImage}/>}<meta name="twitter:card" content={ogImage?'summary_large_image':'summary'}/>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}/>}<meta property="og:site_name" content="WhichPadel"/>
<slot name="head"/>{preload&&<link rel="preload" href={preload} as="fetch" crossorigin="anonymous"/>}<meta name="theme-color" content="#0b2a3c"/>{usPage?<link rel="alternate" hreflang="en-US" href={canon}/>:alts&&<>{Object.entries(alts).map(([l,u])=><link rel="alternate" hreflang={l} href={"https://whichpadel.com"+u}/>)}{alts.en&&<link rel="alternate" hreflang="x-default" href={"https://whichpadel.com"+alts.en}/>}</>}<meta property="og:locale" content={usPage?'en_US':OG_LOCALE[L2]}/>
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "cf3636dc954245fca45c0fa20ca789bf"}'></script>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23d4ff3a'/%3E%3C/svg%3E"/>
{showBf && <script is:inline>try{if(localStorage.wp_bf==='1')document.documentElement.classList.add('bf-off')}catch(e){}</script>}
</head><body>
{focus ? <Fragment><header class="hdr fz-hdr"><div class="wrap"><a class="logo" href={url("home",L2)}><span class="ball"></span><span>Which<em>Padel</em></span></a>
<a class="fz-x" href={closeHref||url("home",L2)} aria-label={D(L2).ui.close}>✕</a><div hidden><Region lang={L2} switcher={switcher} region={region}/></div></div></header>
<main class="fz-main"><slot/></main>
</Fragment> : <Fragment><div class="ubar"><div class="wrap"><div id="ubar-rgn"></div>{showBf && <a class="ubar-msg" href={bfHref}><b>Black Friday</b><span class="bf-l">{D(L2).ui.bfBar}</span><span class="bf-s">{D(L2).ui.bfBarShort}</span><i aria-hidden="true">→</i></a>}<div class="ubar-end"><div id="ubar-search"></div><div id="ubar-util"></div>{showBf && <button type="button" class="ubar-x" id="bf-x" aria-label={D(L2).ui.close}>✕</button>}</div></div></div>{showBf && <script is:inline>document.getElementById('bf-x').onclick=()=>{try{localStorage.wp_bf='1'}catch(e){}document.documentElement.classList.add('bf-off')}</script>}<header class="hdr"><div class="wrap">
<a class="logo" href={url("home",L2)}><span class="ball"></span><span>Which<em>Padel</em></span></a>
<SearchL lang={L2}/>
<button class="burger" aria-label={D(L2).ui.menu} aria-expanded="false" aria-controls="nav" onclick="const n=document.getElementById('nav');this.setAttribute('aria-expanded',n.classList.toggle('open'));placeRegion()">☰</button>
<NavL lang={L2} switcher={switcher} cta={navCta}/>
<script is:inline>function placeRegion(){const btn=document.getElementById('rgn-btn'),home=document.getElementById('ftr-rgn'),slot=document.getElementById('nav-rgn'),bar=document.getElementById('ubar-rgn'),nav=document.getElementById('nav');if(!btn||!home||!slot||!nav)return;const desktop=innerWidth>1180,open=nav.classList.contains('open');(!desktop&&open?slot:desktop&&bar?bar:home).appendChild(btn);nav.style.top=open?document.querySelector('.hdr').getBoundingClientRect().bottom+'px':''}document.getElementById("nav").addEventListener("click",e=>{if(e.target.closest("a")){const n=document.getElementById("nav");n.classList.remove("open");document.querySelector(".burger").setAttribute("aria-expanded","false");n.querySelectorAll(".dd").forEach(d=>d.classList.remove("open"));placeRegion()}});document.addEventListener("click",e=>{if(!e.target.closest(".dd"))document.querySelectorAll(".dd.open").forEach(d=>d.classList.remove("open"))});function placeSearch(){const btn=document.getElementById("gs-open"),home=document.getElementById("hdr-search"),bar=document.getElementById("ubar-search");if(!btn||!home||!bar)return;(innerWidth>1180?bar:home).appendChild(btn)}function placeUtil(){const box=document.getElementById("site-util"),bar=document.getElementById("ubar-util"),nav=document.getElementById("nav");if(!box||!bar||!nav)return;if(innerWidth>1180)bar.appendChild(box);else{const dd=nav.querySelector(".dd");if(dd)dd.parentNode.insertBefore(box,dd);else nav.appendChild(box)}}placeSearch();placeUtil();document.addEventListener("DOMContentLoaded",()=>{placeRegion();placeSearch();placeUtil()});addEventListener("resize",()=>{placeRegion();placeSearch();placeUtil()});</script>
</div></header>
{L2==='en' && <dialog class="ai-dlg" id="ai-dlg" aria-labelledby="ai-h">
<button type="button" class="ai-x" data-ai-close aria-label="Close">✕</button>
<button type="button" class="ai-mic" id="ai-mic" aria-pressed="true" aria-label="Listening. Tap when you are done"><span class="ring" aria-hidden="true"></span><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></button>
<h2 id="ai-h">Describe your game</h2>
<label class="ai-sr" for="ai-t">What you said</label>
<input id="ai-t" type="text" enterkeyhint="go" autocomplete="off" autofocus placeholder="Or type it here and press enter"/>
<p class="ai-status" id="ai-status" aria-live="polite">Listening</p>
</dialog>}
<GeoBanner lang={L2}/>
<slot name="hero"/>
<main class="wrap"><slot/>
{newsletter && <FooterL lang={L2} news/>}
</main>
<FooterL lang={L2} switcher={switcher} region={region}/>
<script is:inline>placeRegion();placeSearch();placeUtil()</script>
{L2==='en' && <script is:inline src="/describe-parse.js"></script>}
{L2==='en' && <script is:inline src="/describe-voice.js"></script>}
{L2==='en' && <script is:inline define:vars={{FINDER: url('finder', L2)}}>
const btns=[...document.querySelectorAll('[data-ai]')], dlg=document.getElementById('ai-dlg'), ta=document.getElementById('ai-t'), status=document.getElementById('ai-status'), mic=document.getElementById('ai-mic');
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
let rec=null, fin='', gen=0, open=false, leaving=false, arm=0, denied=false, misses=0, openedAt=0, voice='cloud', deviceTried=false, vgen=0;
const setOn=on=>btns.forEach(b=>{b.classList.toggle('on',on); b.setAttribute('aria-expanded',on?'true':'false');});
const liveOn=on=>{mic.setAttribute('aria-pressed',on?'true':'false'); mic.classList.toggle('on',on);};
function kill(){gen++; clearTimeout(arm); const r=rec; rec=null; if(r){try{r.onresult=r.onerror=r.onend=null; r.stop();}catch(e){}} liveOn(false);}
function stopVoice(){vgen++; voice='cloud'; deviceTried=false; if(window.DGVoice) window.DGVoice.stop(); mic.classList.remove('dead','wait');}
function end(){leaving=true; open=false; stopVoice(); kill(); setOn(false);}
function shut(){end(); if(dlg.open) dlg.close();}
function go(){clearTimeout(arm); const t=(ta.value||fin).trim(); if(t.length<8){status.textContent='Keep going. Your level, which side, control or power, and a budget.'; if(voice==='cloud'&&SR&&!denied&&!rec) listen(); return;} if(!window.DG){status.textContent='One moment, then say it again.'; return;} leaving=true; if(window.DGVoice) window.DGVoice.stop(); kill(); const p=window.DG.parse(t); status.textContent=p.why.join(' · '); setTimeout(()=>{location.href=FINDER+'?'+new URLSearchParams(window.DG.racket(p));},800);}
function schedule(){clearTimeout(arm); if((ta.value||'').trim().length>=8) arm=setTimeout(go,1500);}
function fail(msg){voice='dead'; denied=true; vgen++; if(window.DGVoice) window.DGVoice.stop(); liveOn(false); mic.classList.remove('wait'); mic.classList.add('dead'); status.textContent=msg; ta.placeholder='Type how you play, then press enter'; ta.focus();}
async function deviceReady(){if(!SR||typeof SR.available!=='function') return false; try{let v=await SR.available({langs:['en-US'],processLocally:true,quality:'dictation'}); if((v==='downloadable'||v==='downloading')&&typeof SR.install==='function'){status.textContent='Downloading voice for this browser…'; v=await SR.install({langs:['en-US'],processLocally:true});} return v==='available';}catch(e){return false;}}
function beginLocal(){if(!open||leaving||voice==='local'||voice==='booting') return; const mine=vgen; voice='booting'; denied=true; kill(); mic.classList.remove('dead'); mic.classList.add('wait'); status.textContent='Getting voice ready…'; if(window.DGVoice) window.DGVoice.prime();
 (async()=>{if(!deviceTried){deviceTried=true; const ok=await deviceReady(); if(mine!==vgen||!open||leaving) return; if(ok){voice='device'; denied=false; misses=0; mic.classList.remove('wait'); status.textContent='Listening. Just start talking.'; listen(); return;}}
  if(mine!==vgen||!open||leaving) return; if(!window.DGVoice){fail('Voice didn\u2019t start. Type how you play, then press enter.'); return;} voice='local';
  window.DGVoice.start({onStatus(s){if(open&&voice==='local'&&mine===vgen) status.textContent=s;}, onReady(){if(open&&voice==='local'&&mine===vgen){mic.classList.remove('dead','wait'); liveOn(true);}}, onPartial(s){if(!open||voice!=='local'||mine!==vgen||!s) return; fin=s+' '; ta.value=s; ta.placeholder='';}, onText(s){if(!open||voice!=='local'||mine!==vgen) return; fin=s+' '; ta.value=s; ta.placeholder=''; schedule();}, onFail(m){if(open&&mine===vgen) fail(m);}});
 })();}
function listen(){if(!SR||denied||!open||leaving||rec||voice==='local'||voice==='booting') return; const mine=gen; const r=rec=new SR(); r.lang='en-US'; r.interimResults=true; r.continuous=false; if(voice==='device'){try{r.processLocally=true;}catch(e){}}
 r.onresult=e=>{if(mine!==gen) return; misses=0; let interim=''; for(let i=e.resultIndex;i<e.results.length;i++){const x=e.results[i]; if(x.isFinal) fin+=x[0].transcript+' '; else interim+=x[0].transcript;} ta.value=(fin+interim).trim(); ta.placeholder=''; status.textContent='Listening'; schedule();};
 r.onerror=e=>{const err=e.error||''; if(err==='no-speech'||err==='aborted') return; if(err==='not-allowed') fail('The microphone is blocked. Type how you play, then press enter.'); else if(err==='audio-capture') fail('No microphone found. Type how you play, then press enter.'); else beginLocal();};
 r.onend=()=>{if(rec===r) rec=null; if(mine!==gen||!open||leaving||denied||(voice!=='cloud'&&voice!=='device')) return; if(++misses>6){beginLocal(); return;} setTimeout(()=>{if(mine===gen&&open&&!leaving&&!denied&&!rec) listen();},400);};
 try{r.start();}catch(e){rec=null; beginLocal(); return;}
 liveOn(true); mic.classList.remove('dead','wait');}
function show(){if(dlg.open){shut(); return;} if(window.DGVoice) window.DGVoice.prime(); stopVoice(); open=true; leaving=false; denied=false; misses=0; fin=''; ta.value=''; ta.placeholder='Or type it here and press enter'; status.textContent='Listening. Just start talking.'; const nav=document.getElementById('nav'); if(nav){nav.classList.remove('open'); const g=document.querySelector('.burger'); if(g) g.setAttribute('aria-expanded','false');} if(typeof placeRegion==='function') placeRegion(); openedAt=performance.now(); try{dlg.showModal();}catch(e){open=false; return;} setOn(true); ta.focus(); if(SR) listen(); else beginLocal();}
btns.forEach(b=>b.addEventListener('click',show));
mic.addEventListener('click',()=>{if(!open||leaving) return; if((ta.value||'').trim().length>=8){go(); return;} if(window.DGVoice) window.DGVoice.prime(); stopVoice(); denied=false; misses=0; mic.classList.remove('dead','wait'); status.textContent='Listening. Just start talking.'; if(SR) listen(); else beginLocal();});
ta.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault(); go();}});
ta.addEventListener('input',()=>{if(rec){const r=rec; rec=null; gen++; try{r.onend=null; r.stop();}catch(e){} liveOn(false);} if(voice==='local'||voice==='booting'){vgen++; voice='cloud'; deviceTried=true; denied=true; if(window.DGVoice) window.DGVoice.stop(); liveOn(false); mic.classList.remove('wait');} fin=ta.value.trim()+(ta.value.trim()?' ':''); schedule();});
dlg.querySelector('[data-ai-close]').addEventListener('click',shut);
dlg.addEventListener('close',()=>{if(open) end();});
dlg.addEventListener('click',e=>{if(e.target===dlg&&performance.now()-openedAt>500) shut();});
</script>}
<script is:inline src="/sub.js" defer></script><script is:inline src="/news.js" defer></script>
<script is:inline>
(()=>{const K='wp_saved',CAP=40,ok=x=>x&&(x.t==='r'||x.t==='s'||x.t==='b'||x.t==='g')&&typeof x.s==='string'&&/^[a-z0-9-]{1,80}$/.test(x.s);
const read=()=>{try{const a=JSON.parse(localStorage[K]||'[]');return Array.isArray(a)?a.filter(ok).slice(0,CAP):[]}catch(e){return[]}};
const write=list=>{try{localStorage[K]=JSON.stringify(list.slice(0,CAP))}catch(e){} document.dispatchEvent(new CustomEvent('wp:saved'))};
const paint=()=>{const list=read(); document.querySelectorAll('[data-save]').forEach(b=>{const on=list.some(x=>x.t===(b.dataset.kind||'r')&&x.s===b.dataset.save); b.setAttribute('aria-pressed',on?'true':'false'); const lab=b.dataset[on?'on':'off']; if(lab){b.setAttribute('aria-label',lab); const t=b.querySelector('.save-lab'); if(t) t.textContent=lab;}}); const n=document.getElementById('saved-n'); if(n){const c=list.length; n.textContent=c?String(c):''; n.hidden=!c;}};
let seq=0; const toggle=(s,t='r')=>{t=t==='s'||t==='b'||t==='g'?t:'r'; if(!/^[a-z0-9-]{1,80}$/.test(s||'')) return false; const on=read().some(x=>x.t===t&&x.s===s); let list=read().filter(x=>!(x.t===t&&x.s===s)); if(!on) list.unshift({t,s}); write(list.slice(0,CAP));
 let acct=false; try{acct=localStorage.wp_acct==='1'}catch(e){}
 if(acct){const n=++seq; fetch('/api/saved',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({op:'toggle',t,s})}).then(async r=>{if(r.status===401){try{localStorage.removeItem('wp_acct')}catch(e){}} if(!r.ok||n!==seq) return; const d=await r.json(); if(Array.isArray(d.items)) write(d.items);}).catch(()=>{});}
 return !on;};
window.wpSaved={read,write,toggle,paint};
document.addEventListener('click',e=>{const rm=e.target.closest('[data-remove]'); if(rm){e.preventDefault(); toggle(rm.dataset.remove, rm.dataset.kind||'r'); return;} const b=e.target.closest('[data-save]'); if(!b) return; e.preventDefault(); toggle(b.dataset.save, b.dataset.kind||'r');});
document.addEventListener('wp:saved',paint); paint();})();
</script>
</Fragment>}</body></html>
