---
import '@fontsource-variable/inter';
import '../styles/site.css';
import '../styles/v4.css';
import '../styles/v5.css';
import '../styles/v6.css';
import '../styles/v7.css';
import '../styles/v8.css';
import Region from '../components/Region.astro'; import NavL from '../components/NavL.astro'; import FooterL from '../components/FooterL.astro'; import { alternates, LOCALE } from '../i18n/routes.js';
import { lists as L0 } from '../lib/data.js'; import { extraLists } from '../lib/seo-content.js';
const lists={...L0,...extraLists};
const { title, description = 'Compare 300+ padel rackets by shape, weight, balance, core and price.', jsonld = null, ogImage = null, noindex = false, preload = null, lang = 'en-GB', alt = null } = Astro.props;
const L2 = lang.startsWith('es')?'es':lang.startsWith('fr')?'fr':'en'; const es = L2!=='en';
const alts = alternates(Astro.url.pathname) || (alt?{en:alt.en,es:alt.es}:null);
const LN={en:'English',es:'Español',fr:'Français'};
const switcher = alts ? Object.entries(alts).filter(([l])=>l!==L2) : [];
const canon = new URL(Astro.url.pathname, Astro.site).href;
const short = t => t.replace('Best padel rackets ','').replace('Best padel racket ','').replace('Best ','').replace(/ \(.*\)$/,'').replace(/^for /,'For ').replace(/^of (\d+)/,'Top picks $1').replace(/^./,c=>c.toUpperCase());
---
<html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/>
{noindex ? <meta name="robots" content="noindex"/> : <link rel="canonical" href={canon}/>}
<meta property="og:url" content={canon}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{ogImage&&<meta property="og:image" content={ogImage}/>}<meta name="twitter:card" content={ogImage?'summary_large_image':'summary'}/>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}/>}<meta property="og:site_name" content="WhichPadel"/>
{preload&&<link rel="preload" href={preload} as="fetch" crossorigin="anonymous"/>}<meta name="theme-color" content="#0b2a3c"/>{alts&&<>{Object.entries(alts).map(([l,u])=><link rel="alternate" hreflang={l} href={"https://whichpadel.com"+u}/>)}{alts.en&&<link rel="alternate" hreflang="x-default" href={"https://whichpadel.com"+alts.en}/>}</>}{es&&<meta property="og:locale" content={L2==="es"?"es_ES":"fr_FR"}/>}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "cf3636dc954245fca45c0fa20ca789bf"}'></script>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23d4ff3a'/%3E%3C/svg%3E"/>
</head><body>
<header class="hdr"><div class="wrap">
<a class="logo" href={es?`/${L2}/`:"/"}><span class="ball"></span><span>Which<em>Padel</em></span></a>
<Region lang={L2}/>
<button class="burger" aria-label={L2==="es"?"Menú":L2==="fr"?"Menu":"Menu"} aria-expanded="false" aria-controls="nav" onclick="const n=document.getElementById('nav');this.setAttribute('aria-expanded',n.classList.toggle('open'))">☰</button>
{es ? <NavL lang={L2} switcher={switcher}/> : <><nav class="nav" id="nav"><a href="/#rackets">All rackets</a><a href="/padel-rackets/">Buying guide</a><a href="/brands/">Brands</a><a href="/players/">Players</a><a href="/compare/">Compare</a>
<div class="dd"><button type="button" aria-haspopup="true" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.parentNode.classList.toggle('open'))">Best lists ▾</button><div class="menu">{Object.entries(lists).map(([k,v])=> <a href={`/best/${k}/`}>{short(v.title)}</a>)}<a href="/black-friday-padel-rackets/">Black Friday deals</a></div></div>
{switcher.map(([l,u])=><a class="lang" href={u} hreflang={l} lang={l}>{LN[l]}</a>)}<a class="cta" href="/#quiz">Racket finder</a></nav></>}
<script is:inline>document.getElementById("nav").addEventListener("click",e=>{if(e.target.closest("a")){const n=document.getElementById("nav");n.classList.remove("open");document.querySelector(".burger").setAttribute("aria-expanded","false");n.querySelectorAll(".dd").forEach(d=>d.classList.remove("open"))}});document.addEventListener("click",e=>{if(!e.target.closest(".dd"))document.querySelectorAll(".dd.open").forEach(d=>d.classList.remove("open"))});</script>
</div></header>
<slot name="hero"/>
<main class="wrap"><slot/>
{es ? <FooterL lang={L2} news/> : <><section class="news" id="newsletter"><div><h2>Padel deals, once a week</h2><p>The biggest racket price drops and new releases, in a 2-minute email. Placeholder: not connected to any email tool yet. See our <a href="/privacy/">privacy policy</a>.</p></div>
<form class="inline-form" novalidate onsubmit="event.preventDefault();const i=this.querySelector('input[type=email]');if(!i.checkValidity()){i.reportValidity();return}this.querySelector('p').hidden=false"><input type="email" required placeholder="you@example.com" aria-label="Email for newsletter" autocomplete="email"/><button class="btn btn-accent">Subscribe</button><p hidden class="ok" style="color:#d4ff3a">Thanks! (Placeholder: nothing was sent.)</p></form></section></>}
</main>
{es ? <FooterL lang={L2} switcher={switcher}/> : <><footer class="ftr"><div class="wrap">
<div class="cols"><div><a class="logo" href="/"><span class="ball"></span><span>Which<em>Padel</em></span></a><p style="margin-top:12px">Independent padel racket comparison. Sourced specs, transparent ranking rules, no paid placements.</p></div>
<div><h2 class="fh">Best lists</h2><ul>{Object.entries(lists).map(([k,v])=> <li><a href={`/best/${k}/`}>{short(v.title)}</a></li>)}</ul></div>
<div><h2 class="fh">Site</h2><ul><li><a href="/#rackets">All rackets</a></li><li><a href="/padel-rackets/">How to choose a padel racket</a></li><li><a href="/brands/">Brands</a></li><li><a href="/players/">Rackets by player</a></li><li><a href="/#quiz">Racket finder</a></li><li><a href="/compare/">Compare</a></li><li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li><li><a href="/privacy/">Privacy policy</a></li></ul></div></div>
<p class="legal">Racket specs are compiled from brand and retailer sources. Ratings are calculated from published specifications by our rating formula; they are not lab or court tests. Brand and model names belong to their owners. Product photos are courtesy of the retailers and brands whose pages we source specs from; a generic shape outline is shown where no photo is available. Prices are recorded snapshots with a check date, not live quotes. Some links may be affiliate links: we may earn a commission at no extra cost to you, and it never changes a rating or ranking.<br/><a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/privacy/">Privacy policy</a>{switcher.map(([l,u])=><> · <a href={u} hreflang={l} lang={l}>{LN[l]}</a></>)}</p>
</div></footer><</>}
</body></html>
