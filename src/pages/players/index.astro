---
import Base from '../../layouts/Base.astro'; import { players, rackets } from '../../lib/data.js';
const n=players.reduce((a,p)=>a+p.rackets.length,0);
const jsonld={'@context':'https://schema.org','@type':'ItemList','name':'Padel rackets by player','url':'https://whichpadel.com/players/','numberOfItems':players.length,'itemListElement':players.map((p,i)=>({'@type':'ListItem','position':i+1,'url':`https://whichpadel.com/players/${p.slug}/`,'name':p.name}))};
---
<Base title={`Padel rackets by player: ${players.length} players, ${n} rackets | WhichPadel`} description={`Which racket does each padel pro use? ${n} signature and player-linked rackets for ${players.length} players, with specs, ratings and prices.`} jsonld={jsonld}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <span>Players</span></nav>
<h1>Padel rackets by player</h1>
<p class="lead-sm">{n} of the {rackets.length} rackets in our database are linked to a named player by the brand or retailer listing (signature or player editions). Pick a player to see their rackets side by side.</p>
<section class="panel vs">{players.map(p=><a href={`/players/${p.slug}/`}><span>{p.name}</span><span class="muted small">{p.rackets.length} racket{p.rackets.length>1?'s':''} →</span></a>)}</section>
</Base>
