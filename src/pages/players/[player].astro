---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import { players, fmtPrice } from '../../lib/data.js';
export function getStaticPaths(){ return players.map(p=>({params:{player:p.slug},props:{p}})); }
const { p } = Astro.props; const rs=p.rackets; const cur=rs[0]; const U=`https://whichpadel.com/players/${p.slug}/`;
const brands=[...new Set(rs.map(r=>r.brand))]; const yrs=[...new Set(rs.map(r=>r.year).filter(Boolean))].sort();
const cnt=k=>{const m={};rs.forEach(r=>{if(r[k])m[r[k]]=(m[r[k]]||0)+1});return Object.entries(m).sort((a,b)=>b[1]-a[1]);};
const shapes=cnt('shape'), cores=cnt('coreHardness'); const w=rs.filter(r=>r.weightMin);
const summary=`Our database links ${rs.length} racket${rs.length>1?'s':''} to ${p.name}, from ${brands.join(' and ')}${yrs.length?` (model year${yrs.length>1?`s ${yrs[0]}–${yrs.at(-1)}`:` ${yrs[0]}`})`:''}.`+(shapes.length?` Shape${shapes.length>1?'s':''}: ${shapes.map(([k,v])=>`${k} (${v})`).join(', ')}.`:'')+(cores.length?` Core: ${cores.map(([k,v])=>`${k} (${v})`).join(', ')}.`:'')+(w.length?` Published weights ${Math.min(...w.map(r=>r.weightMin))}–${Math.max(...w.map(r=>r.weightMax||r.weightMin))} g.`:'');
const faq=[[`What racket does ${p.name} use?`,`The most recent racket in our database linked to ${p.name} is the ${cur.model}${cur.year?` (${cur.year})`:''}. This is based on the brand or retailer listing naming the player; pros can change rackets or play customised versions.`],
 ...(rs.length>1?[[`How many ${p.name} rackets are there?`,`We list ${rs.length} rackets linked to ${p.name}: ${rs.map(r=>r.model).join(', ')}.`]]:[]),
 [`How much does the ${p.name} racket cost?`, cur.price!=null?`The last recorded price for the ${cur.model} is ${fmtPrice(cur)}. Prices change often, so check the shop.`:`We do not have a recorded price for the ${cur.model}.`]];
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'ItemList','name':`${p.name} padel rackets`,'url':U,'numberOfItems':rs.length,'itemListElement':rs.map((r,i)=>({'@type':'ListItem','position':i+1,'url':`https://whichpadel.com/rackets/${r.slug}/`,'name':r.model}))},{'@type':'FAQPage','mainEntity':faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':'https://whichpadel.com/'},{'@type':'ListItem','position':2,'name':'Players','item':'https://whichpadel.com/players/'},{'@type':'ListItem','position':3,'name':p.name,'item':U}]}]};
---
<Base title={`${p.name} padel racket${rs.length>1?'s':''}: ${rs.length} model${rs.length>1?'s':''} compared | WhichPadel`} description={`What racket does ${p.name} use? ${summary}`.slice(0,158)} jsonld={jsonld}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/players/">Players</a> › <span>{p.name}</span></nav>
<h1>{p.name} padel rackets</h1>
<p class="lead-sm">{summary}</p>
{rs.length>1&&<p><a class="btn" href={`/compare/?r=${rs.slice(0,3).map(r=>r.slug).join(',')}`}>Compare {p.name}’s rackets</a></p>}
<div class="grid">{rs.map((r,i)=><Card r={r} eager={i<2}/>)}</div>
<section class="panel"><h2>FAQ</h2>{faq.map(([q,a])=><div class="faq"><h3>{q}</h3><p>{a}</p></div>)}</section>
<p class="muted small">Player links come from the official model names and listings in our source data. We don’t publish player biographies or rankings.</p>
</Base>
