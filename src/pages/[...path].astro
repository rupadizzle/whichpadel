---
// Every page of every language is generated here from the route map (src/i18n/routes.js). One view per page type; no per-language page files.
import { pages, url, LANGS } from '../i18n/routes.js';
import { brandList, players, bySlug } from '../lib/data.js'; import { brandYears } from '../lib/extra.js'; import { vsPairs } from '../lib/vs.js';
import VHome from '../views/VHome.astro'; import VGuide from '../views/VGuide.astro'; import VIndex from '../views/VIndex.astro'; import VList from '../views/VList.astro';
import VProduct from '../views/VProduct.astro'; import VHub from '../views/VHub.astro';
import VBrands from '../views/VBrands.astro'; import VBrand from '../views/VBrand.astro'; import VBrandYear from '../views/VBrandYear.astro';
import VVs from '../views/VVs.astro'; import VTool from '../views/VTool.astro'; import VBf from '../views/VBf.astro'; import VLegal from '../views/VLegal.astro'; import VFinder from '../views/VFinder.astro'; import V404 from '../views/V404.astro'; import VShoeCompare from '../views/VShoeCompare.astro'; import { shoeBySlug, shoeOnlyBrands } from '../lib/shoes.js';
const shoeBrandPage=Object.fromEntries(shoeOnlyBrands.map(b=>[b.slug,{name:b.name,slug:b.slug,count:0,rackets:[]}]));
export function getStaticPaths(){ const out=[];
 for(const lang of LANGS){ for(const p of pages()){ const u=url(p.type,lang,p.id); if(!u) continue; out.push({params:{path:u.replace(/^\/|\/$/g,'')||undefined},props:{type:p.type,id:p.id,lang}}); }
  if(lang!=='en') out.push({params:{path:`${lang}/404`},props:{type:'404',lang}}); }
 return out; }
import { ballBySlug } from '../lib/balls.js'; import { bagBySlug } from '../lib/bags.js'; import VSaved from '../views/VSaved.astro';
const { type, id, lang } = Astro.props;
const brand=s=>brandList.find(b=>b.slug===s)||shoeBrandPage[s];
---
{type==='home'&&<VHome lang={lang}/>}
{type==='guide'&&<VGuide lang={lang}/>}
{type==='bestIndex'&&<VIndex kind="best" lang={lang}/>}
{type==='best'&&<VList kind="best" k={id} lang={lang}/>}
{type==='racket'&&<VProduct kind="racket" r={bySlug[id]} lang={lang}/>}
{type==='brands'&&<VBrands lang={lang}/>}
{type==='brand'&&<VBrand b={brand(id)} lang={lang}/>}
{type==='brandYear'&&<VBrandYear b={brandYears.find(b=>b.id===id)} lang={lang}/>}
{type==='players'&&<VIndex kind="players" lang={lang}/>}
{type==='player'&&<VList kind="player" p={players.find(p=>p.slug===id)} lang={lang}/>}
{type==='vs'&&<VVs p={vsPairs.find(v=>v.slug===id)} lang={lang}/>}
{type==='finder'&&<VFinder lang={lang}/>}
{type==='tool'&&<VTool lang={lang}/>}
{type==='bf'&&<VBf lang={lang}/>}
{type==='privacy'&&<VLegal kind="privacy" lang={lang}/>}
{type==='affiliate'&&<VLegal kind="affiliate" lang={lang}/>}
{type==='about'&&<VLegal kind="about" lang={lang}/>}
{type==='years'&&<VIndex kind="years" lang={lang}/>}
{type==='year'&&<VList kind="year" y={id} lang={lang}/>}
{type==='rackets'&&<VHub kind="rackets" p={id} lang={lang}/>}
{type==='shoes'&&<VHub kind="shoes" lang={lang}/>}
{type==='shoeCompare'&&<VShoeCompare lang={lang}/>}
{type==='shoe'&&<VProduct kind="shoe" s={shoeBySlug[id]} lang={lang}/>}
{type==='shoeList'&&<VList kind="shoe" k={id} lang={lang}/>}
{type==='shoeBrand'&&<VList kind="shoe" k="brand" b={shoeOnlyBrands.find(b=>b.slug===id)} lang={lang}/>}
{type==='balls'&&<VHub kind="balls" lang={lang}/>}
{type==='bags'&&<VHub kind="bags" lang={lang}/>}
{type==='bag'&&<VProduct kind="bag" g={bagBySlug[id]} lang={lang}/>}
{type==='ball'&&<VProduct kind="ball" b={ballBySlug[id]} lang={lang}/>}
{type==='us'&&<VList kind="us" k={id}/>}
{type==='404'&&<V404 lang={lang}/>}
{type==='saved'&&<VSaved lang={lang}/>}
