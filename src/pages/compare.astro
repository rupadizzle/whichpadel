---
import Base from '../layouts/Base.astro'; import { rackets } from '../lib/data.js';
const popular=['bullpadel','nox','adidas','babolat','head','siux'].map(b=>rackets.find(r=>r.brand.toLowerCase().includes(b)&&r.image)).filter(Boolean).slice(0,6).map(r=>r.slug);
---
<Base alt={{en:'/compare/',es:'/es/comparador-palas-padel/'}} preload="/compare-data.json" title="Compare padel rackets side by side | WhichPadel" description="Compare two or three padel rackets side by side: shape, weight, balance, core, price and spec-based ratings.">
<div class="cmp-intro"><h1>Compare padel rackets</h1><p class="muted">Up to 3 rackets side by side. The best value in each row is highlighted.</p></div>
<div id="cmp" class="cmp" data-popular={popular.join(',')}><p class="panel empty">Loading comparison…</p></div>
<p class="muted small trust">Ratings are calculated from published specs (our rating formula), not court tests. Prices are recorded snapshots with a check date, not live quotes.</p>
<dialog class="sheet" id="sheet" aria-labelledby="sheet-h"><div class="sheet-in"><div class="sheet-top"><h2 id="sheet-h" class="h3">Add a racket</h2><button class="x" type="button" data-close aria-label="Close">✕</button></div>
<input id="sheet-q" type="search" placeholder={`Search ${rackets.length} rackets`} aria-label="Search rackets" autocomplete="off"/>
<ul class="pick-list" id="sheet-list"></ul></div></dialog>
<script is:inline>
if(location.search){const m=document.createElement('meta');m.name='robots';m.content='noindex,follow';document.head.appendChild(m);}
(async()=>{const slim=await (await fetch("/compare-data.json")).json();
const rp=()=>slim.forEach(x=>{const q=WP.best(x.o,"en");x.p=q.txt;x.g=q.v;x.u=q.u||x.u;});rp();
const by=Object.fromEntries(slim.map(x=>[x.s,x])); const $=id=>document.getElementById(id); const root=$('cmp');
let sel=(new URLSearchParams(location.search).get('r')||'').split(',').filter(s=>by[s]).slice(0,3); let slot=-1;
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const SCORES=['Power','Control','Handling','Forgiveness','Comfort','Value'];
const SPECS=['Shape','Weight','Balance','Hardness','Core','Face','Thickness','Year'];
const img=(x,w,h)=>x.i?`<img src="${x.i}" alt="${esc(x.m)} padel racket" width="${w}" height="${h}" decoding="async">`:`<span class="noimg" style="width:${w}px;height:${h}px" aria-hidden="true">${esc((x.sh||'?')[0].toUpperCase())}</span>`;
const short=x=>x.m.replace(x.b+' ','');
function save(){history.replaceState(null,'',sel.length?'?r='+sel.join(','):location.pathname);}
function winner(vals,hi=true){const n=vals.filter(v=>typeof v==='number'); if(n.length<2) return null; const m=hi?Math.max(...n):Math.min(...n); return n.filter(v=>v===m).length===n.length?null:m;}
function verdict(xs){const pick=(f,lab)=>{const b=[...xs].sort((a,c)=>f(c)-f(a)); if(f(b[0])===f(b[1])) return ''; return `<li><span>${lab}</span><b>${esc(short(b[0]))}</b></li>`;};
 return pick(x=>x.Power,'Best for power')+pick(x=>x.Control,'Best for control')+pick(x=>x.Forgiveness+x.Comfort,'Best for beginners')+pick(x=>x.Value,'Best value');}
function draw(){save(); const xs=sel.map(s=>by[s]); const n=Math.max(xs.length,2); root.style.setProperty('--n',n);
 if(xs.length<2){const pop=root.dataset.popular.split(',').filter(s=>!sel.includes(s)).slice(0,4);
  root.innerHTML=`<div class="slots">${[0,1].map(i=>xs[i]?headCell(xs[i],i):`<button class="slot-add" type="button" data-add="${i}"><span>+</span>Add racket ${i+1}</button>`).join('')}</div>
  <section class="panel"><h2 class="h3">Popular to compare</h2><div class="pop">${pop.map(s=>`<button type="button" class="popb" data-quick="${s}">${img(by[s],40,48)}<span>${esc(by[s].m)}</span></button>`).join('')}</div></section>`; return;}
 let h=`<div class="chead" style="--n:${xs.length+(xs.length<3?1:0)}">${xs.map(headCell).join('')}${xs.length<3?`<button class="slot-add sm" type="button" data-add="${xs.length}"><span>+</span>Add</button>`:''}</div>`;
 const v=verdict(xs); if(v) h+=`<section class="verdict" aria-label="Quick verdict"><h2 class="h3">Quick verdict</h2><ul>${v}</ul></section>`;
 const grp=(title,fields,open,isNum)=>`<details class="cgroup" ${open?'open':''}><summary>${title}</summary>${fields.map(f=>{const vals=xs.map(x=>x[f]); if(vals.every(v=>v==null||v==='—')) return ''; const w=isNum?winner(vals):null;
  return `<div class="crow"><div class="clab">${f}</div><div class="cvals" style="--n:${xs.length}">${vals.map(val=>`<div class="cv${w!==null&&val===w?' win':''}">${isNum?`<b>${val}</b><span class="bar"><i style="width:${val}%"></i></span>`:esc(val??'—')}</div>`).join('')}</div></div>`;}).join('')}</details>`;
 const pr=xs.map(x=>x.g); const pw=winner(pr.map(g=>g??Infinity),false);
 h+=`<details class="cgroup" open><summary>Price</summary><div class="crow"><div class="clab">Recorded price</div><div class="cvals" style="--n:${xs.length}">${xs.map(x=>`<div class="cv${pw!==null&&x.g===pw?' win':''}"><b>${esc(x.p)}</b>${x.pc?`<span class="tiny">checked ${x.pc}</span>`:''}</div>`).join('')}</div></div></details>`;
 h+=grp('Calculated ratings',SCORES,true,true)+grp('Specifications',SPECS,true,false);
 h+=`<div class="buyrow" style="--n:${xs.length}">${xs.map(x=>`<a class="btn aff" rel="sponsored nofollow" data-affiliate="PLACEHOLDER" href="${esc(x.u)}" aria-label="Check price: ${esc(x.m)}"><span class="bn">${esc(short(x))}</span><span>Check price</span></a>`).join('')}<p class="disc">Ad: these may be affiliate links; we may earn a commission at no extra cost to you. <a href="/affiliate-disclosure/">Disclosure</a></p></div>`;
 root.innerHTML=h;}
function headCell(x,i){return `<div class="hc">${img(x,48,58)}<a class="hn" href="/rackets/${x.s}/">${esc(short(x))}</a><span class="hp">${esc(x.p)}</span><div class="hact"><button type="button" class="mini" data-add="${i}" aria-label="Swap ${esc(x.m)}">Swap</button><button type="button" class="mini" data-rm="${i}" aria-label="Remove ${esc(x.m)}">✕</button></div></div>`;}
function list(){const q=$('sheet-q').value.toLowerCase().trim(); const r=slim.filter(x=>!sel.includes(x.s)&&(!q||x.m.toLowerCase().includes(q))).slice(0,40);
 $('sheet-list').innerHTML=r.length?r.map(x=>`<li><button type="button" data-pick="${x.s}">${img(x,32,38)}<span><b>${esc(x.m)}</b><small>${esc(x.Shape)} · ${esc(x.p)}</small></span></button></li>`).join(''):'<li class="muted">No match</li>';}
function open(i){slot=i; $('sheet-q').value=''; list(); $('sheet').showModal(); if(matchMedia('(min-width:700px)').matches) $('sheet-q').focus();}
document.addEventListener('click',e=>{const t=e.target.closest('[data-add],[data-rm],[data-pick],[data-close],[data-quick]'); if(!t){ if(e.target===$('sheet')) $('sheet').close(); return;}
 const d=t.dataset; if(d.add!=null) open(+d.add); else if(d.rm!=null){sel.splice(+d.rm,1);draw();} else if(d.quick){sel.push(d.quick);draw();}
 else if(d.pick){ if(slot<sel.length) sel[slot]=d.pick; else sel.push(d.pick); sel=sel.slice(0,3); $('sheet').close(); draw(); window.scrollTo({top:0}); } else if(d.close!=null) $('sheet').close();});
document.addEventListener('wp:region',()=>{rp();draw();});
let tm; $('sheet-q').addEventListener('input',()=>{clearTimeout(tm);tm=setTimeout(list,80)}); draw();})();
</script>
</Base>
