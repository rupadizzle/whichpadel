---
// Design trial. Same products as /shells, drawn as one card. Not in the sitemap route map.
import Base from '../layouts/Base.astro';
import Shell2Card from '../components/Shell2Card.astro';
import { rackets } from '../lib/data.js';
import { shoes, shoeImg } from '../lib/shoes.js';
import { balls } from '../lib/balls.js';
import { D, url } from '../i18n/index.js';
import { HUB } from '../i18n/hub.js';
import { SHOE } from '../i18n/shoes.js';
import { BALL } from '../i18n/balls.js';
import { pick, fmt, DEFAULT_REGION } from '../lib/price.js';

const lang = 'en';
const d = D(lang), t = d.terms, H = HUB[lang], S = SHOE[lang], B = BALL[lang];
const reg = DEFAULT_REGION(lang);
const escRe = s => String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const shortM = r => {
  let s = r.model || '';
  if (r.brand) s = s.replace(new RegExp('^' + escRe(r.brand) + '\\s+', 'i'), '');
  if (r.year) s = s.replace(new RegExp('\\s+' + r.year + '\\s*$'), '');
  return s.trim() || r.model;
};
const quote = item => {
  const q = pick(item, reg);
  if (q.none) return { price: H.none, was: '' };
  return {
    price: H.fromP.replace('{p}', fmt(q.v, q.cur, lang)),
    was: fmt(Math.round(q.v / 0.75), q.cur, lang),
  };
};
const ballEach = b => {
  const q = pick(b, reg);
  return q.none ? '' : `${fmt(Math.round(q.v / b.balls * 100) / 100, q.cur, lang)} ${B.perBall}`;
};
const withImg = rackets.filter(r => r.image && r.ratings && r.shape);
const racket = withImg.find(r => (r.year || 0) >= 2026 && r.audience !== 'junior') || withImg[0];
const racketB = withImg.find(r => r.slug !== racket.slug && r.brand !== racket.brand) || withImg[1];
const shoe = shoes.find(s => s.imgs && s.inStock) || shoes.find(s => s.imgs);
const ball = balls.find(b => b.imgs) || balls[0];
const barsOf = r => ['power', 'control', 'forgiveness'].filter(k => r.ratings && r.ratings[k] != null).map(k => ({ label: t.rt[k], value: r.ratings[k] }));
const specR = r => [r.shape && t.shapeCap[r.shape], r.weightMin && `${r.weightMin}${r.weightMax && r.weightMax !== r.weightMin ? '–' + r.weightMax : ''}\u00a0g`].filter(Boolean).join(' · ');
const specS = s => [S.genders[s.gender], ...s.sole.map(k => S.soles[k])].filter(Boolean).join(' · ');
const specB = b => [B.speeds[b.speed], b.tour && B.tours[b.tour], b.eco && B.eco, ballEach(b)].filter(Boolean).join(' · ');
const shoeName = () => {
  let n = shoe.name || '';
  if (shoe.brand) n = n.replace(new RegExp('^' + escRe(shoe.brand) + '\\s+', 'i'), '');
  if (shoe.year) {
    n = n.replace(new RegExp('\\s+' + shoe.year + '\\s*$'), '');
    const yy = String(shoe.year).slice(-2);
    if (yy.length === 2) n = n.replace(new RegExp('\\s+' + yy + '\\s*$'), '');
  }
  return n.trim() || shoe.name;
};
const rq = quote(racket), sq = quote(shoe), bq = quote(ball), rbq = quote(racketB);
const L = (type, id) => url(type, lang, id);
const cut = '−25%';
---
<Base lang={d.locale} title="One card surface" description="A design trial of the shared product card: one surface, name and price on one line, controls off the type." noindex>
<div class="s2p">
  <p class="s2p-kicker">Shells 2 · <a href="/shells">Current shells</a></p>
  <h1>One surface</h1>
  <p class="s2p-lead">The same products as the shells page. The photo runs to the edge of a single card. The name and the price share a line, and the spec sits underneath. Save, alert, and compare sit together, off the type.</p>

  <section class="s2p-block">
    <h2>Tile</h2>
    <p class="s2p-lead">A shorter photo, on the same grey ground for a racket, a shoe, and a ball. The −25% is the example cut from the shells page. The usual price sits under the current one.</p>
    <ul class="s2-grid">
      <Shell2Card lang={lang} posture="tile" eager compare off={cut} was={rq.was} href={L('racket', racket.slug)} img={racket.image} brand={[racket.brand, racket.year].filter(Boolean).join(' · ')} name={shortM(racket)} spec={specR(racket)} price={rq.price} save={racket.slug}/>
      <Shell2Card lang={lang} posture="tile" compare off={cut} was={sq.was} href={L('shoe', shoe.slug)} img={shoeImg(shoe) || ''} kind="s" brand={[shoe.brand, shoe.year].filter(Boolean).join(' · ')} name={shoeName()} spec={specS(shoe)} price={sq.price} save={shoe.slug}/>
      <Shell2Card lang={lang} posture="tile" off={cut} was={bq.was} href={L('ball', ball.slug)} img={ball.imgs ? `/balls/g/${ball.slug}-400.webp` : ''} kind="b" brand={ball.brand} name={ball.model} spec={specB(ball)} price={bq.price} save={ball.slug}/>
    </ul>
  </section>

  <section class="s2p-block">
    <h2>Row</h2>
    <p class="s2p-lead">The same card on its side. The photo is a column of the card. Actions sit at the end.</p>
    <ul class="s2-list">
      <Shell2Card lang={lang} posture="row" compare href={L('racket', racket.slug)} img={racket.image} brand={[racket.brand, racket.year].filter(Boolean).join(' · ')} name={shortM(racket)} spec={specR(racket)} price={rq.price} save={racket.slug}/>
      <Shell2Card lang={lang} posture="row" compare href={L('shoe', shoe.slug)} img={shoeImg(shoe) || ''} kind="s" brand={[shoe.brand, shoe.year].filter(Boolean).join(' · ')} name={shoeName()} spec={specS(shoe)} price={sq.price} save={shoe.slug}/>
      <Shell2Card lang={lang} posture="row" href={L('ball', ball.slug)} img={ball.imgs ? `/balls/g/${ball.slug}-400.webp` : ''} kind="b" brand={ball.brand} name={ball.model} spec={specB(ball)} price={bq.price} save={ball.slug}/>
    </ul>
  </section>

  <section class="s2p-block">
    <h2>Best list</h2>
    <p class="s2p-lead">Rank stays on the photo. The bars use the width of the text. On a phone the photo moves back on top and the controls return to the corner.</p>
    <div class="s2-pair">
      <div class="s2-wide">
        <p class="s2p-kicker">Wide</p>
        <ul class="s2-list">
          <Shell2Card lang={lang} posture="best" eager rank={1} compare href={L('racket', racketB.slug)} img={racketB.image} brand={[racketB.brand, racketB.year].filter(Boolean).join(' · ')} name={shortM(racketB)} spec={specR(racketB)} price={rbq.price} save={racketB.slug} bars={barsOf(racketB)}/>
          <Shell2Card lang={lang} posture="best" rank={2} compare href={L('racket', racket.slug)} img={racket.image} brand={[racket.brand, racket.year].filter(Boolean).join(' · ')} name={shortM(racket)} spec={specR(racket)} price={rq.price} save={racket.slug} bars={barsOf(racket)}/>
        </ul>
      </div>
      <div class="s2-phone">
        <p class="s2p-kicker">Phone</p>
        <ul class="s2-list">
          <Shell2Card lang={lang} posture="best" rank={1} compare href={L('racket', racketB.slug)} img={racketB.image} brand={[racketB.brand, racketB.year].filter(Boolean).join(' · ')} name={shortM(racketB)} spec={specR(racketB)} price={rbq.price} save={racketB.slug} bars={barsOf(racketB)}/>
          <Shell2Card lang={lang} posture="best" rank={2} compare href={L('racket', racket.slug)} img={racket.image} brand={[racket.brand, racket.year].filter(Boolean).join(' · ')} name={shortM(racket)} spec={specR(racket)} price={rq.price} save={racket.slug} bars={barsOf(racket)}/>
        </ul>
      </div>
    </div>
  </section>
</div>
</Base>

<style is:global>
.s2p-kicker{font-size:.75rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--green);margin:0 0 4px}
.s2p-kicker a{letter-spacing:0;text-transform:none;font-weight:600}
.s2p > h1{margin:0 0 8px}
.s2p-block > h2{margin:0 0 8px;font-size:1.35rem}
.s2p-lead{margin:0 0 16px;max-width:62ch;color:var(--mut)}
.s2p-block{margin:0 0 40px}
.s2p-block:first-of-type{margin-top:28px}
.s2-grid,.s2-list{list-style:none;margin:0;padding:0}
.s2-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;max-width:880px}
.s2-list{display:grid;gap:10px;max-width:40rem}
.s2-wide .s2-list{max-width:46rem}
.s2-pair{display:grid;grid-template-columns:minmax(0,46rem) minmax(16rem,22.5rem);gap:28px;align-items:start}
.s2-phone{max-width:22.5rem}

.s2{position:relative;background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;min-width:0}
.s2:hover{border-color:#c8d3da}
.s2:has(.s2-a:focus-visible){outline:2px solid var(--navy);outline-offset:2px}
.s2-a{color:inherit;text-decoration:none;min-width:0}
.s2-a:hover .s2-name{text-decoration:underline;text-underline-offset:.12em}
.s2-ph{position:relative;background:#f3f6f5;min-width:0;overflow:hidden}
.s2-ph img{position:absolute;inset:6%;width:auto;height:auto;max-width:88%;max-height:88%;margin:auto;object-fit:contain}
.s2-body{display:flex;flex-direction:column;gap:2px;min-width:0;padding:10px 12px 12px;background:#fff}
.s2-brand{font-size:.6875rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--mut);line-height:1.3}
.s2-line{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.s2-name{font-weight:700;font-size:.9375rem;line-height:1.25;letter-spacing:-.01em;min-width:0}
.s2-price{display:flex;flex-direction:column;align-items:flex-end;gap:1px;flex:none;white-space:nowrap}
.s2-price s{color:var(--mut);font-size:.75rem;font-weight:500;line-height:1.2;text-decoration:line-through}
.s2-price b{color:var(--green);font-size:.9375rem;font-weight:700}
.s2-spec{font-size:.75rem;line-height:1.35;color:var(--mut)}
.s2-bars{display:grid;gap:6px;margin-top:8px}
.s2-bars>span{display:grid;grid-template-columns:5.5rem minmax(0,1fr) 1.6rem;gap:8px;align-items:center;font-size:.75rem;color:var(--mut)}
.s2-bars b{color:var(--ink);text-align:right;font-weight:650}
.s2-track{height:7px;border-radius:99px;background:#e8edf0;overflow:hidden}
.s2-track i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--green2),#58c27d)}
.s2-rank{position:absolute;top:8px;left:8px;z-index:2;background:var(--navy);color:var(--lime);font-weight:800;font-size:.75rem;line-height:1;padding:5px 7px;border-radius:7px}
.s2-off{position:absolute;left:8px;bottom:8px;z-index:2;margin:0;padding:2px 6px;border-radius:6px;background:var(--lime);color:var(--navy);font-size:.75rem;font-weight:800;line-height:1.2;letter-spacing:-.02em}
.s2-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

.s2-tile .s2-a{display:flex;flex-direction:column;height:100%}
.s2-tile .s2-ph{aspect-ratio:4/3}
.s2-tile .s2-name{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.5em}
.s2-tile .s2-acts{position:absolute;top:8px;right:8px;z-index:2;padding:2px;background:rgb(255 255 255 / .92);border:1px solid rgb(15 28 36 / .08);border-radius:10px}

.s2-row,.s2-best{display:grid;grid-template-columns:112px minmax(0,1fr) auto;align-items:stretch}
.s2-best{grid-template-columns:156px minmax(0,1fr) auto}
.s2-row .s2-a,.s2-best .s2-a{display:grid;grid-column:1 / 3;grid-row:1;grid-template-columns:subgrid}
.s2-row .s2-body,.s2-best .s2-body{align-self:center;padding:10px 8px 10px 12px}
.s2-row .s2-acts,.s2-best .s2-acts{grid-column:3;grid-row:1;align-self:center;padding-right:4px}

.s2-acts{display:flex;align-items:center}
.s2-acts .rk-bell,.s2-acts .save-heart,.s2-acts .s2-cmp{width:32px;height:32px;min-height:0;margin:0;padding:0;border:0;border-radius:8px;background:none;box-shadow:none;display:grid;place-items:center;color:#5c6b74;cursor:pointer}
.s2-acts .bell,.s2-acts .heart,.s2-acts .s2-cmp svg{width:16px;height:16px;flex:none}
.s2-acts .rk-bell:hover,.s2-acts .save-heart:hover,.s2-acts .s2-cmp:hover{color:var(--ink);background:rgb(15 28 36 / .06)}
.s2-acts .save-heart[aria-pressed="true"]{color:#e11d48;background:none}
.s2-acts .rk-bell[aria-pressed="true"]{color:var(--green);background:none}
.s2-cmp{position:relative}
.s2-cmp input{position:absolute;opacity:0;inset:0;width:100%;height:100%;min-height:0;margin:0;padding:0;border:0;cursor:pointer}
.s2-cmp:has(input:checked){color:var(--green)}
.s2-cmp:has(input:focus-visible){outline:2px solid var(--green2);outline-offset:1px}
.s2-acts .rk-bell:focus-visible,.s2-acts .save-heart:focus-visible{outline:2px solid var(--green2);outline-offset:1px}

.s2-phone .s2-best{display:flex;flex-direction:column}
.s2-phone .s2-best .s2-a{display:flex;flex-direction:column;grid-column:auto;grid-row:auto}
.s2-phone .s2-best .s2-ph{aspect-ratio:4/3}
.s2-phone .s2-best .s2-body{align-self:stretch;padding:10px 12px 12px}
.s2-phone .s2-best .s2-acts{position:absolute;top:8px;right:8px;grid-column:auto;padding:2px;background:rgb(255 255 255 / .92);border:1px solid rgb(15 28 36 / .08);border-radius:10px}

@media(max-width:980px){
 .s2-pair{grid-template-columns:1fr}
}
@media(max-width:720px){
 .s2-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:640px){
 .s2-phone{display:none}
 .s2-wide .s2-best{display:flex;flex-direction:column}
 .s2-wide .s2-best .s2-a{display:flex;flex-direction:column;grid-column:auto;grid-row:auto}
 .s2-wide .s2-best .s2-ph{aspect-ratio:4/3}
 .s2-wide .s2-best .s2-body{align-self:stretch;padding:10px 12px 12px}
 .s2-wide .s2-best .s2-acts{position:absolute;top:8px;right:8px;grid-column:auto;padding:2px;background:rgb(255 255 255 / .92);border:1px solid rgb(15 28 36 / .08);border-radius:10px}
}
@media(max-width:460px){
 .s2-grid{grid-template-columns:1fr}
}
</style>
