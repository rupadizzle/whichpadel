---
import Base from '../../layouts/Base.astro'; import RacketImage from '../../components/RacketImage.astro'; import { brandList, rackets } from '../../lib/data.js';
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'ItemList','name':'Padel racket brands','numberOfItems':brandList.length,'itemListElement':brandList.map((b,i)=>({'@type':'ListItem','position':i+1,'url':`https://whichpadel.com/brands/${b.slug}/`,'name':b.name}))},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':'https://whichpadel.com/'},{'@type':'ListItem','position':2,'name':'Brands','item':'https://whichpadel.com/brands/'}]}]};
const sorted=[...brandList].sort((a,b)=>b.count-a.count||a.name.localeCompare(b.name));
---
<Base title={`Padel racket brands: ${brandList.length} brands compared | WhichPadel`} description={`Browse ${rackets.length} padel rackets from ${brandList.length} brands, including Bullpadel, Nox, Adidas, Siux, Babolat and Head. Sourced specs and spec-based ratings for every model.`} jsonld={jsonld}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <span>Brands</span></nav>
<h1>Padel racket brands</h1>
<p class="muted lead-sm">{brandList.length} brands and {rackets.length} rackets, each with specs taken from the maker's or a retailer's published page. Pick a brand to see its full range, or read our <a href="/padel-rackets/#brands">guide to padel racket brands</a>.</p>
<div class="bgrid">{sorted.map(b=>{const pic=b.rackets.find(r=>r.image)||b.rackets[0]; return <a class="bcard" href={`/brands/${b.slug}/`}><RacketImage r={pic} size={44} label={false}/><span><b>{b.name}</b><span class="muted small">{b.count} racket{b.count>1?'s':''}</span></span></a>;})}</div>
</Base>
