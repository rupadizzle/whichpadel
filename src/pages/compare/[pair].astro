---
import Price from '../../components/Price.astro'; import { offersOf } from '../../lib/price.js';
import Base from '../../layouts/Base.astro'; import RacketImage from '../../components/RacketImage.astro';
import { vsPairs, vsCopy, specRows } from '../../lib/vs.js'; import { fmtPrice, cap } from '../../lib/data.js';
export function getStaticPaths(){ return vsPairs.map(p=>({params:{pair:p.slug},props:{p}})); }
const { p } = Astro.props; const {A,B}=p; const xs=[A,B]; const c=vsCopy(A,B);
const U=`https://whichpadel.com/compare/${p.slug}/`;
const win=(vals,hi=true)=>{const n=vals.filter(v=>typeof v==='number'); if(n.length<2||n[0]===n[1]) return null; return hi?Math.max(...n):Math.min(...n);};
const SC=['power','control','handling','forgiveness','comfort','value']; const SA=specRows(A), SB=specRows(B);
const pw=win([A.priceGBPApprox,B.priceGBPApprox],false);
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'FAQPage','mainEntity':c.faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':'https://whichpadel.com/'},{'@type':'ListItem','position':2,'name':'Compare','item':'https://whichpadel.com/compare/'},{'@type':'ListItem','position':3,'name':`${c.a} vs ${c.b}`,'item':U}]}]};
const others=vsPairs.filter(x=>x.slug!==p.slug).slice(0,6);
---
<Base title={`${A.model} vs ${B.model}: specs compared | WhichPadel`} description={`${c.a} vs ${c.b}: shape, weight, balance, core, price and spec-based ratings side by side, with a quick verdict.`.slice(0,158)} jsonld={jsonld} ogImage={A.image?`https://whichpadel.com${A.image}`:undefined}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/compare/">Compare</a> › <span>{c.a} vs {c.b}</span></nav>
<div class="cmp-intro"><h1>{c.a} vs {c.b}</h1><p class="muted">{c.intro}</p></div>
<div class="cmp" style="--n:2">
<div class="chead" style="--n:2">{xs.map(r=><div class="hc"><RacketImage r={r} size={48}/><a class="hn" href={`/rackets/${r.slug}/`}>{r.model.replace(r.brand+' ','')}</a><Price r={r} cls="hp"/></div>)}</div>
<section class="verdict" aria-label="Verdict"><h2 class="h3">Our verdict</h2><p style="margin:0">{c.verdict}</p></section>
<details class="cgroup" open><summary>Price</summary><div class="crow"><div class="clab">Recorded price</div><div class="cvals" style="--n:2">{xs.map(r=><div class={`cv${pw!==null&&r.priceGBPApprox===pw?' win':''}`}><b><Price r={r}/></b>{r.priceChecked&&<span class="tiny">checked {r.priceChecked}</span>}</div>)}</div></div></details>
<details class="cgroup" open><summary>Calculated ratings</summary>{SC.map(k=>{const w=win([A.ratings[k],B.ratings[k]]); return <div class="crow"><div class="clab">{cap(k)}</div><div class="cvals" style="--n:2">{xs.map(r=><div class={`cv${w!==null&&r.ratings[k]===w?' win':''}`}><b>{r.ratings[k]}</b><span class="bar"><i style={`width:${r.ratings[k]}%`}></i></span></div>)}</div></div>;})}</details>
<details class="cgroup" open><summary>Specifications</summary>{Object.keys(SA).filter(k=>SA[k]!=null||SB[k]!=null).map(k=><div class="crow"><div class="clab">{k}</div><div class="cvals" style="--n:2"><div class="cv">{SA[k]??'Not published'}</div><div class="cv">{SB[k]??'Not published'}</div></div></div>)}</details>
<div class="buyrow" style="--n:2">{xs.map(r=><a class="btn aff" rel="sponsored nofollow" data-affiliate="PLACEHOLDER" data-o={JSON.stringify(offersOf(r))} href={r.productUrl} aria-label={`Check price: ${r.model}`}><span class="bn">{r.model.replace(r.brand+' ','')}</span><span>Check price</span></a>)}<p class="disc">Ad: these may be affiliate links; we may earn a commission at no extra cost to you. <a href="/affiliate-disclosure/">Disclosure</a></p></div>
</div>
<p class="muted small trust">Ratings are calculated from published specs (our rating formula), not court tests. <a href={`/compare/?r=${A.slug},${B.slug}`}>Add a third racket in the compare tool →</a></p>
<section class="panel"><h2>{c.a} vs {c.b}: FAQ</h2>{c.faq.map(([q,a])=><div class="faq"><h3>{q}</h3><p>{a}</p></div>)}</section>
<section class="panel vs"><h2>More head-to-heads</h2>{others.map(o=><a href={`/compare/${o.slug}/`}><span>{o.A.model} vs {o.B.model}</span><span>→</span></a>)}</section>
</Base>
