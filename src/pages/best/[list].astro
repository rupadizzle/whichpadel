---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import { rackets, lists, VALUE_FORMULA } from '../../lib/data.js';
export function getStaticPaths(){ return Object.keys(lists).map(list=>({params:{list}})); }
const K=Astro.params.list; const L=lists[K]; const top=L.pick(rackets).slice(0,15); const U=`https://whichpadel.com/best/${K}/`;
const faq=[[`How is the ${L.title.toLowerCase()} list ranked?`,`${L.rule} Only the top ${top.length} are shown, and no brand pays for a place.`],['Are these ratings from court tests?','No. The ratings are calculated from published specifications using our rating formula. They are not lab or on-court tests.'],[`Which racket is number one?`,`${top[0]?.model} is currently first on this list, based on the rule above.`]];
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'ItemList','name':L.title,'url':U,'numberOfItems':top.length,'itemListElement':top.map((r,i)=>({'@type':'ListItem','position':i+1,'url':`https://whichpadel.com/rackets/${r.slug}/`,'name':r.model}))},
{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':'https://whichpadel.com/'},{'@type':'ListItem','position':2,'name':L.title,'item':U}]},
{'@type':'FAQPage','mainEntity':faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))}]};
import { extraLists } from '../../lib/seo-content.js';
const others=Object.entries({...lists,...extraLists}).filter(([k])=>k!==K);
---
<Base alt={Astro.params.list==='best-padel-racket-2026'?{en:'/best/best-padel-racket-2026/',es:'/es/mejores-palas-padel/'}:null} title={`${L.title} (2026): ranked from published specs | WhichPadel`} description={`${L.title} for 2026: the top ${top.length} picks from ${rackets.length} rackets, ranked by a transparent rule on published specs. #1 is ${top[0]?.model}.`} jsonld={jsonld}>
<section class="phero" slot="hero"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="/" style="color:#9fb6c0">Home</a> › <span>Best lists</span></nav><span class="eyebrow">Updated October 2026 · {top.length} picks</span><h1>{/2026/.test(L.title)?L.title:`${L.title} (2026)`}</h1>{L.intro&&<p>{L.intro}</p>}</div></section>
<div class="rulebox"><b>How this list is built:</b> {L.rule} Top {top.length} shown. No sponsored placements. Ratings are calculated from published specs (our rating formula), not court tests or paid reviews.</div>
<div class="rlist" id="best">{top.map((r,i)=><Card r={r} rank={i+1} eager={i===0}/>)}</div>
<div class="toolbar"><span class="muted small">Tick 2–3 rackets to compare them.</span><button class="btn btn-sm" type="button" onclick="const s=[...document.querySelectorAll('.cmp:checked')].map(c=>c.value).slice(0,3); if(s.length<2) return alert('Tick 2 or 3 rackets'); location.href='/compare/?r='+s.join(',');">Compare selected</button></div>
{L.method&&<section class="panel" id="methodology"><h2>Methodology</h2><p>{VALUE_FORMULA}</p><p class="muted small">Ratings come from published specs (our rating formula), not court tests. Prices are recorded snapshots, so the score moves when prices change.</p></section>}
<section class="panel"><h2>Frequently asked questions</h2>{faq.map(([q,a])=><div class="faq"><h3>{q}</h3><p>{a}</p></div>)}</section>
<section class="panel vs"><h2>Other buying guides</h2>{others.map(([k,v])=><a href={`/best/${k}/`}><span>{v.title}</span><span>→</span></a>)}<p style="margin:12px 0 0"><a href="/padel-rackets/">How to choose a padel racket →</a> · <a href="/brands/">Browse rackets by brand →</a></p></section>
</Base>
