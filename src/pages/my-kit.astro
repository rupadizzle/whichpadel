<section class="panel"><h2 class="h3">Want something better?</h2><p>Describe how you play and we'll suggest alternatives: <a href="/describe/">racket finder</a> · <a href="/describe-shoes/">shoe finder</a> · <a href="/deals/">today's deals</a>.</p></section>
<script is:inline src="/deal-check.js"></script>
<script is:inline define:vars={{SH,BA,BG,RK}}>
const $=id=>document.getElementById(id), esc=s=>String(s).replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
const K='wp_kit'; const read=()=>{try{return JSON.parse(localStorage[K]||'[]')}catch(e){return []}}; const write=a=>{try{localStorage[K]=JSON.stringify(a)}catch(e){}};
const SLOTS={bag:{t:'Bag',lead:'Search for the bag you use.',label:'Search',ph:'Adidas, Bullpadel…'},racket:{t:'Racket',lead:'Search for the racket you use now.',label:'Search',ph:'Bullpadel, Vertex…'},shoes:{t:'Shoes',lead:'Search for the shoes you play in.',label:'Search',ph:'Asics, Gel-Padel…'}};
const byKey=new Map();
const row=(k,n,i,u,t,api)=>({k,n,i,u,t,api});
BG.forEach(([k,n,i,u,px,kind])=>byKey.set(k,{...row(k,n,i,u,'Bag','/api/shoe-prices'),px,kind}));
SH.forEach(([k,n,i,u])=>byKey.set(k,row(k,n,i,u,'Shoes','/api/shoe-prices')));
BA.forEach(([k,n,i,u])=>byKey.set(k,row(k,n,i,u,'Balls','/api/shoe-prices')));
$('kball-l').innerHTML=BA.map(([,n])=>`<option value="${esc(n)}">`).join('');
let RACKETS=null, openSlot=null, req=0;
const rackets=()=>RACKETS||(RACKETS=fetch('/cards.json').then(r=>{if(!r.ok) throw new Error(); return r.json()}).then(a=>{a.forEach(c=>{const it=row(c.s,c.m,c.i||'',RK.replace('__',c.s),'Racket','/api/all-prices'); byKey.set(c.s,it);}); return a;}).catch(e=>{RACKETS=null; throw e;}));
const slotOf=x=>x.t==='Racket'?'racket':x.t==='Shoes'?'shoes':x.t==='Bag'?'bag':null;
const worn=()=>{const o={}; for(const x of read()){const s=slotOf(x); if(s&&!o[s]) o[s]=x;} return o;};
function put(it){let a=read().filter(x=>x.k!==it.k&&x.t!=='Shirt'); if(it.t!=='Balls') a=a.filter(x=>x.t!==it.t); const save={k:it.k,n:it.n,i:it.i,u:it.u,t:it.t,api:it.api,at:new Date().toISOString().slice(0,10)}; if(it.kind) save.kind=it.kind; a.unshift(save); write(a);}
function paintFig(){const w=worn();
 document.querySelectorAll('.kit-zone').forEach(el=>{const s=el.dataset.slot, x=w[s]; el.classList.toggle('is-set',!!x); el.classList.toggle('is-open',openSlot===s);
  el.setAttribute('aria-pressed',openSlot===s?'true':'false'); el.setAttribute('aria-label',x?`${SLOTS[s].t}: ${x.n}. Change`:`${SLOTS[s].t}. Choose what you use`);});
 placeHits();}
function placeHits(){const fig=document.querySelector('.kit-fig'), fr=fig.getBoundingClientRect(), svg=fig.querySelector('svg'); if(!svg) return;
 const box={bag:'#fig-bag',racket:'#fig-racket',shoes:'#fig-shoes'};
 const grow={bag:[6,6],racket:[6,6],shoes:[8,6]};
 for(const [s,sel] of Object.entries(box)){const r=svg.querySelector(sel).getBoundingClientRect(); const zone=fig.querySelector(`[data-zone="${s}"]`); const [gy,gx]=grow[s];
  zone.style.left=(r.left-fr.left-gx)+'px'; zone.style.top=(r.top-fr.top-gy)+'px'; zone.style.width=(r.width+gx*2)+'px'; zone.style.height=(r.height+gy*2)+'px';}}
function closePick(){openSlot=null; $('kpick').hidden=true; paintFig();}
async function showResults(q){const mine=++req, slot=openSlot; if(!SLOTS[slot]) return; const n=q.trim().toLowerCase();
 if(n.length<2){$('kpick-list').innerHTML=''; $('kpick-msg').textContent='Type at least two letters.'; return;}
 $('kpick-msg').textContent='Searching…';
 try{if(slot==='racket') await rackets();}catch(e){if(mine===req) $('kpick-msg').textContent='The racket list did not load. Refresh the page.'; return;}
 if(mine!==req||openSlot!==slot) return;
 const type=SLOTS[slot].t, on=worn()[slot];
 const hit=[...byKey.values()].filter(x=>x.t===type&&x.n.toLowerCase().includes(n)).sort((a,b)=>(a.n.toLowerCase().startsWith(n)?0:1)-(b.n.toLowerCase().startsWith(n)?0:1)||a.n.localeCompare(b.n)).slice(0,12);
 $('kpick-list').innerHTML=hit.map(x=>`<li><button type="button" data-k="${esc(x.k)}"${on&&on.k===x.k?' aria-current="true"':''}>${x.i?`<img src="${esc(x.i)}" alt="" width="48" height="48">`:`<span class="kit-ph"></span>`}<span class="kit-rn">${esc(x.n)}${x.kind?`<small class="muted" style="display:block">${esc(x.kind)}</small>`:''}</span></button></li>`).join('');
 $('kpick-msg').textContent=hit.length?`${hit.length} match${hit.length===1?'':'es'}`:'No matches.';}
function openPick(slot){openSlot=slot; const meta=SLOTS[slot]; $('kpick').hidden=false; $('kpick-h').textContent=meta.t; $('kpick-lead').textContent=meta.lead; $('kpick-f').hidden=false;
 $('kpick-qlabel').textContent=meta.label; $('kpick-q').placeholder=meta.ph; $('kpick-msg').textContent=''; $('kpick-list').innerHTML=''; $('kpick-q').value='';
 paintFig(); showResults(''); $('kpick-q').focus();}
function choose(k){const it=byKey.get(k); if(!it) return; put(it); render(); if(openSlot) showResults($('kpick-q').value);}
$('kfig').addEventListener('click',e=>{const el=e.target.closest('[data-slot]'); if(!el) return; const s=el.dataset.slot; if(openSlot===s) closePick(); else openPick(s);});
$('kpick-done').onclick=closePick;
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&openSlot) closePick();});
$('kpick-f').onsubmit=e=>{e.preventDefault(); const first=$('kpick-list').querySelector('[data-k]'); if(first) choose(first.dataset.k);};
$('kpick-q').addEventListener('input',()=>{if(openSlot) showResults($('kpick-q').value);});
$('kpick-list').onclick=e=>{const b=e.target.closest('[data-k]'); if(b) choose(b.dataset.k);};
$('kball').onsubmit=e=>{e.preventDefault(); const v=$('kball-q').value.trim().toLowerCase(); const it=[...byKey.values()].find(x=>x.t==='Balls'&&x.n.toLowerCase()===v); $('kball-msg').textContent=it?'Added.':'Pick a ball from the list.'; if(!it) return; put(it); $('kball-q').value=''; render();};
const F=(p,c)=>WPDeal.fmt(p,c);
async function render(){const kept=read().filter(x=>x.t!=='Shirt'); if(kept.length!==read().length) write(kept); paintFig(); const a=read(); $('kempty').hidden=a.length>0; const UL=$('kit');
 const rows=await Promise.all(a.map(async x=>{let hint='No shop price right now.';
  if(x.api){const j=await WPDeal.get(x.api); const e=j&&j.r&&j.r[x.k];
   if(e&&e.p>0){const v=WPDeal.verdict(e); hint=`Best price today: ${F(e.p,e.c)} at ${esc(e.n||e.d)}${e.s===0?' (out of stock)':''}. `; hint+=v?esc(v.t):e.drop>=5?`Down ${e.drop}% on its previous price. Good time to reorder.`:'No price drop right now.';}
   else if(x.t==='Bag'){const px=(byKey.get(x.k)||{}).px; if(px) hint=`Best price today: ${F(px[0],px[1])} at ${esc(px[2])}.`;}}
  const go=x.u?`<a class="btn btn-line btn-sm" href="${esc(x.u)}">Reorder</a>`:'';
  return `<li style="display:flex;gap:12px;align-items:center;padding:10px 0;border-top:1px solid #e8edf0">${x.i?`<img src="${esc(x.i)}" alt="" width="56" height="56" loading="lazy" style="object-fit:contain">`:''}<span style="flex:1"><small class="muted">${esc(x.kind||x.t)}</small><br/><b>${x.u?`<a href="${esc(x.u)}">${esc(x.n)}</a>`:esc(x.n)}</b><small style="display:block">${hint}</small></span>${go} <button class="btn btn-line btn-sm" type="button" data-rm="${esc(x.k)}" aria-label="Remove ${esc(x.n)}">✕</button></li>`;}));
 UL.innerHTML=rows.join(''); UL.querySelectorAll('[data-rm]').forEach(b=>b.onclick=()=>{write(read().filter(x=>x.k!==b.dataset.rm)); render();});}
addEventListener('resize',placeHits);
render();
</script>
</Base>
