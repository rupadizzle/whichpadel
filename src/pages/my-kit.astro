---
// "My kit": the bag, racket, shoes and balls you use now. Stored only in this browser (localStorage 'wp_kit').
// Deal hints come from the existing read-only price APIs. Bag rows are not on that API yet, so a bag uses its recorded shop price (same source as the bag page).
import Base from '../layouts/Base.astro';
import { shoes, shoeImg } from '../lib/shoes.js'; import { balls, ballImg } from '../lib/balls.js'; import { bags, bagImg, bagOffer } from '../lib/bags.js'; import { SHOPS } from '../lib/price.js'; import { url } from '../i18n/routes.js';
const shopName=d=>{const v=SHOPS[d]; return v&&v.name&&v.name!==d?v.name:String(d||'').replace(/\.(com|net|co\.uk|de|es)$/,'');};
const SH=shoes.map(s=>[s.slug,s.name,shoeImg(s)||'',url('shoe','en',s.slug)]);
const BA=balls.map(b=>['ball-'+b.slug,b.name,ballImg(b)||'',url('ball','en',b.slug)]);
const BG=bags.map(b=>{const q=bagOffer(b,'GB'), o=q&&q.o; return [b.id,b.name,bagImg(b)||'',url('bag','en',b.slug),o?[o.p,o.c,shopName(o.d)]:null,(b.type||'').replace(/\b\w/g,c=>c.toUpperCase())];});
const RK=url('racket','en','__');
const title='My kit: get told when what you use is cheaper';
---
<Base lang="en-GB" title={title+' | WhichPadel'} description="Tap the bag, racket and shoes you play with. We show today's best price, whether it's a real deal, and when to reorder.">
<article class="panel kit-page"><h1>{title}</h1>
<p>Tap the bag, racket or shoes and choose what you use now. We show today’s best price and whether it’s a genuine deal, so you can reorder at the right time. Your kit is saved only in this browser.</p>
<div class="kit-board">
<div class="kit-stage" id="kfig">
<div class="kit-fig">
