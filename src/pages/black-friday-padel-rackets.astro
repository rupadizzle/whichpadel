---
import Base from '../layouts/Base.astro'; import Card from '../components/Card.astro'; import PriceAlert from '../components/PriceAlert.astro'; import { rackets } from '../lib/data.js';
const dates=rackets.map(r=>r.priceChecked).filter(Boolean).sort(); const from=dates[0], to=dates.at(-1);
const ok=rackets.filter(r=>r.valueScore!=null&&r.image);
const tiers=[['Best value under £100',0,100],['Best value £100–£200',100,200],['Best value over £200',200,1e9]].map(([h,a,b])=>({h,rs:ok.filter(r=>r.priceGBPApprox>a&&r.priceGBPApprox<=b).sort((x,y)=>y.valueScore-x.valueScore).slice(0,4)}));
const tips=[['Check the price history, not the “was” price','A crossed-out price is only meaningful if the racket actually sold at it. Note today’s price (we show the date we recorded each one) and compare it on the day.'],['Compare the same model year','Shops often discount last year’s model. That can be a great deal, but check the year in the name: a 2026 racket at 2027 prices isn’t a bargain.'],['Look at the spec, not the hype','Shape, weight, balance and core decide how a racket plays. A big discount on the wrong racket is still the wrong racket. Use our compare tool before buying.'],['Factor in delivery and returns','Some EU shops add shipping or customs to UK orders. Compare the final price at checkout.'],['Set a target price now','Decide what you’d pay for the racket you want, then set an alert below so you only act on a real drop.']];
const faq=[['When is Black Friday 2026?','Black Friday 2026 is Friday 27 November, with Cyber Monday on 30 November. Many padel shops start offers earlier in November.'],['Are these Black Friday prices?','No. These are the latest prices we recorded, between '+from+' and '+to+'. We do not show “was” prices or invented discounts; check the shop for the live price.'],['How do I know a padel deal is real?','Compare the live price with the dated price we recorded here. If it is lower than our recorded price, it is a genuine drop since we last checked.']];
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'FAQPage','mainEntity':faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':'https://whichpadel.com/'},{'@type':'ListItem','position':2,'name':'Black Friday padel rackets','item':'https://whichpadel.com/black-friday-padel-rackets/'}]}]};
---
<Base title="Black Friday padel rackets 2026: best value picks & real deals | WhichPadel" description={`Black Friday 2026 padel racket guide: best value picks at recorded prices (checked ${to}), how to spot a real deal, and a price-drop alert. No fake “was” prices.`} jsonld={jsonld}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <span>Black Friday</span></nav>
<h1>Black Friday padel rackets 2026</h1>
<p class="lead-sm">Black Friday is 27 November 2026. Before the sales start, here are the best value rackets at today’s recorded prices, so you can tell a real deal from a marketing one.</p>
<p class="rulebox"><b>Prices recorded {from} to {to}.</b> These are the last prices we saw, not live Black Friday prices, and we never show “was” prices or invented discounts. Ranked by our <a href="/best/best-value-padel-rackets/#methodology">value score</a>.</p>
{tiers.filter(t=>t.rs.length).map(t=><section><h2>{t.h}</h2><div class="grid">{t.rs.map(r=><Card r={r}/>)}</div></section>)}
<p><a href="/best/best-value-padel-rackets/">See the full best-value list →</a></p>
<section class="panel"><h2>How to spot a real padel racket deal</h2>{tips.map(([h,p])=><div class="faq"><h3>{h}</h3><p>{p}</p></div>)}</section>
<PriceAlert/>
<section class="panel"><h2>FAQ</h2>{faq.map(([q,a])=><div class="faq"><h3>{q}</h3><p>{a}</p></div>)}</section>
</Base>
