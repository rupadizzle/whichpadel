---
// English deals page. Everything is computed in the browser from the recorded price history (read-only price APIs). No history = no verdict.
import Base from '../layouts/Base.astro';
import { allRackets } from '../lib/data.js'; import { shoes, shoeImg } from '../lib/shoes.js'; import { balls, ballImg } from '../lib/balls.js';
import { url } from '../i18n/routes.js'; import { FX } from '../lib/price.js';
const CAT={};
for(const r of allRackets) CAT[r.slug]={n:r.model,u:url('racket','en',r.slug),i:r.image||'',k:'r'};
for(const s of shoes) CAT[s.slug]={n:s.name,u:url('shoe','en',s.slug),i:shoeImg(s)||'',k:'s'};
for(const b of balls) CAT['ball-'+b.slug]={n:b.name,u:url('ball','en',b.slug),i:ballImg(b)||'',k:'b'};
const title='Padel deals: real price drops and lowest prices';
---
<Base lang="en-GB" title={title+' | WhichPadel'} description="Padel racket, shoe and ball deals checked against the prices we have recorded: real drops, lowest-ever prices and the cheapest in stock.">
<article class="panel prose"><h1>{title}</h1>
<p>We check prices every few hours and keep the history, so we can tell a real discount from a price that was raised and then "cut". Black Friday is on 27 November 2026: <a href="/black-friday/">get our one Black Friday email</a>.</p></article>
<section class="panel" id="d-real"><h2>Biggest drops vs the usual price</h2><ol class="dl" data-l="real"></ol><p class="muted small" data-empty="real" hidden>Not enough history yet. We give a verdict only after at least 3 weeks of recorded prices, so these appear from mid-November.</p></section>
<section class="panel" id="d-low"><h2>Lowest prices we've ever recorded</h2><ol class="dl" data-l="low"></ol><p class="muted small" data-empty="low" hidden>Not enough history yet (we need at least 3 weeks of recorded prices).</p></section>
<section class="panel" id="d-cut"><h2>Price cuts in the last 7 days</h2><ol class="dl" data-l="cut"></ol><p class="muted small" data-empty="cut" hidden>No price cuts recorded this week.</p></section>
<section class="panel"><h2>Cheapest in stock</h2>
<h3>Rackets</h3><ol class="dl" data-l="r"></ol><h3>Shoes</h3><ol class="dl" data-l="s"></ol><h3>Balls</h3><ol class="dl" data-l="b"></ol></section>
<p class="muted small" style="margin:12px 4px">Prices are the cheapest in-stock offer we found at the time shown. Shop links may earn us a commission; it never changes the order.</p>
<style>.dl{list-style:none;padding:0;margin:8px 0 16px}.dl li{display:flex;gap:12px;align-items:center;padding:8px 0;border-top:1px solid #e8edf0}.dl img{width:48px;height:48px;object-fit:contain}.dl a{font-weight:600}.dl small{display:block;color:#5b6b75}</style>
<script is:inline src="/deal-check.js"></script>
<script is:inline define:vars={{CAT,RATES:FX.rates}}>
const gbp=(p,c)=>p/(RATES[c]||1)*(RATES.GBP||1);
const esc=s=>String(s).replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
const F=WPDeal.fmt;
const li=(x,note)=>`<li>${x.c.i?`<img src="${esc(x.c.i)}" alt="" loading="lazy">`:''}<span><a href="${esc(x.c.u)}">${esc(x.c.n)}</a><small>${esc(note)}</small></span></li>`;
const put=(k,rows)=>{document.querySelector(`[data-l="${k}"]`).innerHTML=rows.join(''); const e=document.querySelector(`[data-empty="${k}"]`); if(e) e.hidden=rows.length>0;};
Promise.all([WPDeal.get('/api/all-prices'),WPDeal.get('/api/shoe-prices')]).then(js=>{
 const items=[]; for(const j of js) for(const [k,e] of Object.entries((j&&j.r)||{})){const c=CAT[k]; if(c&&e&&e.p>0) items.push({k,e,c,v:WPDeal.verdict(e),g:gbp(e.p,e.c)});}
 const inS=items.filter(x=>x.e.s!==0);
 put('real',inS.filter(x=>x.v&&(x.v.k==='drop'||x.v.k==='lowest')).sort((a,b)=>b.v.pct-a.v.pct).slice(0,15).map(x=>li(x,`${F(x.e.p,x.e.c)} at ${x.e.n||x.e.d} · ${x.v.pct}% below usual ${F(x.v.usual,x.e.c)}`)));
 put('low',inS.filter(x=>x.v&&x.v.k==='lowest').sort((a,b)=>b.v.pct-a.v.pct).slice(0,15).map(x=>li(x,`${F(x.e.p,x.e.c)} at ${x.e.n||x.e.d} · lowest since ${x.v.since}`)));
 put('cut',inS.filter(x=>x.e.drop>=5).sort((a,b)=>b.e.drop-a.e.drop).slice(0,15).map(x=>li(x,`${F(x.e.p,x.e.c)} at ${x.e.n||x.e.d} · down ${x.e.drop}% on its previous price (${x.e.t})`)));
 for(const k of ['r','s','b']) put(k,inS.filter(x=>x.c.k===k).sort((a,b)=>a.g-b.g).slice(0,8).map(x=>li(x,`${F(x.e.p,x.e.c)} at ${x.e.n||x.e.d} · checked ${x.e.t}`)));
});
</script>
</Base>
