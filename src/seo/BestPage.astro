---
import Base from '../layouts/Base.astro'; import Card from '../components/Card.astro'; import { rackets, lists } from '../lib/data.js'; import { extraLists } from '../lib/seo-content.js';
const { k } = Astro.props; const L=extraLists[k]; const all=L.pick(rackets); const top=all.slice(0,15); const U=`https://whichpadel.com/best/${k}/`;
const faq=[[`How is the ${L.title.toLowerCase()} list ranked?`,`${L.rule} ${all.length} rackets qualified; the top ${top.length} are shown. No brand pays for a place.`],['Are these ratings from court tests?','No. The ratings are calculated from published specifications using our rating formula. They are not lab or on-court tests.'],['Which racket is number one?',`${top[0]?.model} is currently first, based on the rule above.`],['How often is this list updated?','Whenever we refresh the database. Prices were last checked in October 2026.']];
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'ItemList','name':L.title,'url':U,'numberOfItems':top.length,'itemListElement':top.map((r,i)=>({'@type':'ListItem','position':i+1,'url':`https://whichpadel.com/rackets/${r.slug}/`,'name':r.model}))},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':'https://whichpadel.com/'},{'@type':'ListItem','position':2,'name':'Padel rackets guide','item':'https://whichpadel.com/padel-rackets/'},{'@type':'ListItem','position':3,'name':L.title,'item':U}]},{'@type':'FAQPage','mainEntity':faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))}]};
const others=[...Object.entries(lists),...Object.entries(extraLists)].filter(([x])=>x!==k);
---
<Base title={`${L.title} (2026): top ${top.length} ranked from specs | WhichPadel`} description={`${L.title} for 2026: ${top.length} picks from ${rackets.length} rackets, ranked by a transparent rule on published specs. #1 is ${top[0]?.model}.`} jsonld={jsonld}>
<section class="phero" slot="hero"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="/" style="color:#9fb6c0">Home</a> › <a href="/padel-rackets/" style="color:#9fb6c0">Padel rackets guide</a> › <span>Best lists</span></nav><span class="eyebrow">Updated October 2026 · {top.length} picks</span><h1>{L.title} (2026)</h1><p>{L.intro}</p></div></section>
<div class="rulebox"><b>How this list is built:</b> {L.rule} {all.length} rackets qualified; top {top.length} shown. No sponsored placements. Ratings are calculated from published specs (our rating formula), not court tests or paid reviews.</div>
<div class="rlist" id="best">{top.map((r,i)=><Card r={r} rank={i+1} eager={i===0}/>)}</div>
<section class="panel"><h2>Frequently asked questions</h2>{faq.map(([q,a])=><div class="faq"><h3>{q}</h3><p>{a}</p></div>)}</section>
<section class="panel vs"><h2>Other buying guides</h2><a href="/padel-rackets/"><span>Padel racket buying guide</span><span>→</span></a>{others.map(([x,v])=><a href={`/best/${x}/`}><span>{v.title}</span><span>→</span></a>)}<p style="margin:12px 0 0"><a href="/brands/">Browse rackets by brand →</a></p></section>
</Base>
