---
import NewsL from './NewsL.astro';
import Price from './Price.astro'; import CardL from './CardL.astro'; import RacketIcon from './RacketIcon.astro';
import PriceAlertL from './PriceAlertL.astro'; import { pick, fmt, offersOf, DEFAULT_REGION } from '../lib/price.js'; import { HUB } from '../i18n/hub.js'; import { hubOrder } from '../lib/hub.js'; import '../styles/hub.css'; import Base from '../layouts/Base.astro';
import { rackets, allRackets, lists as L0, brandList } from '../lib/data.js'; import { extraLists } from '../lib/seo-content.js'; import { y27 } from '../lib/extra.js';
import { url, LOCALE, BEST_KEYS } from '../i18n/routes.js'; import { DICTS, CURL } from '../i18n/index.js'; import { HOME } from '../i18n/home.js'; import { FINDER } from '../i18n/finder.js'; import { SHOE } from '../i18n/shoes.js';
const { lang='en' } = Astro.props; const H=HOME[lang]; const F=FINDER[lang]; const CUR0=CURL(lang);
const lists={...L0,...extraLists};
const brands=brandList.map(b=>b.name);
const ptxt=r=>{const q=pick(r,DEFAULT_REGION(lang)); return q.none?HB.none:HB.from1.replace('{p}',fmt(q.v,q.cur,lang));};
const FIRST=8; const HB=HUB[lang];
const picks=(()=>{const seen=new Set(),o=[]; for(const r of hubOrder().filter(r=>r.image&&r.price!=null&&r.year>=2026).sort((a,b)=>(b.valueScore||0)-(a.valueScore||0))){ if(seen.has(r.brand)) continue; seen.add(r.brand); o.push(r); if(o.length===8) break;} return o;})();
const ok=rackets.filter(r=>r.image&&r.published>=4);
const rows=[['best-value-padel-rackets',r=>r.valueScore,'value'],['most-comfortable-padel-rackets',r=>r.ratings.comfort,'comfort'],['most-powerful-padel-rackets',r=>r.ratings.power,'power']].map(([k,f,l],i)=>({h:H.rows[i],k,l:H.js.rt[l],f,rs:L0[k].pick(ok).slice(0,10)}));
const lastChecked=rackets.map(x=>x.priceChecked).filter(Boolean).sort().at(-1);
const gkeys=Object.keys(lists).slice(0,6).filter(k=>BEST_KEYS.includes(k));
const gname=k=>DICTS[lang].copy.best.titles[k][0].replace(/ \(.*\)/,'');
const L=(t,id)=>url(t,lang,id);
const SITE='https://whichpadel.com';
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'WebSite','name':'WhichPadel','url':SITE+L('home'),'inLanguage':LOCALE[lang]},{'@type':'ItemList','name':HB.top,'numberOfItems':picks.length,'itemListElement':picks.map((r,i)=>({'@type':'ListItem','position':i+1,'url':SITE+L('racket',r.slug),'name':r.model}))}]};
const HU={rk:L('racket','X').replace(/X\/$/,''),cmp:L('rackets'),aff:L('affiliate')};
const sorts=['','gbp:1','gbp:-1','power:-1','control:-1','forgiveness:-1','value:-1','year:-1','model:1'];
const baseProps={lang:DICTS[lang].locale};
import { BALL } from '../i18n/balls.js'
---
<Base {...baseProps} title={H.title(allRackets.length)} description={H.desc(allRackets.length,brands.length)} jsonld={jsonld}>
<section class="hero" slot="hero"><div class="wrap"><div>
<span class="eyebrow">{H.eyebrow(allRackets.length,brands.length)}</span>
<h1>{H.h1a}</h1>
<p class="lead">{typeof H.lead==="function"?H.lead(allRackets.length):H.lead}</p>
<a class="quizcta" href={L('finder')}>🎯<span>{H.qcta}<small>{H.qctaS}</small></span><span class="arr" aria-hidden="true">→</span></a>
<form class="search" data-gs style="margin-top:16px" action={L('rackets')} method="get"><input name="q" type="search" placeholder={H.searchPh} aria-label={H.searchL}/><button class="btn">{H.search}</button></form>
<div class="hero-ctas"><a class="btn btn-ghost" href={L('rackets')}>{H.cmpCta}</a><a class="btn btn-ghost" href={L('guide')}>{H.howCta}</a></div>
<div class="stats"><div><b>{allRackets.length}</b><span>{H.stats[0]}</span></div><div><b>{brands.length}</b><span>{H.stats[1]}</span></div><div><b>0</b><span>{H.stats[2]}</span></div></div>
</div><div class="hero-art"><RacketIcon shape="round" size={110}/><RacketIcon shape="teardrop" size={110}/><RacketIcon shape="diamond" size={110}/></div></div></section>

<section class="section fcta"><a class="fcta-card" href={L('shoes')}><span class="fcta-ic" aria-hidden="true">👟</span><span class="fcta-t"><b>{SHOE[lang].home.t}</b><span>{SHOE[lang].home.s}</span></span><span class="fcta-arr" aria-hidden="true">→</span></a></section>
{BALL[lang]&&<section class="section fcta"><a class="fcta-card" href={url('balls',lang)}><span class="fcta-ic" aria-hidden="true">🎾</span><span class="fcta-t"><b>{BALL[lang].home.t}</b><span>{BALL[lang].home.s}</span></span><span class="fcta-arr" aria-hidden="true">→</span></a></section>}
<section class="section fcta"><a class="fcta-card" href={L('finder')}><span class="fcta-ic" aria-hidden="true">🎯</span><span class="fcta-t"><b>{F.cta}</b><span>{F.ctaS}</span></span><span class="fcta-arr" aria-hidden="true">→</span></a></section>

{rows.map(x=><section class="hrow-wrap"><div class="hrow-head"><h2 class="h3">{x.h}</h2><a href={L('best',x.k)}>{H.seeAll}</a></div><ul class="hrow">{x.rs.map(r=><li><a class="hc2" href={L('racket',r.slug)}><img src={r.image} alt={`${r.model} ${H.js.alt}`} width="126" height="120" loading="lazy" decoding="async"/><span class="m">{r.model}</span><span class="s">{x.l} <b>{x.f(r)}</b> · <Price r={r} lang={lang}/></span></a></li>)}</ul></section>)}
<section class="section"><div class="sec-head"><h2>{H.guidesH}</h2></div>
<ul class="gchips">{gkeys.map(k=><li><a href={L('best',k)}>{gname(k)}</a></li>)}<li><a href={L('bf')}>{H.bf}</a></li>{y27.slice(0,3).map(b=><li><a href={L('brandYear',b.id)}>{H.y27(b.name)}</a></li>)}<li><a href={L('tool')}>{H.tool}</a></li><li><a class="gall" href={L('bestIndex')}>{H.allGuides}</a></li></ul></section>

<section class="section" id="rackets"><div class="sec-head hrow-head"><h2>{HB.top}</h2><a href={L('rackets')}>{HB.all(allRackets.length)}</a></div>
<ul class="tp-row">{picks.map((r,i)=><li class="rk"><a class="rk-a" href={L('racket',r.slug)}><span class="rk-i"><img src={r.image} alt={`${r.model} ${HB.alt}`} width="96" height="112" loading={i<4?"eager":"lazy"} decoding="async"/></span><span class="rk-t"><span class="rk-b">{r.brand}{r.year&&` · ${r.year}`}</span><span class="rk-m">{r.model}</span><span class="rk-p pz" data-s={r.slug} data-o={JSON.stringify(offersOf(r))} data-f1={HB.from1} data-fn={HB.fromN} data-none={HB.none}>{ptxt(r)}</span></span></a></li>)}</ul>
<div class="tp-cta"><a class="btn btn-accent" href={L('rackets')}>{HB.all(allRackets.length)} →</a></div>
<script is:inline define:vars={{RU:L('rackets')}}>if(location.hash==='#rackets') location.replace(RU);</script>
</section>
<NewsL lang={lang} src="home"/>

</Base>
