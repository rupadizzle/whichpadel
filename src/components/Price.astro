---
import { pick, fmt, offersOf, FX, DEFAULT_REGION } from '../lib/price.js';
const { r, lang='en', cls='', checkLabel } = Astro.props; const p=pick(r,DEFAULT_REGION(lang));
const none=lang==='es'?'Ver precio':lang==='fr'?'Voir le prix':'Check price';
const tip=p.conv?(lang==='es'?`Convertido desde ${p.o.c} con el tipo del ${FX.date}`:lang==='fr'?`Converti depuis ${p.o.c} au taux du ${FX.date}`:`Converted from ${p.o.c} at the ${FX.date} rate`):undefined;
---
<span class={`pz ${cls}${p.conv?' cv':''}`} data-o={JSON.stringify(offersOf(r))} title={tip}>{p.none?(checkLabel||none):fmt(p.v,p.cur,lang)}</span>
