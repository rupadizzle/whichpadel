---
// The one product card. Rackets pass `r`. Shoes and bags pass fields through ShoeCard and BagCard. Balls pass the fields. A blank copy is rendered once in RkCardTemplate for pages that build cards in the browser.
import '../styles/hub.css';
import SaveHeart from './SaveHeart.astro';
import Price from './Price.astro';
import RacketIcon from './RacketIcon.astro';
import { D, url } from '../i18n/index.js';
const { r, lang, rank, keys, compare=false, eager=false, region=null, line, href, img, alt='', brand, name, spec, save, kind='r', dataBrand, why='', off='', attrs={}, cls='' } = Astro.props;
const d = D(lang), t = d.terms, u = d.ui;
const escRe = s => String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const shortM = x => {
  let s = x.model || '';
  if (x.brand) s = s.replace(new RegExp('^' + escRe(x.brand) + '\\s+', 'i'), '');
  if (x.year) s = s.replace(new RegExp('\\s+' + x.year + '\\s*$'), '');
  return s.trim() || x.model;
};
const specR = x => [x.shape && t.shapeCap[x.shape], x.weightMin && `${x.weightMin}${x.weightMax && x.weightMax !== x.weightMin ? '–' + x.weightMax : ''}\u00a0g`].filter(Boolean).join(' · ');
const href0 = r ? url('racket', lang, r.slug) : href;
const img0 = r ? r.image : img;
const alt0 = r ? r.model : alt;
const brand0 = r ? [r.brand, r.year].filter(Boolean).join(' · ') : brand;
const name0 = r ? shortM(r) : name;
const spec0 = line ?? (r ? specR(r) : spec);
const save0 = r ? r.slug : save;
const bars = r && keys ? keys.filter(k => r.ratings && r.ratings[k] != null) : [];
const nameId = `rk-n-${crypto.randomUUID()}`;
---
<li {...attrs} class:list={['rk', cls, 'rk-card']} data-s={save0} data-brand={dataBrand}><a class="rk-a" href={href0} aria-labelledby={nameId}><span class="rk-i"><span class="rk-ph">{img0 ? <img src={img0} alt={alt0} width="96" height="112" loading={eager ? 'eager' : 'lazy'} decoding="async"/> : r && <RacketIcon shape={r.shape || 'hybrid'} size={48}/>}</span>{rank && <span class="rank">#{rank}</span>}<span class="rk-off" hidden={!off}>{off}</span></span><span class="rk-frame" aria-hidden="true"></span><span class="rk-b"><span>{brand0}</span></span><span class="rk-m" id={nameId}>{name0}</span><span class="rk-ft">{spec0 && <span class="rk-c">{spec0}</span>}<span class="rk-pv">{r ? <Price r={r} lang={lang} from shops={false} region={region}/> : <slot/>}</span></span>{bars.length > 0 && <span class="rk-bars minibars">{bars.map(k => <span class="mb"><span>{t.rt[k]}</span><span class="bar"><i style={`width:${r.ratings[k]}%`}></i></span><b>{r.ratings[k]}</b></span>)}</span>}{why && <p class="rk-why">{why}</p>}</a>{save0 && <span class="rk-acts"><button type="button" class="rk-bell" data-h={u.alertH('{n}')} aria-label={`${u.px.cmp.alertDrop}: ${name0}`}><svg class="bell" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8.5a6 6 0 0 1 12 0c0 4.5 1.5 6 1.5 8.5h-15c0-2.5 1.5-4 1.5-8.5z"/><path d="M10 18.5a2 2 0 0 0 4 0"/></svg></button><SaveHeart slug={save0} kind={kind} off={u.save} on={u.saved}/></span>}{compare && <label class="rk-x"><input type="checkbox" class="rk-cb" value={save0}/><span><span class="sr">{u.addToCompare}: {name0}</span></span></label>}</li>
