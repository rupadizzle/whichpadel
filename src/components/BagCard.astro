---
import RkCard from './RkCard.astro';
import { bagImg, bagTypeKey, bagComp } from '../lib/bags.js'; import { BAG } from '../i18n/bags.js'; import { D, url } from '../i18n/index.js';
import { pick, fmt, DEFAULT_REGION } from '../lib/price.js';
const { b, lang, eager = false } = Astro.props; const T = BAG[lang]; const u = D(lang).ui; const img = bagImg(b);
const escRe = x => String(x).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const shortN = () => { let n = b.name || ''; if (b.brand) n = n.replace(new RegExp('^' + escRe(b.brand) + '\\s+', 'i'), ''); if (b.year) { n = n.replace(new RegExp('\\s+' + b.year + '\\s*$'), ''); const yy = String(b.year).slice(-2); if (yy.length === 2) n = n.replace(new RegExp('\\s+' + yy + '\\s*$'), ''); } return n.trim() || b.name; };
const typeK = bagTypeKey(b);
const spec = [T.types[typeK], b.rackets != null && T.racketsN(b.rackets), b.year && String(b.year)].filter(Boolean).join(' · ');
const q = pick(b, DEFAULT_REGION(lang));
const price = q.none ? u.checkPrice : T.from1.split('{p}')[0] + fmt(q.v, q.cur, lang);
const th = bagComp(b.thermal); const sh = bagComp(b.shoe);
---
<RkCard lang={lang} kind="g" href={url('bag', lang, b.slug)} img={img || ''} alt={T.alt(b.name)} brand={[b.brand, b.year].filter(Boolean).join(' · ')} name={shortN()} spec={spec} save={b.slug} eager={eager} attrs={{ 'data-m': shortN(), 'data-b': b.brand, 'data-type': typeK, 'data-th': th, 'data-shoe': sh, 'data-y': b.year || 0, 'data-n': b.offs?.filter(o => o.s).length || 0 }}><span class="pz">{price}</span></RkCard>
