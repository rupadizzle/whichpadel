---
// Site-wide search. The button lives in the header; the catalogue is fetched the first time it opens.
import { D } from '../i18n/index.js';
import { GS } from '../i18n/search.js';
import { HUB } from '../i18n/hub.js';
import { SHOE } from '../i18n/shoes.js';
import { BALL } from '../i18n/balls.js';
import { YC } from '../lib/years.js';
import { SHOE_LIST_KEYS, UNDER, listCur } from '../lib/shoes.js';
import { bud, val, fmtM, SYMS } from '../lib/money.js';
import { FX } from '../lib/price.js';
import { url, BEST_KEYS } from '../i18n/routes.js';
const { lang = 'en' } = Astro.props;
const S = GS[lang] || GS.en;
const ui = D(lang).ui;
const plain = s => String(s).replace(/⟦([mbsMBS])\|([\d.]+)\|([A-Za-z]{3})\|([A-Za-z]{3})⟧/g, (_, k, n, f, d0) => {
  k = k.toLowerCase(); f = f.toUpperCase(); d0 = d0.toUpperCase();
  return k === 's' ? (SYMS[d0] || '') : fmtM(val(FX.rates, k, +n, f, d0), d0, lang);
});
const titles = D(lang).copy.best.titles;
const guides = [];
for (const k of BEST_KEYS) {
  const row = titles[k];
  if (row) guides.push([url('best', lang, k), plain(row[0])]);
}
const shoeLists = SHOE[lang].lists;
for (const k of SHOE_LIST_KEYS) {
  const L = shoeLists[k];
  if (!L) continue;
  const amt = UNDER[k] ? plain(bud(UNDER[k], listCur(lang))) : null;
  const h = typeof L[0] === 'function' ? (amt ? L[0](amt) : null) : L[0];
  if (h) guides.push([url('shoeList', lang, k), plain(h)]);
}
const pages = [
  [url('rackets', lang), HUB[lang].nav],
  [url('shoes', lang), SHOE[lang].nav],
  BALL[lang] && [url('balls', lang), BALL[lang].nav],
  [url('brands', lang), ui.brands],
  [url('players', lang), ui.players],
  [url('finder', lang), ui.finder],
  [url('guide', lang), ui.guide],
  [url('bestIndex', lang), ui.guides],
  [url('years', lang), YC[lang].hub],
  [url('bf', lang), ui.bf],
  [url('tool', lang), ui.tools],
].filter(x => x && x[0] && x[1]);
const end = u => u.endsWith('/') ? u : u + '/';
const cfg = {
  ph: S.ph, empty: S.empty, loading: S.loading, fail: S.fail, browse: S.browse, result1: S.result1, results: S.results,
  groups: { ...S.groups, go: S.browse },
  U: { r: end(url('racket', lang, 'x')).replace(/x\/$/, ''), s: end(url('shoe', lang, 'x')).replace(/x\/$/, ''), b: end(url('ball', lang, 'x')).replace(/x\/$/, ''), m: end(url('brand', lang, 'x')).replace(/x\/$/, ''), sb: end(url('shoeBrand', lang, 'x')).replace(/x\/$/, ''), p: end(url('player', lang, 'x')).replace(/x\/$/, '') },
  pages, guides,
};
const cfgJson = JSON.stringify(cfg).replace(/</g, '\\u003c');
---
<span id="hdr-search"><button type="button" class="gs-open" id="gs-open" aria-label={S.label} aria-haspopup="dialog" aria-controls="gs" aria-keyshortcuts="Control+K Meta+K"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button></span>
<dialog class="gs" id="gs" aria-labelledby="gs-label">
<form id="gs-form" class="gs-bar" role="search" autocomplete="off">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
<label id="gs-label" class="gs-sr" for="gs-q">{S.label}</label>
<input id="gs-q" type="search" role="combobox" aria-autocomplete="list" aria-controls="gs-list" aria-expanded="false" placeholder={S.ph} enterkeyhint="search" autocomplete="off" spellcheck="false"/>
<button type="button" class="gs-x" data-gs-close aria-label={ui.close}>✕</button>
</form>
<div id="gs-list" class="gs-list" role="listbox" aria-label={S.label}></div>
<p id="gs-status" class="gs-sr" aria-live="polite"></p>
</dialog>
<script type="application/json" id="gs-cfg" set:html={cfgJson}></script>
<script>
import { querySearch } from '../lib/search.js';
const cfg = JSON.parse(document.getElementById('gs-cfg').textContent);
const dlg = document.getElementById('gs');
const inp = document.getElementById('gs-q');
const list = document.getElementById('gs-list');
const status = document.getElementById('gs-status');
const openBtn = document.getElementById('gs-open');
let idx = null, idxP = null, active = -1, seq = 0, blockHero = 0;

function warm() {
  if (!idxP) idxP = fetch('/search-index.json').then(r => { if (!r.ok) throw new Error('search'); return r.json(); }).then(d => { idx = d; return d; });
  return idxP;
}
openBtn.addEventListener('pointerenter', () => { warm(); }, { once: true });
openBtn.addEventListener('focus', () => { warm(); }, { once: true });

function setActive(i, scroll) {
  const opts = [...list.querySelectorAll('[role="option"]')];
  if (!opts.length) { active = -1; inp.removeAttribute('aria-activedescendant'); return; }
  active = (i + opts.length) % opts.length;
  opts.forEach((el, n) => {
    const on = n === active;
    el.setAttribute('aria-selected', on ? 'true' : 'false');
    if (on) { el.id = 'gs-opt'; if (scroll) el.scrollIntoView({ block: 'nearest' }); }
    else if (el.id === 'gs-opt') el.removeAttribute('id');
  });
  inp.setAttribute('aria-activedescendant', 'gs-opt');
}

function render(items, note, statusText) {
  const frag = document.createDocumentFragment();
  let last = '';
  for (const it of items) {
    if (it.k !== last) {
      last = it.k;
      const p = document.createElement('p');
      p.className = 'gs-lab';
      p.textContent = cfg.groups[it.k] || '';
      frag.append(p);
    }
    const a = document.createElement('a');
    a.className = 'gs-row';
    a.href = it.h;
    a.setAttribute('role', 'option');
    a.setAttribute('aria-selected', 'false');
    if (it.img) {
      const im = document.createElement('img');
      im.src = it.img; im.alt = ''; im.width = 40; im.height = 48; im.decoding = 'async';
      a.append(im);
    }
    const tx = document.createElement('span');
    tx.className = 'gs-tx';
    const b = document.createElement('b');
    b.textContent = it.t;
    tx.append(b);
    if (it.meta) { const sm = document.createElement('small'); sm.textContent = it.meta; tx.append(sm); }
    a.append(tx);
    frag.append(a);
  }
  if (!items.length) {
    const p = document.createElement('p');
    p.className = 'gs-empty';
    p.textContent = note || cfg.empty;
    frag.append(p);
  }
  list.replaceChildren(frag);
  if (items.length) setActive(0, false);
  else { active = -1; inp.removeAttribute('aria-activedescendant'); }
  status.textContent = statusText != null ? statusText : (items.length === 1 ? cfg.result1 : items.length ? cfg.results.replace('§', String(items.length)) : (note || cfg.empty));
}

function browse() {
  render(cfg.pages.map(([h, t]) => ({ k: 'go', h, t, meta: '', img: '' })), '', cfg.browse);
}

function run() {
  const q = inp.value;
  if (q.trim().length < 2) { browse(); return; }
  const my = ++seq;
  const paint = (note) => { if (my !== seq) return; render(querySearch({ idx, pages: cfg.pages, guides: cfg.guides, q, U: cfg.U }), note); };
  if (idx) { paint(); return; }
  render([], cfg.loading);
  warm().then(() => paint()).catch(() => { if (my !== seq) return; const items = querySearch({ idx: null, pages: cfg.pages, guides: cfg.guides, q, U: cfg.U }); render(items, items.length ? '' : cfg.fail); });
}

function shutNav() {
  const n = document.getElementById('nav');
  if (n) n.classList.remove('open');
  const b = document.querySelector('.burger');
  if (b) b.setAttribute('aria-expanded', 'false');
}
function open(q) {
  shutNav();
  if (!dlg.open) dlg.showModal();
  inp.setAttribute('aria-expanded', 'true');
  if (q != null) inp.value = q;
  inp.focus();
  const end = inp.value.length;
  try { inp.setSelectionRange(end, end); } catch (e) {}
  run();
}
function close() { if (dlg.open) dlg.close(); }

openBtn.addEventListener('click', () => open(''));
dlg.addEventListener('close', () => { blockHero = performance.now(); inp.setAttribute('aria-expanded', 'false'); });
dlg.addEventListener('click', e => { if (e.target === dlg) close(); });
document.querySelector('[data-gs-close]').addEventListener('click', close);
inp.addEventListener('input', run);
list.addEventListener('mousemove', e => {
  const a = e.target.closest('[role="option"]');
  if (!a) return;
  const opts = [...list.querySelectorAll('[role="option"]')];
  const i = opts.indexOf(a);
  if (i >= 0 && i !== active) setActive(i, false);
});

document.addEventListener('pointerdown', e => {
  if (performance.now() - blockHero < 500) return;
  const form = e.target.closest?.('form[data-gs]');
  if (!form || !e.target.closest('input, button')) return;
  e.preventDefault();
  open(form.querySelector('input')?.value || '');
});
document.addEventListener('focusin', e => {
  if (dlg.open || performance.now() - blockHero < 500) return;
  const field = e.target.closest?.('form[data-gs] input');
  if (!field) return;
  open(field.value || '');
});
document.addEventListener('submit', e => {
  const form = e.target?.closest?.('form[data-gs]');
  if (!form) return;
  e.preventDefault();
  open(form.querySelector('input')?.value || '');
});
document.addEventListener('keydown', e => {
  const typing = e.target.closest?.('input, textarea, select, [contenteditable="true"]');
  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
    e.preventDefault();
    if (dlg.open) close();
    else open(typing && typing.form?.hasAttribute('data-gs') ? typing.value : '');
    return;
  }
  if (e.key === '/' && !dlg.open && !typing) { e.preventDefault(); open(''); return; }
  if (!dlg.open) return;
  if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1, true); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active < 0 ? 0 : active - 1, true); }
  else if (e.key === 'Enter') {
    const opts = [...list.querySelectorAll('[role="option"]')];
    const el = opts[active] || opts[0];
    if (el) { e.preventDefault(); location.href = el.href; }
  }
});
</script>
