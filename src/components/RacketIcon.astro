---
const { shape, size = 72 } = Astro.props;
const heads = {
  round: '<ellipse cx="40" cy="38" rx="30" ry="32"/>',
  teardrop: '<path d="M40 5c18 0 30 13 30 32 0 17-14 33-30 37-16-4-30-20-30-37C10 18 22 5 40 5z"/>',
  diamond: '<path d="M40 4c14 0 30 14 30 30 0 14-14 30-30 40C26 64 10 48 10 34 10 18 26 4 40 4z"/>',
  hybrid: '<path d="M40 5c17 0 30 13 30 31 0 16-13 32-30 38-17-6-30-22-30-38C10 18 23 5 40 5z"/>',
};
const head = heads[shape] || heads.hybrid;
---
<svg class="ricon" width={size} height={size*1.35} viewBox="0 0 80 108" aria-hidden="true">
  <g fill="var(--icon-face,#e8f0ec)" stroke="var(--icon-line,#0b3d2e)" stroke-width="3" set:html={head}/>
  <g fill="var(--icon-line,#0b3d2e)" opacity=".28">{[0,1,2,3].map(r=>[0,1,2,3].map(c=><circle cx={28+c*8} cy={24+r*9} r="1.8"/>))}</g>
  <rect x="35" y="74" width="10" height="30" rx="4" fill="var(--icon-line,#0b3d2e)"/>
  <rect x="35" y="88" width="10" height="3" fill="#d4ff3a"/>
</svg>
