---
// Country + currency picker (shared, all languages). Country decides which shops/delivery apply; currency is a separate, saved choice
// that defaults to the country's local currency. Converted prices get an "approx." marker.
import { REGIONS, FX, SHOPS, DEFAULT_REGION, CURRENCIES, SYM } from '../lib/price.js'; import { D } from '../i18n/index.js';
import { LANG_NAME } from '../i18n/routes.js';
const { lang='en', switcher=[], region=null } = Astro.props; const RG=D(lang).ui.region; const UI=D(lang).ui;
const SH=Object.fromEntries(Object.entries(SHOPS).map(([d,s])=>[d,{y:s.delivers||[],n:s.no||[]}]));
const CFG={FX:{date:FX.date,rates:FX.rates},SH,R:Object.fromEntries(Object.entries(REGIONS).map(([k,v])=>[k,[v[0],v[2]]])),SYM,CUR:CURRENCIES};
const def=region||DEFAULT_REGION(lang); const dc=REGIONS[def][2];
const selfHref=Astro.url.pathname.replace(/^((?:\/[a-z][a-z])?)\/404\/$/,'$1/404.html');
---
<button type="button" class="rgn" id="rgn-btn" aria-haspopup="dialog" aria-label={RG.all}><svg class="rgn-globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg><span class="rgn-x">{lang.toUpperCase()} · <span id="rgn-reg">{def}</span> · </span><span id="rgn-cur">{SYM[dc]}</span></button>
<dialog class="sheet rgn-sheet" id="rgn-sheet" aria-labelledby="rgn-h"><div class="sheet-in"><div class="sheet-top"><h2 id="rgn-h" class="h3">{RG.all}</h2><button class="x" type="button" data-rgn-close aria-label={UI.close}>✕</button></div>
<h3 class="rgn-sub">{UI.language}</h3>
<ul class="lang-seg" data-lang-pick><li><a aria-current="true" href={selfHref} lang={lang} hreflang={lang} class="on">{LANG_NAME[lang]}</a></li>{switcher.map(([l,h])=><li><a href={h} lang={l} hreflang={l}>{LANG_NAME[l]}</a></li>)}</ul>
<h3 class="rgn-sub">{RG.countryH}</h3>
<p class="muted small" style="margin:0">{RG.shops}</p>
<ul class="rgn-list">{Object.entries(REGIONS).map(([k,[f,n,c]])=><li><button type="button" data-rgn={k} aria-pressed={k===def?'true':'false'}><span>{f} {n}</span><span class="muted">{c}</span></button></li>)}</ul>
<h3 class="rgn-sub">{RG.curH}</h3>
<div class="cur-seg" role="radiogroup" aria-label={RG.curH}>{CURRENCIES.map(c=><button type="button" role="radio" data-cur={c} aria-checked={c===dc?'true':'false'}>{SYM[c]} {c}</button>)}</div>
<p class="muted small" style="margin:0">{RG.curNote}</p>
<button type="button" class="btn btn-accent rgn-save" data-rgn-save>{RG.save}</button></div></dialog>
<script is:inline define:vars={{CFG,lang,DEF:def,CONV:RG.conv('§',FX.date),NONE:UI.seeSpecs,NOUS:RG.noUS||UI.seeSpecs,AP:RG.approx,PAGE:!!region}}>
(()=>{const {FX,SH,R,SYM,CUR}=CFG; const EU=['AT','BG','HR','CY','CZ','DK','EE','FI','GR','HU','LV','LT','LU','MT','PL','RO','SK','SI'];
// strict countries: only shops verified to deliver there AND pricing in the local currency (one price, one currency; no cross-border guesses)
const STRICT={US:'USD'};
const ls=k=>{try{return localStorage[k]}catch(e){return null}}; const set=(k,v)=>{try{localStorage[k]=v}catch(e){}};
const nonEn=lang!=='en'; // a country-specific page (e.g. US money pages) sets its own default; a saved choice still wins
// PAGE = a country-specific page (the /us/ pages): it always opens in that country and currency, without changing the saved choice
let reg=PAGE?DEF:(ls('wp_region')||(nonEn?DEF:ls('wp_geo'))||DEF); if(!R[reg]) reg=DEF;
let cur=ls('wp_cur'); if(!CUR.includes(cur)) cur=null; const curNow=()=>cur||R[reg][1];
const fmt=(n,c)=>{const v=Math.round(n); if(c==='SEK') return v+' kr'; return nonEn?v+' '+SYM[c]:SYM[c]+v;};
function best(os){const C=curNow(); const c=(os||[]).map(o=>{const s=SH[o.d]||{y:[],n:[]}; const sx=STRICT[reg]; const st=sx?(s.y.includes(reg)&&o.c===sx?0:2):s.y.includes(reg)?0:s.n.includes(reg)?2:1; const nat=o.c===C; return {...o,st,nat,v:nat?o.p:Math.round(o.p/FX.rates[o.c]*FX.rates[C])};}).filter(o=>o.st<2).sort((a,b)=>a.st-b.st||(b.nat-a.nat)||a.v-b.v);
 if(!c.length) return {txt:STRICT[reg]?NOUS:NONE,v:null,u:null,none:true}; const o=c[0]; return {txt:fmt(o.v,C),v:o.v,u:o.u,conv:!o.nat,from:o.c,unk:o.st===1,cur:C};}
function apply(){const C=curNow(); const l=document.getElementById('rgn-reg'); if(l) l.textContent=reg; const lc=document.getElementById('rgn-cur'); if(lc) lc.textContent=SYM[C];
 document.querySelectorAll('[data-cur]').forEach(b=>b.setAttribute('aria-checked',b.dataset.cur===C?'true':'false'));
 document.querySelectorAll('[data-rgn]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.rgn===reg?'true':'false'));
 document.querySelectorAll('.pz[data-o]').forEach(e=>{const q=best(JSON.parse(e.dataset.o)); if(e.dataset.fn){const os=JSON.parse(e.dataset.o).filter(o=>{const x=SH[o.d]; return !x||!x.n.includes(reg)}); e.textContent=q.v==null?e.dataset.none:(os.length>1?e.dataset.fn.replace('{n}',os.length):e.dataset.f1).replace('{p}',q.txt);} else e.textContent=q.txt; e.classList.toggle('cv',!!q.conv); e.dataset.ap=AP; if(q.conv) e.title=CONV.replace('§',q.from); else e.removeAttribute('title');});
 document.querySelectorAll('a.aff[data-o]').forEach(a=>{const q=best(JSON.parse(a.dataset.o)); if(q.u) a.href=q.u; a.toggleAttribute('data-nous',!!(q.none&&STRICT[reg]));});
 const MR=(k,n,f)=>{if(f===C) return Math.round(n); const v=n/FX.rates[f]*FX.rates[C]; if(k!=='b') return Math.round(v); const st=v<50?5:v<300?10:v<1000?50:100; return Math.max(st,Math.round(v/st)*st);};
 document.querySelectorAll('.mz').forEach(e=>{e.textContent=fmt(MR(e.dataset.k,+e.dataset.m,e.dataset.mc),C);});
 document.querySelectorAll('.mzs').forEach(e=>{e.textContent=SYM[C];});
 document.querySelectorAll('input[data-mb]').forEach(e=>{e.value=MR('b',+e.dataset.mb,e.dataset.mc);});
 const mt=document.documentElement.dataset.mt; if(mt) document.title=mt.replace(/⟦([mbsMBS])\|([\d.]+)\|([A-Za-z]{3})\|([A-Za-z]{3})⟧/gi,(_,k,n,f)=>(k=k.toLowerCase())==="s"?SYM[C]:fmt(MR(k,+n,f.toUpperCase()),C));
 document.querySelectorAll('[data-usrow]').forEach(e=>e.hidden=reg!=='US');
 document.dispatchEvent(new Event('wp:region'));}
window.WP={best,shop(d,c){const s=SH[d], sx=STRICT[reg]; if(sx) return s&&s.y.includes(reg)&&(!c||c===sx)?'y':'n'; return !s?'u':s.y.includes(reg)?'y':s.n.includes(reg)?'n':'u';},strict(){return !!STRICT[reg]},setRC(r,c){if(R[r]){reg=r;set('wp_region',r);} if(CUR.includes(c)){cur=c;set('wp_cur',c);} apply();},get region(){return reg},get currency(){return curNow()},approx:AP};
window.wpApply=apply;
document.addEventListener('DOMContentLoaded',()=>{ if(reg!==DEF||cur) apply();
 const fs=document.querySelectorAll('.pz[data-s]'); if(fs.length) fetch('/api/prices').then(x=>x.ok?x.json():null).then(j=>{if(!j||!j.r) return; fs.forEach(e=>{const r=j.r[e.dataset.s]; if(!r) return; const os=(Array.isArray(r.o)&&r.o.length?r.o:[r]).filter(o=>o.p>0); if(os.length) e.dataset.o=JSON.stringify(os.map(o=>({d:o.d,p:o.p,c:o.c,u:o.u})));}); apply();}).catch(()=>{});
 const d=document.getElementById('rgn-sheet'); 
 let sR,sC,sL; const mark=()=>{document.querySelectorAll('[data-rgn]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.rgn===sR?'true':'false'));
  document.querySelectorAll('[data-cur]').forEach(b=>b.setAttribute('aria-checked',b.dataset.cur===(sC||R[sR][1])?'true':'false'));
  document.querySelectorAll('[data-lang-pick] a').forEach(a=>a.classList.toggle('on',a===sL));};
 document.getElementById('rgn-btn').onclick=()=>{sR=reg;sC=cur;sL=document.querySelector('[data-lang-pick] a[aria-current]');mark();d.showModal();};
 d.addEventListener('click',e=>{const la=e.target.closest('[data-lang-pick] a'); if(la){e.preventDefault(); sL=la; mark(); return;}
  const k=e.target.closest('[data-cur]'); if(k){sC=k.dataset.cur; mark(); return;}
  const b=e.target.closest('[data-rgn]'); if(b){sR=b.dataset.rgn; mark(); return;}
  if(e.target.closest('[data-rgn-save]')){ if(sR!==reg||ls('wp_region')){reg=sR; set('wp_region',reg);} if(sC){cur=sC; set('wp_cur',cur);} apply(); d.close();
   if(sL&&!sL.hasAttribute('aria-current')){set('wp_lang',sL.lang); try{document.cookie='wp_lang='+sL.lang+';path=/;max-age=31536000;samesite=lax'}catch(x){} location.href=sL.getAttribute('href');} return;}
  if(e.target.closest('[data-rgn-close]')||e.target===d) d.close();});
 if(!nonEn&&!PAGE&&!ls('wp_region')&&!ls('wp_geo')) fetch('/api/geo').then(r=>r.json()).then(j=>{const c=j.country; const k=R[c]?c:c==='UK'?'GB':EU.includes(c)?'EU':c?'ROW':null; if(k){set('wp_geo',k); if(!ls('wp_region')&&k!==reg){reg=k; apply();}}}).catch(()=>{});
});})();
</script>
