---
// First-visit country confirm: "Are you in {Country}?" -> Confirm (saves country+currency via the picker; switches language only if the
// country's language differs) or Choose country (opens the globe picker). Close = dismiss. Never auto-redirects. Bots excluded.
import { D } from '../i18n/index.js'; import { REGIONS, SYM } from '../lib/price.js';
const { lang='en' } = Astro.props; const r=D(lang).ui.region;
const T={m:r.geoQ('§c','§s'),ok:r.geoOk('§c'),ch:r.geoCh,x:D(lang).ui.close};
const RC=Object.fromEntries(Object.entries(REGIONS).map(([k,v])=>[k,v[2]]));
---
<div id="geo-bn" class="geo-bn" role="dialog" aria-modal="true" aria-labelledby="geo-msg" aria-describedby="geo-sub" hidden><div class="geo-card"><p id="geo-msg" class="geo-q"></p><p id="geo-sub"></p><div class="geo-act"><button type="button" class="btn btn-accent" id="geo-ok"></button><button type="button" class="btn" id="geo-ch"></button></div><button type="button" class="geo-x" id="geo-x" aria-label={T.x}>✕</button></div></div>
<script is:inline define:vars={{T,RC,SYM,lang}}>
(()=>{const ls=k=>{try{return localStorage[k]}catch(e){return null}}; const set=(k,v)=>{try{localStorage[k]=v}catch(e){}};
if(ls('wp_lang')||ls('wp_region')||ls('wp_cur')||ls('wp_geo_stay')) return;
const q=new URLSearchParams(location.search).get('geo');
if(!q&&(navigator.webdriver||/bot|crawl|spider|slurp|lighthouse|headless|preview|facebookexternalhit|bingpreview/i.test(navigator.userAgent))) return;
const LM={ES:'es',PT:'pt',FR:'fr',BE:'fr',IT:'it',DE:'de'};
const EU=['AT','BG','HR','CY','CZ','DK','EE','FI','GR','HU','LV','LT','LU','MT','PL','RO','SK','SI'];
const go=c=>{if(!c||!/^[A-Za-z]{2}$/.test(c)) return; c=c.toUpperCase(); if(c==='UK') c='GB';
 const rk=RC[c]?c:EU.includes(c)?'EU':'ROW', cu=RC[rk], tl=LM[c]||'en'; let cn=c; try{cn=new Intl.DisplayNames([lang],{type:'region'}).of(c)||c}catch(e){}
 const b=document.getElementById('geo-bn'), ok=document.getElementById('geo-ok'), ch=document.getElementById('geo-ch');
 const raw=T.m.replace('§c',cn).replace('§s',SYM[cu]), parts=raw.match(/^(¿?.+?\?)\s*([\s\S]*)$/);
 document.getElementById('geo-msg').textContent=parts?parts[1]:raw; document.getElementById('geo-sub').textContent=parts?parts[2]:''; ok.textContent=T.ok.replace('§c',cn); ch.textContent=T.ch;
 const hide=()=>{b.hidden=true;};
 ok.onclick=()=>{ if(window.WP&&WP.setRC) WP.setRC(rk,cu); else {set('wp_region',rk); set('wp_cur',cu);} hide();
  if(tl!==lang){const a=document.querySelector('[data-lang-pick] a[hreflang="'+tl+'"]'); if(a){set('wp_lang',tl); try{document.cookie='wp_lang='+tl+';path=/;max-age=31536000;samesite=lax'}catch(x){} location.href=a.getAttribute('href');}}};
 ch.onclick=()=>{set('wp_geo_stay','1'); hide(); const g=document.getElementById('rgn-btn'); if(g) g.click();};
 document.getElementById('geo-x').onclick=()=>{set('wp_geo_stay','1'); hide();};
 b.hidden=false; ok.focus({preventScroll:true});};
const run=()=>{ if(q) return go(q); fetch('/api/geo').then(r=>r.json()).then(j=>go(j.country)).catch(()=>{}); };
document.readyState==='loading'?document.addEventListener('DOMContentLoaded',run):run();})();
</script>
<style is:global>
.geo-bn{position:fixed;inset:0;z-index:var(--z-sheet);display:flex;align-items:center;justify-content:center;padding:var(--s4);box-sizing:border-box;background:var(--scrim-light);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
/* stylelint-disable-next-line declaration-no-important -- keeps the banner laid out while hidden (no layout shift) */
.geo-bn[hidden]{display:flex !important;visibility:hidden;pointer-events:none;background:none;backdrop-filter:none;-webkit-backdrop-filter:none}
html:has(.geo-bn:not([hidden])){overflow:hidden}
.geo-card{position:relative;width:min(28rem,100%);max-height:calc(100dvh - 48px);display:flex;flex-direction:column;align-items:stretch;gap:var(--s3);padding:var(--s5) var(--s5) var(--s5);background:var(--card);color:var(--navy);border:1px solid var(--line);border-radius:var(--r);box-sizing:border-box;box-shadow:var(--sh-pop)}
.geo-q{margin:0;padding-right:var(--s6);font-size:var(--fs-xl);font-weight:var(--fw-black);line-height:var(--lh-ui);letter-spacing:-.02em}
#geo-sub{margin:0;color:var(--mut);font-size:var(--fs-base);line-height:var(--lh-body)}
.geo-act{display:flex;flex-direction:column;gap:var(--s2);margin-top:var(--s2)}.geo-act .btn{width:100%;min-height:48px;min-width:44px}
.geo-x{position:absolute;top:8px;right:8px;width:44px;height:44px;border:0;background:none;color:inherit;font-size:var(--fs-base);cursor:pointer}
@media (prefers-reduced-transparency:reduce){.geo-bn{backdrop-filter:none;-webkit-backdrop-filter:none;background:var(--scrim)}}
</style>
