---
// Side-by-side racket comparison. Embed mode is the full-screen takeover on the racket list.
import { rackets } from '../lib/data.js'; import { D, url, mat } from '../i18n/index.js';
const { lang, embed = false } = Astro.props;
const d = D(lang), u = d.ui, c = u.cmp, t = d.terms;
const popular = ['bullpadel','nox','adidas','babolat','head','siux'].map(b => rackets.find(r => r.brand.toLowerCase().includes(b) && r.image)).filter(Boolean).slice(0, 6).map(r => r.slug);
const FM = Object.fromEntries([...new Set(rackets.flatMap(r => [r.faceMaterial, r.coreMaterial]).filter(Boolean))].map(v => [v, mat(v, lang)]).filter(([a, b]) => a !== b));
const TX = { FM, c: { ...c, addN: c.addN('§'), search: c.search('§') }, u: { checkPrice: u.checkPrice, cmpP: u.px.cmp.title, seeSpecs: u.seeSpecs, checked: u.checked, adNoteShort: u.adNoteShort, disclosure: u.disclosure, recordedPrice: u.recordedPrice, aff: url('affiliate', lang), rk: url('racket', lang, '§') }, TR: { Power: t.rt.power, Control: t.rt.control, Handling: t.rt.handling, Forgiveness: t.rt.forgiveness, Comfort: t.rt.comfort, Value: t.rt.value, Shape: t.spec.shape, Weight: t.spec.weight, Balance: t.spec.balance, Hardness: t.spec.hardness, Core: t.spec.core, Face: t.spec.face, Thickness: t.spec.thickness, Year: t.spec.year }, VT: { Round: t.shapeCap.round, Teardrop: t.shapeCap.teardrop, Diamond: t.shapeCap.diamond, Hybrid: t.shapeCap.hybrid, Low: t.bal.low, Medium: t.bal.medium, High: t.bal.high, Soft: t.core.soft, 'Medium-soft': t.core['medium-soft'], 'Medium-hard': t.core['medium-hard'], Hard: t.core.hard } };
---
<div id="cmp" class="cmp cmp-cards" data-popular={popular.join(',')} data-embed={embed ? '1' : undefined}><p class="panel empty">{c.loading}</p></div>
<p class="muted small trust">{c.trust}</p>
<dialog class="sheet" id="sheet" aria-labelledby="sheet-h"><div class="sheet-in"><div class="sheet-top"><h2 id="sheet-h" class="h3">{c.add}</h2><button class="x" type="button" data-close aria-label={u.close}>✕</button></div>
<input id="sheet-q" type="search" placeholder={c.search(rackets.length)} aria-label={c.searchLabel} autocomplete="off"/>
<ul class="pick-list" id="sheet-list"></ul></div></dialog>
<script is:inline define:vars={{ TX, embed }}>
(()=>{const root=document.getElementById('cmp'); const sheet=document.getElementById('sheet');
if(embed) document.body.appendChild(sheet);
let queued=null, slim=null, by=null, started=null, sel=[], held=[], cap=2, slot=-1;
window.wpCompare={set(ids){queued=ids; boot();}, get(){return sel.slice();}};
const boot=()=>started||(started=(async()=>{
 slim=await (await fetch('/compare-data.json')).json(); const C=TX.c,UU=TX.u,TR=TX.TR,VT=TX.VT;
 slim.forEach(x=>{['Shape','Balance','Hardness'].forEach(k=>{if(VT[x[k]])x[k]=VT[x[k]]});['Face','Core'].forEach(k=>{if(TX.FM[x[k]])x[k]=TX.FM[x[k]]});x.Weight=x.Weight&&x.Weight.replace(/ \(.*\)/,'').replace(' to ','–');});
 const rp=()=>slim.forEach(x=>{const q=WP.best(x.o);x.p=q.txt;x.g=q.v;x.u=q.u||x.u;});rp();
 by=Object.fromEntries(slim.map(x=>[x.s,x]));
 const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
 const SCORES=['Power','Control','Handling','Forgiveness','Comfort','Value'];
 const SPECS=['Shape','Weight','Balance','Hardness','Core','Face','Thickness','Year'];
 const img=(x,w,h)=>x.i?`<img src="${x.i}" alt="${esc(x.m)}" width="${w}" height="${h}" decoding="async">`:`<span class="noimg" style="width:${w}px;height:${h}px" aria-hidden="true">${esc((x.sh||'?')[0].toUpperCase())}</span>`;
 const icoSwap='<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 8h12m0 0-3-3m3 3-3 3M20 16H8m0 0 3-3m-3 3 3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
 const icoX='<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
 const short=x=>x.m.replace(new RegExp('^'+String(x.b||'').replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\s+','i'),'');
 function save(){try{sessionStorage.wp_cmp=sel.join(','); sessionStorage.wp_cmp_held=held.join(',')}catch(e){}
  if(embed){document.dispatchEvent(new CustomEvent('wp:cmp',{detail:sel.slice()})); return;}
  const q=sel.length?'?r='+sel.join(','):''; history.replaceState(null,'',location.pathname+q);}
 function setCap(n){n=n===3?3:2; if(n===2){if(sel.length>2) held=[sel[2]]; sel=sel.slice(0,2); cap=2; draw(); return;}
  if(sel.length>=3){cap=3; held=[]; draw(); return;}
  const extra=held.find(s=>!sel.includes(s)); if(extra){sel=sel.concat(extra).slice(0,3); held=[]; cap=3; draw(); return;}
  cap=3; open(sel.length);}
 function winner(vals,hi=true){const n=vals.filter(v=>typeof v==='number'); if(n.length<2) return null; const m=hi?Math.max(...n):Math.min(...n); return n.filter(v=>v===m).length===n.length?null:m;}
 function draw(){save(); const xs=sel.slice(0,cap).map(s=>by[s]); const n=xs.length; root.style.setProperty('--n',Math.max(n,2));
  if(n<2){const pop=root.dataset.popular.split(',').filter(s=>!sel.includes(s)).slice(0,4);
   root.innerHTML=`<div class="slots">${[0,1].map(i=>xs[i]?headCell(xs[i],i):`<button class="slot-add" type="button" data-add="${i}"><span>+</span>${C.addN.replace('§',i+1)}</button>`).join('')}</div>
   <section class="panel"><h2 class="h3">${C.popular}</h2><div class="pop">${pop.map(s=>`<button type="button" class="popb" data-quick="${s}">${img(by[s],40,48)}<span>${esc(by[s].m)}</span></button>`).join('')}</div></section>`; return;}
  const tog=`<div class="cmp-n"><span class="cmp-n-lab" id="cmp-n-lab">${esc(C.compare)}</span><div class="cmp-n-set" role="radiogroup" aria-labelledby="cmp-n-lab"><label><input type="radio" name="cmpn" value="2"${cap===2?' checked':''}><span>2</span></label><label><input type="radio" name="cmpn" value="3"${cap===3?' checked':''}><span>3</span></label></div></div>`;
  let h=tog+`<div class="chead" style="--n:${n}">${xs.map(headCell).join('')}</div>`;
  const grp=(title,fields,open,isNum)=>`<details class="cgroup" ${open?'open':''}><summary>${title}</summary>${fields.map(f=>{const vals=xs.map(x=>x[f]); if(vals.every(v=>v==null||v==='—')) return ''; const w=isNum?winner(vals):null;
   return `<div class="crow"><div class="clab">${TR[f]||f}</div><div class="cvals" style="--n:${n}">${vals.map(val=>`<div class="cv${w!==null&&val===w?' win':''}">${isNum?`<b>${val}</b><span class="bar"><i style="width:${val}%"></i></span>`:esc(val??'—')}</div>`).join('')}</div></div>`;}).join('')}</details>`;
  const pr=xs.map(x=>x.g); const pw=winner(pr.map(g=>g??Infinity),false);
  h+=`<details class="cgroup" open><summary>${C.price}</summary><div class="crow"><div class="clab">${UU.recordedPrice}</div><div class="cvals" style="--n:${n}">${xs.map(x=>`<div class="cv${pw!==null&&x.g===pw?' win':''}"><b>${esc(x.p)}</b>${x.pc?`<span class="tiny">${UU.checked} ${x.pc}</span>`:''}</div>`).join('')}</div></div></details>`;
  h+=grp(C.ratings,SCORES,true,true)+grp(C.specsH,SPECS,true,false);
  h+=`<div class="buyrow" style="--n:${n}">${xs.map(x=>`<a class="btn" href="${UU.rk.replace('§',x.s)}"><span class="bsub">${x.g!=null?`<span class="bp">${esc(x.p)}</span><span class="ba">${esc(UU.cmpP)}</span>`:`<span class="ba">${esc(UU.seeSpecs)}</span>`}</span></a>`).join('')}<p class="disc">${UU.adNoteShort} <a href="${UU.aff}">${UU.disclosure}</a></p></div>`;
  root.innerHTML=h;}
 function headCell(x,i){return `<div class="hc"><div class="hcin">${x.i?`<img src="${x.i}" alt="" width="80" height="80" decoding="async">`:`<span class="noimg" aria-hidden="true">${esc((x.sh||'?')[0].toUpperCase())}</span>`}<div class="hbody"><a class="hn" href="${UU.rk.replace('§',x.s)}">${esc(short(x))}</a><span class="hp">${esc(x.p)}</span></div><div class="hact"><button type="button" class="mini" data-add="${i}" aria-label="${C.swap}: ${esc(x.m)}">${icoSwap}</button><button type="button" class="mini" data-rm="${i}" aria-label="${C.remove}: ${esc(x.m)}">${icoX}</button></div></div></div>`;}
 function list(){const q=document.getElementById('sheet-q').value.toLowerCase().trim(); const r=slim.filter(x=>!sel.includes(x.s)&&(!q||x.m.toLowerCase().includes(q))).slice(0,40);
  document.getElementById('sheet-list').innerHTML=r.length?r.map(x=>`<li><button type="button" data-pick="${x.s}">${img(x,32,38)}<span><b>${esc(x.m)}</b><small>${esc(x.Shape)} · ${esc(x.p)}</small></span></button></li>`).join(''):'<li class="muted">'+C.noMatch+'</li>';}
 function open(i){slot=i; document.getElementById('sheet-q').value=''; list(); sheet.showModal(); if(matchMedia('(min-width:700px)').matches) document.getElementById('sheet-q').focus();}
 function onClick(e){const t=e.target.closest('[data-add],[data-rm],[data-pick],[data-close],[data-quick]'); if(!t){ if(e.target===sheet) sheet.close(); return;}
  const d=t.dataset; if(d.add!=null) open(+d.add); else if(d.rm!=null){sel.splice(+d.rm,1); if(sel.length<3) cap=2; draw();} else if(d.quick){if(sel.length<cap) sel.push(d.quick); draw();}
  else if(d.pick){ if(slot<sel.length) sel[slot]=d.pick; else if(sel.length<cap) sel.push(d.pick); held=held.filter(s=>!sel.includes(s)); sheet.close(); draw(); const sc=root.closest('.cmp-take-body'); if(sc) sc.scrollTop=0; else window.scrollTo({top:0}); }
  else if(d.close!=null) sheet.close();}
 root.addEventListener('click',onClick); sheet.addEventListener('click',onClick);
 root.addEventListener('change',e=>{if(e.target.name==='cmpn') setCap(+e.target.value);});
 sheet.addEventListener('close',()=>{if(cap===3&&sel.length<3){cap=2; draw();}});
 document.addEventListener('wp:region',()=>{rp(); if(!embed||document.getElementById('cmp-take')?.open) draw();});
 let tm; document.getElementById('sheet-q').addEventListener('input',()=>{clearTimeout(tm);tm=setTimeout(list,80)});
 function apply(ids){const next=(ids||[]).map(String).filter(s=>by[s]).slice(0,3); sel=next; held=held.filter(s=>!sel.includes(s)); cap=sel.length>=3?3:2; draw();}
 window.wpCompare={set:apply, get(){return sel.slice();}};
 if(embed){ if(queued) apply(queued); }
 else { sel=(new URLSearchParams(location.search).get('r')||'').split(',').filter(s=>by[s]).slice(0,3);
  if(sel.length<2){try{const mem=(sessionStorage.wp_cmp||'').split(',').filter(s=>by[s]).slice(0,3); if(mem.length>=2) sel=mem;}catch(e){}}
  try{held=(sessionStorage.wp_cmp_held||'').split(',').filter(s=>by[s]&&!sel.includes(s)).slice(0,1)}catch(e){}
  cap=sel.length>=3?3:2; draw(); }
})()); if(!embed) boot();})();
</script>
