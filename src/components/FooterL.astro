---
import { D, url } from '../i18n/index.js'; import { LANG_NAME } from '../i18n/routes.js';
import { FX } from '../lib/price.js'; import { render, bud } from '../lib/money.js';
import Region from './Region.astro'; import { BAG } from '../i18n/bags.js';
import { HUB } from '../i18n/hub.js'; import { SHOE } from '../i18n/shoes.js'; import { BALL } from '../i18n/balls.js';
import { YC } from '../lib/years.js'; import { UNDER, listCur, SHOE_LIST_KEYS } from '../lib/shoes.js';
import { RACKET_GUIDES, SHOE_GUIDES, SHOE_MENU } from '../lib/nav-menu.js';
const { lang, switcher=[], news=false, region=null } = Astro.props; const d=D(lang); const u=d.ui; const LN=LANG_NAME;
const show=s=>render(String(s??''),lang,FX.rates);
const sm=SHOE_MENU[lang];
const shoeGuides=SHOE_GUIDES.filter(k=>SHOE_LIST_KEYS.includes(k));
const shoeTitle=k=>{const row=SHOE[lang].lists[k][0]; return typeof row==='function'?row(bud(UNDER[k],listCur(lang))):row;};
const browse = [
  { href: url('brands', lang), label: u.brands },
  { href: url('players', lang), label: u.players },
  { href: url('balls', lang), label: BALL[lang].nav },
  ...(url('bags', lang) ? [{ href: url('bags', lang), label: BAG[lang].nav }] : []),
  { href: url('finder', lang), label: u.finder },
  { href: url('bf', lang), label: u.bf },
];
const FOOT_MORE = {
  en: [
    { type:'deals', label:'Deals' }, { type:'myKit', label:'My kit' },
    { type:'article', id:'rules', label:'Padel rules' }, { type:'article', id:'hold', label:'How to hold a racket' }, { type:'article', id:'vs', label:'Padel vs paddle tennis' },
    { type:'gifts', id:'main', label:'Gifts' }, { type:'gifts', id:'men', label:'Gifts for men' }, { type:'gifts', id:'women', label:'Gifts for women' },
    { type:'buyGuide', id:'accessories', label:'Padel accessories' }, { type:'buyGuide', id:'grips', label:'Grips and overgrips' },
  ],
  es: [
    { type:'deals', label:'Ofertas' }, { type:'myKit', label:'Mi equipo' },
    { type:'article', id:'rules', label:'Reglas del pádel' }, { type:'article', id:'hold', label:'Cómo coger la pala' }, { type:'article', id:'vs', label:'Pádel vs paddle tennis' },
    { type:'gifts', id:'main', label:'Regalos' },
    { type:'buyGuide', id:'accessories', label:'Accesorios de pádel' }, { type:'buyGuide', id:'grips', label:'Grips y overgrips' },
  ],
  fr: [
    { type:'deals', label:'Bonnes affaires' }, { type:'myKit', label:'Mon kit' },
    { type:'article', id:'rules', label:'Règles du padel' }, { type:'article', id:'hold', label:'Comment tenir la raquette' }, { type:'article', id:'vs', label:'Padel vs paddle tennis' },
    { type:'gifts', id:'main', label:'Cadeaux' },
    { type:'buyGuide', id:'accessories', label:'Accessoires de padel' }, { type:'buyGuide', id:'grips', label:'Grips et overgrips' },
  ],
  pt: [
    { type:'deals', label:'Ofertas' }, { type:'myKit', label:'O meu kit' },
    { type:'article', id:'rules', label:'Regras do pádel' }, { type:'article', id:'hold', label:'Como segurar a raquete' }, { type:'article', id:'vs', label:'Pádel vs paddle tennis' },
    { type:'gifts', id:'main', label:'Presentes' },
    { type:'buyGuide', id:'accessories', label:'Acessórios de pádel' }, { type:'buyGuide', id:'grips', label:'Grips e overgrips' },
  ],
  it: [
    { type:'deals', label:'Offerte' }, { type:'myKit', label:'Il mio kit' },
    { type:'article', id:'rules', label:'Regole del padel' }, { type:'article', id:'hold', label:'Come impugnare la racchetta' }, { type:'article', id:'vs', label:'Padel vs paddle tennis' },
    { type:'gifts', id:'main', label:'Regali' },
    { type:'buyGuide', id:'accessories', label:'Accessori padel' }, { type:'buyGuide', id:'grips', label:'Grip e overgrip' },
  ],
  de: [
    { type:'deals', label:'Angebote' }, { type:'myKit', label:'Mein Kit' },
    { type:'article', id:'rules', label:'Padel-Regeln' }, { type:'article', id:'hold', label:'Padelschläger halten' }, { type:'article', id:'vs', label:'Padel vs Paddle Tennis' },
    { type:'gifts', id:'main', label:'Geschenke' },
    { type:'buyGuide', id:'accessories', label:'Padel-Zubehör' }, { type:'buyGuide', id:'grips', label:'Griffe und Overgrips' },
  ],
};
const more = [
  ...(FOOT_MORE[lang]||[]).map(x=>({ href: url(x.type, lang, x.id), label: x.label })).filter(x=>x.href),
  { href: url('affiliate', lang), label: u.affiliate },
  { href: url('about', lang), label: u.aboutL },
  { href: url('author', lang), label: u.authorL },
  { href: url('privacy', lang), label: u.privacy },
];
const site = [...browse, ...more];
const siteRows = Math.ceil(site.length / 2);
---
<footer class="ftr">{news && <section class="news" id="newsletter"><div class="wrap"><div><h2>{u.newsH}</h2><p>{u.newsP}{' '}<a href={url('privacy',lang)}>{u.privacy.toLowerCase()}</a>.</p></div>
<form class="inline-form" novalidate data-sub="news" data-lang={lang} data-err={u.subErr}><input type="email" required placeholder={u.emailPh} aria-label={u.emailLabel} autocomplete="email"/><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp"/><button class="btn btn-accent">{u.subscribe}</button><div class="ts-box" data-ts></div><p hidden class="ok" role="status" data-ok={u.thanks}></p></form></div></section>}
<div class="wrap">
<div class="cols"><div><a class="logo" href={url('home',lang)}><span class="ball"></span><span>Which<em>Padel</em></span></a><p class="mt3">{u.footerAbout}</p><p class="small"><a href="mailto:hello@whichpadel.com">hello@whichpadel.com</a></p><p class="small"><a href="https://www.facebook.com/whichpadel/" target="_blank" rel="noopener noreferrer">Facebook</a></p>{lang==='en' && <button data-parity-skip type="button" class="ai" data-ai aria-haspopup="dialog" aria-expanded="false" aria-controls="ai-dlg" aria-label="Describe your game">AI</button>}</div>
<div><h2 class="fh">{HUB[lang].nav}</h2><ul><li><a href={url('rackets',lang)}>{u.allRackets}</a></li><li><a href={url('guide',lang)}>{u.guide}</a></li>{RACKET_GUIDES.map(k=><li><a href={url('best',lang,k)} set:html={show(d.copy.best.titles[k][0])} /></li>)}<li><a href={url('bestIndex',lang)}>{u.seeAll}</a></li><li><a href={url('years',lang)}>{YC[lang].hub}</a></li><li><a href={url('tool',lang)}>{u.tools}</a></li></ul></div>
<div><h2 class="fh">{SHOE[lang].nav}</h2><ul><li><a href={url('shoes',lang)}>{sm.all}</a></li>{shoeGuides.map(k=><li><a href={url('shoeList',lang,k)} set:html={show(shoeTitle(k))} /></li>)}</ul></div>
<div><h2 class="fh">{u.footerSite}</h2><ul class="site-links" style={`grid-template-rows:repeat(${siteRows},auto)`}>{site.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul></div></div>
<div class="ftr-rgn" id="ftr-rgn"><Region lang={lang} switcher={switcher} region={region}/></div>
<p class="legal"><Fragment set:html={u.legal}/><br/><a href={url('affiliate',lang)}>{u.affiliate}</a> · <a href={url('privacy',lang)}>{u.privacy}</a> · <button type="button" class="ck-open" data-ck-open>{u.ck.set}</button> · {u.contact}: <a href="mailto:hello@whichpadel.com">hello@whichpadel.com</a></p>
</div></footer>
