---
import { D, url } from '../i18n/index.js'; import { BEST_KEYS } from '../i18n/routes.js';
const { lang, switcher=[], news=false } = Astro.props; const d=D(lang); const u=d.ui; const LN={en:'English',es:'Español',fr:'Français'};
---
{news ? <section class="news" id="newsletter"><div><h2>{u.newsH}</h2><p>{u.newsP}{' '}<a href={url('privacy',lang)}>{u.privacy}</a>.</p></div>
<form class="inline-form" novalidate onsubmit="event.preventDefault();const i=this.querySelector('input[type=email]');if(!i.checkValidity()){i.reportValidity();return}this.querySelector('p').hidden=false"><input type="email" required placeholder={u.emailPh} aria-label={u.emailLabel} autocomplete="email"/><button class="btn btn-accent">{u.subscribe}</button><p hidden class="ok" style="color:#d4ff3a">{u.thanks}</p></form></section>
: <footer class="ftr"><div class="wrap">
<div class="cols"><div><a class="logo" href={url('home',lang)}><span class="ball"></span><span>Which<em>Padel</em></span></a><p style="margin-top:12px">{u.footerAbout}</p></div>
<div><h2 class="fh">{u.footerLists}</h2><ul>{BEST_KEYS.slice(0,9).map(k=><li><a href={url('best',lang,k)}>{d.copy.best.titles[k][0]}</a></li>)}</ul></div>
<div><h2 class="fh">{u.footerSite}</h2><ul><li><a href={url('home',lang)+'#rackets'}>{u.allRackets}</a></li><li><a href={url('guide',lang)}>{u.guide}</a></li><li><a href={url('home',lang)+'#quiz'}>{u.finder}</a></li><li><a href={url('brands',lang)}>{u.brands}</a></li><li><a href={url('players',lang)}>{u.players}</a></li><li><a href={url('compare',lang)}>{u.compare}</a></li><li><a href={url('tool',lang)}>{u.tools}</a></li><li><a href={url('bf',lang)}>{u.bf}</a></li><li><a href={url('affiliate',lang)}>{u.affiliate}</a></li><li><a href={url('privacy',lang)}>{u.privacy}</a></li></ul></div></div>
<p class="legal"><Fragment set:html={u.legal}/><br/><a href={url('affiliate',lang)}>{u.affiliate}</a> · <a href={url('privacy',lang)}>{u.privacy}</a>{switcher.map(([l,h])=><> · <a href={h} hreflang={l} lang={l}>{LN[l]}</a></>)}</p>
</div></footer>}
