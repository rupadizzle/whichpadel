---
// Design trial for /shells-2. One card surface: photo flush to the edge, name and price on one line, controls off the type.
import SaveHeart from './SaveHeart.astro';
import { D } from '../i18n/index.js';

const {
  lang = 'en',
  href,
  img = '',
  alt = '',
  brand = '',
  name = '',
  spec = '',
  price = '',
  off = '',
  rank = '',
  bars = [],
  compare = false,
  save = '',
  kind = 'r',
  posture = 'tile',
  eager = false,
} = Astro.props;

const u = D(lang).ui;
const nameId = `s2-${crypto.randomUUID()}`;
const icoBell = '<svg class="bell" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8.5a6 6 0 0 1 12 0c0 4.5 1.5 6 1.5 8.5h-15c0-2.5 1.5-4 1.5-8.5z"/><path d="M10 18.5a2 2 0 0 0 4 0"/></svg>';
const icoCmp = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7.5" y="7.5" width="12" height="12" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M7.5 11.5V6.2A2.2 2.2 0 0 1 9.7 4H16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
---
<li class:list={['s2', 'rk', `s2-${posture}`]}>
  <a class="s2-a" href={href} aria-labelledby={nameId}>
    <span class="s2-ph">
      {img && <img src={img} alt={alt || name} width="400" height="300" loading={eager ? 'eager' : 'lazy'} decoding="async"/>}
      {rank && <span class="s2-rank">#{rank}</span>}
      {off && <span class="s2-off">{off}</span>}
    </span>
    <span class="s2-body">
      {brand && <span class="s2-brand">{brand}</span>}
      <span class="s2-name" id={nameId}>{name}</span>
      <span class="s2-price">{price}</span>
      {spec && <span class="s2-meta"><span class="s2-spec">{spec}</span></span>}
      {bars.length > 0 && <span class="s2-bars">{bars.map(bar => <span><span>{bar.label}</span><span class="s2-track"><i style={`width:${bar.value}%`}></i></span><b>{bar.value}</b></span>)}</span>}
    </span>
  </a>
  <span class="rk-m s2-sr">{name}</span>
  {save && <span class="s2-acts">
    <button type="button" class="rk-bell" data-slug={save} data-kind={kind} data-h={u.alertH('{n}')} data-off={u.px.cmp.alertDrop} data-on={u.alerted} aria-label={`${u.px.cmp.alertDrop}: ${name}`} set:html={icoBell}/>
    <SaveHeart slug={save} kind={kind} off={u.save} on={u.saved}/>
    {compare && <label class="s2-cmp"><input type="checkbox" value={save}/><span set:html={icoCmp}/><span class="s2-sr">{u.addToCompare}: {name}</span></label>}
  </span>}
</li>
