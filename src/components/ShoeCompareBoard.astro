---
// Side-by-side shoe comparison. Embed mode is the full-screen takeover on the shoe list.
import { shoes, rankShoes, shoeImg } from '../lib/shoes.js';
import { SHOE, SHOE_CMP } from '../i18n/shoes.js';
import { pick, fmt, DEFAULT_REGION } from '../lib/price.js';
import { D, url } from '../i18n/index.js';
const { lang, embed = false } = Astro.props;
const d = D(lang), u = d.ui, T = SHOE[lang], C = SHOE_CMP[lang];
const from = T.from1.split('{p}')[0];
const slim = shoes.map(s => {
  const q = pick(s, DEFAULT_REGION(lang));
  const sole = s.sole.map(k => T.soles[k]).filter(Boolean).join(', ');
  const sz = s.sizesEU.length ? s.sizesEU.join(' · ') : (s.sizesUK.length ? s.sizesUK.join(' · ') + ' UK' : null);
  return { s: s.slug, n: s.name, b: s.brand, y: s.year || null, g: T.genders[s.gender] || null, so: sole || null, cu: s.cushion.length ? s.cushion.map(c => c.toUpperCase()).join(', ') : null, wide: s.wide ? 1 : 0, vib: s.vibram ? 1 : 0, cols: s.colours, shops: s.shops, sz, i: shoeImg(s), p: q.none ? null : q.v, pt: q.none ? null : from + fmt(q.v, q.cur, lang) };
});
const popular = rankShoes(shoes, lang).slice(0, 6).map(s => s.slug);
const DATA = { slim, popular, C, L: { price: C.price, specs: C.specs, fit: T.spec.gender, sole: T.spec.sole, cushion: T.spec.cushion, wide: T.wide, vibram: T.vibram, season: T.spec.year, sizes: C.sizes, cols: T.spec.cols, shops: T.spec.shops }, shoe: url('shoe', lang, '§'), aff: url('affiliate', lang), note: u.adNoteShort, disc: u.disclosure, none: u.checkPrice };
---
<div id="cmp" class="cmp cmp-cards" data-popular={popular.join(',')} data-embed={embed ? '1' : undefined}><p class="panel empty">{C.loading}</p></div>
<p class="muted small trust">{C.trust}</p>
<dialog class="sheet" id="sheet" aria-labelledby="sheet-h"><div class="sheet-in"><div class="sheet-top"><h2 id="sheet-h" class="h3">{C.add}</h2><button class="x" type="button" data-close aria-label={u.close}>✕</button></div>
<input id="sheet-q" type="search" placeholder={C.searchPh} aria-label={C.search} autocomplete="off"/>
<ul class="pick-list" id="sheet-list"></ul></div></dialog>
<script type="application/json" id="sc-data" set:html={JSON.stringify(DATA).replace(/</g,'\\u003c')}></script>
<script is:inline>
(()=>{const root=document.getElementById('cmp'); const sheet=document.getElementById('sheet'); const embed=root.dataset.embed==='1';
if(embed) document.body.appendChild(sheet);
const {slim,popular,C,L,shoe,aff,note,disc,none}=JSON.parse(document.getElementById('sc-data').textContent);
const by=Object.fromEntries(slim.map(x=>[x.s,x])); const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const ROWS=[['g','fit'],['so','sole'],['cu','cushion'],['wide','wide','yn'],['vib','vibram','yn'],['y','season'],['sz','sizes'],['cols','cols'],['shops','shops']];
let sel=[], held=[], cap=2, slot=-1;
const img=x=>x.i?`<img src="${esc(x.i)}" alt="" width="80" height="80" decoding="async">`:`<span class="noimg" aria-hidden="true">${esc((x.b||'?')[0])}</span>`;
const icoSwap='<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 8h12m0 0-3-3m3 3-3 3M20 16H8m0 0 3-3m-3 3 3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const icoGo='<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const icoX='<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
const short=x=>x.n.replace(new RegExp('^'+x.b.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\s+','i'),'');
const cell=(x,k,kind)=>{const v=x[k]; if(kind==='yn') return v?C.yes:C.no; return v==null||v===''?'—':esc(v);};
function save(){try{sessionStorage.wp_shoe_cmp=sel.join(','); sessionStorage.wp_shoe_cmp_held=held.join(',')}catch(e){}
 if(embed){document.dispatchEvent(new CustomEvent('wp:cmp',{detail:sel.slice()})); return;}
 const q=sel.length?'?s='+sel.join(','):''; history.replaceState(null,'',location.pathname+q);}
function winner(vals){const n=vals.filter(v=>typeof v==='number'); if(n.length<2) return null; const m=Math.min(...n); return n.filter(v=>v===m).length===n.length?null:m;}
function headCell(x,i){return `<div class="hc"><div class="hcin">${img(x)}<div class="hbody"><a class="hn" href="${shoe.replace('§',x.s)}">${esc(short(x))}</a><span class="hp">${esc(x.pt||none)}</span></div><div class="hact"><button type="button" class="mini" data-add="${i}" aria-label="${esc(C.swap)}: ${esc(x.n)}">${icoSwap}</button><button type="button" class="mini" data-rm="${i}" aria-label="${esc(C.remove)}: ${esc(x.n)}">${icoX}</button></div></div></div>`;}
function setCap(n){n=n===3?3:2; if(n===2){if(sel.length>2) held=[sel[2]]; sel=sel.slice(0,2); cap=2; draw(); return;}
 if(sel.length>=3){cap=3; held=[]; draw(); return;}
 const extra=held.find(s=>!sel.includes(s)); if(extra){sel=sel.concat(extra).slice(0,3); held=[]; cap=3; draw(); return;}
 cap=3; open(sel.length);}
function draw(){save(); const xs=sel.slice(0,cap).map(s=>by[s]); const slots=Math.max(xs.length,2); root.style.setProperty('--n',slots);
 if(xs.length<2){const pop=popular.filter(s=>!sel.includes(s)).slice(0,4);
  root.innerHTML=`<div class="slots">${[0,1].map(i=>xs[i]?headCell(xs[i],i):`<button class="slot-add" type="button" data-add="${i}"><span>+</span>${esc(C.addN.replace('§',i+1))}</button>`).join('')}</div>
  <section class="panel"><h2 class="h3">${esc(C.popular)}</h2><div class="pop">${pop.map(s=>`<button type="button" class="popb" data-quick="${s}">${img(by[s])}<span>${esc(by[s].n)}</span></button>`).join('')}</div></section>`; return;}
 const tog=`<div class="cmp-n"><span class="cmp-n-lab" id="cmp-n-lab">${esc(C.compare)}</span><div class="cmp-n-set" role="radiogroup" aria-labelledby="cmp-n-lab"><label><input type="radio" name="cmpn" value="2"${cap===2?' checked':''}><span>2</span></label><label><input type="radio" name="cmpn" value="3"${cap===3?' checked':''}><span>3</span></label></div></div>`;
 let h=tog+`<div class="chead" style="--n:${xs.length}">${xs.map(headCell).join('')}</div>`;
 const pr=xs.map(x=>x.p); const pw=winner(pr);
 h+=`<details class="cgroup" open><summary>${esc(C.price)}</summary><div class="crow"><div class="clab">${esc(L.price)}</div><div class="cvals" style="--n:${xs.length}">${xs.map(x=>`<div class="cv${pw!==null&&x.p===pw?' win':''}"><b>${esc(x.pt||none)}</b></div>`).join('')}</div></div></details>`;
 const body=ROWS.map(([k,lab,kind])=>{const vals=xs.map(x=>x[k]); if(kind!=='yn'&&vals.every(v=>v==null||v==='')) return '';
  return `<div class="crow"><div class="clab">${esc(L[lab])}</div><div class="cvals" style="--n:${xs.length}">${xs.map(x=>`<div class="cv">${cell(x,k,kind)}</div>`).join('')}</div></div>`;}).join('');
 if(body) h+=`<details class="cgroup" open><summary>${esc(C.specs)}</summary>${body}</details>`;
 const btn=x=>embed?`<span class="bsub">${x.pt?`<span class="bp">${esc(x.pt)}</span>${icoGo}`:`<span class="ba">${esc(C.see)}</span>${icoGo}`}</span>`:`<span class="bn">${esc(short(x))}</span><span>${esc(x.pt||C.see)}</span>`;
 h+=`<div class="buyrow" style="--n:${xs.length}">${xs.map(x=>`<a class="btn" href="${shoe.replace('§',x.s)}">${btn(x)}</a>`).join('')}<p class="disc">${esc(note)} <a href="${aff}">${esc(disc)}</a></p></div>`;
 root.innerHTML=h;}
function list(){const q=$('sheet-q').value.toLowerCase().trim(); const r=slim.filter(x=>!sel.includes(x.s)&&(!q||(x.n+' '+x.b).toLowerCase().includes(q))).slice(0,40);
 $('sheet-list').innerHTML=r.length?r.map(x=>`<li><button type="button" data-pick="${x.s}">${img(x)}<span><b>${esc(x.n)}</b><small>${esc(x.g||'')} · ${esc(x.pt||none)}</small></span></button></li>`).join(''):'<li class="muted">'+esc(C.noMatch)+'</li>';}
function open(i){slot=i; $('sheet-q').value=''; list(); sheet.showModal(); if(matchMedia('(min-width:700px)').matches) $('sheet-q').focus();}
function onClick(e){const t=e.target.closest('[data-add],[data-rm],[data-pick],[data-close],[data-quick]'); if(!t){ if(e.target===sheet) sheet.close(); return;}
 const d=t.dataset; if(d.add!=null) open(+d.add); else if(d.rm!=null){sel.splice(+d.rm,1); if(sel.length<3) cap=2; draw();} else if(d.quick){if(sel.length<cap) sel.push(d.quick); draw();}
 else if(d.pick){ if(slot<sel.length) sel[slot]=d.pick; else if(sel.length<cap) sel.push(d.pick); held=held.filter(s=>!sel.includes(s)); sheet.close(); draw(); const sc=root.closest('.cmp-take-body'); if(sc) sc.scrollTop=0; else window.scrollTo({top:0}); }
 else if(d.close!=null) sheet.close();}
root.addEventListener('click',onClick); sheet.addEventListener('click',onClick);
root.addEventListener('change',e=>{if(e.target.name==='cmpn') setCap(+e.target.value);});
sheet.addEventListener('close',()=>{if(cap===3&&sel.length<3){cap=2; draw();}});
let tm; $('sheet-q').addEventListener('input',()=>{clearTimeout(tm);tm=setTimeout(list,80)});
function applyIds(ids){const next=(ids||[]).map(String).filter(s=>by[s]).slice(0,3); sel=next; held=held.filter(s=>!sel.includes(s)); cap=sel.length>=3?3:2; draw();}
window.wpCompare={set:applyIds, get(){return sel.slice();}};
if(!embed){ sel=(new URLSearchParams(location.search).get('s')||'').split(',').filter(s=>by[s]).slice(0,3);
 if(sel.length<2){try{const mem=(sessionStorage.wp_shoe_cmp||'').split(',').filter(s=>by[s]).slice(0,3); if(mem.length>=2) sel=mem;}catch(e){}}
 try{held=(sessionStorage.wp_shoe_cmp_held||'').split(',').filter(s=>by[s]&&!sel.includes(s)).slice(0,1)}catch(e){}
 cap=sel.length>=3?3:2; draw(); }
})();
</script>
