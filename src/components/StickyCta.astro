---
import Price from './Price.astro';
const { r, lang, shop, openLabel, buyLabel, alert = null } = Astro.props; // alert: {slug, kind, h, off, on} adds a labelled price-alert button (rackets); off/on are the button labels
---
<div class="stickycta" id="stickycta" aria-hidden="true"><button type="button" class="sp" id="stickyopen" tabindex="-1" aria-haspopup="dialog" aria-label={openLabel}><b><Price r={r} lang={lang}/><svg class="spchev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></b><span>{shop}</span></button>{alert && <button type="button" class="rk-bell sbell" tabindex="-1" data-slug={alert.slug} data-kind={alert.kind} data-h={alert.h} data-off={alert.off} data-on={alert.on} aria-label={alert.off} aria-pressed="false"><svg class="bell" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8.5a6 6 0 0 1 12 0c0 4.5 1.5 6 1.5 8.5h-15c0-2.5 1.5-4 1.5-8.5z"/><path d="M10 18.5a2 2 0 0 0 4 0"/></svg><span class="pxalert-lab">{alert.off}</span></button>}<button type="button" class="btn" id="stickybuy" tabindex="-1" aria-haspopup="dialog">{buyLabel}</button></div>
