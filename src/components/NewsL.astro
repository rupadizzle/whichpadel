---
import { NEWS } from '../i18n/news.js'; import { url } from '../i18n/routes.js';
const { lang='en', src='', bare=false, consent='', button='' } = Astro.props; const N=NEWS[lang]||NEWS.en;
---
<form class="nl" novalidate data-sub="nl" data-lang={lang} data-src={src} data-err={N.err}>
{!bare && <p class="nl-t"><b>✉ {N.h}:</b> {N.p}</p>}
<div class="nl-r"><input type="email" required placeholder={N.ph} aria-label={N.ph} autocomplete="email"/><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp"/><button class="btn btn-accent">{button||N.b}</button></div>
<label class="nl-c"><input type="checkbox" required/><span>{consent||N.c} <a href={url('privacy',lang)}>{N.priv}</a>.</span></label>
<p hidden class="nl-m" role="status" data-ok={N.ok}></p>
</form>
<style is:global>
.nl{margin:var(--s5) 0;padding:var(--s4);border:1px solid var(--line);border-radius:var(--r-s);display:grid;gap:var(--s2)}
.nl-t{margin:0}.nl-r{display:flex;gap:var(--s2);flex-wrap:wrap}.nl-r input[type="email"]{flex:1;min-width:200px;min-height:44px;padding:0 var(--s4)}.nl-r .btn{min-height:44px;padding:0 var(--s4)}
.nl-c{display:flex;gap:var(--s2);align-items:flex-start;font-size:var(--fs-m);min-height:44px;cursor:pointer}.nl-c input{width:24px;height:24px;margin:0;flex:none}
.nl-m{margin:0;font-weight:600}.nl-m.bad{color:var(--danger)}.nl-m.good{color:var(--green)}
</style>
