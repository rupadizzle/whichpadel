---
import { D, url } from '../i18n/index.js';
const { lang, racket } = Astro.props; const u=D(lang).ui;
---
<section class="offer alert-panel"><div><h2 class="h3">🔔 {u.alertH(racket)}</h2><p>{u.alertP(racket)}</p><ul>{u.alertPerks.map(x=><li>{x}</li>)}</ul></div>
<form class="inline-form" novalidate data-sub="alert" data-lang={lang} data-racket={racket||''} data-err={u.subErr}><input type="email" required placeholder={u.emailPh} aria-label={u.emailLabel} autocomplete="email"/>{!racket&&<input type="number" min="0" inputmode="numeric" placeholder={u.maxPrice} aria-label={u.maxPrice}/>}<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp"/><button class="btn btn-accent">{u.alertBtn}</button><p hidden class="ok" role="status" data-ok={u.thanks}></p>
<p class="muted small" style="margin:0">{u.placeholderNote} <a href={url('privacy',lang)}>{u.privacy.toLowerCase()}</a>.</p></form></section>
