---
import { D, url } from '../i18n/index.js';
const { lang, racket } = Astro.props; const u=D(lang).ui;
---
<section class="offer alert-panel"><div><h2 class="h3">🔔 {u.alertH(racket)}</h2><p>{u.alertP(racket)}</p><ul>{u.alertPerks.map(x=><li>{x}</li>)}</ul></div>
<form class="inline-form" onsubmit="event.preventDefault();const i=this.querySelector('input[type=email]');if(!i.checkValidity()){i.reportValidity();return}this.querySelector('p').hidden=false"><input type="email" required placeholder={u.emailPh} aria-label={u.emailLabel} autocomplete="email"/>{!racket&&<input type="number" min="0" inputmode="numeric" placeholder={u.maxPrice} aria-label={u.maxPrice}/>}<button class="btn btn-accent">{u.alertBtn}</button><p hidden class="ok">{u.thanks}</p>
<p class="muted small" style="margin:0">{u.placeholderNote} <a href={url('privacy',lang)}>{u.privacy.toLowerCase()}</a>.</p></form></section>
