---
import Price from './Price.astro'; import { shoeImg } from '../lib/shoes.js'; import { SHOE } from '../i18n/shoes.js'; import { url } from '../i18n/index.js';
const { s, lang, eager=false, rank, region=null } = Astro.props; const T=SHOE[lang]; const img=shoeImg(s);
---
<li class="rk sk" data-s={s.slug} data-b={s.brand} data-g={s.gender} data-so={s.sole.join(' ')} data-sz={s.sizesEU.join(' ')} data-y={s.year||0} data-n={s.inStock}><a class="rk-a" href={url('shoe',lang,s.slug)}><span class="rk-i">{img&&<img src={img} alt={T.alt(s.name)} width="96" height="96" loading={eager?'eager':'lazy'} decoding="async"/>}</span><span class="rk-t"><span class="rk-b">{rank&&<>#{rank} · </>}{s.brand}{s.year&&` · ${s.year}`}</span><span class="rk-m">{s.name}</span><span class="rk-c">{[T.genders[s.gender],...s.sole.map(k=>T.soles[k])].join(' · ')}</span><span class="rk-p"><Price r={s} lang={lang} region={region}/>{s.shops>1&&<small class="muted"> · {s.shops}×</small>}</span></span></a></li>
