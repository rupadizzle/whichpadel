---
import { shoeImg } from '../lib/shoes.js'; import { SHOE, SHOE_CMP } from '../i18n/shoes.js'; import { D, url } from '../i18n/index.js';
import { pick, fmt, DEFAULT_REGION } from '../lib/price.js';
const { s, lang, eager=false, rank, region=null, compare=false } = Astro.props; const T=SHOE[lang]; const C=SHOE_CMP[lang]; const img=shoeImg(s);
const escRe=x=>String(x).replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
const shortN=()=>{let n=s.name||''; if(s.brand) n=n.replace(new RegExp('^'+escRe(s.brand)+'\\s+','i'),''); if(s.year){n=n.replace(new RegExp('\\s+'+s.year+'\\s*$'),''); const yy=String(s.year).slice(-2); if(yy.length===2) n=n.replace(new RegExp('\\s+'+yy+'\\s*$'),'');} return n.trim()||s.name;};
const spec=[T.genders[s.gender],...s.sole.map(k=>T.soles[k])].filter(Boolean).join(' · ');
const q=pick(s,region||DEFAULT_REGION(lang));
const price=q.none?D(lang).ui.checkPrice:T.from1.split('{p}')[0]+fmt(q.v,q.cur,lang);
---
<li class="rk sk" data-s={s.slug} data-m={shortN()} data-b={s.brand} data-g={s.gender} data-so={s.sole.join(' ')} data-sz={s.sizesEU.join(' ')} data-y={s.year||0} data-n={s.inStock}><a class="rk-a" href={url('shoe',lang,s.slug)}><span class="rk-i">{img&&<img src={img} alt={T.alt(s.name)} width="96" height="96" loading={eager?'eager':'lazy'} decoding="async"/>}</span><span class="rk-t"><span class="rk-b">{rank&&<>#{rank} · </>}{[s.brand,s.year].filter(Boolean).join(' · ')}</span><span class="rk-m">{shortN()}</span><span class="rk-c">{spec}</span><span class="rk-p"><span class="pz rk-pv">{price}</span></span></span></a>{compare&&<label class="rk-x" title={C.compare}><input type="checkbox" class="rk-cb" value={s.slug}/><span><span class="sr">{C.compare}: {s.name}</span></span></label>}</li>
