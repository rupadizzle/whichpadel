---
import { YC } from '../lib/years.js'; import { SHOE } from '../i18n/shoes.js'; import { BALL } from '../i18n/balls.js';
import { D, url } from '../i18n/index.js'; import { HUB } from '../i18n/hub.js';
import { FX } from '../lib/price.js'; import { fmtM, val, SYMS } from '../lib/money.js';
const { lang, cta = true } = Astro.props; const d=D(lang); const u=d.ui;
const HEAD=['best-padel-rackets-for-beginners','best-padel-racket-2026','best-power-padel-rackets','best-control-padel-rackets','best-womens-padel-rackets','best-padel-rackets-under-150'];
const shortT=k=>d.copy.best.titles[k][0].replace(/^(Best|Most|Mejores|Meilleures|Melhores|Migliori|Die besten) (padel rackets?|palas de pádel|raquettes de padel|raquetes de padel|racchette da padel|padelschläger) /i,'').replace(/^(Best|Most) (.*) padel rackets?/,'$1 $2').replace(/^Die besten Kontroll-Padelschläger$/i,'Kontrolle').replace(/ \(.*\)$/,'').replace(/^of (\d+)/i,'Top picks $1').replace(/^./,c=>c.toUpperCase());
const lab=s=>s.replace(/⟦([mbsMBS])\|([\d.]+)\|([A-Za-z]{3})\|([A-Za-z]{3})⟧/g,(_,k,n,f,d0)=>{k=k.toLowerCase();f=f.toUpperCase();d0=d0.toUpperCase();return k==='s'?`<span class="mzs" data-mc="${d0}">${SYMS[d0]}</span>`:`<span class="mz" data-k="${k}" data-m="${n}" data-mc="${f}">${fmtM(val(FX.rates,k,+n,f,d0),d0,lang)}</span>`;});
---
<nav class="nav" id="nav"><a href={url('rackets',lang)}>{HUB[lang].nav}</a><a href={url('shoes',lang)}>{SHOE[lang].nav}</a>{BALL[lang]&&lang!=='pt'&&<a href={url('balls',lang)}>{BALL[lang].nav}</a>}
<div class="dd"><button type="button" aria-haspopup="true" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.parentNode.classList.toggle('open'))">{u.guides} ▾</button><div class="menu"><div class="dd-col"><a href={url('guide',lang)}>{u.guide}</a><p class="dd-lab">{u.bestLists}</p>{HEAD.map(k=><a href={url('best',lang,k)} set:html={lab(shortT(k))} />)}<a href={url('bestIndex',lang)}>{u.seeAll}</a></div><div class="dd-col dd-more"><a href={url('compare',lang)}>{u.compare}</a><a href={url('brands',lang)}>{u.brands}</a><a href={url('players',lang)}>{u.players}</a><a href={url('years',lang)}>{YC[lang].hub}</a><a href={url('tool',lang)}>{u.tools}</a><a href={url('bf',lang)}>{u.bf}</a></div></div></div>
{cta && <a class="cta" href={url('finder',lang)}>{u.finder}</a>}</nav>
