---
import { YC } from '../lib/years.js'; import { SHOE } from '../i18n/shoes.js';
import { D, url } from '../i18n/index.js'; import { HUB } from '../i18n/hub.js'; import { BEST_KEYS, SHAPE_KEYS, LANG_NAME } from '../i18n/routes.js';
const { lang, switcher=[] } = Astro.props; const d=D(lang); const u=d.ui; const LN=LANG_NAME;
const shortT=k=>d.copy.best.titles[k][0].replace(/^(Mejores|Las|Meilleures|Les|Best|Most) (palas de pádel|raquettes de padel|padel rackets?) /,'').replace(/^(Las |Les )?(palas de pádel|raquettes de padel|padel rackets) /,'').replace(/^(Best|Most) (.*) padel rackets?/,'$1 $2').replace(/ \(.*\)$/,'').replace(/^of (\d+)/i,'Top picks $1').replace(/^./,c=>c.toUpperCase());
---
<nav class="nav" id="nav"><a href={url('rackets',lang)}>{HUB[lang].nav}</a><a href={url('shoes',lang)}>{SHOE[lang].nav}</a><a href={url('guide',lang)}>{u.guide}</a><a href={url('brands',lang)}>{u.brands}</a><a href={url('players',lang)}>{u.players}</a><a href={url('compare',lang)}>{u.compare}</a>
<div class="dd"><button type="button" aria-haspopup="true" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.parentNode.classList.toggle('open'))">{u.bestLists} ▾</button><div class="menu"><a href={url('bestIndex',lang)}>{u.seeAll.replace(' →','')}</a>{BEST_KEYS.filter(k=>!SHAPE_KEYS.includes(k)).map(k=><a href={url('best',lang,k)}>{shortT(k)}</a>)}<a href={url('years',lang)}>{YC[lang].hub}</a><a href={url('bf',lang)}>{u.bf}</a><a href={url('tool',lang)}>{u.tools}</a></div></div>
<a class="cta" href={url('finder',lang)}>{u.finder}</a></nav>
