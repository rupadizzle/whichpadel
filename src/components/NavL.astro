---
import { YC } from '../lib/years.js'; import { SHOE } from '../i18n/shoes.js'; import { BALL } from '../i18n/balls.js'; import { BAG } from '../i18n/bags.js';
import { D, url } from '../i18n/index.js'; import { HUB } from '../i18n/hub.js';
import { FX } from '../lib/price.js'; import { fmtM, val, SYMS } from '../lib/money.js';
const { lang, cta = true } = Astro.props; const d=D(lang); const u=d.ui;
const bfHref = url('bf', lang);
const HEAD=['best-padel-rackets-for-beginners','best-padel-racket-2026','best-power-padel-rackets','best-control-padel-rackets','best-womens-padel-rackets','best-padel-rackets-under-150'];
const shortT=k=>d.copy.best.titles[k][0].replace(/^(Best|Most|Mejores|Meilleures|Melhores|Migliori|Die besten) (padel rackets?|palas de pádel|raquettes de padel|raquetes de padel|racchette da padel|padelschläger) /i,'').replace(/^(Best|Most) (.*) padel rackets?/,'$1 $2').replace(/^Die besten Kontroll-Padelschläger$/i,'Kontrolle').replace(/ \(.*\)$/,'').replace(/^of (\d+)/i,'Top picks $1').replace(/^./,c=>c.toUpperCase());
const lab=s=>s.replace(/⟦([mbsMBS])\|([\d.]+)\|([A-Za-z]{3})\|([A-Za-z]{3})⟧/g,(_,k,n,f,d0)=>{k=k.toLowerCase();f=f.toUpperCase();d0=d0.toUpperCase();return k==='s'?`<span class="mzs" data-mc="${d0}">${SYMS[d0]}</span>`:`<span class="mz" data-k="${k}" data-m="${n}" data-mc="${f}">${fmtM(val(FX.rates,k,+n,f,d0),d0,lang)}</span>`;});
---
<nav class="nav" id="nav"><div class="nav-main"><a href={url('rackets',lang)}>{HUB[lang].nav}</a><a href={url('shoes',lang)}>{SHOE[lang].nav}</a>{BALL[lang]&&<a href={url('balls',lang)}>{BALL[lang].nav}</a>}{BAG[lang]&&url('bags',lang)&&<a href={url('bags',lang)}>{BAG[lang].nav}</a>}<a class="nav-bf" href={bfHref} aria-current={Astro.url.pathname===bfHref?'page':undefined}>Black Friday</a><div id="site-util"><a id="saved-link" href={url('saved',lang)}>{u.savedNav}<b id="saved-n" hidden></b></a><div class="acct" id="acct"><button type="button" class="acct-btn" id="acct-btn" aria-expanded="false" aria-controls="acct-pop"><span class="acct-lab" id="acct-lab">{u.signIn}</span></button><div class="acct-pop" id="acct-pop" hidden><form id="acct-form" novalidate><p class="acct-h" id="acct-h">{u.acctH}</p><p class="acct-p">{u.acctP} <a href={url('privacy',lang)}>{u.privacy}</a></p><input type="email" required placeholder={u.emailPh} aria-label={u.emailLabel} autocomplete="email"/><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp"/><button class="btn btn-accent" type="submit">{u.keepBtn}</button><p hidden class="ok" id="acct-msg" role="status"></p></form><div id="acct-in" hidden><p class="acct-email" id="acct-email"></p><p class="acct-p">{u.savedAs}</p><button type="button" class="btn btn-line" id="acct-out">{u.signOut}</button></div></div></div></div>
<div class="dd"><button type="button" aria-haspopup="true" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.parentNode.classList.toggle('open'))">{u.guides} ▾</button><div class="menu"><div class="dd-col"><a href={url('guide',lang)}>{u.guide}</a><p class="dd-lab">{u.bestLists}</p>{HEAD.map(k=><a href={url('best',lang,k)} set:html={lab(shortT(k))} />)}<a href={url('bestIndex',lang)}>{u.seeAll}</a></div><div class="dd-col dd-more"><a href={url('rackets',lang)}>{u.compare}</a><a href={url('brands',lang)}>{u.brands}</a><a href={url('players',lang)}>{u.players}</a><a href={url('years',lang)}>{YC[lang].hub}</a><a href={url('tool',lang)}>{u.tools}</a><a href={url('bf',lang)}>{u.bf}</a></div></div></div></div><div class="nav-end">{cta && <a class="cta" href={url('finder',lang)}>Finder</a>}</div><div class="nav-rgn" id="nav-rgn"></div></nav>
<script is:inline define:vars={{SIGN:u.signIn, ACCT:u.account, OK:u.keepOk, ERR:u.keepErr, MAIL:u.keepMail}}>
(()=>{const btn=document.getElementById('acct-btn'), pop=document.getElementById('acct-pop'), lab=document.getElementById('acct-lab'), form=document.getElementById('acct-form'), inn=document.getElementById('acct-in'), mail=document.getElementById('acct-email');
 if(!btn||!pop) return;
 const setOpen=on=>{pop.hidden=!on; btn.setAttribute('aria-expanded',on?'true':'false'); if(on){const f=form.hidden?document.getElementById('acct-out'):form.querySelector('input[type=email]'); if(f) f.focus();}};
 const short=email=>{const name=(email||'').split('@')[0]; if(!name) return ACCT; return name.length>18?name.slice(0,17)+'…':name;};
 const apply=d=>{const on=!!(d&&d.on); form.hidden=on; inn.hidden=!on; mail.textContent=on?(d.email||''):''; lab.textContent=on?short(d.email):SIGN; if(on&&d.email) btn.setAttribute('aria-label',d.email); else btn.removeAttribute('aria-label');};
 btn.onclick=()=>setOpen(pop.hidden);
 document.addEventListener('click',e=>{if(!pop.hidden&&!document.getElementById('acct').contains(e.target)) setOpen(false);});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!pop.hidden){setOpen(false); btn.focus();}});
 document.addEventListener('wp:acct',e=>apply(e.detail));
 form.onsubmit=async e=>{e.preventDefault(); const i=form.querySelector('input[type=email]'), b=form.querySelector('button'), msg=document.getElementById('acct-msg'); if(!i.checkValidity()){i.reportValidity(); return;} b.disabled=true; let status=0;
  try{const r=await fetch('/api/auth/start',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({email:i.value.trim(),lang:(document.documentElement.lang||'en').slice(0,2),next:location.pathname,website:form.querySelector('input.hp')?.value||''})}); status=r.status;}catch(err){status=0;}
  b.disabled=false; msg.hidden=false; msg.textContent=status===503?MAIL:(status>=200&&status<300)?OK:ERR;};
 document.getElementById('acct-out').onclick=async()=>{try{await fetch('/api/auth/out',{method:'POST',credentials:'same-origin'});}catch(e){} try{localStorage.removeItem('wp_acct')}catch(e){} apply(null); document.dispatchEvent(new CustomEvent('wp:acct',{detail:null})); setOpen(false);};
 document.addEventListener('DOMContentLoaded',async()=>{
  const q=new URLSearchParams(location.search), own=!!document.getElementById('keep-form');
  if(!own&&q.get('auth')==='bad'){setOpen(true); const msg=document.getElementById('acct-msg'); msg.hidden=false; msg.textContent=ERR;}
  if(!own&&q.get('sync')==='1'&&window.wpSaved){try{const r=await fetch('/api/saved',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({merge:true,items:window.wpSaved.read()})}); if(r.ok){const d=await r.json(); if(Array.isArray(d.items)) window.wpSaved.write(d.items); try{localStorage.wp_acct='1'}catch(e){} apply({on:true,email:d.email||''});}}catch(e){}}
  if(!own&&(q.has('sync')||q.has('auth'))){q.delete('sync'); q.delete('auth'); history.replaceState(null,'',location.pathname+(q.toString()?'?'+q:''));}
  let flagged=false; try{flagged=localStorage.wp_acct==='1'}catch(e){}
  if(!flagged){apply(null); return;}
  apply({on:true,email:''});
  try{const r=await fetch('/api/saved',{credentials:'same-origin'}); if(r.status===401){try{localStorage.removeItem('wp_acct')}catch(e){} apply(null); return;} if(!r.ok) return; const d=await r.json(); apply({on:true,email:d.email||''});}catch(e){}
 });})();
</script>
