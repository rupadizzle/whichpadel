---
import Crumbs from './Crumbs.astro';
import Byline from './Byline.astro';
const { lang, label, crumbs, h1, pageUrl, lead, eyebrow, photo } = Astro.props;
---
<section class={photo?"phero phero--photo":"phero"}><div class="wrap"><div class="phero__text"><Crumbs label={label} items={crumbs}/>{eyebrow&&<span class="eyebrow">{eyebrow}</span>}<h1>{h1}</h1><Byline lang={lang} headline={h1} pageUrl={pageUrl}/>{lead&&<div class="seo"><p>{lead}</p></div>}</div>{photo&&<img class="phero__photo" src={photo.src} alt={photo.alt} width="622" height="800" decoding="async"/>}</div></section>
<style is:global>.phero--photo .wrap{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--s5);align-items:end}.phero--photo .phero__text{align-self:center}.phero__photo{display:block;width:auto;height:clamp(170px,17vw,220px);max-width:100%;object-fit:contain;margin-bottom:-2rem}@media (width < 600px){.phero--photo .wrap{display:block}.phero--photo .phero__text{margin-bottom:var(--s3)}.phero__photo{height:auto;width:auto;max-height:220px;margin:0 0 -2rem auto}}</style>
