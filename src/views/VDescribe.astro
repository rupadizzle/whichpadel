---
import Base from '../layouts/Base.astro'; import { D, url } from '../i18n/index.js'; import { TOOL } from '../i18n/tools.js';
const { lang } = Astro.props;
const T = TOOL.describe[lang];
const FINDER = url('finder', lang);
const shoesHref = url('describeShoes', lang);
---
<Base lang={D(lang).locale} focus title={T.title + ' | WhichPadel'} description={T.desc}>
<div class="fz"><section class="fz-scr fz-intro">
 <h1>{T.h1}</h1>
 <button type="button" class="btn btn-accent fz-start" id="dg-rec">{T.btn}</button>
 <p class="fz-sub" id="dg-live" aria-live="polite" hidden></p>
 <p class="fz-trust" id="dg-note" hidden>{T.note}<a href={FINDER}>{T.finder}</a></p>
</section></div>
<script is:inline src="/describe-parse.js"></script>
<script is:inline define:vars={{FINDER, shoesHref, T}}>
if(new URLSearchParams(location.search).get('for')==='shoes') location.replace(shoesHref);
const $=id=>document.getElementById(id), B=$('dg-rec'), L=$('dg-live');
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
if(!SR){B.hidden=true; $('dg-note').hidden=false;}
else{let rec=null, fin='';
 const done=()=>{const t=fin.trim(); if(t.length<8){B.textContent=T.again; L.textContent=t?T.short:''; return;}
  const p=window.DG.parse(t), a=window.DG.racket(p); B.disabled=true; B.textContent=T.finding;
  L.textContent=T.heard+p.why.join(' · ');
  setTimeout(()=>location.href=FINDER+'?'+new URLSearchParams(a),1200);};
 B.onclick=()=>{if(rec){rec.stop();return;} fin=''; rec=new SR(); rec.lang=T.speechLang; rec.interimResults=true; rec.continuous=true;
  rec.onresult=e=>{let interim=''; for(let i=e.resultIndex;i<e.results.length;i++){const r=e.results[i]; if(r.isFinal) fin+=r[0].transcript+' '; else interim+=r[0].transcript;} L.hidden=false; L.textContent='“'+(fin+interim).trim()+'”';};
  rec.onerror=e=>{if(e.error==='not-allowed'||e.error==='service-not-allowed'){B.hidden=true; $('dg-note').hidden=false;}};
  rec.onend=()=>{rec=null; done();};
  rec.start(); B.textContent=T.done; L.hidden=false; L.textContent=T.listening;};}
</script>
</Base>
