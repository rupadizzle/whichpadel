---
// Ball detail page: specs + per-shop tube prices. Live offers from /api/shoe-prices key "ball-<slug>" (same engine, 8h recheck, 48h freshness); US visitors see US shops only.
import Base from '../layouts/Base.astro'; import Price from '../components/Price.astro';
import { SHOPS, FX } from '../lib/price.js';
import { balls, ballImg, rankBalls, BALL_CHECKED } from '../lib/balls.js'; import { BALL } from '../i18n/balls.js'; import { D, url, SITE } from '../i18n/index.js';
import { slugify, brandList } from '../lib/data.js';
import SaveHeart from '../components/SaveHeart.astro';
const SN=Object.fromEntries(Object.entries(SHOPS).map(([k,v])=>[k,[v.name&&v.name!==k?v.name:k.replace(/\.(com|net|co\.uk|de|es)$/,''),typeof v.affiliate==='string'&&v.affiliate.startsWith('https://')?v.affiliate:'']]));
const { b, lang } = Astro.props; const d=D(lang), u=d.ui, T=BALL[lang]; const img=ballImg(b);
const bs=slugify(b.brand); const bHref=brandList.some(x=>x.slug===bs)?url('brand',lang,bs)+'#balls':null;
const intro=T.intro1(b)+(b.tour?' '+T.tour[b.tour]+'.':'');
const rows=[[T.spec.brand,b.brand],[T.spec.balls,b.balls],[T.spec.speed,T.speeds[b.speed]],[T.spec.tour,b.tour?T.tour[b.tour]:null],[T.spec.shops,b.shops]].filter(([,v])=>v!=null);
const best0=[...b.offs].sort((x,y)=>y.s-x.s||x.p-y.p)[0]; const BN=(SN[best0.d]||[best0.d])[0];
const oj=JSON.stringify(b.offs.filter(o=>o.s||!b.offs.some(x=>x.s)).map(o=>({d:o.d,p:o.p,c:o.c,u:o.u})));
const similar=rankBalls(balls.filter(x=>x.slug!==b.slug&&x.speed===b.speed),lang).slice(0,6);
const U=SITE+url('ball',lang,b.slug);
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'Product','name':b.name+' (3)','url':U,'brand':{'@type':'Brand','name':b.brand},...(img?{'image':SITE+img}:{}),'description':intro,'offers':{'@type':'AggregateOffer','lowPrice':String(Math.min(...b.offs.map(o=>o.p))),'highPrice':String(Math.max(...b.offs.map(o=>o.p))),'priceCurrency':best0.c,'offerCount':b.offs.length}},
 {'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':T.crumb,'item':SITE+url('balls',lang)},{'@type':'ListItem','position':3,'name':b.name,'item':U}]}]};
---
<Base lang={d.locale} title={`${b.name} | ${T.crumb} | WhichPadel`} description={intro} jsonld={jsonld} ogImage={img?SITE+img:undefined}>
<nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <a href={url('balls',lang)}>{T.crumb}</a> › <span>{b.name}</span></nav>
<div class="detail rp2 shoe ball">
<header class="rph"><p class="brand"><span>{bHref?<a href={bHref}>{b.brand}</a>:b.brand}</span><SaveHeart slug={b.slug} kind="b" off={u.save} on={u.saved}/></p><h1>{b.name}</h1>
<ul class="kchips">{[T.speeds[b.speed],b.tour&&T.tour[b.tour],b.eco&&T.eco,T.tube].filter(Boolean).map(c=><li>{c}</li>)}</ul></header>
{img&&<section class="rpg" aria-label={T.alt(b.name)}><div class="gtrack"><div class="gslide"><img src={img} alt={T.alt(b.name)} width="400" height="400" fetchpriority="high" decoding="sync"/></div></div></section>}
<aside class="panel buybox" id="buybox"><p class="price-big"><Price r={b} lang={lang}/> <small class="muted">({T.tube})</small></p><p class="muted small" id="pxstatic">{u.checkedOn(BALL_CHECKED)}</p>
<ul class="pxl" id="bxl" hidden></ul><div class="pxhist" id="pxhist" hidden></div><p class="pxnous" id="bxnous" hidden>{T.noUS}</p>
<a class="btn aff btn-lg" id="buymain" href={best0.u} rel="sponsored nofollow" data-affiliate="PLACEHOLDER" data-o={oj}>{T.buy.replace('{s}',BN)} →</a> <span class="disc">{u.ad}: {u.adNote} <a href={url('affiliate',lang)}>{u.disclosure}</a></span></aside>
<div class="rpbody">
<section class="panel"><p class="intro">{intro}</p></section>
<section class="panel"><h2>{T.specs}</h2><table class="spec"><tbody>{rows.map(([k,v])=><tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table></section>
{similar.length>0&&<section class="panel vs"><h2>{T.similar}</h2>{similar.map(x=><a href={url('ball',lang,x.slug)}><span>{x.name}</span><span>→</span></a>)}</section>}
</div></div>
<div class="stickycta" id="stickycta" aria-hidden="true"><button type="button" class="sp" id="stickyopen" tabindex="-1" aria-haspopup="dialog" aria-label={u.px.cmp.openS}><b><Price r={b} lang={lang}/><svg class="spchev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></b><span>{BN}</span></button><button type="button" class="btn" id="stickybuy" tabindex="-1" aria-haspopup="dialog">{u.px.cmp.showP}</button></div>
<script is:inline define:vars={{PS:'ball-'+b.slug,PX:u.px,SN,RATES:FX.rates,LG:lang,PB:T.perBall,BUY:T.buy,N:b.balls,RM:b.name,AD:u.ad,ADN:u.adNote,DISC:u.disclosure,DISCU:url('affiliate',lang)}}>
const okHost=location.hostname==='whichpadel.com'||location.hostname==='localhost'||location.hostname==='127.0.0.1'||/\.whichpadel\.pages\.dev$/.test(location.hostname)||/[?&]px=1/.test(location.search);
const pxOn=on=>{document.body.classList.toggle('px-live',!!on); document.dispatchEvent(new CustomEvent('px-live'));};
if(okHost){ window.__pxLive=1; fetch('/api/shoe-prices',{signal:AbortSignal.timeout?AbortSignal.timeout(5000):undefined}).then(x=>x.ok?x.json():null).then(j=>{const e=j&&j.r&&j.r[PS]; if(!e){pxOn(0); return;}
 const os=(Array.isArray(e.o)&&e.o.length?e.o:[e]).filter(o=>o.p>0&&/^https:\/\//.test(o.u));
 const esc=s=>String(s).replace(/[<>&"]/g,c=>'&#'+c.charCodeAt(0)+';');
 const C=PX.cmp, today=Date.parse(new Date().toISOString().slice(0,10));
 function render(){const W=window.WP||{currency:'GBP'}, cur=W.currency; const cv=(n,c)=>c===cur?n:n/RATES[c]*RATES[cur];
  const f=n=>{const v=n.toFixed(2), sy={GBP:'£',EUR:'€',USD:'$'}[cur]||''; return LG!=='en'?v.replace('.',',')+' '+sy:sy+v;};
  const fn=(n,c)=>{const v=Number.isInteger(n)?String(n):n.toFixed(2); const sy={GBP:'£',EUR:'€',USD:'$'}[c]; return c==='SEK'?v+' kr':LG!=='en'?v.replace('.',',')+' '+sy:sy+v;};
  const AX=(window.WP&&WP.approx)||'approx.'; const fb=o=>o.c===cur?fn(o.p,o.c):AX+' '+f(o.v);
  const rows=os.filter(o=>!W.shop||W.shop(o.d,o.c)!=='n').map(o=>({...o,v:cv(o.p,o.c),st:W.shop?W.shop(o.d,o.c):'u'})).sort((a,b)=>((a.s===0)-(b.s===0))||a.v-b.v);
  const L=document.getElementById('bxl'), M=document.getElementById('buymain'), NU=document.getElementById('bxnous');
  if(!rows.length){pxOn(0); if(W.strict&&W.strict()){NU.hidden=false; M.hidden=true; L.hidden=true;} return;}
  NU.hidden=true; M.hidden=true; pxOn(1); const sp=document.getElementById('pxstatic'); if(sp) sp.hidden=true;
  const href=o=>{const a=(SN[o.d]||[])[1]; return a?a.replace('{url}',encodeURIComponent(o.u)):o.u;};
  const sn=o=>esc((SN[o.d]||[o.n||o.d])[0]);
  const ag=t=>{if(!t) return ''; const n=Math.max(0,Math.round((today-Date.parse(t))/864e5)); return n===0?C.tdy:C.agoS.replace('{n}',n);};
  L.innerHTML=rows.map(o=>`<li class="pxr${o.s===0?' oos':''}"><span class="pxs"><b>${sn(o)}</b> <small>${f(o.v)} · ${f(o.v/N)} ${esc(PB)}</small></span> <a class="btn aff btn-sm" href="${esc(href(o))}" rel="sponsored nofollow" target="_blank">${esc(BUY.replace('{s}',''))}→</a></li>`).join(''); L.hidden=false;
  const row=(o,best)=>`<li class="pxr${best?' best':''}${o.s===0?' oos':''}${o.st!=='y'?' nc':''}"><span class="pxs"><b>${sn(o)}</b><small class="pxm">${best?`<span class="pxbd">${C.bestDeal}</span>`:''}<i class="dot${o.s===0?' no':''}" aria-label="${o.s===0?PX.oos:C.inStock}"></i>${o.s===0?PX.oos+' · ':''}<span class="pxag">${o.st!=='y'?`<span class="pxnc" title="${C.nc}" aria-label="${C.nc}">${C.ncS}</span>`:ag(o.t)}</span></small></span><span class="pxp">${fn(o.p,o.c)}<small class="pxcv">${o.c!==cur?AX+' '+f(o.v)+' · ':''}${f(o.v/N)} ${esc(PB)}</small></span><a class="btn pxb${best?' pri':''}" href="${esc(href(o))}" rel="sponsored nofollow" target="_blank" aria-label="${BUY.replace('{s}',sn(o))}">${C.buyS}</a></li>`;
  const b=rows[0]; const ul=`<ul class="pxl">${rows.map((o,i)=>row(o,i===0&&o.s!==0)).join('')}</ul>`;
  const S=document.getElementById('stickybuy'); if(S){const SP=document.querySelector('#stickycta .sp'); const FR={en:'from',es:'desde',fr:'dès',de:'ab',it:'da',pt:'desde'}[LG]||'from'; if(SP) SP.innerHTML=`<b><small>${FR}</small> ${fb(b)}<svg class="spchev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></b><span>${sn(b)}</span>`;}
  let D=document.getElementById('pxsheet'); if(!D){D=document.createElement('div'); D.id='pxsheet'; D.className='pxsheet'; D.hidden=true; document.body.appendChild(D);}
  const foot=`<div class="pxshist" id="pxshist" hidden></div><p class="disc">${esc(AD)}: ${esc(ADN)} <a href="${esc(DISCU)}">${esc(DISC)}</a></p>`;
  const cnt=rows.length===1?C.n1:C.nN.replace('{n}',rows.length);
  D.innerHTML=`<div class="pxsb" data-x></div><div class="pxsp" role="dialog" aria-modal="true" aria-labelledby="pxst" tabindex="-1"><div class="pxsg" aria-hidden="true"></div><div class="pxsh"><h2 id="pxst">${esc(RM)}</h2><button type="button" class="pxsx" data-x aria-label="${C.close}">✕</button></div><div class="pxsc"><p class="pxsub pxcnt">${cnt}</p>${ul}${foot}</div></div>`;
  sheetWire(D); hist(cv,f);}
 let opener=null;
 function sheetOpen(){const D=document.getElementById('pxsheet'); if(!D) return; opener=document.activeElement; D.hidden=false; document.documentElement.classList.add('pxlock'); requestAnimationFrame(()=>requestAnimationFrame(()=>D.classList.add('open'))); setTimeout(()=>D.querySelector('.pxsp').focus(),30);}
 function sheetClose(){const D=document.getElementById('pxsheet'); if(!D||D.hidden) return; D.classList.remove('open'); const p=D.querySelector('.pxsp'); p.style.transform=''; document.documentElement.classList.remove('pxlock');
  const rm=matchMedia('(prefers-reduced-motion: reduce)').matches; setTimeout(()=>{D.hidden=true;},rm?0:250); if(opener&&opener.focus) opener.focus();}
 function sheetWire(D){D.querySelectorAll('[data-x]').forEach(x=>x.onclick=sheetClose);
  const p=D.querySelector('.pxsp'), sc=D.querySelector('.pxsc'); let y0=null, dy=0;
  p.addEventListener('touchstart',e=>{if(sc.scrollTop>0&&sc.contains(e.target)){y0=null;return;} y0=e.touches[0].clientY; dy=0; p.style.transition='none';},{passive:true});
  p.addEventListener('touchmove',e=>{if(y0==null) return; dy=Math.max(0,e.touches[0].clientY-y0); p.style.transform=`translateY(${dy}px)`;},{passive:true});
  p.addEventListener('touchend',()=>{if(y0==null) return; p.style.transition=''; if(dy>80) sheetClose(); else p.style.transform=''; y0=null;});}
 document.addEventListener('keydown',e=>{const D=document.getElementById('pxsheet'); if(!D||D.hidden) return; if(e.key==='Escape'){e.preventDefault(); sheetClose(); return;}
  if(e.key==='Tab'){const F=[...D.querySelectorAll('a[href],button:not([hidden])')].filter(x=>x.offsetParent!==null); if(!F.length) return; const a=F[0], z=F[F.length-1];
   if(e.shiftKey&&(document.activeElement===a||document.activeElement===D.querySelector('.pxsp'))){e.preventDefault(); z.focus();} else if(!e.shiftKey&&document.activeElement===z){e.preventDefault(); a.focus();}}});
 const SC=document.getElementById('stickycta'); if(SC) SC.addEventListener('click',()=>sheetOpen());
 let HD=90; const H=Array.isArray(e.h)?e.h.filter(x=>x&&x[1]>0):[];
 function hist(cv,f){const B=document.getElementById('pxhist'),S=document.getElementById('pxshist'); if(!H.length) return;
  const dd=new Set(H.map(x=>x[0])).size; if(dd<3){if(S){S.hidden=true;S.innerHTML='';} if(!B) return; const Lng=document.documentElement.lang||'en'; let d=H[0][0]; try{d=new Date(d+'T12:00:00Z').toLocaleDateString(Lng,{day:'numeric',month:'short'});}catch(_){} B.innerHTML=`<p class="pxsince">${C.since.replace('{d}',d)}</p>`; B.hidden=false; return;}
  const cut=new Date(Date.now()-HD*864e5).toISOString().slice(0,10); const pts=H.filter(x=>x[0]>=cut).map(x=>[x[0],cv(x[1],e.c)]); if(!pts.length) return;
  const vs=pts.map(p=>p[1]), lo=Math.min(...vs), hi=Math.max(...vs), rg=(hi-lo)||1, n=pts.length;
  const xy=pts.map((p,i)=>[(n===1?150:i/(n-1)*300).toFixed(1),(58-(p[1]-lo)/rg*52).toFixed(1)]);
  const svg=`<svg viewBox="0 0 300 64" preserveAspectRatio="none" role="img" aria-label="${C.hist}"><polyline fill="none" stroke="#13795c" stroke-width="2" vector-effect="non-scaling-stroke" points="${xy.map(p=>p.join(',')).join(' ')}"/>${n<4?xy.map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="3" fill="#13795c"/>`).join(''):''}</svg>`;
  const note=H.length<7&&HD===90?C.since.replace('{d}',H[0][0]):C.lowN.replace('{n}',HD).replace('{p}',f(lo));
  const html=`${svg}<p class="muted small">${note}</p>`;
  if(B){B.innerHTML=html; B.hidden=false;} if(S){S.innerHTML=html; S.hidden=false;}}
 render(); document.addEventListener('wp:region',render); window.wpApply&&window.wpApply();}).catch(()=>pxOn(0)); }
</script>
<script is:inline>
document.body.classList.add('has-sticky');
const sc=document.getElementById('stickycta'),bb=document.getElementById('buybox'),mq=matchMedia('(max-width:899px)');
if(mq.matches&&window.__pxLive) document.body.classList.add('px-live');
let io;
function syncBar(){
 const live=mq.matches&&document.body.classList.contains('px-live');
 if(live){if(io){io.disconnect();io=null;} sc.classList.add('show'); sc.setAttribute('aria-hidden','false'); sc.querySelectorAll('button').forEach(b=>b.tabIndex=0); return;}
 if(!mq.matches){if(io){io.disconnect();io=null;} sc.classList.remove('show'); sc.setAttribute('aria-hidden','true'); sc.querySelectorAll('button').forEach(b=>b.tabIndex=-1); return;}
 sc.classList.remove('show'); sc.setAttribute('aria-hidden','true'); sc.querySelectorAll('button').forEach(b=>b.tabIndex=-1);
 if(!io&&bb){io=new IntersectionObserver(([e])=>{if(document.body.classList.contains('px-live')) return; const show=!e.isIntersecting; sc.classList.toggle('show',show); sc.setAttribute('aria-hidden',show?'false':'true'); sc.querySelectorAll('button').forEach(b=>b.tabIndex=show?0:-1);}); io.observe(bb);}
}
syncBar(); mq.addEventListener('change',syncBar); document.addEventListener('px-live',syncBar);
</script>
</Base>
