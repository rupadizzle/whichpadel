---
// Shoe money pages (best, men's, women's, junior, clay, omni, wide, cheap, under X) and brand pages: ranked list + method + FAQ.
import Base from '../layouts/Base.astro'; import '../styles/hub.css'; import ShoeCard from '../components/ShoeCard.astro';
import { shoes, rankShoes, SHOE_LISTS, SHOE_LIST_KEYS, shoeBrands, UNDER, listCur } from '../lib/shoes.js'; import { bud } from '../lib/money.js';
import { SHOE } from '../i18n/shoes.js'; import { D, url, SITE } from '../i18n/index.js';
const { k, b, lang } = Astro.props; const d=D(lang), u=d.ui, T=SHOE[lang];
const list=k==='brand'?rankShoes(shoes.filter(s=>s.brand===b.name),lang):SHOE_LISTS[k](lang);
const amt=UNDER[k]?bud(UNDER[k],listCur(lang)):null;
const L=T.lists[k]; const h1=k==='brand'?L[0](b.name):amt?L[0](amt):L[0]; const intro=k==='brand'?L[1](b.name,list.length):amt?L[1](amt):L[1];
const U=SITE+(k==='brand'?url('shoeBrand',lang,b.slug):url('shoeList',lang,k));
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'ItemList','name':h1,'url':U,'numberOfItems':list.length,'itemListElement':list.map((s,i)=>({'@type':'ListItem','position':i+1,'url':SITE+url('shoe',lang,s.slug),'name':s.name}))},
 {'@type':'FAQPage','mainEntity':T.faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))},
 {'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':T.crumb,'item':SITE+url('shoes',lang)},{'@type':'ListItem','position':3,'name':h1,'item':U}]}]};
const others=SHOE_LIST_KEYS.filter(x=>x!==k&&!x.startsWith('u'));
---
<Base lang={d.locale} title={T.t(h1,list.length)} description={intro} jsonld={jsonld}>
<section class="phero" slot="hero"><div class="wrap"><nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <a href={url('shoes',lang)}>{T.crumb}</a> › <span>{h1}</span></nav><h1>{h1}</h1><div class="seo"><p>{intro}</p><p>{T.method}</p></div></div></section>
<div class="hub">
<ul class="hub-grid">{list.map((s,i)=><ShoeCard s={s} lang={lang} rank={i+1} eager={i<4}/>)}</ul>
<p><a class="btn btn-line" href={url('shoes',lang)}>{T.hubLink}</a></p>
<section class="panel"><h2 class="h3">{T.faqH}</h2>{T.faq.map(([q,a])=><details><summary><b>{q}</b></summary><p>{a}</p></details>)}</section>
<section class="hub-pre"><h2 class="h3">{T.guides}</h2><p>{others.map(x=><a href={url('shoeList',lang,x)}>{T.lists[x][0]}</a>)}</p><p><b>{T.byBrand}</b>{shoeBrands.map(x=><a href={url('shoeBrand',lang,x.slug)}>{x.name}</a>)}</p></section>
</div>
</Base>
