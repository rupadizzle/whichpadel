---
import Base from '../layouts/Base.astro';
import { shoes, shoeImg } from '../lib/shoes.js'; import { D, url } from '../i18n/index.js'; import { SHOPS } from '../lib/price.js';
import { TOOL } from '../i18n/tools.js';
const { lang } = Astro.props;
const T = TOOL.describeShoes[lang];
const AFF=Object.fromEntries(Object.entries(SHOPS).flatMap(([k,v])=>typeof v.affiliate==='string'&&v.affiliate.startsWith('https://')?[[k,v.affiliate]]:[]));
const SH=shoes.map(s=>({s:s.slug,n:s.name,b:s.brand,g:s.gender,y:s.year||0,so:s.sole,cu:s.cushion,wd:!!s.wide,w:s.weight,i:shoeImg(s),u:url('shoe',lang,s.slug),o:(s.offs||[]).map(o=>({d:o.d,p:o.p,c:o.c,u:o.u,s:o.s}))}));
const FINDER=url('finder',lang);
const describeHref=url('describe',lang);
const kitHref=url('myKit',lang);
const locale=D(lang).locale;
---
<Base lang={locale} title={T.title+' | WhichPadel'} description={T.desc}>
<article class="panel prose"><h1>{T.h1}</h1>
<p>{T.lead}</p>
<p class="muted small">{T.racketLink} <a href={describeHref}>{T.racketCta}</a>.</p>
<label for="dg-t"><b data-lab>{T.label}</b></label>
<textarea id="dg-t" rows="5" style="width:100%;box-sizing:border-box;font:inherit;padding:10px;border-radius:10px;border:1px solid #cdd6db" placeholder={T.ph}></textarea>
<p><button type="button" class="btn" id="dg-go">{T.go}</button> <button type="button" class="btn btn-line" id="dg-mic" hidden>{T.speak}</button> <small class="muted" id="dg-ms"></small></p>
</article>
<section class="panel" id="dg-read" hidden><h2 class="h3">{T.understood}</h2><ul id="dg-chips"></ul><p class="muted small">{T.notRight}</p></section>
<section class="panel" id="dg-out" hidden></section>
<p class="muted small" style="margin:12px 4px">{T.foot}<a href={kitHref}>{T.kit}</a>{T.kitEnd}</p>
<script is:inline src="/describe-parse.js"></script>
<script is:inline define:vars={{SH,FINDER,AFF,T,locale}}>
const $=id=>document.getElementById(id), esc=s=>String(s).replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
const {parse,racket}=window.DG;
const cushion=s=>(s.cu||[]).some(c=>/gel|boost|wave|flytefoam|ff blast|bounce|dynawall/.test(c));
function shoeRank({A}){const knee=A.injury.some(x=>/knee|heel|plantar|back|achilles|shin|ankle/.test(x));
 const live=window.__shoeLive||{};
 const P=s=>{const e=live[s.s]; const os=(e&&e.o&&e.o.length?e.o:s.o).filter(o=>o.p>0&&o.s!==0); if(!os.length) return null; const g=o=>o.c==='GBP'?o.p:o.c==='EUR'?o.p*0.84:o.c==='USD'?o.p*0.75:o.p/13; return os.map(o=>({...o,g:g(o)})).sort((a,b)=>a.g-b.g)[0];};
 return SH.map(s=>{const b=P(s); if(!b) return null; if(A.money&&b.g>A.money) return null; if(A.gender&&s.g!==A.gender&&s.g!=='u') return null; if(s.g==='k') return null;
  let sc=0; const r=[];
  if(A.surface==='clay'){ if(s.so.includes('clay')||s.so.includes('omni')){sc+=6; r.push('Clay/omni sole grips on sandy artificial grass');} else if(s.so.includes('herringbone')){sc+=3; r.push('Herringbone sole: good all-round grip');} }
  else if(A.surface==='hard'){ if(s.so.includes('allcourt')||s.so.includes('herringbone')){sc+=5; r.push('Herringbone/all-court sole suits indoor courts');} }
  else if(s.so.includes('herringbone')){sc+=2; r.push('Herringbone sole: works on most courts');}
  if(knee&&cushion(s)){sc+=5; r.push('Extra cushioning ('+s.cu.join(', ')+') for '+A.injury.join('/'));}
  if(A.wide&&s.wd){sc+=6; r.push('Wide fit');}
  if(A.light&&s.w&&s.w<=360){sc+=3; r.push('Light: '+s.w+' g');}
  if(A.dur&&s.so.includes('clay')){sc+=1;}
  sc+=(s.y>=2026?3:s.y>=2025?1:0); if(A.money) sc+=b.g/A.money*3;
  if(!r.length) r.push('Good match for your budget');
  return {s,b,sc,r};}).filter(Boolean).sort((a,b)=>b.sc-a.sc).slice(0,6);}
const F=(p,c)=>{try{return new Intl.NumberFormat(locale,{style:'currency',currency:c,maximumFractionDigits:p%1?2:0}).format(p)}catch(e){return p+' '+c}};
const shopGo=o=>{const a=AFF[o.d]; if(a) return a.replace('{url}',encodeURIComponent(o.u)); try{const u=new URL(o.u); if(!u.searchParams.has('utm_source')){u.searchParams.set('utm_source','whichpadel'); u.searchParams.set('utm_medium','referral');} return u.toString();}catch(e){return o.u;}};
async function go(){const raw=$('dg-t').value.trim(); if(raw.length<8){$('dg-t').focus(); return;}
 const P=parse(raw); $('dg-chips').innerHTML=P.why.map(w=>`<li>${esc(w)}</li>`).join(''); $('dg-read').hidden=false; const O=$('dg-out'); O.hidden=false;
 if(!window.__shoeLive){try{const j=await (await fetch('/api/shoe-prices')).json(); window.__shoeLive=j&&j.r||{};}catch(e){window.__shoeLive={};}}
 const L=shoeRank(P); O.innerHTML=`<h2 class="h3">${esc(T.matches)}</h2>`+(L.length?`<ol class="dl" style="list-style:none;padding:0">${L.map(x=>`<li style="display:flex;gap:12px;align-items:center;padding:10px 0;border-top:1px solid #e8edf0">${x.s.i?`<img src="${esc(x.s.i)}" alt="" width="64" height="64" loading="lazy" style="object-fit:contain">`:''}<span><a href="${esc(x.s.u)}"><b>${esc(x.s.n)}</b></a><small style="display:block">${x.r.map(esc).join(' · ')}</small><small style="display:block">From ${F(x.b.p,x.b.c)} at ${esc(x.b.d)} · <a href="${esc(shopGo(x.b))}" rel="sponsored nofollow" target="_blank">Shop</a> · <a href="${esc(x.s.u)}">All prices</a></small></span></li>`).join('')}</ol>`:`<p>${esc(T.none)}</p>`);
 O.scrollIntoView({behavior:'smooth',block:'start'});}
$('dg-go').onclick=go;
const preset=new URLSearchParams(location.search).get('q');
if(preset){$('dg-t').value=preset; if(preset.trim().length>=8) go();}
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
if(SR){const b=$('dg-mic'); b.hidden=false; let rec=null; b.onclick=()=>{if(rec){rec.stop();return;} rec=new SR(); rec.lang=T.speechLang; rec.interimResults=false; rec.continuous=true; const base=$('dg-t').value; let txt='';
 rec.onresult=e=>{for(let i=e.resultIndex;i<e.results.length;i++) if(e.results[i].isFinal) txt+=e.results[i][0].transcript+' '; $('dg-t').value=(base?base+' ':'')+txt;};
 rec.onend=()=>{rec=null; b.textContent=T.speak; $('dg-ms').textContent='';}; rec.onerror=e=>{$('dg-ms').textContent='Microphone: '+e.error;};
 rec.start(); b.textContent=T.stop; $('dg-ms').textContent=T.listening;};}
</script>
</Base>
