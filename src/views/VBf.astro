---
import '../styles/bf.css';
import Base from '../layouts/Base.astro';
import Byline from '../components/Byline.astro';
import NewsL from '../components/NewsL.astro';
import { D, url, SITE } from '../i18n/index.js';

const { lang } = Astro.props;
const d = D(lang), u = d.ui, C = d.copy.bf;
const h1plain = C.h1.replace(/<[^>]+>/g, '');
const END = Date.parse('2026-11-27T00:00:00Z');
const left = Math.max(0, END - Date.now());
const parts = [Math.floor(left / 864e5), Math.floor(left / 36e5) % 24, Math.floor(left / 6e4) % 60, Math.floor(left / 1e3) % 60];
const jsonld = {'@context':'https://schema.org','@type':'FAQPage','mainEntity':C.faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))};
---
<Base lang={d.locale} newsletter={false} title={C.title+d.copy.titleSuffix} description={C.desc} jsonld={jsonld}>
<section class="bf-hero" slot="hero"><div class="wrap">
<div class="bf-top">
<p class="bf-kicker">{C.kicker}</p>
<div class="bf-copy">
<h1 set:html={C.h1}/>
<p class="bf-lead">{C.lead}</p>
</div>
<div id="bf-mail"><NewsL lang={lang} src="blackfriday" bare consent={C.consent} button={C.button}/></div>
</div>
<p class="bf-count" data-bf-count>{parts.map((n,i)=><span><b>{i ? String(n).padStart(2,'0') : n}</b><i>{C.units[i]}</i></span>)}</p>
</div></section>

<section class="bf-points"><h2>{C.pointsH}</h2><div class="bf-point-row">{C.points.map(([h,p])=><div class="bf-tip"><h3>{h}</h3><p>{p}</p></div>)}</div></section>
<section class="bf-quiet"><h2>{u.faq}</h2>{C.faq.map(([q,a])=><div class="faq"><h3>{q}</h3><p>{a}</p></div>)}</section>
{C.now && <p class="bf-more"><a href="/deals/">{C.now}</a></p>}
<Byline lang={lang} headline={h1plain} pageUrl={SITE+url('bf',lang)}/>
<script is:inline>
(()=>{
  const root=document.querySelector('[data-bf-count]');
  if(!root) return;
  const bits=[...root.querySelectorAll(':scope > span > b')];
  const end=Date.parse('2026-11-27T00:00:00Z');
  const tick=()=>{const left=Math.max(0,end-Date.now()); const v=[Math.floor(left/864e5),Math.floor(left/36e5)%24,Math.floor(left/6e4)%60,Math.floor(left/1e3)%60]; bits.forEach((b,i)=>{b.textContent=i?String(v[i]).padStart(2,'0'):String(v[i]);});};
  tick();
  setInterval(tick, matchMedia('(prefers-reduced-motion: reduce)').matches?60000:1000);
})();
</script>
</Base>
