---
// Index pages: best-list index, year index, player index. One hero, one link list, optional preview rows.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinderCard from '../components/FinderCard.astro';
import RkCard from '../components/RkCard.astro';
import { rackets } from '../lib/data.js';
import { kitPlayers as players } from '../lib/player-kit.js';
import { D, url, SITE } from '../i18n/index.js';
import { BEST_KEYS } from '../i18n/routes.js';
import { pickL } from '../i18n/lists.js';
import { YEARS, YC, ofYear, FCARD } from '../lib/years.js';
const { kind, lang } = Astro.props;
const d = D(lang), u = d.ui;
const page = (() => {
  if (kind === 'best') {
    const B = d.copy.best;
    const L = BEST_KEYS.map(k => ({ k, t: B.titles[k], rs: pickL(k, lang).slice(0, 3) }));
    return {
      title: B.indexTitle + d.copy.titleSuffix, description: B.indexDesc(rackets.length), h1: B.indexH1,
      pageUrl: SITE + url('bestIndex', lang), lead: B.indexLead(rackets.length),
      crumbs: [{ href: url('home', lang), label: u.home }, { label: u.bestLists }],
      jsonld: { '@context': 'https://schema.org', '@type': 'ItemList', name: B.indexH1, itemListElement: L.map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + url('best', lang, l.k), name: l.t[0] })) },
      links: [...L.map(l => ({ href: url('best', lang, l.k), label: l.t[0], meta: '→' })), { href: url('years', lang), label: YC[lang].hub, meta: '→' }],
      rows: L.slice(0, 4).map(l => ({ title: l.t[0], href: url('best', lang, l.k), rs: l.rs })),
    };
  }
  if (kind === 'years') {
    const C = YC[lang];
    const L = YEARS.map(y => ({ y, rs: ofYear(y) }));
    const n = L.reduce((a, l) => a + l.rs.length, 0);
    return {
      title: C.hubT + d.copy.titleSuffix, description: C.hubD(n), h1: C.hub,
      pageUrl: SITE + url('years', lang), lead: C.hubL,
      crumbs: [{ href: url('home', lang), label: u.home }, { label: C.hub }],
      jsonld: { '@context': 'https://schema.org', '@type': 'ItemList', name: C.hub, itemListElement: L.map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + url('year', lang, l.y), name: C.h(l.y) })) },
      links: L.map(l => ({ href: url('year', lang, l.y), label: C.h(l.y), meta: `${C.count(l.rs.length)} →` })),
      rows: L.filter(l => l.rs.length >= 3).map(l => ({ title: C.h(l.y), href: url('year', lang, l.y), rs: l.rs.slice(0, 3) })),
      finder: FCARD[lang],
    };
  }
  const C = d.copy.players;
  const n = players.reduce((a, p) => a + p.rackets.length, 0);
  const shoeN = players.reduce((a, p) => a + p.shoes.length, 0);
  const bagN = url('bags', lang) ? players.reduce((a, p) => a + p.bags.length, 0) : 0;
  const meta = p => [C.count(p.rackets.length).replace(/\s*→\s*$/, ''), p.shoes.length ? C.shoesN(p.shoes.length) : '', url('bags', lang) && p.bags.length ? C.bagsN(p.bags.length) : ''].filter(Boolean).join(' · ') + ' →';
  return {
    title: C.title(players.length, n) + d.copy.titleSuffix, description: C.desc(players.length, n), h1: C.h1,
    pageUrl: SITE + url('players', lang), lead: C.lead(n, rackets.length) + (shoeN || bagN ? ' ' + C.gear(shoeN, bagN) : ''),
    crumbs: [{ href: url('home', lang), label: u.home }, { label: u.players }],
    jsonld: { '@context': 'https://schema.org', '@type': 'ItemList', name: C.h1, url: SITE + url('players', lang), numberOfItems: players.length, itemListElement: players.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + url('player', lang, p.slug), name: p.name })) },
    links: players.map(p => ({ href: url('player', lang, p.slug), label: p.name, meta: meta(p), metaClass: 'muted small' })),
    rows: [],
  };
})();
---
<Base lang={d.locale} title={page.title} description={page.description} jsonld={page.jsonld}>
<PageHero slot="hero" lang={lang} label={u.breadcrumb} crumbs={page.crumbs} h1={page.h1} pageUrl={page.pageUrl} lead={page.lead}/>
<section class="panel vs">{page.links.map(l => <a href={l.href}><span>{l.label}</span>{l.metaClass ? <span class={l.metaClass}>{l.meta}</span> : <span>{l.meta}</span>}</a>)}</section>
{page.rows.map(l => <section class="hrow-wrap"><div class="hrow-head"><h2 class="h3">{l.title}</h2><a href={l.href}>{u.seeAll}</a></div><div class="hub cat rk-rows rk-best"><ul class="hub-grid">{l.rs.map((r, i) => <RkCard r={r} rank={i + 1} lang={lang} keys={['power','control','forgiveness']}/>)}</ul></div></section>)}
{page.finder && <FinderCard fc={page.finder} href={url('finder', lang)}/>}
</Base>
