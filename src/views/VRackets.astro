---
// /rackets/ hub: the full racket database as a focused comparison tool. Static pages 1..N (crawlable), client-side filters/sort with state in the URL.
// Filtered URLs (?brand=…) are never separate pages: they keep the canonical of /rackets/; the indexable presets are the existing brand, year and shape pages.
import Base from '../layouts/Base.astro'; import '../styles/hub.css'; import RacketIcon from '../components/RacketIcon.astro';
import { allRackets as rackets, brandList } from '../lib/data.js'; import { D, url, SITE } from '../i18n/index.js'; import { SHAPE_KEYS } from '../i18n/routes.js';
import { pick, fmt, DEFAULT_REGION } from '../lib/price.js'; import { HUB } from '../i18n/hub.js'; import { PER, hubOrder, hubPages, wtN } from '../lib/hub.js';
const { p=1, lang } = Astro.props; const d=D(lang), u=d.ui, H=HUB[lang], t=d.terms; const N=rackets.length; const P=hubPages();
const order=hubOrder(); const rs=order.slice((p-1)*PER,p*PER);
const topB=[...brandList].sort((a,b)=>b.count-a.count).slice(0,10);
const brandPick=[...brandList].sort((a,b)=>b.count-a.count||a.name.localeCompare(b.name));
const years=[...new Set(rackets.map(r=>r.year).filter(Boolean))].sort((a,b)=>b-a);
const reg=DEFAULT_REGION(lang);
const AUD=['unisex','men','women','junior']; const audN=Object.fromEntries(AUD.map(k=>[k,rackets.filter(r=>r.audience===k).length]));
const audL=k=>H.auds[['men','women','junior','unisex'].indexOf(k)];
const priceTxt=r=>{const q=pick(r,reg); return q.none?H.none:H.fromP.replace('{p}',fmt(q.v,q.cur,lang));};
const escRe=s=>String(s).replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
const shortM=r=>{let s=r.model||''; if(r.brand) s=s.replace(new RegExp('^'+escRe(r.brand)+'\\s+','i'),''); if(r.year) s=s.replace(new RegExp('\\s+'+r.year+'\\s*$'),''); return s.trim()||r.model;};
const spec=r=>[r.audience!=='unisex'&&audL(r.audience),r.shape&&t.shapeCap[r.shape],r.weightMin&&`${r.weightMin}${r.weightMax&&r.weightMax!==r.weightMin?'–'+r.weightMax:''}\u00a0g`].filter(Boolean).join(' · ');
const pu=i=>url('rackets',lang,i); const U=SITE+pu(p);
const title=p>1?`${H.h1(N)} · ${H.pageL} ${p} | WhichPadel`:H.title(N);
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'CollectionPage','name':H.h1(N),'url':U,'description':H.desc(N)},{'@type':'ItemList','name':H.h1(N),'numberOfItems':N,'itemListOrder':'https://schema.org/ItemListUnordered','itemListElement':rs.map((r,i)=>({'@type':'ListItem','position':(p-1)*PER+i+1,'url':SITE+url('racket',lang,r.slug),'name':r.model}))},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':H.crumb,'item':SITE+pu(1)}]}]};
const HT={...H,title:null,h1:null,desc:null,all:null,shapeCap:t.shapeCap,rk:url('racket',lang,'X').replace(/X\/$/,''),cmp:url('compare',lang),save:u.save,saved:u.saved,brands:Object.fromEntries(brandList.map(b=>[b.slug,b.name])),PER,P,p,base:pu(1),pfx:pu(2).replace(/2\/$/,''),lang,order:order.map(r=>r.slug)};
const hasNext=p<P; const PAGES=Array.from({length:P},(_,i)=>i+1);
const chip=(vals,labels)=>vals.map((v,i)=>[v,labels[i]]);
const groupsA=[['shape',H.shape,chip(['round','teardrop','diamond','hybrid'],H.shapes)],['bal',H.balance,chip(['low','medium','high'],H.lmh)],['wt',H.weight,chip(['l','m','h'],H.wts)],['hard',H.hard,chip(['soft','medium','hard'],H.smh)],['level',H.level,chip(['b','i','a'],H.lvls)]];
const G=Object.fromEntries(groupsA.map(g=>[g[0],g])); const main=[G.shape,G.level]; const adv=[G.bal,G.wt,G.hard];
---
<Base lang={d.locale} title={title} description={p>1?`${H.desc(N)} ${H.pageL} ${p}/${P}.`:H.desc(N)} jsonld={jsonld}>
<nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <span>{H.crumb}</span></nav>
<div class="hub cat" id="hub" data-p={p}>
<header class="hub-hd"><h1>{H.h1(N)}</h1><p>{H.intro}</p></header>
<div class="hub-bar">
<div class="hub-tb">
 <label class="hub-q"><span class="sr">{H.search}</span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="h-q" type="search" placeholder={H.searchPh} autocomplete="off"/></label>
 <button type="button" class="hub-fo" id="h-open" aria-controls="h-f" aria-expanded="false"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M7 12h10M10 18h4"/></svg>{H.filters}<span id="h-fn" class="hub-n"></span></button>
 <label class="hub-so"><span class="sr">{H.sort}</span><select id="h-sort2">{['pop','price','hi','new','old','best'].map((k,i)=><option value={k}>{H.sorts[i]}</option>)}</select></label>
</div>
</div>
<div class="hub-ac" id="h-ac" aria-label={H.activeF} hidden></div>
<div class="hub-l">
<div class="hub-shade" id="h-shade" hidden></div>
<aside class="hub-f" id="h-f" aria-label={H.filters}>
 <div class="hub-fh"><h2>{H.filters}</h2><button type="button" class="x" id="h-x" aria-label={H.close}>✕</button></div>
 <div class="hub-fb">
  <label class="hub-bq hub-mq"><span class="sr">{H.search}</span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="h-q2" type="search" placeholder={H.searchPh} autocomplete="off"/></label>
  <fieldset class="hub-g"><legend>{H.aud}</legend><div class="hub-chips">{AUD.map(k=><label><input type="checkbox" name="h-aud" value={k}/><span>{audL(k)} <small>{audN[k]}</small></span></label>)}</div></fieldset>
  {main.map(g=><fieldset class="hub-g"><legend>{g[1]}</legend><div class="hub-chips">{g[2].map(o=><label><input type="checkbox" name={'h-'+g[0]} value={o[0]}/><span>{o[1]}</span></label>)}</div></fieldset>)}
  <fieldset class="hub-g"><legend>{H.price}</legend><div class="hub-pr"><label><span class="sr">{H.min}</span><input id="h-min" type="number" min="0" inputmode="numeric" placeholder={H.min}/></label><span aria-hidden="true">–</span><label><span class="sr">{H.max}</span><input id="h-max" type="number" min="0" inputmode="numeric" placeholder={H.max}/></label></div></fieldset>
  <label class="hub-tg"><input type="checkbox" id="h-stock"/><span><b>{H.stock}</b><small>{H.stockS}</small></span></label>
  <details class="hub-adv" id="h-adv"><summary>{H.moreF}</summary><div class="hub-advb">
   <fieldset class="hub-g hub-brands"><legend>{H.brand}</legend><label class="hub-bq"><span class="sr">{H.brandPh}</span><input id="h-bq" type="search" placeholder={H.brandPh} autocomplete="off"/></label><div class="hub-chips">{brandPick.map((b,i)=><label hidden={i>=8}><input type="checkbox" name="h-brand" value={b.slug}/><span>{b.name}</span></label>)}</div><p class="hub-bnone" id="h-bnone" hidden>{H.brandNone}</p>{brandPick.length>8&&<button type="button" class="hub-bmore" id="h-bmore" data-t={H.moreB}>{H.moreB.replace('§',String(brandPick.length-8))}</button>}</fieldset>
   <fieldset class="hub-g"><legend>{H.year}</legend><div class="hub-chips">{years.map(y=><label><input type="checkbox" name="h-year" value={y}/><span>{y}</span></label>)}</div></fieldset>
   {adv.map(g=><fieldset class="hub-g"><legend>{g[1]}</legend><div class="hub-chips">{g[2].map(o=><label><input type="checkbox" name={'h-'+g[0]} value={o[0]}/><span>{o[1]}</span></label>)}</div></fieldset>)}
  </div></details>
 </div>
 <div class="hub-ff"><button type="button" class="btn btn-line" id="h-clear">{H.clr}</button><button type="button" class="btn btn-accent" id="h-apply">{H.apply.replace('§',String(N))}</button></div>
</aside>
<section class="hub-main">
 <div class="hub-head"><p class="hub-cnt"><b id="h-count" aria-live="polite">{H.results.replace('§',String(N))}</b></p><label class="hub-sort"><span class="sr">{H.sort}</span><select id="h-sort">{['pop','price','hi','new','old','best'].map((k,i)=><option value={k} selected={k==='pop'}>{H.sorts[i]}</option>)}</select></label></div>
 <ul class="hub-grid" id="h-grid">{rs.map((r,i)=><li class="rk" data-s={r.slug}><a class="rk-a" href={url('racket',lang,r.slug)}><span class="rk-i">{r.image?<img src={r.image} alt={`${r.model} ${H.alt}`} width="96" height="112" loading={i<4?'eager':'lazy'} decoding="async"/>:<RacketIcon shape={r.shape||'hybrid'} size={48}/>}</span><span class="rk-t"><span class="rk-b">{[r.brand,r.year].filter(Boolean).join(' · ')}</span><span class="rk-m">{shortM(r)}</span><span class="rk-c">{spec(r)}</span><span class="rk-p"><span class="pz rk-pv">{priceTxt(r)}</span></span></span></a><button type="button" class="savebtn save-heart" data-save={r.slug} data-off={u.save} data-on={u.saved} aria-pressed="false" aria-label={u.save}><svg class="heart" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></button><label class="rk-x" title={H.compare}><input type="checkbox" class="rk-cb" value={r.slug}/><span><span class="sr">{H.compare}: {r.model}</span></span></label></li>)}</ul>
 <p class="hub-empty" id="h-empty" hidden>{H.empty} <button type="button" class="btn btn-sm btn-line" id="h-clear2">{H.clear}</button></p>
 <nav class="hub-pg" id="h-pg" aria-label={H.pageL}>
  {hasNext?<a class="btn btn-line hub-more" id="h-more" rel="next" href={pu(p+1)}>{H.more}</a>:<a class="btn btn-line hub-more" id="h-more" href={pu(1)} hidden>{H.more}</a>}
  <ol>{PAGES.map(i=><li><a href={pu(i)} aria-current={i===p?'page':undefined}>{i}</a></li>)}</ol>
 </nav>
 <section class="hub-pre"><h2 class="h3">{H.presets}</h2>
  <p><b>{H.byBrand}</b>{topB.map(b=><a href={url('brand',lang,b.slug)}>{b.name}</a>)}<a href={url('brands',lang)}>{u.brands} →</a></p>
  <p><b>{H.byYear}</b>{years.map(y=><a href={url('year',lang,y)}>{y}</a>)}</p>
  <p><b>{H.byShape}</b>{SHAPE_KEYS.map((k,i)=><a href={url('best',lang,k)}>{H.shapes[i]}</a>)}</p>
 </section>
</section>
</div>
<div class="hub-tray" id="h-tray" hidden><ul id="h-sel"></ul><button type="button" class="btn btn-accent" id="h-go" disabled>{H.cmpGo} <span id="h-seln"></span></button></div>
{['round','teardrop','diamond','hybrid'].map(sh=><template id={`hic-${sh}`}><RacketIcon shape={sh} size={48}/></template>)}
</div>

<script type="application/json" id="h-data" set:html={JSON.stringify(HT).replace(/</g,'\\u003c')}></script>
<script is:inline>
(()=>{const T=JSON.parse(document.getElementById('h-data').textContent);const $=id=>document.getElementById(id), hub=$('hub'), grid=$('h-grid'); let all=null, view=[], shown=0; const sel=[];
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const parts=v=>String(v||'').split(',').map(s=>s.trim()).filter(Boolean);
const rv=n=>[...document.querySelectorAll(`input[name="h-${n}"]:checked`)].map(i=>i.value).filter(Boolean).join(',');
const setR=(n,v)=>{const want=new Set(parts(v)); const boxes=[...document.querySelectorAll(`input[name="h-${n}"]`)]; boxes.forEach(i=>{if(i.value) i.checked=want.has(i.value);}); const all=boxes.find(i=>!i.value); if(all) all.checked=!boxes.some(i=>i.value&&i.checked);};
function paintBrands(){const box=document.querySelector('.hub-brands .hub-chips'); if(!box) return; const q=($('h-bq').value||'').trim().toLowerCase(), open=box.dataset.open==='1', labs=[...box.querySelectorAll('label')]; let n=0, hide=0; labs.forEach((lab,i)=>{const name=(lab.textContent||'').trim().toLowerCase(), on=lab.querySelector('input').checked, match=!q||name.includes(q), keep=on||(match&&(!!q||open||i<8)); lab.hidden=!keep; if(keep) n++; else if(!q) hide++;}); const more=$('h-bmore'); if(more){more.hidden=!!q||open||!hide; if(!more.hidden) more.textContent=more.dataset.t.replace('§',hide);} const none=$('h-bnone'); if(none) none.hidden=n>0;}
const syncAll=box=>{const seg=box.closest('.hub-seg')||box.closest('.hub-g'); if(!seg) return; const boxes=[...seg.querySelectorAll('input[type="checkbox"]')]; const all=boxes.find(i=>!i.value); const rest=boxes.filter(i=>i.value); if(!all) return; if(!box.value){rest.forEach(i=>i.checked=false); all.checked=true;} else all.checked=!rest.some(i=>i.checked);};
const KEYS=['q','aud','brand','year','shape','bal','wt','hard','level','min','max','stock','sort'];
let qv='';
const setQ=v=>{qv=v; if($('h-q').value!==v)$('h-q').value=v; if($('h-q2').value!==v)$('h-q2').value=v;};
const get=()=>({q:qv.trim(),aud:rv('aud'),brand:rv('brand'),year:rv('year'),shape:rv('shape'),bal:rv('bal'),wt:rv('wt'),hard:rv('hard'),level:rv('level'),min:$('h-min').value,max:$('h-max').value,stock:$('h-stock').checked?'1':'',sort:$('h-sort').value==='pop'?'':$('h-sort').value});
const put=s=>{setQ((s.q||'').trim());setR('brand',parts(s.brand).filter(v=>T.brands[v]).join(','));setR('year',s.year||'');['aud','shape','bal','wt','hard','level'].forEach(k=>setR(k,s[k]||''));$('h-sort2').value=s.sort||'pop';if(['brand','year','bal','wt','hard'].some(k=>s[k]))$('h-adv').open=true;$('h-min').value=s.min||'';$('h-max').value=s.max||'';$('h-stock').checked=s.stock==='1';$('h-sort').value=s.sort||'pop'; paintBrands();};
const active=s=>KEYS.some(k=>s[k]);
const nf=s=>['aud','brand','year','shape','bal','wt','hard','level'].reduce((n,k)=>n+parts(s[k]).length,0)+(s.q?1:0)+(s.stock?1:0)+((s.min||s.max)?1:0);
const hit=(sel,v)=>!sel.length||sel.includes(String(v??''));
// offers: static card offer, replaced by the live price engine when it answers
const offers=r=>(r.live||r.o||[]).filter(o=>o.p>0);
const reach=r=>offers(r).filter(o=>!window.WP||WP.shop(o.d,o.c)!=='n');
const best=r=>window.WP?WP.best(offers(r)):null;
const priceV=r=>{const q=best(r); return q&&q.v!=null?q.v:null;};
const near=r=>window.WP?offers(r).some(o=>WP.shop(o.d,o.c)==='y'&&o.s!==0):offers(r).length>0;
const saving=r=>{const os=reach(r); if(os.length<2) return (r.drop||0); const v=os.map(o=>o.p); return Math.max(r.drop||0,(Math.max(...v)-Math.min(...v))/Math.max(...v));};
const ptxt=r=>{const q=best(r); return (!q||q.v==null)?T.none:T.fromP.replace('{p}',q.txt);};
const shortM=r=>{let s=r.m||''; if(r.b) s=s.replace(new RegExp('^'+r.b.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\s+','i'),''); if(r.y) s=s.replace(new RegExp('\\s+'+r.y+'\\s*$'),''); return s.trim()||r.m;};
const spec=r=>[r.a&&r.a!=='unisex'&&T.auds[['men','women','junior'].indexOf(r.a)],r.sh&&T.shapeCap[r.sh],r.w0&&`${r.w0}${r.w1&&r.w1!==r.w0?'–'+r.w1:''}\u00a0g`].filter(Boolean).join(' · ');
const card=(r,i)=>{const img=r.i?`<img src="${r.i}" alt="${esc(r.m)} ${esc(T.alt)}" width="96" height="112" loading="${i<4?'eager':'lazy'}" decoding="async">`:($('hic-'+(r.sh||'hybrid'))||$('hic-hybrid')).innerHTML;
 const on=sel.includes(r.s);
 return `<li class="rk${on?' sel':''}" data-s="${r.s}"><a class="rk-a" href="${T.rk}${r.s}/"><span class="rk-i">${img}</span><span class="rk-t"><span class="rk-b">${esc([r.b,r.y].filter(Boolean).join(' · '))}</span><span class="rk-m">${esc(shortM(r))}</span><span class="rk-c">${esc(spec(r))}</span><span class="rk-p"><span class="pz rk-pv">${esc(ptxt(r))}</span></span></span></a><button type="button" class="savebtn save-heart" data-save="${r.s}" data-off="${esc(T.save)}" data-on="${esc(T.saved)}" aria-pressed="false" aria-label="${esc(T.save)}"><svg class="heart" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></button><label class="rk-x" title="${esc(T.compare)}"><input type="checkbox" class="rk-cb" value="${r.s}"${on?' checked':''}><span><span class="sr">${esc(T.compare)}: ${esc(r.m)}</span></span></label></li>`;};
const OI=Object.fromEntries(T.order.map((s,i)=>[s,i])); const pop=r=>-(OI[r.s]??1e6);
function filt(s){const q=s.q.toLowerCase(), bn=parts(s.brand).map(sl=>T.brands[sl]).filter(Boolean), mn=parseFloat(s.min), mx=parseFloat(s.max);
 return all.filter(r=>(!q||(r.m+' '+r.b).toLowerCase().includes(q))&&hit(bn,r.b)&&hit(parts(s.year),r.y)&&hit(parts(s.aud),r.a)&&hit(parts(s.shape),r.sh)&&hit(parts(s.bal),r.bn)&&hit(parts(s.wt),r.wn)&&hit(parts(s.hard),r.cn)&&hit(parts(s.level),r.lv)&&(!s.stock||near(r))&&((isNaN(mn)&&isNaN(mx))||((v=>v!=null&&(isNaN(mn)||v>=mn)&&(isNaN(mx)||v<=mx))(priceV(r)))));}
function sortv(v,k){const P=r=>{const x=priceV(r); return x==null?Infinity:x;};
 const map={best:(a,b)=>(P(a)===Infinity)-(P(b)===Infinity)||saving(b)-saving(a)||P(a)-P(b),price:(a,b)=>P(a)-P(b),hi:(a,b)=>(P(b)===Infinity)-(P(a)===Infinity)||P(b)-P(a),new:(a,b)=>(b.y||0)-(a.y||0)||P(a)-P(b),old:(a,b)=>(a.y||9999)-(b.y||9999)||P(a)-P(b),pop:(a,b)=>pop(b)-pop(a)}; const f=map[k]||map.pop;
 return [...v].sort(f);}
const syncURL=s=>{const qs=new URLSearchParams(); KEYS.forEach(k=>{if(s[k]) qs.set(k,s[k]);}); const q=qs.toString(); history.replaceState(null,'',(q?T.base:location.pathname)+(q?'?'+q:'')+location.hash);};
const setCount=n=>{chips();$('h-count').textContent=T.results.replace('§',n); $('h-apply').textContent=T.apply.replace('§',n);};
function render(reset){ if(reset) shown=T.PER; grid.innerHTML=view.slice(0,shown).map(card).join(''); $('h-empty').hidden=view.length>0; const m=$('h-more'); if(m) m.hidden=shown>=view.length; window.wpSaved&&wpSaved.paint(); }
async function apply(push=true){ await load(); const s=get(); const act=active(s); hub.classList.toggle('js-f',act); $('h-fn').textContent=nf(s)?String(nf(s)):'';
 view=sortv(filt(s),s.sort); setCount(view.length); if(push) syncURL(s);
 if(!act&&!hub.dataset.dirty){ shown=T.PER*T.p; refreshPrices(); const m=$('h-more'); if(m) m.hidden=shown>=view.length; return; }
 hub.dataset.dirty=1; if(!act) shown=T.PER; render(true); }
function refreshPrices(){ grid.querySelectorAll('.rk').forEach(li=>{const r=all&&all.find(x=>x.s===li.dataset.s); if(r) li.querySelector('.rk-pv').textContent=ptxt(r);}); }
let prom=null; const load=()=>prom||(prom=Promise.all([fetch('/cards.json').then(r=>r.json()),fetch('/api/all-prices').then(r=>r.ok?r.json():null).catch(()=>null)]).then(([a,p])=>{const L=p&&p.r||{}; a.forEach(r=>{const e=L[r.s]; if(e){const os=(Array.isArray(e.o)&&e.o.length?e.o:[e]).filter(o=>o.p>0).map(o=>({d:o.d,p:o.p,c:o.c,u:o.u,s:o.s})); if(os.length) r.live=os; r.drop=e.drop||0;}}); all=a; return a;}));
// active filter chips
const LBL=k=>({aud:T.aud,shape:T.shape,bal:T.balance,wt:T.weight,hard:T.hard,level:T.level,brand:T.brand,year:T.year})[k];
function chips(){const s=get(); const out=[]; const lab=(n,v)=>{const i=[...document.querySelectorAll(`input[name="h-${n}"]`)].find(el=>el.value===v); const t=i&&i.nextElementSibling; return t?(t.childNodes[0].textContent||'').trim():v;};
 ['aud','shape','level','bal','wt','hard','year'].forEach(k=>parts(s[k]).forEach(v=>out.push([k,v,lab(k,v)]))); parts(s.brand).forEach(v=>out.push(['brand',v,T.brands[v]||v]));
 if(s.min||s.max) out.push(['price','',T.price+': '+(s.min||'0')+'–'+(s.max||'∞')]); if(s.stock) out.push(['stock','',T.stock]); if(s.q) out.push(['q','','“'+s.q+'”']);
 const ac=$('h-ac'); ac.hidden=!out.length; ac.innerHTML=out.map(([k,v,label])=>`<button type="button" class="hub-chip" data-k="${esc(k)}" data-v="${esc(v)}">${esc(label)}<span aria-hidden="true">✕</span></button>`).join('')+(out.length>1?`<button type="button" class="hub-chip hub-chip-x" data-k="*">${esc(T.clr)}</button>`:'');}
$('h-ac').addEventListener('click',e=>{const b=e.target.closest('[data-k]'); if(!b) return; const k=b.dataset.k; if(k==='*') return clear(); const s=get(); if(k==='price'){s.min='';s.max='';} else if(b.dataset.v) s[k]=parts(s[k]).filter(v=>v!==b.dataset.v).join(','); else s[k]=''; put(s); hub.dataset.dirty=1; apply();});
// sheet (mobile)
const sheet=o=>{$('h-f').classList.toggle('open',o); $('h-shade').hidden=!o; $('h-open').setAttribute('aria-expanded',o); document.body.style.overflow=o?'hidden':''; if(o) load();};
$('h-open').onclick=()=>sheet(true); $('h-x').onclick=$('h-shade').onclick=()=>sheet(false); $('h-apply').onclick=()=>{sheet(false); hub.scrollIntoView({block:'start'});};
document.addEventListener('keydown',e=>{if(e.key==='Escape') sheet(false);});
let tm; ['h-q','h-q2'].forEach(i=>$(i).addEventListener('input',()=>{setQ($(i).value);clearTimeout(tm); tm=setTimeout(apply,200);})); ['h-min','h-max'].forEach(i=>$(i).addEventListener('input',()=>{clearTimeout(tm); tm=setTimeout(apply,200);}));
['h-sort','h-stock'].forEach(i=>$(i).addEventListener('change',()=>{$('h-sort2').value=$('h-sort').value;apply();}));
$('h-sort2').addEventListener('change',()=>{$('h-sort').value=$('h-sort2').value;apply();});
document.querySelectorAll('.hub-seg input,.hub-chips input').forEach(i=>i.addEventListener('change',e=>{syncAll(e.target); if(e.target.name==='h-brand') paintBrands(); apply();}));
$('h-bq').addEventListener('input',paintBrands); const bmore=$('h-bmore'); if(bmore) bmore.addEventListener('click',()=>{document.querySelector('.hub-brands .hub-chips').dataset.open='1'; paintBrands();});
const clear=()=>{$('h-bq').value=''; const box=document.querySelector('.hub-brands .hub-chips'); if(box) delete box.dataset.open; put({}); hub.dataset.dirty=1; apply();}; $('h-clear').onclick=clear; $('h-clear2').onclick=clear;
// load more: crawlable link to the next static page, enhanced to append in place
const more=$('h-more'); if(more) more.addEventListener('click',async e=>{e.preventDefault(); if(!all) await apply(false);
 grid.insertAdjacentHTML('beforeend',view.slice(shown,shown+T.PER).map(card).join('')); shown+=T.PER; more.hidden=shown>=view.length; window.wpSaved&&wpSaved.paint();
 const np=Math.floor(shown/T.PER)+1; if(np<=T.P) more.href=T.pfx+np+'/'; });
// compare tray (max 3)
function tray(){ $('h-tray').hidden=!sel.length; document.body.classList.toggle('has-tray',sel.length>0); $('h-sel').innerHTML=sel.map(s=>{const r=all&&all.find(x=>x.s===s); const m=r?r.m:s; return `<li>${esc(m.length>22?m.slice(0,21)+'…':m)}<button type="button" data-rm="${s}" aria-label="${esc(T.remove)}: ${esc(m)}">✕</button></li>`;}).join('');
 $('h-seln').textContent=`${sel.length}/3`; $('h-go').disabled=sel.length<2;
 grid.querySelectorAll('.rk').forEach(li=>{const on=sel.includes(li.dataset.s); li.classList.toggle('sel',on); const c=li.querySelector(".rk-cb"); if(c) c.checked=on;}); try{sessionStorage.wp_hub_cmp=sel.join(',')}catch(e){} }
grid.addEventListener('change',e=>{const c=e.target.closest(".rk-cb"); if(!c) return; const i=sel.indexOf(c.value); if(c.checked){ if(sel.length>=3){c.checked=false; alert(T.max3); return;} if(i<0) sel.push(c.value);} else if(i>=0) sel.splice(i,1); load().then(tray); tray();});
$('h-sel').addEventListener('click',e=>{const b=e.target.closest('[data-rm]'); if(!b) return; sel.splice(sel.indexOf(b.dataset.rm),1); tray();});
$('h-go').onclick=()=>{ if(sel.length>=2) location.href=T.cmp+'?r='+sel.join(','); };
try{(sessionStorage.wp_hub_cmp||'').split(',').filter(Boolean).slice(0,3).forEach(s=>sel.push(s));}catch(e){}
// init from URL
const qs=new URLSearchParams(location.search); const s0={}; KEYS.forEach(k=>s0[k]=qs.get(k)||''); put(s0);
document.addEventListener('wp:region',()=>{ if(all){ view=sortv(filt(get()),get().sort); setCount(view.length); if(hub.dataset.dirty) render(false); else refreshPrices(); } });
if(sel.length) load().then(tray);
if(active(s0)) apply(false); else load().then(()=>apply(false));
})();
</script>
</Base>
