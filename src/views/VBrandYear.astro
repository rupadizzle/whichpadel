---
import Base from '../layouts/Base.astro'; import Byline from '../components/Byline.astro'; import FinderCard from '../components/FinderCard.astro'; import RkCard from '../components/RkCard.astro'; import { brandYears } from '../lib/extra.js'; import { FCARD } from '../lib/years.js'; import { D, url, SITE, P, mat, balTxt, wt } from '../i18n/index.js';
const { b, lang } = Astro.props; const d=D(lang), u=d.ui, C=d.copy.y27, t=d.terms; const U=SITE+url('brandYear',lang,b.id); const sh=r=>r.model.replace(b.name+' ','');
const rowsL=(o,n)=>[[t.spec.shape,t.shapeCap[o.shape],t.shapeCap[n.shape]],[t.spec.weight,wt(o),wt(n)],[t.spec.balance,balTxt(o,lang),balTxt(n,lang)],[t.spec.core,[t.core[o.coreHardness],mat(o.coreMaterial,lang)].filter(Boolean).join(' · ')||null,[t.core[n.coreHardness],mat(n.coreMaterial,lang)].filter(Boolean).join(' · ')||null],[t.spec.face,mat(o.faceMaterial,lang),mat(n.faceMaterial,lang)],[u.recordedPrice,P(o,lang),P(n,lang)]].map(([k,a,c])=>({k,a:a??u.notPublished,b:c??u.notPublished,same:(a??null)===(c??null)}));
const others=brandYears.filter(x=>x.slug===b.slug&&x.year!==b.year);
const jsonld={'@context':'https://schema.org','@type':'ItemList','name':C.h1(b.name,b.year),'url':U,'numberOfItems':b.models.length,'itemListElement':b.models.map((r,i)=>({'@type':'ListItem','position':i+1,'url':SITE+url('racket',lang,r.slug),'name':r.model}))};
---
<Base lang={d.locale} title={C.title(b.name,b.year,b.models.length)+d.copy.titleSuffix} description={C.desc(b.name,b.year,b.models.length,b.pairs.length,b.prev)} jsonld={jsonld}>
<section class="phero" slot="hero"><div class="wrap"><nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <a href={url('brands',lang)}>{u.brands}</a> › <a href={url('brand',lang,b.slug)}>{b.name}</a> › <span>{b.year}</span></nav><h1>{C.h1(b.name,b.year)}</h1><Byline lang={lang} headline={C.h1(b.name,b.year)} pageUrl={U}/><div class="seo"><p>{C.lead(b.name,b.year,b.models.length,b.pairs.length,b.prev)}</p></div></div></section>
<div class="best-split">
<div class="best-main">
<div class="hub cat rk-rows rk-best"><ul class="hub-grid">{b.models.map((r,i)=><RkCard r={r} lang={lang} eager={i<2} keys={['power','control','forgiveness']}/>)}</ul></div>
{b.pairs.length>0&&<section class="panel"><h2>{C.changed(b.prev,b.year)}</h2><p class="muted small">{C.note}</p>
{b.pairs.map(({o,n})=><div class="y-pair"><h3>{sh(o)} → {sh(n)}</h3><div class="tscroll"><table class="spec"><tbody><tr><th></th><th>{b.prev}</th><th>{b.year}</th></tr>{rowsL(o,n).map(x=><tr><th>{x.k}</th><td>{x.same?x.a:<b>{x.a}</b>}</td><td>{x.same?x.b:<b>{x.b}</b>}</td></tr>)}</tbody></table></div><p class="small" style="margin:8px 0 0"><a href={url('racket',lang,o.slug)}>{sh(o)}</a> · <a href={url('racket',lang,n.slug)}>{sh(n)}</a> · <a href={url('rackets',lang)+`?r=${o.slug},${n.slug}`}>{C.side}</a></p></div>)}</section>}
</div>
<aside class="best-side">
<FinderCard fc={FCARD[lang]} href={url('finder', lang)}/>
<section class="panel vs">{others.length>0&&<h2>{d.copy.brand.years}</h2>}{others.map(s=><a href={url('brandYear',lang,s.id)}><span>{s.year}</span><span>→</span></a>)}<p><a href={url('brand',lang,b.slug)}>{C.all(b.name)}</a></p></section>
</aside>
</div>
</Base>
