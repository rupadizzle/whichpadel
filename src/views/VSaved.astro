---
import Base from '../layouts/Base.astro'; import '../styles/hub.css'; import RkCardTemplate from '../components/RkCardTemplate.astro'; import { D, url } from '../i18n/index.js';
import { shoes, shoeImg } from '../lib/shoes.js'; import { balls, ballImg } from '../lib/balls.js'; import { bags, bagImg } from '../lib/bags.js';
import { pick, fmt, DEFAULT_REGION } from '../lib/price.js';
const { lang } = Astro.props; const d=D(lang), u=d.ui;
const TX={empty:u.savedEmpty,remove:u.remove,details:u.details,save:u.save,saved:u.saved,compare:u.savedCompare,keepOk:u.keepOk,keepErr:u.keepErr,keepMail:u.keepMail,deleteAsk:u.deleteAsk};
const money=x=>{const q=pick(x,DEFAULT_REGION(lang)); return q.none?'':fmt(q.v,q.cur,lang);};
const MORE=[...shoes.map(s=>({t:'s',s:s.slug,b:s.brand,m:s.name,y:s.year||'',i:shoeImg(s)||'',p:money(s)})),...balls.map(b=>({t:'b',s:b.slug,b:b.brand,m:b.name,y:'',i:ballImg(b)||'',p:money(b)})),...bags.map(g=>({t:'g',s:g.slug,b:g.brand,m:g.name,y:g.year||'',i:bagImg(g)||'',p:money(g)}))];
const ballBase=url('ball',lang,'X').replace(/X\/$/,'');
const bagBase=(url('bag',lang,'X')||url('bag','en','X')).replace(/X\/$/,'');
---
<Base lang={d.locale} title={u.savedH+d.copy.titleSuffix} description={u.savedDesc} noindex preload="/cards.json">
<nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <span>{u.savedNav}</span></nav>
<h1>{u.savedH}</h1>
<p class="muted" id="saved-device" hidden>{u.savedDevice}</p>
<p id="saved-empty" class="empty" hidden>{u.savedEmpty}</p>
<p id="saved-go" hidden><a class="btn" href={url('rackets',lang)}>{u.rackets}</a></p>
<div class="hub cat"><ul class="hub-grid" id="saved-list"></ul></div>
<RkCardTemplate lang={lang}/>
<p id="saved-cmp-wrap" hidden><a class="btn" id="saved-cmp" href={url('rackets',lang)}>{u.savedCompare}</a></p>
<section class="panel" id="saved-keep">
 <h2 class="h3">{u.keepH}</h2>
 <p class="muted">{u.keepP} <a href={url('privacy',lang)}>{u.privacy}</a></p>
 <form id="keep-form" class="inline-form" novalidate>
  <input type="email" required placeholder={u.emailPh} aria-label={u.emailLabel} autocomplete="email"/>
  <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp"/>
  <button class="btn btn-accent" type="submit">{u.keepBtn}</button>
  <p hidden class="ok" id="keep-msg" role="status"></p>
 </form>
</section>
<section class="panel" id="saved-acct" hidden>
 <p><b>{u.savedAs}</b> <span id="saved-email"></span></p>
 <p class="hero-ctas"><button type="button" class="btn btn-line" id="saved-out">{u.signOut}</button><button type="button" class="btn btn-line" id="saved-del">{u.deleteAccount}</button></p>
</section>
<script is:inline define:vars={{TX, MORE, CMP:url('rackets',lang), RK:url('racket',lang,'X').replace(/X\/$/,''), SK:url('shoe',lang,'X').replace(/X\/$/,''), BK:ballBase, GK:bagBase}}>
document.addEventListener('DOMContentLoaded',async()=>{
 const S=window.wpSaved; if(!S) return;
 const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
 const $=id=>document.getElementById(id);
 let cat=[];
 const key=x=>x.t+'\0'+x.s;
 const prune=list=>{const known=new Set(cat.map(key)); return list.filter(x=>known.has(key(x)));};
 const same=(a,b)=>JSON.stringify(a)===JSON.stringify(b);
 let acctQuiet=false;
 function showIn(email){ try{localStorage.wp_acct='1'}catch(e){} $('saved-keep').hidden=true; $('saved-acct').hidden=false; $('saved-email').textContent=email||''; $('saved-device').hidden=true; if(!acctQuiet) document.dispatchEvent(new CustomEvent('wp:acct',{detail:{on:true,email:email||''}})); }
 function showOut(){ try{localStorage.removeItem('wp_acct')}catch(e){} $('saved-keep').hidden=false; $('saved-acct').hidden=true; $('saved-device').hidden=false; if(!acctQuiet) document.dispatchEvent(new CustomEvent('wp:acct',{detail:null})); }
 document.addEventListener('wp:acct',e=>{acctQuiet=true; if(e.detail&&e.detail.on) showIn(e.detail.email); else showOut(); acctQuiet=false;});
 function render(){
  const by=Object.fromEntries(cat.map(r=>[key(r),r]));
  const rows=S.read().map(x=>by[key(x)]).filter(Boolean);
  $('saved-empty').hidden=rows.length>0; $('saved-go').hidden=rows.length>0;
  const href=r=>(r.t==='s'?SK:r.t==='b'?BK:r.t==='g'?GK:RK)+r.s+'/';
  const short=r=>{let s=r.m||''; const b=r.b?String(r.b).replace(/[.*+?^${}()|[\]\\]/g,'\\$&'):''; if(b) s=s.replace(new RegExp('^'+b+'\\s+','i'),''); if(r.y) s=s.replace(new RegExp('\\s+'+r.y+'\\s*$'),''); return (s.trim()||r.m);};
  const fill=(r,i)=>{const li=document.getElementById('rk-card').content.firstElementChild.cloneNode(true); const id='sv-'+i;
   li.querySelector('.rk-x')?.remove();
   const a=li.querySelector('.rk-a'); a.href=href(r); a.setAttribute('aria-labelledby',id);
   const ph=li.querySelector('.rk-ph');
   if(r.i){const img=document.createElement('img'); img.src=r.i; img.alt=''; img.width=96; img.height=96; img.loading='lazy'; ph.replaceChildren(img);}
   li.querySelector('.rk-b span').textContent=[r.b,r.y].filter(Boolean).join(' · ');
   const name=li.querySelector('.rk-m'); name.id=id; name.textContent=short(r);
   li.querySelector('.rk-c').remove();
   li.querySelector('.rk-pv').textContent=r.p||'';
   const heart=li.querySelector('.save-heart'); heart.dataset.save=r.s; heart.dataset.kind=r.t; heart.dataset.off=TX.save; heart.dataset.on=TX.saved; heart.setAttribute('aria-pressed','true'); heart.setAttribute('aria-label',TX.saved);
   return li;};
  $('saved-list').replaceChildren(...rows.map(fill));
  const rs=rows.filter(r=>r.t==='r'); const cmp=$('saved-cmp'); if(rs.length>=2){ cmp.href=CMP+'?r='+rs.slice(0,3).map(r=>r.s).join(','); $('saved-cmp-wrap').hidden=false; } else $('saved-cmp-wrap').hidden=true;
  S.paint();
 }
 document.addEventListener('wp:saved',render);
 try{ cat=(await (await fetch('/cards.json')).json()).map(r=>({...r,t:'r'})); }catch(e){ cat=[]; }
 cat=cat.concat(MORE);
 const q=new URLSearchParams(location.search); let signed=false, items=null;
 try{
  if(q.get('sync')==='1'){
   const r=await fetch('/api/saved',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({merge:true,items:S.read()})});
   if(r.ok){ const d=await r.json(); items=d.items||[]; showIn(d.email); signed=true; }
  } else {
   const r=await fetch('/api/saved',{credentials:'same-origin'});
   if(r.ok){ const d=await r.json(); items=d.items||[]; showIn(d.email); signed=true; }
  }
 }catch(e){}
 if(!signed) showOut();
 const base=prune(items||S.read());
 if(signed&&!same(base,items||[])){ try{ await fetch('/api/saved',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({merge:false,items:base})}); }catch(e){} }
 if(!same(base,S.read())) S.write(base);
 if(q.get('auth')==='bad'){ const msg=$('keep-msg'); msg.hidden=false; msg.textContent=TX.keepErr; }
 if(q.has('sync')||q.has('auth')){ q.delete('sync'); q.delete('auth'); history.replaceState(null,'',location.pathname+(q.toString()?'?'+q:'')); }
 render();
 $('keep-form').onsubmit=async e=>{
  e.preventDefault(); const f=e.target, i=f.querySelector('input[type=email]'), b=f.querySelector('button'), msg=$('keep-msg');
  if(!i.checkValidity()){ i.reportValidity(); return; }
  b.disabled=true; let status=0;
  try{ const r=await fetch('/api/auth/start',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({email:i.value.trim(),lang:(document.documentElement.lang||'en').slice(0,2),next:location.pathname,website:f.querySelector('input.hp')?.value||''})}); status=r.status; }catch(err){ status=0; }
  b.disabled=false; msg.hidden=false; msg.textContent=status===503?TX.keepMail:(status>=200&&status<300)?TX.keepOk:TX.keepErr;
 };
 $('saved-out').onclick=async()=>{ try{ await fetch('/api/auth/out',{method:'POST',credentials:'same-origin'}); }catch(e){} showOut(); };
 $('saved-del').onclick=async()=>{ if(!confirm(TX.deleteAsk)) return; try{ const r=await fetch('/api/account',{method:'DELETE',credentials:'same-origin'}); if(!r.ok) return; }catch(e){ return; } showOut(); };
});
</script>
</Base>
