---
// Shoe comparison page for a shared /shoes/compare/?s= link. The list opens the same board in a takeover.
import Base from '../layouts/Base.astro';
import ShoeCompareBoard from '../components/ShoeCompareBoard.astro';
import { SHOE, SHOE_CMP } from '../i18n/shoes.js';
import { D, url, SITE } from '../i18n/index.js';
const { lang } = Astro.props; const d=D(lang), u=d.ui, T=SHOE[lang], C=SHOE_CMP[lang];
const U=SITE+url('shoeCompare',lang);
const jsonld={'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':T.crumb,'item':SITE+url('shoes',lang)},{'@type':'ListItem','position':3,'name':C.h1,'item':U}]};
---
<Base lang={d.locale} title={C.h1+' | WhichPadel'} description={C.lead} jsonld={jsonld}>
<script is:inline>if(location.search){const m=document.createElement('meta');m.name='robots';m.content='noindex,follow';document.head.appendChild(m);}</script>
<nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <a href={url('shoes',lang)}>{T.crumb}</a> › <span>{C.h1}</span></nav>
<div class="cmp-intro"><h1>{C.h1}</h1><p class="muted">{C.lead}</p></div>
<ShoeCompareBoard lang={lang}/>
</Base>
