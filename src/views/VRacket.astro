---
import { YC, FCARD } from '../lib/years.js'; import { gallery, levelOf, RP, insight } from '../lib/rp2.js'; import RacketIcon from '../components/RacketIcon.astro';
import NewsL from '../components/NewsL.astro';
import Base from '../layouts/Base.astro'; import RacketImage from '../components/RacketImage.astro'; import Price from '../components/Price.astro'; import PriceAlertL from '../components/PriceAlertL.astro';
import { rackets, brandList, cap, brandSlug, absImg, lists, playerSlug } from '../lib/data.js'; import { extraLists, isWomens } from '../lib/seo-content.js'; import { vsFor } from '../lib/vs.js'; import { offersOf, SHOPS, FX, domainOf } from '../lib/price.js';
const SN=Object.fromEntries(Object.entries(SHOPS).map(([k,s])=>[k,[s.name&&s.name!==k?s.name:k.replace(/\.(com|net|co\.uk)$/,''),typeof s.affiliate==='string'&&s.affiliate.startsWith('https://')?s.affiliate:'']]));
import { D, url, P, racketX, mat, balTxt, wt, SITE } from '../i18n/index.js';
import { HUB as HUBA } from '../i18n/hub.js';
const { r, lang } = Astro.props; const audLbl=HUBA[lang].aud+': '+HUBA[lang].auds[['men','women','junior','unisex'].indexOf(r.audience)];
const audLD={'@type':'PeopleAudience',...(r.audience==='men'?{suggestedGender:'male'}:r.audience==='women'?{suggestedGender:'female'}:r.audience==='junior'?{audienceType:'Junior'}:{suggestedGender:'unisex'})}; const d=D(lang), t=d.terms, u=d.ui, C=d.copy.racket; const x=racketX(r,lang);
const rows=[[t.spec.brand,r.brand],[t.spec.year,r.year],[t.spec.shape,t.shapeCap[r.shape]],[t.spec.weight,wt(r)],[t.spec.balance,x.bal],[t.spec.core,mat(r.coreMaterial,lang)],[t.spec.hardness,t.core[r.coreHardness]],[t.spec.face,x.face],[t.spec.frame,mat(r.frame,lang)],[t.spec.thickness,r.thicknessMm?r.thicknessMm+' mm':null],...(r.player?[[t.spec.player,r.player]]:[]),[t.spec.value,r.valueScore!=null?`${r.valueScore}/100`:null]];
const similar=rackets.filter(y=>y.slug!==r.slug&&y.shape===r.shape&&y.priceGBPApprox&&r.priceGBPApprox&&Math.abs(y.priceGBPApprox-r.priceGBPApprox)<40).slice(0,3);
const bs=brandSlug(r.brand); const hasB=brandList.some(b=>b.slug===bs); const bHref=hasB?url('brand',lang,bs):url('brands',lang); const sameBrand=rackets.filter(y=>y.brand===r.brand&&y.slug!==r.slug).slice(0,6);
const ALL={...lists,...extraLists}; const inLists=Object.entries(ALL).filter(([k,v])=>d.copy.best.titles[k]&&v.pick(rackets).slice(0,15).some(y=>y.slug===r.slug));
const lvl=isWomens(r)?'best-womens-padel-rackets':r.shape==='round'?'best-padel-rackets-for-beginners':r.shape==='diamond'?'best-advanced-padel-rackets':'best-intermediate-padel-rackets';
const U=SITE+url('racket',lang,r.slug); const intro0=C.intro(r,t,x); const intro=r.rated?intro0:intro0.split(/(?<=[.!?])\s+/).filter(z=>!z.includes('/100')).join(' '); const avg=Math.round(Object.values(r.ratings).reduce((a,b)=>a+b,0)/6);
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'Product','name':r.model,'url':U,'brand':{'@type':'Brand','name':r.brand},...(r.image?{'image':absImg(r)}:{}),'description':intro,'category':t.racketFull,'audience':audLD,...(r.price!=null?{'offers':{'@type':'Offer','price':String(r.price),'priceCurrency':r.currency,'url':r.productUrl}}:{})},
 {'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':u.brands,'item':SITE+url('brands',lang)},{'@type':'ListItem','position':3,'name':r.brand,'item':SITE+bHref},{'@type':'ListItem','position':4,'name':r.model,'item':U}]}]};
const G=gallery(r), R2=RP(lang), lv=levelOf(r), ins=r.rated?insight(r,lang):{suits:[],pros:[],cons:[]}, FC=FCARD[lang]||FCARD.en; const alt=t.imgAlt(r.model);
const srows=rows.filter(([k,v])=>v!=null&&v!==''&&v!==false);
const kchips=[r.audience&&audLbl,r.shape&&t.shapeCap[r.shape],x.bal&&t.fBal(x.bal),wt(r),r.coreHardness&&t.fCore(t.core[r.coreHardness]),lv&&R2.lvl[lv]].filter(Boolean);
const more=[...new Map([...similar,...rackets.filter(y=>y.slug!==r.slug&&y.shape===r.shape&&y.brand!==r.brand&&y.image)].map(y=>[y.slug,y])).values()].slice(0,4);
const oj=JSON.stringify(offersOf(r)); const BD=domainOf(r.productUrl||''); const BN=(SN[BD]||[BD||r.brand])[0]; const vs=vsFor(r.slug); const cmpU=url('compare',lang)+`?r=${r.slug}${similar[0]?','+similar[0].slug:''}`;
---
<Base lang={d.locale} title={C.title(r.model)+d.copy.titleSuffix} description={C.desc(r,t,x.price)} jsonld={jsonld} ogImage={absImg(r)}>
<Fragment slot="head">{G[0]&&<link rel="preload" as="image" href={G[0].l} imagesrcset={G[0].one?undefined:`${G[0].s} 400w, ${G[0].l} 800w`} imagesizes="(max-width: 899px) 100vw, 480px" fetchpriority="high"/>}</Fragment>
<nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <a href={url('brands',lang)}>{u.brands}</a> › <a href={bHref}>{r.brand}</a> › <span>{r.model.replace(r.brand+' ','')}</span></nav>
<div class="detail rp2">
<section class="rpg" aria-label={alt} data-n={G.length}>
{G.length>0?<>
<div class="gtrack" tabindex="0">{G.map((g,i)=><button type="button" class="gslide" data-i={i} aria-label={`${R2.zoom}: ${R2.photo(i+1,G.length)}`}><img src={g.l} srcset={g.one?undefined:`${g.s} 400w, ${g.l} 800w`} sizes="(max-width: 899px) 100vw, 480px" alt={i===0?alt:`${alt} – ${R2.photo(i+1,G.length)}`} width="480" height="600" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':undefined} decoding={i===0?'sync':'async'}/></button>)}</div>
{G.length>1&&<><span class="gcount" aria-live="polite"><b>1</b> / {G.length}</span>
<button type="button" class="garr gprev" aria-label={R2.prev}>‹</button><button type="button" class="garr gnext" aria-label={R2.next}>›</button>
<div class="gdots" aria-hidden="true">{G.map((_,i)=><i class={i===0?'on':''}></i>)}</div>
<div class="gthumbs">{G.map((g,i)=><button type="button" data-i={i} aria-label={R2.photo(i+1,G.length)} aria-current={i===0?'true':undefined}><img src={g.s} alt="" width="64" height="80" loading="lazy" decoding="async"/></button>)}</div></>}
<dialog class="gzoom" aria-label={alt}><button type="button" class="gzx" aria-label={R2.close}>✕</button><div class="gztrack">{G.map(g=><img data-src={g.l} alt="" width="960" height="1200"/>)}</div></dialog>
</>:<div class="gtrack gnone"><RacketIcon shape={r.shape} size={120}/></div>}
</section>
<header class="rph">
<p class="brand"><span><a href={url('brand',lang,bs)}>{r.brand}</a>{r.year&&<> · <a href={url('year',lang,r.year)}>{r.year}</a></>}</span><button type="button" class="save-heart" data-save={r.slug} data-off={u.save} data-on={u.saved} aria-pressed="false" aria-label={u.save}><svg class="heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></button></p><h1>{r.model}</h1>
{r.player&&<p class="small rpply">{u.usedBy} <a href={url('player',lang,playerSlug(r.player))}>{r.player}</a></p>}
{kchips.length>0&&<ul class="kchips">{kchips.map(c=><li>{c}</li>)}</ul>}
</header>
<aside class="panel buybox" id="buybox"><p class="price-big" id="pxbig"><Price r={r} lang={lang}/> <span class="pxdrop" id="pxdrop" hidden></span></p>{r.priceChecked&&<p class="muted small" id="pxstatic">{u.checkedOn(r.priceChecked)}</p>}<ul class="pxlive muted small" id="pxlive" hidden></ul>
<div class="pxcmp" id="pxcmp" hidden></div><div class="pxhist" id="pxhist" hidden></div>
{r.productUrl&&r.price!=null&&<a class="btn aff btn-lg" id="buymain" href={r.productUrl} rel="sponsored nofollow" data-affiliate="PLACEHOLDER" data-o={oj}>{u.px.cmp.buy.replace('{s}',BN)} →</a>} <span class="disc">{u.ad}: {u.adNote} <a href={url('affiliate',lang)}>{u.disclosure}</a></span>
<a class="btn btn-sm" style="width:100%" href={cmpU}>{u.compareThis}</a></aside>
<div class="rpbody">
<section class="panel"><h2>{u.overview}</h2><p class="intro">{intro}</p>
{(ins.suits.length>0)&&<><h3>{R2.suits}</h3><ul class="suits">{ins.suits.map(s=><li>{s}</li>)}</ul></>}
{(ins.pros.length>0||ins.cons.length>0)&&<div class="pc">{ins.pros.length>0&&<div><h3>{R2.pros}</h3><ul class="pros">{ins.pros.map(s=><li>{s}</li>)}</ul></div>}{ins.cons.length>0&&<div><h3>{R2.cons}</h3><ul class="cons">{ins.cons.map(s=><li>{s}</li>)}</ul></div>}</div>}
<p class="small rpguide">{C.notSure} <a href={url('guide',lang)}>{C.howChoose}</a> {C.orSee} <a href={url('best',lang,lvl)}>{d.copy.best.titles[lvl][0].toLowerCase()}</a>.</p>{inLists.length>0&&<p class="muted small" style="margin:0">{u.featuredIn}: {inLists.map(([k],i)=><>{i>0&&' · '}<a href={url('best',lang,k)}>{d.copy.best.titles[k][0]}</a></>)}</p>}</section>
{r.rated&&<section class="panel"><div class="overall"><div class="ring" style={`background:conic-gradient(#13795c ${avg*3.6}deg,#e8edf0 0)`}><span>{avg}</span></div><div><h2 style="margin:0">{u.calcRatings}</h2><p class="muted small" style="margin:0">{u.avgOfSix}</p></div></div>
<div class="scores">{Object.entries(r.ratings).map(([k,v])=><div class="row"><span>{t.rt[k]}</span><div class="bar"><i style={`width:${v}%`}></i></div><b>{v}</b></div>)}</div>
<p class="muted small">{u.ratingsNote}</p></section>}
<details class="panel rpspec" id="rpspec" open><summary><h2>{R2.specs}</h2></summary><div class="tscroll"><table class="spec"><tbody>{srows.map(([k,v])=><tr><th>{k}</th><td>{v}</td></tr>)}{r.price!=null&&<tr><th>{t.spec.price}</th><td><Price r={r} lang={lang}/>{r.priceChecked&&<> ({u.checked} {r.priceChecked})</>}</td></tr>}</tbody></table></div>
{r.inputsMissing.length>0&&<p class="muted small" style="margin-top:12px">{u.missing(x.missing.join(', '))}</p>}</details>
{more.length>0&&<section class="panel"><h2>{R2.more}</h2><div class="rpsim">{more.map(s=><a href={url('racket',lang,s.slug)}><span class="rpsi">{s.image?<img src={s.image} alt="" width="72" height="90" loading="lazy" decoding="async"/>:<RacketIcon shape={s.shape} size={40}/>}</span><span><b>{s.model}</b><small>{s.shape&&t.shapeCap[s.shape]}{s.price!=null&&<> · <Price r={s} lang={lang}/></>}</small></span></a>)}</div>
<a class="btn btn-sm rpcmp" href={cmpU}>{R2.cmp} →</a></section>}
{(vs.length>0||similar.length>0)&&<section class="panel vs"><h2>{u.headToHead}</h2>{vs.map(v=><a href={url('vs',lang,v.slug)}><span>{v.A.model} vs {v.B.model}</span><span>→</span></a>)}{similar.filter(s=>!vs.some(v=>v.A.slug===s.slug||v.B.slug===s.slug)).map(s=><a href={url('compare',lang)+`?r=${r.slug},${s.slug}`}><span>{r.model} vs {s.model}</span><span>→</span></a>)}</section>}
{sameBrand.length>0&&<section class="panel vs"><h2>{u.moreFrom(r.brand)}</h2>{sameBrand.map(s=><a href={url('racket',lang,s.slug)}><span>{s.model}</span><span>→</span></a>)}<p style="margin:12px 0 0"><a href={bHref}>{u.allBrand(r.brand)}</a>{r.year&&<> · <a href={url('year',lang,r.year)}>{YC[lang].more(r.year)}</a></>}</p></section>}
<section class="panel fcard"><div><h2 class="h3">{FC[0]}</h2><p class="muted">{FC[1]}</p></div><a class="btn" href={url('finder',lang)}>{FC[2]} →</a></section>
</div>
</div>
<section class="nudge" id="rv-wrap" hidden><h2>{u.recent}</h2><div class="rv" id="rv"></div></section>
<PriceAlertL lang={lang} racket={r.model}/>
<NewsL lang={lang} src="racket"/>
<div class="stickycta" id="stickycta" aria-hidden="true"><button type="button" class="sp" id="stickyopen" tabindex="-1" aria-haspopup="dialog" aria-label={u.px.cmp.openS}><b><Price r={r} lang={lang}/><svg class="spchev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></b><span>{BN}</span></button><button type="button" class="btn" id="stickybuy" tabindex="-1" aria-haspopup="dialog">{u.px.cmp.showP}</button></div>
<script is:inline define:vars={{PS:r.slug,PX:u.px,SN,RATES:FX.rates,LG:lang,RM:r.model,AD:u.ad,ADN:u.adNote,DISC:u.disclosure,DISCU:url('affiliate',lang)}}>
// live prices from the price engine (/api/prices). Compare list: one row per shop (e.o), filtered to the visitor's country, cheapest in-stock first.
const okHost=location.hostname==='whichpadel.com'||location.hostname==='localhost'||location.hostname==='127.0.0.1'||/\.whichpadel\.pages\.dev$/.test(location.hostname)||/[?&]px=1/.test(location.search);
const pxOn=on=>{document.body.classList.toggle('px-live',!!on); document.dispatchEvent(new CustomEvent('px-live'));};
if(okHost){ window.__pxLive=1; fetch('/api/all-prices',{signal:AbortSignal.timeout?AbortSignal.timeout(5000):undefined}).then(x=>x.ok?x.json():null).then(j=>{const e=j&&j.r&&j.r[PS]; if(!e){pxOn(0); return;}
 const os=(Array.isArray(e.o)&&e.o.length?e.o:[e]).filter(o=>o.p>0&&/^https:\/\//.test(o.u));
 const oj=JSON.stringify(os.map(o=>({d:o.d,p:o.p,c:o.c,u:o.u}))); document.querySelectorAll('.pz[data-o],a.aff[data-o]').forEach(n=>n.dataset.o=oj);
 const L=document.getElementById('pxlive'); const C=PX.cmp, esc=s=>String(s).replace(/[<>&"]/g,c=>'&#'+c.charCodeAt(0)+';');
 const today=Date.parse(new Date().toISOString().slice(0,10));
 function render(){const W=window.WP||{region:'GB',currency:'GBP'}, reg=W.region, cur=W.currency;
  const cv=(n,c)=>c===cur?n:n/RATES[c]*RATES[cur]; const f=n=>{const v=Math.round(n); return cur==='SEK'?v+' kr':LG!=='en'?v+' '+{GBP:'£',EUR:'€',USD:'$'}[cur]:{GBP:'£',EUR:'€',USD:'$'}[cur]+v;};
  // exact shop price in the shop's own currency (what the visitor will see on the shop), e.g. €64.95
  const fn=(n,c)=>{const v=Number.isInteger(n)?String(n):n.toFixed(2); const sy={GBP:'£',EUR:'€',USD:'$'}[c]; return c==='SEK'?v+' kr':LG!=='en'?v.replace('.',',')+' '+sy:sy+v;};
  const AX=(window.WP&&WP.approx)||'approx.'; const fb=o=>o.c===cur?fn(o.p,o.c):AX+' '+f(o.v);
  const rows=os.map(o=>{const s=window.WP&&WP.shop?WP.shop(o.d,o.c):null; const st=s?s:'u'; return {...o,v:cv(o.p,o.c),st};}).filter(o=>o.st!=='n')
   .sort((a,b)=>((a.s===0)-(b.s===0))||a.v-b.v);
  const vis=os.filter(o=>!window.WP||!WP.shop||WP.shop(o.d,o.c)!=='n'); const low=Math.min(...vis.map(o=>cv(o.min30||o.p,o.c)));
  L.innerHTML=`<li>${PX.low30}: <b>${f(low)}</b></li>`; L.hidden=false; const sp=document.getElementById('pxstatic'); if(sp) sp.hidden=true;
  const P=document.getElementById('pxcmp'), M=document.getElementById('buymain');
  if(!rows.length){pxOn(0); if(window.WP&&WP.strict&&WP.strict()){L.hidden=true; P.innerHTML=`<p class="pxnous">${PX.noUS||'No US shop yet'}</p>`; P.hidden=false; if(M) M.hidden=true; return;} P.hidden=true;P.innerHTML='';if(M) M.hidden=false;return;}
  const age=t=>{const n=Math.max(0,Math.round((today-Date.parse(t))/864e5)); return n===0?C.today:n===1?C.ago1:C.ago.replace('{n}',n);};
  const href=o=>{const a=(SN[o.d]||[])[1]; return a?a.replace('{url}',encodeURIComponent(o.u)):o.u;};
  const sn=o=>esc((SN[o.d]||[o.n||o.d])[0]);
  const ag=t=>{const n=Math.max(0,Math.round((today-Date.parse(t))/864e5)); return n===0?C.tdy:C.agoS.replace('{n}',n);};
  const row=(o,best)=>`<li class="pxr${best?' best':''}${o.s===0?' oos':''}${o.st!=='y'?' nc':''}"><span class="pxs"><b>${sn(o)}</b><small class="pxm">${best?`<span class="pxbd">${C.bestDeal}</span>`:''}<i class="dot${o.s===0?' no':''}" aria-label="${o.s===0?PX.oos:C.inStock}"></i>${o.s===0?PX.oos+' · ':''}<span class="pxag">${o.st!=='y'?`<span class="pxnc" title="${C.nc}" aria-label="${C.nc}">${C.ncS}</span>`:ag(o.t)}</span></small></span><span class="pxp">${fn(o.p,o.c)}${o.c!==cur?`<small class="pxcv">${AX} ${f(o.v)}</small>`:''}</span><a class="btn pxb${best?' pri':''}" href="${esc(href(o))}" rel="sponsored nofollow" target="_blank" aria-label="${C.buy.replace('{s}',sn(o))}">${C.buyS}</a></li>`;
  const conf=rows.filter(o=>o.st==='y'), unc=rows.filter(o=>o.st!=='y'), all=[...conf,...unc], top=all.slice(0,4);
  const b=all[0], bi=b.s!==0; const ul=(L,o0)=>`<ul class="pxl">${L.map((o,i)=>row(o,o0&&i===0&&bi)).join('')}</ul>`;
  let h=`<p class="pxsub pxcnt">${(rows.length===1?C.n1:C.nN.replace('{n}',rows.length))}</p>`+ul(top,true);
  if(all.length>4) h+=`<button type="button" class="pxall" id="pxall" aria-haspopup="dialog">${C.allN.replace('{n}',all.length)}</button>`;
  P.innerHTML=h; P.hidden=false; M.hidden=true; pxOn(1); const PB=document.getElementById('pxbig'); if(PB) PB.hidden=true; L.hidden=true;
  const S=document.getElementById('stickybuy'); if(S){const SP=document.querySelector('#stickycta .sp'); const FR={en:'from',es:'desde',fr:'dès',de:'ab',it:'da',pt:'desde'}[LG]||'from'; if(SP) SP.innerHTML=`<b><small>${FR}</small> ${fb(b)}<svg class="spchev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></b><span>${sn(b)}</span>`;}
  // bottom sheet
  let D=document.getElementById('pxsheet'); if(!D){D=document.createElement('div'); D.id='pxsheet'; D.className='pxsheet'; D.hidden=true; document.body.appendChild(D);}
  const foot=`<div class="pxshist" id="pxshist" hidden></div><p class="disc">${esc(AD)}: ${esc(ADN)} <a href="${esc(DISCU)}">${esc(DISC)}</a></p>`;
  D.innerHTML=`<div class="pxsb" data-x></div><div class="pxsp" role="dialog" aria-modal="true" aria-labelledby="pxst" tabindex="-1"><div class="pxsg" aria-hidden="true"></div><div class="pxsh"><h2 id="pxst">${esc(RM)}</h2><button type="button" class="pxsx" data-x aria-label="${C.close}">✕</button></div><div class="pxsc">${ul(top,true)}${all.length>4?`<div class="pxsmore" hidden>${ul(all.slice(4),false)}</div><button type="button" class="pxall pxsall">${C.showAll.replace('{n}',all.length)}</button>`:''}${foot}</div></div>`;
  sheetWire(D);
  hist(cv,f);}
 let opener=null;
 function sheetOpen(full){const D=document.getElementById('pxsheet'); if(!D) return; opener=document.activeElement; D.classList.toggle('full',!!full); const m=D.querySelector('.pxsmore'), sa=D.querySelector('.pxsall'); if(m){m.hidden=!full; sa.hidden=!!full;}
  D.hidden=false; document.documentElement.classList.add('pxlock'); requestAnimationFrame(()=>requestAnimationFrame(()=>D.classList.add('open'))); setTimeout(()=>D.querySelector('.pxsp').focus(),30);}
 function sheetClose(){const D=document.getElementById('pxsheet'); if(!D||D.hidden) return; D.classList.remove('open'); const p=D.querySelector('.pxsp'); p.style.transform=''; document.documentElement.classList.remove('pxlock');
  const rm=matchMedia('(prefers-reduced-motion: reduce)').matches; setTimeout(()=>{D.hidden=true;},rm?0:250); if(opener&&opener.focus) opener.focus();}
 function sheetWire(D){D.querySelectorAll('[data-x]').forEach(x=>x.onclick=sheetClose);
  const sa=D.querySelector('.pxsall'); if(sa) sa.onclick=()=>{D.querySelector('.pxsmore').hidden=false; sa.hidden=true; D.classList.add('full'); const f=D.querySelector('.pxsmore a'); if(f) f.focus();};
  const p=D.querySelector('.pxsp'), sc=D.querySelector('.pxsc'); let y0=null, dy=0;
  p.addEventListener('touchstart',e=>{if(sc.scrollTop>0&&sc.contains(e.target)) {y0=null;return;} y0=e.touches[0].clientY; dy=0; p.style.transition='none';},{passive:true});
  p.addEventListener('touchmove',e=>{if(y0==null) return; dy=Math.max(0,e.touches[0].clientY-y0); p.style.transform=`translateY(${dy}px)`;},{passive:true});
  p.addEventListener('touchend',()=>{if(y0==null) return; p.style.transition=''; if(dy>80) sheetClose(); else p.style.transform=''; y0=null;});
  const pa=document.getElementById('pxall'); if(pa) pa.onclick=()=>sheetOpen(true);}
 document.addEventListener('keydown',e=>{const D=document.getElementById('pxsheet'); if(!D||D.hidden) return; if(e.key==='Escape'){e.preventDefault(); sheetClose(); return;}
  if(e.key==='Tab'){const F=[...D.querySelectorAll('a[href],button:not([hidden])')].filter(x=>x.offsetParent!==null); if(!F.length) return; const a=F[0], z=F[F.length-1];
