---
import { YC } from '../lib/years.js';
import NewsL from '../components/NewsL.astro';
import Base from '../layouts/Base.astro'; import RacketImage from '../components/RacketImage.astro'; import Price from '../components/Price.astro'; import PriceAlertL from '../components/PriceAlertL.astro';
import { rackets, cap, brandSlug, absImg, lists, playerSlug } from '../lib/data.js'; import { extraLists, isWomens } from '../lib/seo-content.js'; import { vsFor } from '../lib/vs.js'; import { offersOf, SHOPS, FX, domainOf } from '../lib/price.js';
const SN=Object.fromEntries(Object.entries(SHOPS).map(([k,s])=>[k,[s.name&&s.name!==k?s.name:k.replace(/\.(com|net|co\.uk)$/,''),typeof s.affiliate==='string'&&s.affiliate.startsWith('https://')?s.affiliate:'']]));
import { D, url, P, racketX, mat, balTxt, wt, SITE } from '../i18n/index.js';
const { r, lang } = Astro.props; const d=D(lang), t=d.terms, u=d.ui, C=d.copy.racket; const x=racketX(r,lang);
const rows=[[t.spec.brand,r.brand],[t.spec.year,r.year],[t.spec.shape,t.shapeCap[r.shape]],[t.spec.weight,wt(r)],[t.spec.balance,x.bal],[t.spec.core,mat(r.coreMaterial,lang)],[t.spec.hardness,t.core[r.coreHardness]],[t.spec.face,x.face],[t.spec.frame,mat(r.frame,lang)],[t.spec.thickness,r.thicknessMm?r.thicknessMm+' mm':null],...(r.player?[[t.spec.player,r.player]]:[]),[t.spec.value,r.valueScore!=null?`${r.valueScore}/100`:null]];
const similar=rackets.filter(y=>y.slug!==r.slug&&y.shape===r.shape&&y.priceGBPApprox&&r.priceGBPApprox&&Math.abs(y.priceGBPApprox-r.priceGBPApprox)<40).slice(0,3);
const bs=brandSlug(r.brand); const sameBrand=rackets.filter(y=>y.brand===r.brand&&y.slug!==r.slug).slice(0,6);
const ALL={...lists,...extraLists}; const inLists=Object.entries(ALL).filter(([k,v])=>d.copy.best.titles[k]&&v.pick(rackets).slice(0,15).some(y=>y.slug===r.slug));
const lvl=isWomens(r)?'best-womens-padel-rackets':r.shape==='round'?'best-padel-rackets-for-beginners':r.shape==='diamond'?'best-advanced-padel-rackets':'best-intermediate-padel-rackets';
const U=SITE+url('racket',lang,r.slug); const intro=C.intro(r,t,x); const avg=Math.round(Object.values(r.ratings).reduce((a,b)=>a+b,0)/6);
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'Product','name':r.model,'url':U,'brand':{'@type':'Brand','name':r.brand},...(r.image?{'image':absImg(r)}:{}),'description':intro,'category':t.racketFull,...(r.price!=null?{'offers':{'@type':'Offer','price':String(r.price),'priceCurrency':r.currency,'url':r.productUrl}}:{})},
 {'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':u.brands,'item':SITE+url('brands',lang)},{'@type':'ListItem','position':3,'name':r.brand,'item':SITE+url('brand',lang,bs)},{'@type':'ListItem','position':4,'name':r.model,'item':U}]}]};
const oj=JSON.stringify(offersOf(r)); const BD=domainOf(r.productUrl||''); const BN=(SN[BD]||[BD||r.brand])[0]; const vs=vsFor(r.slug); const cmpU=url('compare',lang)+`?r=${r.slug}${similar[0]?','+similar[0].slug:''}`;
---
<Base lang={d.locale} title={C.title(r.model)+d.copy.titleSuffix} description={C.desc(r,t,x.price)} jsonld={jsonld} ogImage={absImg(r)}>
<nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <a href={url('brands',lang)}>{u.brands}</a> › <a href={url('brand',lang,bs)}>{r.brand}</a> › <span>{r.model.replace(r.brand+' ','')}</span></nav>
<div class="detail"><div>
<section class="panel dhero"><div class="art"><RacketImage lang={lang} r={r} size={100} eager/></div><div>
<p class="brand"><a href={url('brand',lang,bs)}>{r.brand}</a>{r.year&&<> · {r.year}</>}</p><h1 style="font-size:clamp(1.6rem,3.5vw,2.4rem)">{r.model}</h1>
{r.player&&<p class="small" style="margin:0 0 8px">{u.usedBy} <a href={url('player',lang,playerSlug(r.player))}>{r.player}</a></p>}
<div class="chips">{r.shape&&<span class="chip">{t.fShape(t.shape[r.shape])}</span>}{t.bal[r.balance]&&<span class="chip">{t.fBal(t.bal[r.balance])}</span>}{r.coreHardness&&<span class="chip">{t.fCore(t.core[r.coreHardness])}</span>}</div></div></section>
<section class="panel"><h2>{u.overview}</h2><p class="intro">{intro}</p><p class="small" style="margin:0 0 8px">{C.notSure} <a href={url('guide',lang)}>{C.howChoose}</a> {C.orSee} <a href={url('best',lang,lvl)}>{d.copy.best.titles[lvl][0].toLowerCase()}</a>.</p>{inLists.length>0&&<p class="muted small" style="margin:0">{u.featuredIn}: {inLists.map(([k],i)=><>{i>0&&' · '}<a href={url('best',lang,k)}>{d.copy.best.titles[k][0]}</a></>)}</p>}</section>
<section class="panel"><div class="overall"><div class="ring" style={`background:conic-gradient(#13795c ${avg*3.6}deg,#e8edf0 0)`}><span>{avg}</span></div><div><h2 style="margin:0">{u.calcRatings}</h2><p class="muted small" style="margin:0">{u.avgOfSix}</p></div></div>
<div class="scores">{Object.entries(r.ratings).map(([k,v])=><div class="row"><span>{t.rt[k]}</span><div class="bar"><i style={`width:${v}%`}></i></div><b>{v}</b></div>)}</div>
<p class="muted small">{u.ratingsNote}</p></section>
<section class="panel"><h2>{u.specs}</h2><div class="tscroll"><table class="spec"><tbody>{rows.map(([k,v])=><tr><th>{k}</th><td>{v||u.notPublished}</td></tr>)}<tr><th>{t.spec.price}</th><td><Price r={r} lang={lang}/>{r.priceChecked&&<> ({u.checked} {r.priceChecked})</>}</td></tr></tbody></table></div>
{r.inputsMissing.length>0&&<p class="muted small" style="margin-top:12px">{u.missing(x.missing.join(', '))}</p>}</section>
{vs.length>0&&<section class="panel vs"><h2>{u.headToHead}</h2>{vs.map(v=><a href={url('vs',lang,v.slug)}><span>{v.A.model} vs {v.B.model}</span><span>→</span></a>)}</section>}
{similar.length>0&&<section class="panel vs"><h2>{u.compareSimilar}</h2>{similar.map(s=><a href={url('compare',lang)+`?r=${r.slug},${s.slug}`}><span>{r.model} vs {s.model}</span><span>→</span></a>)}</section>}
{r.year&&<p style="margin:16px 0"><a class="btn btn-sm" style="min-height:44px;display:inline-flex;align-items:center" href={url('year',lang,r.year)}>{YC[lang].more(r.year)} →</a></p>}
{sameBrand.length>0&&<section class="panel vs"><h2>{u.moreFrom(r.brand)}</h2>{sameBrand.map(s=><a href={url('racket',lang,s.slug)}><span>{s.model}</span><span>→</span></a>)}<p style="margin:12px 0 0"><a href={url('brand',lang,bs)}>{u.allBrand(r.brand)}</a></p></section>}
</div>
<aside class="panel buybox" id="buybox"><p class="price-big" id="pxbig"><Price r={r} lang={lang}/> <span class="pxdrop" id="pxdrop" hidden></span></p>{r.priceChecked&&<p class="muted small" id="pxstatic">{u.checkedOn(r.priceChecked)}</p>}<ul class="pxlive muted small" id="pxlive" hidden></ul>
<div class="pxcmp" id="pxcmp" hidden></div><div class="pxhist" id="pxhist" hidden></div>
<a class="btn aff btn-lg" id="buymain" href={r.productUrl} rel="sponsored nofollow" data-affiliate="PLACEHOLDER" data-o={oj}>{u.px.cmp.buy.replace('{s}',BN)} →</a> <span class="disc">{u.ad}: {u.adNote} <a href={url('affiliate',lang)}>{u.disclosure}</a></span>
<a class="btn btn-sm" style="width:100%" href={cmpU}>{u.compareThis}</a></aside>
</div>
<section class="nudge" id="rv-wrap" hidden><h2>{u.recent}</h2><div class="rv" id="rv"></div></section>
<PriceAlertL lang={lang} racket={r.model}/>
<NewsL lang={lang} src="racket"/>
<div class="stickycta" id="stickycta" aria-hidden="true"><button type="button" class="sp" id="stickyopen" tabindex="-1" aria-haspopup="dialog" aria-label={u.px.cmp.openS}><b><Price r={r} lang={lang}/><svg class="spchev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></b><span>{BN}</span></button><button type="button" class="btn" id="stickybuy" tabindex="-1" aria-haspopup="dialog">{u.px.cmp.showP}</button></div>
<script is:inline define:vars={{PS:r.slug,PX:u.px,SN,RATES:FX.rates,LG:lang,RM:r.model}}>
// live prices from the price engine (/api/prices). Compare list: one row per shop (e.o), filtered to the visitor's country, cheapest in-stock first.
const okHost=location.hostname==='whichpadel.com'||/\.whichpadel\.pages\.dev$/.test(location.hostname)||/[?&]px=1/.test(location.search);
if(okHost) fetch('/api/prices',{signal:AbortSignal.timeout?AbortSignal.timeout(5000):undefined}).then(x=>x.ok?x.json():null).then(j=>{const e=j&&j.r&&j.r[PS]; if(!e) return;
 const os=(Array.isArray(e.o)&&e.o.length?e.o:[e]).filter(o=>o.p>0&&/^https:\/\//.test(o.u));
 const oj=JSON.stringify(os.map(o=>({d:o.d,p:o.p,c:o.c,u:o.u}))); document.querySelectorAll('.pz[data-o],a.aff[data-o]').forEach(n=>n.dataset.o=oj);
 const L=document.getElementById('pxlive'); const C=PX.cmp, esc=s=>String(s).replace(/[<>&"]/g,c=>'&#'+c.charCodeAt(0)+';');
 const today=Date.parse(new Date().toISOString().slice(0,10));
 function render(){const W=window.WP||{region:'GB',currency:'GBP'}, reg=W.region, cur=W.currency;
  const cv=(n,c)=>c===cur?n:n/RATES[c]*RATES[cur]; const f=n=>{const v=Math.round(n); return cur==='SEK'?v+' kr':LG!=='en'?v+' '+{GBP:'£',EUR:'€',USD:'$'}[cur]:{GBP:'£',EUR:'€',USD:'$'}[cur]+v;};
  // exact shop price in the shop's own currency (what the visitor will see on the shop), e.g. €64.95
  const fn=(n,c)=>{const v=Number.isInteger(n)?String(n):n.toFixed(2); const sy={GBP:'£',EUR:'€',USD:'$'}[c]; return c==='SEK'?v+' kr':LG!=='en'?v.replace('.',',')+' '+sy:sy+v;};
  const AX=(window.WP&&WP.approx)||'approx.'; const fb=o=>o.c===cur?fn(o.p,o.c):AX+' '+f(o.v);
  const rows=os.map(o=>{const s=window.WP&&WP.shop?WP.shop(o.d):null; const st=s?s:'u'; return {...o,v:cv(o.p,o.c),st};}).filter(o=>o.st!=='n')
   .sort((a,b)=>((a.s===0)-(b.s===0))||a.v-b.v);
  const low=Math.min(...os.map(o=>cv(o.min30||o.p,o.c)));
  L.innerHTML=`<li>${PX.low30}: <b>${f(low)}</b></li>`; L.hidden=false; const sp=document.getElementById('pxstatic'); if(sp) sp.hidden=true;
  const P=document.getElementById('pxcmp'), M=document.getElementById('buymain');
  if(!rows.length){P.hidden=true;P.innerHTML='';M.hidden=false;return;}
  const age=t=>{const n=Math.max(0,Math.round((today-Date.parse(t))/864e5)); return n===0?C.today:n===1?C.ago1:C.ago.replace('{n}',n);};
  const href=o=>{const a=(SN[o.d]||[])[1]; return a?a.replace('{url}',encodeURIComponent(o.u)):o.u;};
  const sn=o=>esc((SN[o.d]||[o.n||o.d])[0]);
  const ag=t=>{const n=Math.max(0,Math.round((today-Date.parse(t))/864e5)); return n===0?C.tdy:C.agoS.replace('{n}',n);};
  const row=(o,best)=>`<li class="pxr${best?' best':''}${o.s===0?' oos':''}${o.st!=='y'?' nc':''}"><span class="pxs"><b>${sn(o)}</b><small class="pxm">${best?`<span class="pxbd">${C.bestDeal}</span>`:''}<i class="dot${o.s===0?' no':''}" aria-label="${o.s===0?PX.oos:C.inStock}"></i>${o.s===0?PX.oos+' · ':''}${ag(o.t)}</small>${o.st!=='y'?`<small class="pxnc">${C.nc}</small>`:''}</span><span class="pxp">${fn(o.p,o.c)}${o.c!==cur?`<small class="pxcv">${AX} ${f(o.v)}</small>`:''}</span><a class="btn pxb${best?' pri':''}" href="${esc(href(o))}" rel="sponsored nofollow" target="_blank" aria-label="${C.buy.replace('{s}',sn(o))}">${C.buyS}</a></li>`;
  const conf=rows.filter(o=>o.st==='y'), unc=rows.filter(o=>o.st!=='y'), all=[...conf,...unc], top=all.slice(0,4);
  const b=all[0], bi=b.s!==0; const ul=(L,o0)=>`<ul class="pxl">${L.map((o,i)=>row(o,o0&&i===0&&bi)).join('')}</ul>`;
  let h=`<p class="pxsub pxcnt">${(rows.length===1?C.n1:C.nN.replace('{n}',rows.length))}</p>`+ul(top,true);
  if(all.length>4) h+=`<button type="button" class="pxall" id="pxall" aria-haspopup="dialog">${C.allN.replace('{n}',all.length)}</button>`;
  P.innerHTML=h; P.hidden=false; M.hidden=true; const PB=document.getElementById('pxbig'); if(PB) PB.hidden=true; L.hidden=true;
  const S=document.getElementById('stickybuy'); if(S){const SP=document.querySelector('#stickycta .sp'); const FR={en:'from',es:'desde',fr:'dès',de:'ab',it:'da',pt:'desde'}[LG]||'from'; if(SP) SP.innerHTML=`<b><small>${FR}</small> ${fb(b)}<svg class="spchev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></b><span>${sn(b)}</span>`;}
  // bottom sheet
  let D=document.getElementById('pxsheet'); if(!D){D=document.createElement('div'); D.id='pxsheet'; D.className='pxsheet'; D.hidden=true; document.body.appendChild(D);}
  D.innerHTML=`<div class="pxsb" data-x></div><div class="pxsp" role="dialog" aria-modal="true" aria-labelledby="pxst" tabindex="-1"><div class="pxsg" aria-hidden="true"></div><div class="pxsh"><h2 id="pxst">${esc(RM)}</h2><button type="button" class="pxsx" data-x aria-label="${C.close}">✕</button></div><div class="pxsc">${ul(top,true)}${all.length>4?`<div class="pxsmore" hidden>${ul(all.slice(4),false)}</div><button type="button" class="pxall pxsall">${C.showAll.replace('{n}',all.length)}</button>`:''}</div></div>`;
  sheetWire(D);
  hist(cv,f);}
 let opener=null;
 function sheetOpen(full){const D=document.getElementById('pxsheet'); if(!D) return; opener=document.activeElement; D.classList.toggle('full',!!full); const m=D.querySelector('.pxsmore'), sa=D.querySelector('.pxsall'); if(m){m.hidden=!full; sa.hidden=!!full;}
  D.hidden=false; document.documentElement.classList.add('pxlock'); requestAnimationFrame(()=>requestAnimationFrame(()=>D.classList.add('open'))); setTimeout(()=>D.querySelector('.pxsp').focus(),30);}
 function sheetClose(){const D=document.getElementById('pxsheet'); if(!D||D.hidden) return; D.classList.remove('open'); const p=D.querySelector('.pxsp'); p.style.transform=''; document.documentElement.classList.remove('pxlock');
  const rm=matchMedia('(prefers-reduced-motion: reduce)').matches; setTimeout(()=>{D.hidden=true;},rm?0:250); if(opener&&opener.focus) opener.focus();}
 function sheetWire(D){D.querySelectorAll('[data-x]').forEach(x=>x.onclick=sheetClose);
  const sa=D.querySelector('.pxsall'); if(sa) sa.onclick=()=>{D.querySelector('.pxsmore').hidden=false; sa.hidden=true; D.classList.add('full'); const f=D.querySelector('.pxsmore a'); if(f) f.focus();};
  const p=D.querySelector('.pxsp'), sc=D.querySelector('.pxsc'); let y0=null, dy=0;
  p.addEventListener('touchstart',e=>{if(sc.scrollTop>0&&sc.contains(e.target)) {y0=null;return;} y0=e.touches[0].clientY; dy=0; p.style.transition='none';},{passive:true});
  p.addEventListener('touchmove',e=>{if(y0==null) return; dy=Math.max(0,e.touches[0].clientY-y0); p.style.transform=`translateY(${dy}px)`;},{passive:true});
  p.addEventListener('touchend',()=>{if(y0==null) return; p.style.transition=''; if(dy>80) sheetClose(); else p.style.transform=''; y0=null;});
  const pa=document.getElementById('pxall'); if(pa) pa.onclick=()=>sheetOpen(true);}
 document.addEventListener('keydown',e=>{const D=document.getElementById('pxsheet'); if(!D||D.hidden) return; if(e.key==='Escape'){e.preventDefault(); sheetClose(); return;}
  if(e.key==='Tab'){const F=[...D.querySelectorAll('a[href],button:not([hidden])')].filter(x=>x.offsetParent!==null); if(!F.length) return; const a=F[0], z=F[F.length-1];
   if(e.shiftKey&&(document.activeElement===a||document.activeElement===D.querySelector('.pxsp'))){e.preventDefault(); z.focus();} else if(!e.shiftKey&&document.activeElement===z){e.preventDefault(); a.focus();}}});
 const SC=document.getElementById('stickycta'); if(SC) SC.addEventListener('click',()=>sheetOpen(false));
 let HD=90; const H=Array.isArray(e.h)?e.h.filter(x=>x&&x[1]>0):[];
 function hist(cv,f){const B=document.getElementById('pxhist'); if(!B||!H.length) return; const W=window.WP||{currency:'GBP'};
  const dd=new Set(H.map(x=>x[0])).size; if(dd<3){const L=document.documentElement.lang||'en'; let d=H[0][0]; try{d=new Date(d+'T12:00:00Z').toLocaleDateString(L,{day:'numeric',month:'short'});}catch(_){} B.innerHTML=`<p class="pxsince">${C.since.replace('{d}',d)}</p>`; B.hidden=false; return;}
  const cut=new Date(Date.now()-HD*864e5).toISOString().slice(0,10); const pts=H.filter(x=>x[0]>=cut).map(x=>[x[0],cv(x[1],e.c)]); if(!pts.length) return;
  const vs=pts.map(p=>p[1]), lo=Math.min(...vs), hi=Math.max(...vs), rg=(hi-lo)||1, n=pts.length;
  const xy=pts.map((p,i)=>[(n===1?150:i/(n-1)*300).toFixed(1),(58-(p[1]-lo)/rg*52).toFixed(1)]);
  const svg=`<svg viewBox="0 0 300 64" preserveAspectRatio="none" role="img" aria-label="${C.hist}"><polyline fill="none" stroke="#13795c" stroke-width="2" vector-effect="non-scaling-stroke" points="${xy.map(p=>p.join(',')).join(' ')}"/>${n<4?xy.map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="3" fill="#13795c"/>`).join(''):''}</svg>`;
  const note=H.length<7&&HD===90?C.since.replace('{d}',H[0][0]):C.lowN.replace('{n}',HD).replace('{p}',f(lo));
  B.innerHTML=`${svg}<p class="muted small">${note}</p>`; B.hidden=false;
  B.querySelectorAll('[data-d]').forEach(x=>x.onclick=()=>{HD=+x.dataset.d; hist(cv,f);});}
 render(); document.addEventListener('wp:region',render);
 if(e.drop>0){const b=document.getElementById('pxdrop'); b.textContent=PX.drop.replace('{n}',e.drop); b.hidden=false;}
 window.wpApply&&window.wpApply();}).catch(()=>{});
</script>
<script is:inline define:vars={{cur:{s:r.slug,m:r.model,i:r.image||''},RK:url('racket',lang,'X').replace(/X\/$/,''),CMP:url('compare',lang),CW:u.compareWith('§')}}>
document.body.classList.add('has-sticky');
const sc=document.getElementById('stickycta'),bb=document.getElementById('buybox');
new IntersectionObserver(([e])=>{const show=!e.isIntersecting;sc.classList.toggle('show',show);sc.setAttribute('aria-hidden',!show);}).observe(bb);
try{const K='rv_'+RK.split('/')[1]; let rv=JSON.parse(localStorage[K]||'[]').filter(x=>x.s!==cur.s);const w=document.getElementById('rv');const e=s=>s.replace(/[<>&]/g,'');
if(rv.length){w.innerHTML=rv.slice(0,8).map(x=>`<a href="${RK}${x.s}/">${x.i?`<img src="${x.i}" alt="" width="60" height="72" loading="lazy">`:''}<span>${e(x.m)}</span></a>`).join('')+`<a href="${CMP}?r=${cur.s},${rv[0].s}"><span>${CW.replace('§',e(rv[0].m))}</span></a>`;document.getElementById('rv-wrap').hidden=false;}
localStorage[K]=JSON.stringify([cur,...rv].slice(0,10));}catch(e){}
</script>
</Base>
