---
// US money pages (English, USD). Lists only items with a live US-dollar price from a shop that delivers in the US (data/us.json snapshot;
// cards then refresh from /api/prices). Country defaults to US on these pages unless the visitor saved another choice.
import Base from '../layouts/Base.astro'; import CardL from '../components/CardL.astro'; import ShoeCard from '../components/ShoeCard.astro'; import '../styles/hub.css';
import { US_PAGES, US_KEYS, US_CHECKED } from '../lib/us.js'; import { url, SITE } from '../i18n/index.js';
const { k } = Astro.props; const P=US_PAGES[k]; const list=P.list(); const n=list.length; const isS=P.kind==='s';
const C={
 'best-padel-rackets':[`Best padel rackets in the USA`,`The ${n} best padel rackets (paddles) you can buy from US shops today, ranked by our ratings, with live prices in US dollars.`],
 'padel-rackets-for-beginners':[`Best padel rackets for beginners in the USA`,`${n} forgiving, easy-to-play padel rackets for new players, all sold by shops that deliver in the US, priced in dollars.`],
 'padel-shoes':[`Padel shoes in the USA`,`${n} padel shoes in stock at shops that deliver in the US, with live prices in dollars. Padel shoes have a padel or clay outsole built for sideways movement on sand-filled turf.`],
};
const [h1,intro]=C[k]||(isS?[`Padel shoes under $${P.cap} in the USA`,`${n} padel shoes at $${P.cap} or less from shops that deliver in the US, ranked by availability and season.`]:[`Best padel rackets under $${P.cap} in the USA`,`${n} padel rackets at $${P.cap} or less from US-delivering shops, ranked by power, control and comfort.`]);
const U=SITE+url('us','en',k); const title=`${h1} (2026): ${n} picks, $ prices | WhichPadel`;
const desc=`${intro.split('. ')[0]}.`.slice(0,158);
const faq=[
 ['Is a padel racket the same as a padel paddle?','Yes. In the US many players say padel paddle; in Europe it is a padel racket. Both mean the same solid, stringless, perforated racket with a wrist strap. A padel racket is not a pickleball paddle.'],
 ['Which shops are included?','Only shops that deliver in the US and charge in US dollars. Each card shows the lowest current dollar price; open a racket to compare every US shop.'],
 ['How fresh are the prices?','We recheck each price about every 8 hours and hide any offer that has not been confirmed in the last 48 hours. Prices can change at any time, so check the shop before you buy.'],
 ...(isS?[['How do padel shoe sizes convert to US sizes?',"As a guide, men's US size = UK size + 1 and women's US size = UK size + 2. Fit varies by brand, so check the shop's size chart."]]:[]),
];
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'ItemList','name':h1,'url':U,'numberOfItems':n,'itemListElement':list.map((x,i)=>({'@type':'ListItem','position':i+1,'url':SITE+url(isS?'shoe':'racket','en',x.slug),'name':x.model||x.name}))},
 {'@type':'FAQPage','mainEntity':faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))},
 {'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':SITE+'/'},{'@type':'ListItem','position':2,'name':h1,'item':U}]}]};
const label=x=>C[x]?.[0]||(US_PAGES[x].kind==='s'?`Padel shoes under $${US_PAGES[x].cap}`:`Padel rackets under $${US_PAGES[x].cap}`);
const others=US_KEYS.filter(x=>x!==k);
---
<Base lang="en-US" title={title} description={desc} jsonld={jsonld} region="US" usPage>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <span>{h1}</span></nav>
<div class="hub us">
<header class="hub-hd"><h1>{h1} (2026)</h1><p class="lead-sm">{intro}</p></header>
<p class="rulebox"><b>How this list is built:</b> only {isS?'shoes':'rackets'} with a live US-dollar price from a shop that delivers in the US. Checked {US_CHECKED}; prices refresh every 8 hours.</p>
{isS?<ul class="hub-grid">{list.map((s,i)=><ShoeCard s={s} lang="en" rank={i+1} eager={i<4} region="US"/>)}</ul>
 :<div class="rlist">{list.map((r,i)=><CardL r={r} rank={i+1} lang="en" eager={i===0} region="US"/>)}</div>}
<p><a class="btn btn-line" href={isS?url('shoes','en'):url('rackets','en',1)}>{isS?'Compare all padel shoes →':'Compare all padel rackets →'}</a></p>
<section class="panel"><h2 class="h3">FAQ</h2>{faq.map(([q,a])=><details><summary><b>{q}</b></summary><p>{a}</p></details>)}</section>
{others.length>0&&<section class="hub-pre"><h2 class="h3">More for US players</h2><p>{others.map(x=><a href={url('us','en',x)}>{label(x)}</a>)}</p></section>}
</div>
</Base>
