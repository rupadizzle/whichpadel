{view.missing && <p class="muted small mt3">{view.missing}</p>}</details>
{view.similar.length > 0 && <section class="panel"><h2>{view.similarH}</h2><div class="rpsim">{view.similar.map(item => <a href={item.href}><span class="rpsi">{item.img ? <img src={item.img} alt="" width="72" height="90" loading="lazy" decoding="async"/> : item.shape ? <RacketIcon shape={item.shape} size={40}/> : null}</span><span><b>{item.title}</b><small>{item.lead}{item.lead && item.item ? ' · ' : ''}{item.item && <Price r={item.item} lang={lang}/>}</small></span></a>)}</div>
{view.similarCmp && <a class="btn btn-line rpcmp" href={view.similarCmp.href}>{view.similarCmp.label} →</a>}</section>}
