 if(document.body.classList.contains('px-live')) return;
 const M=document.getElementById('buymain'), big=document.getElementById('pxbig'), note=document.getElementById('pxstatic'), nous=document.getElementById('bxnous'), cmpNous=document.querySelector('#pxcmp .pxnous'), size=document.getElementById('pxsize'), disc=document.querySelector('#buybox .disc');
 const shop=(sc&&sc.querySelector('.sp>span')||{}).textContent.trim()||'', priceEl=sc&&sc.querySelector('.sp b .pz'), price=(priceEl?priceEl.textContent:big?big.textContent:'').replace(/\s+/g,' ').trim();
 const why=nous&&!nous.hidden?nous:(cmpNous||null);
