}
syncBar(); mq.addEventListener('change',syncBar);
const esc=s=>String(s==null?'':s).replace(/[<>&"]/g,c=>'&#'+c.charCodeAt(0)+';');
let opener=null;
function sheetOpen(){const D=document.getElementById('pxsheet'); if(!D) return; opener=document.activeElement; D.hidden=false; document.documentElement.classList.add('pxlock'); requestAnimationFrame(()=>requestAnimationFrame(()=>D.classList.add('open'))); setTimeout(()=>{const p=D.querySelector('.pxsp'); if(p) p.focus();},30);}
function sheetClose(){const D=document.getElementById('pxsheet'); if(!D||D.hidden||D.dataset.live==='1') return; D.classList.remove('open'); const p=D.querySelector('.pxsp'); if(p) p.style.transform=''; document.documentElement.classList.remove('pxlock'); setTimeout(()=>{D.hidden=true;},matchMedia('(prefers-reduced-motion: reduce)').matches?0:250); if(opener&&opener.focus) opener.focus();}
