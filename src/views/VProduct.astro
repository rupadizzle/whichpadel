</div>
{kind === 'racket' && <><section class="nudge" id="rv-wrap" hidden><h2>{u.recent}</h2><div class="rv" id="rv"></div></section>
<StickyCta r={r} lang={lang} shop={page.buy.shop || page.BN} openLabel={u.px.cmp.openS} buyLabel={u.px.cmp.showP}/></>}
{kind === 'shoe' && <><section class="nudge" id="rv-wrap" hidden><h2>{u.recent}</h2><div class="rv" id="rv"></div></section>
<StickyCta r={s} lang={lang} shop={page.shoe.BN} openLabel={u.px.cmp.openS} buyLabel={u.px.cmp.showP}/></>}
{kind === 'ball' && <StickyCta r={b} lang={lang} shop={page.ball.BN} openLabel={u.px.cmp.openS} buyLabel={u.px.cmp.showP}/>}
{kind === 'bag' && <StickyCta r={g} lang={lang} shop={page.bag.BN} openLabel={u.px.cmp.openS} buyLabel={u.px.cmp.showP}/>}
<script is:inline define:vars={{ SHIP: shipData.shops, RATES: FX.rates }}>
window.wpShip=function(d,region,price,cur){
 const rules=SHIP[d]; if(!rules||price==null||!region) return null;
 const rule=rules.find(x=>x.r.indexOf(region)>=0); if(!rule||!RATES[cur]||!RATES[rule.c]) return null;
 const p=cur===rule.c?+price:+price/RATES[cur]*RATES[rule.c]; if(!Number.isFinite(p)) return null;
 const band=rule.b.slice().sort((a,b)=>b[0]-a[0]).find(x=>p+1e-6>=x[0]); if(!band) return null;
 return {fee:band[1],cur:rule.c};
};
window.wpConv=function(n,from,to){if(n==null||!RATES[from]||!RATES[to]) return null; const v=from===to?+n:+n/RATES[from]*RATES[to]; return Number.isFinite(v)?v:null;};
</script>
{(kind === 'racket' || kind === 'shoe' || kind === 'bag') && <ProductPriceScript slug={page.slug} name={page.name} u={u} SN={page.SN} lang={lang} api={page.api} sizeNote={page.sizeNote}/>}
{(kind === 'racket' || kind === 'shoe') && <script is:inline define:vars={{ cur: page.recent.cur, RK: page.recent.rk, CMP: page.recent.cmp, CW: page.recent.cw, CMPLINK: page.recent.link }}>
try{const K='rv_'+RK.split('/')[1]; let rv=JSON.parse(localStorage[K]||'[]').filter(x=>x.s!==cur.s);const w=document.getElementById('rv');const e=s=>s.replace(/[<>&]/g,'');
rv=rv.filter(x=>x&&/^[a-z0-9-]{1,80}$/.test(x.s||''));const mk=(href,img,t)=>{const a=document.createElement('a');a.href=href;if(img){const i=document.createElement('img');i.src=img;i.alt='';i.width=60;i.height=72;i.loading='lazy';a.append(i);}const sp=document.createElement('span');sp.textContent=t;a.append(sp);return a;};
if(rv.length){rv.slice(0,8).forEach(x=>w.append(mk(`${RK}${x.s}/`,/^\/(rackets|shoes)\/[a-z0-9\/._-]+\.webp$/.test(x.i||'')?x.i:'',e(String(x.m||'')))));if(CMPLINK)w.append(mk(`${CMP}?r=${cur.s},${rv[0].s}`,'',CW.replace('§',e(String(rv[0].m||'')))));document.getElementById('rv-wrap').hidden=false;}
localStorage[K]=JSON.stringify([cur,...rv].slice(0,10));}catch(e){}
</script>}
<script is:inline define:vars={{ BUY: u.px.cmp.buyS, CLOSE: u.px.cmp.close, N1: u.px.cmp.n1, SEEK: u.px.cmp.seek, FREE: u.px.cmp.shipFree, PLUS: u.px.cmp.shipPlus, EXTRA: u.px.cmp.shipExtra }}>
document.body.classList.add('has-sticky');
const sc=document.getElementById('stickycta'), mq=matchMedia('(max-width:899px)');
