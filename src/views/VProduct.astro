 const list=!why&&M&&M.href?`<p class="pxsub pxcnt">${esc(N1)}</p><ul class="pxl"><li class="pxr best"><span class="pxs"><b>${esc(shop)}</b></span><span class="pxp">${esc(price)}${shipNote()}</span><a class="btn pxb pri" href="${esc(M.href)}" rel="sponsored nofollow">${esc(BUY)}</a></li><li class="pxr pxseek"><span class="pxs"><b>${esc(SEEK)}</b></span></li></ul>${checked}`:'';
 const row=why?`<p class="pxnous">${esc(why.textContent)}</p>`:(list||`<p class="pxbigp">${esc(price)}</p>`);
 const P=document.getElementById('pxcmp'); if(list&&P){P.innerHTML=list; P.hidden=false; if(big) big.hidden=true; if(note) note.hidden=true; M.hidden=true;}
 D.dataset.live='0';
 D.innerHTML=`<div class="pxsb" data-x></div><div class="pxsp" role="dialog" aria-modal="true" aria-labelledby="pxst" tabindex="-1"><div class="pxsg" aria-hidden="true"></div><div class="pxsh"><h2 id="pxst">${esc(title)}</h2><button type="button" class="pxsx" data-x aria-label="${esc(CLOSE)}">✕</button></div><div class="pxsc">${row}${size?`<p class="pxsize">${esc(size.textContent.trim())}</p>`:''}${disc?`<p class="disc">${disc.innerHTML}</p>`:''}</div></div>`;
 D.querySelectorAll('[data-x]').forEach(x=>x.onclick=sheetClose);
 const p=D.querySelector('.pxsp'), box=D.querySelector('.pxsc'); let y0=null, dy=0;
 p.addEventListener('touchstart',e=>{if(box.scrollTop>0&&box.contains(e.target)){y0=null;return;} y0=e.touches[0].clientY; dy=0; p.style.transition='none';},{passive:true});
 p.addEventListener('touchmove',e=>{if(y0==null) return; dy=Math.max(0,e.touches[0].clientY-y0); p.style.transform=`translateY(${dy}px)`;},{passive:true});
 p.addEventListener('touchend',()=>{if(y0==null) return; p.style.transition=''; if(dy>80) sheetClose(); else p.style.transform=''; y0=null;});
 if(sc&&!sc.dataset.wired){sc.dataset.wired='1'; sc.addEventListener('click',sheetOpen);}
}
if(!window.__pxStaticKeys){window.__pxStaticKeys=1; document.addEventListener('keydown',e=>{const D=document.getElementById('pxsheet'); if(!D||D.hidden||D.dataset.live==='1') return; if(e.key==='Escape'){e.preventDefault(); sheetClose(); return;}
 if(e.key==='Tab'){const F=[...D.querySelectorAll('a[href],button:not([hidden])')].filter(x=>x.offsetParent!==null); if(!F.length) return; const a=F[0], z=F[F.length-1];
  if(e.shiftKey&&(document.activeElement===a||document.activeElement===D.querySelector('.pxsp'))){e.preventDefault(); z.focus();} else if(!e.shiftKey&&document.activeElement===z){e.preventDefault(); a.focus();}}});}
document.addEventListener('px-static',arm); document.addEventListener('wp:region',()=>{if(window.__pxStatic&&!document.body.classList.contains('px-live')) arm();}); if(window.__pxStatic) arm();
</script>
