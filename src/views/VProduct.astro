{view.more.length > 0 && <section class="panel vs"><h2>{view.moreH}</h2>{view.more.map(item => <a href={item.href}><span>{item.name}</span><span>→</span></a>)}{(view.allHref || view.yearMore) && <p class="m0 mt3">{view.allHref && <a href={view.allHref}>{view.allLabel}</a>}{view.yearMore && <>{view.allHref && ' · '}<a href={view.yearMore.href}>{view.yearMore.label}</a></>}</p>}</section>}
