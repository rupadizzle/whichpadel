---
// One finder for rackets, shoes, balls and bags. The first choice picks the product;
// each product has its own questions and scoring. Racket scoring is unchanged, and
// old racket result links (no ?p=) still open.
import Base from '../layouts/Base.astro'; import { rackets } from '../lib/data.js'; import { shoes } from '../lib/shoes.js'; import { balls } from '../lib/balls.js'; import { bags } from '../lib/bags.js';
import { D, url, SITE, CURL } from '../i18n/index.js';
import { HOME } from '../i18n/home.js'; import { FINDER } from '../i18n/finder.js'; import { FZ } from '../i18n/finder2.js'; import { KIT } from '../i18n/finder-kit.js'; import { HUB } from '../i18n/hub.js';
import RkCardTemplate from '../components/RkCardTemplate.astro';
import { SHOPS, offersOf, FX } from '../lib/price.js'; import { fmtM, val, SYMS } from '../lib/money.js';
const { lang } = Astro.props; const d=D(lang), u=d.ui, H=HOME[lang], F=FINDER[lang], Z=FZ[lang], K=KIT[lang]; const CUR0=CURL(lang);
const L=(t,id)=>url(t,lang,id);
const hasBag=!!L('bag','x');
const prods=K.products.filter(p=>p.id!=='bag'||hasBag);
const doms=new Set();
rackets.forEach(r=>offersOf(r).forEach(o=>o.d&&doms.add(o.d)));
for(const list of [shoes,balls,...(hasBag?[bags]:[])]) list.forEach(x=>(x.offs||[]).forEach(o=>o.d&&doms.add(o.d)));
const nShops=doms.size;
const SN=Object.fromEntries(Object.entries(SHOPS).map(([k,s])=>[k,[s.name&&s.name!==k?s.name:k.replace(/\.(com|net|co\.uk|es|de|fr|it|pt)$/,''),typeof s.affiliate==='string'&&s.affiliate.startsWith('https://')?s.affiliate:'']]));
const jsonld={'@context':'https://schema.org','@graph':[
 {'@type':'WebApplication','name':F.h1,'url':SITE+L('finder'),'applicationCategory':'SportsApplication','inLanguage':lang,'offers':{'@type':'Offer','price':'0','priceCurrency':'EUR'}},
 {'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+L('home')},{'@type':'ListItem','position':2,'name':F.crumb,'item':SITE+L('finder')}]}]};
const BUD=['100','150','200','300','any'];
const money=s=>String(s).replace(/⟦([mbsMBS])\|([\d.]+)\|([A-Za-z]{3})\|([A-Za-z]{3})⟧/g,(_,k,n,f,d0)=>{k=k.toLowerCase();f=f.toUpperCase();d0=d0.toUpperCase();return k==='s'?`<span class="mzs" data-mc="${d0}">${SYMS[d0]}</span>`:`<span class="mz" data-k="${k}" data-m="${n}" data-mc="${f}">${fmtM(val(FX.rates,k,+n,f,d0),d0,lang)}</span>`;});
const budL=[...H.budgets.slice(0,3),H.budgets[2].replace('|200|','|300|'),H.budgets[3]].map(money);
const Q=[['level',Z.q[0],['beginner','intermediate','advanced'],Z.lv],['side',Z.q[1],['right','left','either'],Z.sd],['style',Z.q[2],['control','all','power'],Z.st],['prio',Z.q[3],['comfort','light','durable','latest'],Z.pr],
 ['budget',Z.q[4],BUD,BUD.map((v,i)=>[['💷','💶','💳','💎','🚀'][i],budL[i],Z.bh[i]])]];
const rows=(k,q,list)=>({k,q,opts:list.map(([v,ic,t,h])=>({v,ic,t,h,html:false}))});
const budgetStep=(q,amounts,hints)=>({k:'budget',q,opts:[
 ...amounts.map((n,i)=>({v:String(n),ic:['💷','💶','💳','💎'][i],t:K.upto.replace('§',money(`⟦b|${n}|${CUR0}|${CUR0}⟧`)),h:hints[i],html:true,mb:String(n)})),
 {v:'any',ic:'🚀',t:K.nolimit,h:hints[amounts.length],html:false}]});
const racketSteps=Q.map(([k,q,vals,opts])=>({k,q,opts:vals.map((v,j)=>({v,ic:opts[j][0],t:opts[j][1],h:opts[j][2],html:k==='budget',mb:k==='budget'&&v!=='any'?v:undefined}))}));
const shoeSteps=[rows('who',K.shoes.q[0],K.shoes.who),rows('court',K.shoes.q[1],K.shoes.court),rows('fit',K.shoes.q[2],K.shoes.fit),budgetStep(K.shoes.q[3],K.shoes.amounts,K.shoes.bh)];
const ballSteps=[rows('use',K.balls.q[0],K.balls.use),rows('speed',K.balls.q[1],K.balls.speed),budgetStep(K.balls.q[2],K.balls.amounts,K.balls.bh)];
const bagSteps=[rows('carry',K.bags.q[0],K.bags.carry),rows('cap',K.bags.q[1],K.bags.cap),rows('extra',K.bags.q[2],K.bags.extra),budgetStep(K.bags.q[3],K.bags.amounts,K.bags.bh)];
const QUIZ=[{id:'racket',steps:racketSteps},{id:'shoes',steps:shoeSteps},{id:'balls',steps:ballSteps},...(hasBag?[{id:'bag',steps:bagSteps}]:[])];
const ZC={...Z,sub:null,w:null,cmpShops:Z.cmpShops('§'),buyAt:Z.buyAt('§'),
 more:Z.more('§1'),less:Z.less('§1'),lessStat:Z.lessStat('§1','§2','§3'),moreStat:Z.moreStat('§1','§2','§3'),alertOos:Z.alertOos('§1','§2'),
 W:{forg:Z.w.forg('§1'),ctl:Z.w.ctl('§1'),ctlBeg:Z.w.ctlBeg('§1'),pow:Z.w.pow('§1'),bal:Z.w.bal('§1','§2'),comf:Z.w.comf('§1'),comfSoft:Z.w.comfSoft('§1'),comfW:Z.w.comfW('§1','§2'),light:Z.w.light('§1','§2'),dur:Z.w.dur('§1'),late:Z.w.late('§1'),shops:Z.w.shops('§1','§2'),price:Z.w.price('§1'),right:Z.w.right,left:Z.w.left}};
const pack=s=>({finding:s.finding,none:s.none,w:s.w,tour:s.tour||null});
const KW={shoes:pack(K.shoes),balls:pack(K.balls),bag:pack(K.bags)};
const KL=Object.fromEntries(K.products.map(p=>[p.id,p.t]));
const pref=t=>{const u=L(t,'X'); return u?u.replace(/X\/$/,''):'';};
const U={href:{racket:pref('racket'),shoes:pref('shoe'),balls:pref('ball'),bag:pref('bag')},cmp:{racket:L('rackets'),shoes:L('shoes')||''}};
const subLine=(hasBag?K.sub:K.subShort).split('§');
const CARD={shape:d.terms.shapeCap,from:HUB[lang].fromP,save:u.save,saved:u.saved,kind:{racket:'r',shoes:'s',balls:'b',bag:'g'}};
---
<Base lang={d.locale} focus title={F.title+' | WhichPadel'} description={F.desc()} jsonld={jsonld}>
<div class="fz" id="fz" data-state="intro">
<div class="fz-modes" id="fz-modes" role="group" aria-label={K.ask} hidden>{prods.map(p=><button type="button" data-mode={p.id}>{p.t}</button>)}</div>
<section class="fz-scr fz-intro" data-scr="intro">
 <h1>{K.promise}</h1>
 <p class="fz-sub">{subLine[0]}<span id="fz-ns">{nShops}</span>{subLine[1]}</p>
 <p class="fz-ask">{K.ask}</p>
 <div class="fz-prods">{prods.map(p=><button type="button" class="fz-prod" data-prod={p.id}><span class="fz-oc"><span class="fz-ic" aria-hidden="true">{p.ic}</span><span class="fz-ot"><b>{p.t}</b><small>{p.h}</small></span></span></button>)}</div>
 <p class="fz-trust">{K.note}</p>
 <p class="fz-trust">✓ {Z.trust}</p>
</section>
<section class="fz-scr fz-q" data-scr="q" hidden>
 <div class="fz-top"><button type="button" class="fz-back" id="fz-back" aria-label={Z.back}>←</button><div class="fz-prog" role="progressbar" aria-valuemin="1" aria-valuemax="5" aria-valuenow="1" id="fz-pr"><i id="fz-bar"></i></div><span class="fz-cnt" id="fz-cnt">1/5</span></div>
 <form id="fq" onsubmit="return false">
 {QUIZ.map(p=>p.steps.map((st,i)=><fieldset class="fz-step" data-p={p.id} data-k={st.k} data-i={i} hidden><legend class="fz-qh">{st.q}</legend>
 <div class="fz-opts">{st.opts.map(o=><label class="fz-o"><input type="radio" name={p.id==='racket'?st.k:`${p.id}-${st.k}`} value={o.v} data-t={o.v} data-mb={o.mb||undefined} data-mc={o.mb?CUR0:undefined}/><span class="fz-oc"><span class="fz-ic" aria-hidden="true">{o.ic}</span><span class="fz-ot">{o.html?<b set:html={o.t}/>:<b>{o.t}</b>}<small>{o.h}</small></span></span></label>)}</div></fieldset>))}
 </form>
</section>
<section class="fz-scr fz-load" data-scr="load" hidden aria-live="polite"><span class="fz-spin" aria-hidden="true"></span><p id="fz-finding">{Z.finding}</p></section>
<section class="fz-scr fz-res" data-scr="res" hidden aria-live="polite"><RkCardTemplate lang={lang}/><div id="fz-out"></div>
 <form class="fz-alert" id="fz-alert" novalidate><h2 class="h3" id="fz-ah">🔔 {Z.alertH}</h2><div class="fz-af"><input type="email" required placeholder={Z.email} aria-label={Z.email} autocomplete="email"/><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp"/><button class="btn">{Z.alertB}</button></div>
 <label class="fz-cons"><input type="checkbox" required/> <span>{Z.consent} <a href={L('privacy')}>{Z.priv}</a>.</span></label><p class="fz-msg" hidden></p></form>
 <p class="disc">{Z.ad} <a href={L('affiliate')}>{Z.disc}</a></p>
</section>
<div class="fz-bar" id="fz-sticky" hidden></div>
</div>
<script is:inline define:vars={{Z:ZC,U,SN,KW,KL,LG:lang,CARD}}>
const $=id=>document.getElementById(id), fz=$('fz'), BASE_TITLE=document.title; const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const R=(t,...a)=>a.reduce((o,v,i)=>o.split('§'+(i+1)).join(v),t).replace('§',a[0]);
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
let prod='racket', cur=0;
const steps=()=>[...document.querySelectorAll(`#fq .fz-step[data-p="${prod}"]`)];
const rv=n=>(document.querySelector(`#fq input[name="${n}"]:checked`)||{}).value||'';
function syncModes(){const bar=$('fz-modes'); bar.hidden=fz.dataset.state!=='q'; bar.querySelectorAll('[data-mode]').forEach(b=>{if(b.dataset.mode===prod) b.setAttribute('aria-current','true'); else b.removeAttribute('aria-current');});}
const scr=s=>{fz.dataset.state=s; document.querySelectorAll('.fz-scr').forEach(e=>{const on=e.dataset.scr===s; e.hidden=!on; if(on&&!RM){e.classList.remove('in'); void e.offsetWidth; e.classList.add('in');}}); $('fz-sticky').hidden=s!=='res'; syncModes(); if(s!=='res'){document.title=BASE_TITLE; fz.classList.remove('fz-oosdeal');} if(s==='intro'&&location.search) history.replaceState(null,'',location.pathname); scrollTo(0,0);};
function enter(id){if(!id||(id===prod&&fz.dataset.state!=='intro')) return; prod=id; if(prod==='racket') load(); else loadKit(); const st=steps(); const missing=st.findIndex(s=>!s.querySelector('input:checked')); if(missing===-1&&st.length){finish(); return;} const q=new URLSearchParams({p:prod}); for(const s of st){const inp=s.querySelector('input:checked'); if(!inp) continue; const k=s.dataset.k; q.set(k,k==='budget'?inp.dataset.t:inp.value);} history.replaceState(null,'','?'+q); show(missing<0?0:missing);}
function show(i){cur=i; scr('q'); const st=steps(); document.querySelectorAll('#fq .fz-step').forEach(s=>{s.hidden=true;}); const s=st[i]; if(!s) return; s.hidden=false; if(!RM){s.classList.remove('in'); void s.offsetWidth; s.classList.add('in');}
 $('fz-bar').style.width=((i+1)/st.length*100)+'%'; $('fz-cnt').textContent=(i+1)+'/'+st.length; $('fz-pr').setAttribute('aria-valuemax',st.length); $('fz-pr').setAttribute('aria-valuenow',i+1);
 const f=s.querySelector('input:checked')||s.querySelector('input'); try{f.focus({preventScroll:true})}catch(e){} }
$('fz-back').onclick=()=>cur>0?show(cur-1):scr('intro');
document.querySelectorAll('[data-prod]').forEach(b=>b.onclick=()=>enter(b.dataset.prod));
document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>enter(b.dataset.mode));
document.querySelectorAll('#fq .fz-step').forEach(s=>{
 s.addEventListener('pointerdown',e=>{const inp=e.target.closest('.fz-o')?.querySelector('input'); s.dataset.keep=inp&&inp.checked?'1':'';});
 s.addEventListener('click',e=>{if(s.dataset.p!==prod||s.dataset.keep!=='1') return; s.dataset.keep=''; const inp=e.target.closest('.fz-o')?.querySelector('input'); if(inp&&inp.checked) advance(+s.dataset.i);});
 s.addEventListener('change',()=>{if(s.dataset.p!==prod) return; setTimeout(()=>advance(+s.dataset.i),RM?0:180);});
});
function advance(i){const st=steps(); if(i<st.length-1&&st.slice(i+1).every(x=>x.querySelector('input:checked'))) finish(); else if(i<st.length-1) show(i+1); else finish();}
let all=null,prom=null,kit=null,kitProm=null;
const bumpNs=n=>{const el=$('fz-ns'); if(el&&n>+el.textContent) el.textContent=n;};
const paint=(list,live,key)=>list.forEach(c=>{const r=live[c[key]]; if(!r) return; const os=(Array.isArray(r.o)&&r.o.length?r.o:[r]).filter(o=>o.p>0); if(os.length) c.o=os.map(o=>({d:o.d,p:o.p,c:o.c,u:o.u,s:o.s,t:o.t}));});
const load=()=>prom||(prom=Promise.all([fetch('/cards.json').then(r=>r.json()),fetch('/api/all-prices').then(r=>r.ok?r.json():null).catch(()=>null)]).then(([a,p])=>{const live=p&&p.r||{}; paint(a,live,'s'); bumpNs(new Set(a.flatMap(c=>(c.o||[]).map(o=>o.d))).size); all=a; return a;}));
const loadKit=()=>kitProm||(kitProm=Promise.all([fetch('/kit.json').then(r=>r.json()),fetch('/api/shoe-prices').then(r=>r.ok?r.json():null).catch(()=>null)]).then(([cat,p])=>{const live=p&&p.r||{}; for(const list of [cat.shoes,cat.balls,cat.bags]) paint(list,live,'px'); const ns=new Set([cat.shoes,cat.balls,cat.bags].flat().flatMap(c=>(c.o||[]).map(o=>o.d))).size; bumpNs(ns); kit=cat; return cat;}));
load();
const bq=r=>(window.WP&&r.o&&r.o.length)?WP.best(r.o):null; const pn=r=>{const q=bq(r); return q&&q.v!=null?q.v:null;};
const W={beginner:{forgiveness:3,comfort:2,handling:1,control:1},intermediate:{control:2,power:1,forgiveness:1,handling:1},advanced:{power:1.5,control:1.5,handling:1}};
const SW={control:{control:3},all:{control:1.5,power:1.5,handling:1},power:{power:3}};
const SIDEW={right:{control:2,forgiveness:1},left:{power:2},either:{}};
const PW={comfort:{comfort:2,forgiveness:1},light:{handling:2},durable:{},latest:{}};
const SHP={control:'round',all:'teardrop',power:'diamond'};
const OK={beginner:d=>d.sh!=='diamond'&&['soft','medium-soft','medium',''].includes(d.c)&&d.forgiveness>=60,intermediate:d=>d.power>=30&&d.control>=30,advanced:()=>true};
const shopsOf=d=>{const m=new Map(); (d.o||[]).forEach(o=>{if(window.WP&&WP.shop(o.d,o.c)==='n') return; const q=WP.best([o]); if(q.v==null) return; const x=m.get(o.d); if(!x||q.v<x.v) m.set(o.d,{...o,v:q.v,txt:q.txt});}); return [...m.values()].sort((a,b)=>((a.s===0)-(b.s===0))||a.v-b.v);};
const sn=d=>esc((SN[d]||[d])[0]); const hrefShop=o=>{const a=(SN[o.d]||[])[1]; if(a) return a.replace('{url}',encodeURIComponent(o.u)); try{const u=new URL(o.u); if(!u.searchParams.has('utm_source')){u.searchParams.set('utm_source','whichpadel'); u.searchParams.set('utm_medium','referral');} return u.toString();}catch(e){return o.u;}};
function rank(A){const L=A.level,S=A.style,P=A.prio,Sd=A.side||'either'; const Bi=document.querySelector(`#fq input[name="budget"][data-t="${A.budget}"]`); const B=A.budget==='any'||!Bi?0:+Bi.value;
 const k=(+(document.querySelector('#fq input[data-t="200"]')||{}).value||200)/200; const gp=d=>pn(d)/k;
 const w={...W[L]}; for(const o of [SW[S],SIDEW[Sd]||{},PW[P]]) for(const [kk,v] of Object.entries(o)) w[kk]=(w[kk]||0)+v; const tot=Object.values(w).reduce((a,b)=>a+b,0);
 const want=L==='beginner'?'round':SHP[S]; const ov=d=>(d.power+d.control+d.forgiveness+d.comfort+d.handling)/5;
 const tier=d=>{const p=gp(d); if(L==='advanced') return Math.min(p,250)/250*10-(S==='power'&&/\b(team|light|lite|control)\b/i.test(d.m)?4:0); if(L==='intermediate') return p>=70&&p<=220?5:0; return 0;};
 const pri=d=>P==='light'?(d.w1&&d.w1<=360?6:d.w0>=370?-4:0):P==='durable'?((d.c==='hard'?5:d.c==='medium'?3:0)+(gp(d)>=120?2:0)):P==='latest'?(d.y>=2026?8:d.y>=2025?3:-3):P==='comfort'?(d.c==='soft'?3:0):0;
 const sideN=d=>Sd==='right'?(d.sh==='round'?4:(d.sh==='teardrop'||d.sh==='hybrid')?2:0):Sd==='left'?(d.sh==='diamond'?4:(d.sh==='teardrop'||d.sh==='hybrid')?2:0):0;
 const sc=d=>{const fit=Object.entries(w).reduce((a,[kk,v])=>a+(d[kk]||0)*v,0)/tot; return 0.8*fit+0.2*ov(d)+(d.sh===want?5:(d.sh==='hybrid'||d.sh==='teardrop')?2:0)+sideN(d)+(shopsOf(d).length>=2?3:0)+(d.y>=2025?3:d.y&&d.y<=2023?-4:0)+(B?pn(d)/B*8:0)+(d.i?1:0)+tier(d)+pri(d);};
 const pool=all.filter(d=>pn(d)!=null&&(!B||(pn(d)<=B&&pn(d)>=B*0.4))&&OK[L](d)&&(P!=='comfort'||(['soft','medium-soft'].includes(d.c)&&d.bl!=='high'&&!(d.w1>365)))&&d.a!=='women'&&d.a!=='junior'&&!/\b(jr|junior|kids?|women|woman|lady|w)\b/i.test(d.m)).map(d=>({d,s:sc(d)})).sort((a,b)=>b.s-a.s);
 const top=[],br=new Set(); for(const x of pool){const bb=x.d.b.toLowerCase(); if(br.has(bb)) continue; br.add(bb); top.push(x); if(top.length===3) break;}
 const why=d=>{const sh=Z.shape[d.sh]||''; const shw=(LG==='en'||LG==='de')&&sh?sh.charAt(0).toUpperCase()+sh.slice(1):sh;
  const shape=shw?R(Z.W.forg,shw):'';
  const style=S==='control'?R(L==='beginner'?Z.W.ctlBeg:Z.W.ctl,d.control):S==='power'?R(Z.W.pow,d.power):R(Z.W.bal,d.power,d.control);
  let pri='';
  if(P==='comfort'){const grams=d.w0?(d.w1&&+d.w1!==+d.w0?d.w0+'–'+d.w1:String(d.w0)):''; const soft=d.c==='soft'||d.c==='medium-soft'; pri=soft&&grams?R(Z.W.comfW,grams,d.comfort):soft?R(Z.W.comfSoft,d.comfort):R(Z.W.comf,d.comfort);}
  else if(P==='light'&&d.w0){const span=R(Z.W.light,d.w0,d.w1&&+d.w1!==+d.w0?d.w1:d.w0); pri=!d.w1||+d.w1===+d.w0?span.replace(/(\d+)\s*[–-]\s*\1/,'$1'):span;}
  else if(P==='durable'&&d.c) pri=R(Z.W.dur,Z.core[d.c]||d.c);
  else if(P==='latest'&&d.y) pri=R(Z.W.late,d.y);
  const side=Sd==='right'?Z.W.right:Sd==='left'?Z.W.left:'';
  const rows=side?[style,pri,side]:[shape,style,pri];
  if(rows.filter(Boolean).length<3){const ss=shopsOf(d); if(ss.length) rows.push(ss.length>1?R(Z.W.shops,ss.length,ss[0].txt):R(Z.W.price,ss[0].txt));}
  return rows.filter(Boolean).slice(0,3);};
 return top.map(x=>({...x,why:why(x.d)}));}
function budgetOf(A){if(!A.budget||A.budget==='any') return 0; const name=prod==='racket'?'budget':prod+'-budget'; const Bi=document.querySelector(`#fq input[name="${name}"][data-t="${A.budget}"]`); return Bi?+Bi.value:0;}
function top3(pool){const top=[],br=new Set(); for(const x of pool){const bb=(x.d.b||'').toLowerCase(); if(br.has(bb)) continue; br.add(bb); top.push(x); if(top.length===3) break;} return top;}
function rankKit(A){const spec=KW[prod], W=spec.w, B=budgetOf(A); const list=kit[prod==='shoes'?'shoes':prod==='balls'?'balls':'bags']||[]; const pool=[];
 for(const d of list){const price=pn(d); if(price==null) continue; if(B&&(price>B||price<B*0.4)) continue; let sc=0; const why=[];
  if(prod==='shoes'){ if(A.who==='any'?d.g==='k':d.g!==A.who) continue; const so=d.so||[];
   if(A.court==='outdoor'){ if(so.includes('clay')||so.includes('omni')){sc+=8; why.push(W.clay);} else if(so.includes('herringbone')){sc+=5; why.push(W.herr);} else if(so.includes('allcourt')) sc-=2; }
   else if(A.court==='indoor'){ if(so.includes('allcourt')){sc+=8; why.push(W.indoor);} else if(so.includes('herringbone')) sc+=2; else if(so.includes('clay')||so.includes('omni')) sc-=1; }
   else if(so.includes('herringbone')||so.includes('clay')||so.includes('omni')) sc+=2;
   if(A.fit==='cushion'){ if(d.cu){sc+=6; why.push(R(W.cush,d.cu.charAt(0).toUpperCase()+d.cu.slice(1)));} }
   else if(A.fit==='latest'){ sc+=d.y>=2026?8:d.y>=2025?3:-2; if(d.y) why.push(R(W.late,d.y)); }
   sc+=d.y>=2026?2:d.y>=2025?1:0;
  } else if(prod==='balls'){
   if(A.use==='tour'){ if(d.tr){sc+=8; why.push((spec.tour&&spec.tour[d.tr])||W.tour);} else sc-=5; }
   else if(A.use==='practice'){ if(!d.tr){sc+=4; why.push(W.practice);} }
   else if(d.tr) sc+=1;
   if(A.speed==='medium'||A.speed==='fast'){ if(d.sp===A.speed){sc+=7; why.push(A.speed==='fast'?W.fast:W.med);} else sc-=6; }
  } else { const kind=d.t==='pack'?'pack':'bag'; if(A.carry==='bag'&&kind!=='bag') continue; if(A.carry==='pack'&&kind!=='pack') continue;
   if(A.cap==='few'&&d.rk){ if(d.rk<=2){sc+=6; why.push(d.rk===1?W.few1:R(W.fewN,d.rk));} else sc-=3; }
   if(A.cap==='many'&&d.rk){ if(d.rk>=3){sc+=6; why.push(R(W.many,d.rk));} else sc-=4; }
   if(A.extra==='shoe'){ if(d.sh==='yes'){sc+=8; why.push(W.shoe);} else sc-=2; }
   if(A.extra==='thermal'){ if(d.th==='yes'){sc+=8; why.push(W.thermal);} else sc-=2; }
   if(why.length<3) why.push(kind==='pack'?W.pack:W.bag);
   sc+=d.y>=2026?2:0;
  }
  const ss=shopsOf(d); if(ss.length>=2) sc+=2; if(ss[0]&&ss[0].s!==0) sc+=2;
  if(B) sc+=(prod==='balls'&&A.use==='practice'?(1-price/B):price/B)*3;
  if(why.length<3&&ss.length) why.push(ss.length>1?R(Z.W.shops,ss.length,ss[0].txt):R(Z.W.price,ss[0].txt));
  let miss=false;
  if(prod==='shoes'){ const so=d.so||[]; if(A.court==='outdoor'&&!(so.includes('clay')||so.includes('omni')||so.includes('herringbone'))) miss=true; if(A.court==='indoor'&&!(so.includes('allcourt')||so.includes('herringbone'))) miss=true; if(A.fit==='cushion'&&!d.cu) miss=true; }
  else if(prod==='balls'){ if(A.use==='tour'&&!d.tr) miss=true; if((A.speed==='medium'||A.speed==='fast')&&d.sp!==A.speed) miss=true; }
  else { if(A.extra==='shoe'&&d.sh!=='yes') miss=true; if(A.extra==='thermal'&&d.th!=='yes') miss=true; if(A.cap==='few'&&d.rk>2) miss=true; if(A.cap==='many'&&d.rk&&d.rk<3) miss=true; }
  pool.push({d,s:sc,why:why.filter(Boolean).slice(0,3),miss});
 } pool.sort((a,b)=>b.s-a.s); const strict=pool.filter(x=>!x.miss); return top3(strict.length?strict:pool);}
