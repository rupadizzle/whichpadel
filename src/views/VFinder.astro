 if(!top.length){out.innerHTML=`<p class="fz-none">${esc(prod==='racket'?Z.none:(KW[prod]&&KW[prod].none)||Z.none)}</p><button class="fz-link" type="button" data-again>↺ ${esc(Z.again)}</button>`; kitChrome(false); setAlert(); $('fz-sticky').innerHTML=''; document.title=BASE_TITLE; bind(); return;}
