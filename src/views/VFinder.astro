 ${shopRows?`<details class="fz-shops"><summary>${esc(R(Z.cmpShops,instock.length))}</summary><ul>${shopRows}</ul></details>`:''}`;}
function paintPicks(){const box=$('fz-choices'); if(!box) return; const win=fzTop[0]; box.replaceChildren();
