const neutral=step=>{const k=step.dataset.k; if(k==='who') return false; const inp=step.querySelector('input:checked'); if(!inp) return true; if(k==='budget') return inp.dataset.t==='any'; return inp.value==='any'||inp.value==='either';};
const money=n=>{const c=(window.WP&&WP.currency)||'EUR'; const v=Math.round(Math.abs(+n)); const sym={GBP:'£',EUR:'€',USD:'$',SEK:'kr'}[c]||''; if(c==='SEK') return v+' kr'; return (document.documentElement.lang||'en').toLowerCase().startsWith('en')?sym+v:v+' '+sym;};
const shopName=d=>(SN[d]||[d])[0];
function altLines(A,win,alt){const lines=[]; const wb=shopsOf(win.d).find(o=>o.s!==0)||shopsOf(win.d)[0]; const ab=shopsOf(alt.d).find(o=>o.s!==0)||shopsOf(alt.d)[0];
 if(wb&&ab&&wb.v!=null&&ab.v!=null){const diff=Math.round(ab.v-wb.v); lines.push(Math.abs(diff)<2?Z.samePrice:R(diff>0?Z.more:Z.less,money(diff)));}
 const styleKey=A.style==='power'?'power':'control'; const styleGap=(+win.d[styleKey]||0)-(+alt.d[styleKey]||0); const comfGap=(+win.d.comfort||0)-(+alt.d.comfort||0);
 const styleBig=Math.abs(styleGap)>=8, comfBig=Math.abs(comfGap)>=8;
 const useComf=comfBig&&(!styleBig||Math.abs(comfGap)>Math.abs(styleGap)); const gap=useComf?comfGap:styleGap; const key=useComf?'comfort':styleKey;
 if(Math.abs(gap)>=8) lines.push(R(gap>0?Z.lessStat:Z.moreStat,(Z.metric&&Z.metric[key])||key,useComf?alt.d.comfort:alt.d[styleKey],useComf?win.d.comfort:win.d[styleKey])); else lines.push(Z.sameFeel);
 return lines.filter(Boolean).slice(0,2);}
function verdictOf(A,d){if(prod!=='racket') return {h:'',sub:''}; const label=(Z.vh&&Z.vh[(A.level||'')+'-'+(A.style||'')])||Z.best; return {h:label+': '+d.m,sub:A.level==='beginner'&&A.budget==='any'?(Z.spend||''):''};}
function shortM(r){let s=r.m||''; if(r.b) s=s.replace(new RegExp('^'+String(r.b).replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\s+','i'),''); if(r.y) s=s.replace(new RegExp('\\s+'+r.y+'\\s*$'),''); return s.trim()||r.m||'';}
function libCard(item,specText,priceTxt){const tpl=document.getElementById('rk-card'); if(!tpl) return null; const li=tpl.content.firstElementChild.cloneNode(true); const kind=(CARD.kind&&CARD.kind[prod])||'r'; const id='fz-'+prod+'-'+item.s;
