---
import { existsSync } from 'node:fs';
// Ranked list pages: best rackets, a release year, a player, shoe lists and brands, and US money pages.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import FinderCard from '../components/FinderCard.astro';
import RkCard from '../components/RkCard.astro';
import HubCss from '../components/HubCss.astro';
import ShoeCard from '../components/ShoeCard.astro';
import { rackets } from '../lib/data.js';
import { D, url, SITE, P } from '../i18n/index.js';
import { BEST_KEYS } from '../i18n/routes.js';
import { pickL, method, ruleL, keysL, whyText } from '../i18n/lists.js';
import { YEARS, YC, ofYear, successor, FCARD } from '../lib/years.js';
import { cnt } from '../i18n/stats.js';
import { shoes, rankShoes, SHOE_LISTS, SHOE_LIST_KEYS, shoeBrands, shoeBrandTarget, UNDER, listCur } from '../lib/shoes.js';
import { bud } from '../lib/money.js';
import { SHOE } from '../i18n/shoes.js';
import { US_PAGES, US_KEYS, US_CHECKED } from '../lib/us.js';
const { kind, k, b, y, p } = Astro.props;
const lang = kind === 'us' ? 'en' : Astro.props.lang;
const d = D(lang), u = d.ui;
const finderHref = url('finder', lang);
const page = (() => {
  if (kind === 'best') {
    const B = d.copy.best;
    const [T, rule0, intro] = B.titles[k];
    const rule = ruleL(k, lang, rule0);
    const title = /2026/.test(T) ? T : `${T} (2026)`;
    const top = pickL(k, lang).slice(0, 10);
    const U = SITE + url('best', lang, k);
    const faq = B.faq(T, rule, top.length, top[0]?.model);
    const FC = { en: ['Not sure which one fits you?', 'Answer 4 quick questions and get your best match with recent prices.', 'Find my racket'], es: ['¿No sabes cuál te va mejor?', 'Responde 4 preguntas rápidas y recibe tu pala ideal con precios recientes.', 'Encontrar mi pala'], fr: ['Vous hésitez ?', 'Répondez à 4 questions rapides et obtenez votre raquette idéale avec les prix récents.', 'Trouver ma raquette'], pt: ['Não sabe qual escolher?', 'Responda a 4 perguntas rápidas e receba a sua raquete ideal com preços recentes.', 'Encontrar a minha raquete'], it: ['Non sai quale fa per te?', 'Rispondi a 4 domande veloci e trova la racchetta giusta con i prezzi aggiornati.', 'Trova la mia racchetta'], de: ['Unsicher, welcher passt?', 'Beantworte 4 kurze Fragen und erhalte deinen passenden Schläger mit aktuellen Preisen.', 'Meinen Schläger finden'] }[lang] || [];
    return {
      locale: d.locale, title: B.title(T) + d.copy.titleSuffix, description: B.desc(T, top.length, rackets.length, top[0]?.model),
      h1: title, pageUrl: U, lead: intro || '', eyebrow: u.updated(top.length),
      crumbs: [{ href: url('home', lang), label: u.home }, { href: url('bestIndex', lang), label: u.bestLists }, { label: title }],
      jsonld: { '@context': 'https://schema.org', '@graph': [{ '@type': 'ItemList', name: T, url: U, numberOfItems: top.length, itemListElement: top.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + url('racket', lang, r.slug), name: r.model })) }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: u.home, item: SITE + url('home', lang) }, { '@type': 'ListItem', position: 2, name: u.bestLists, item: SITE + url('bestIndex', lang) }, { '@type': 'ListItem', position: 3, name: T, item: U }] }, { '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }] },
      top, faq, rule, FC, KS: keysL(k), method: method(k), B, others: BEST_KEYS.filter(x => x !== k),
    };
  }
  if (kind === 'year') {
    const C = YC[lang], FC = FCARD[lang], CUR = 2026;
    const rs = ofYear(y);
    const brands = [...new Set(rs.map(r => r.brand))].sort();
    const U = SITE + url('year', lang, y);
    const newer = YEARS.filter(x => x > y).at(-1), older = YEARS.find(x => x < y);
    const repl = y < CUR ? rs.map(r => [r, successor(r)]).filter(pair => pair[1]) : [];
    const T = C.t(y);
    return {
      locale: d.locale, title: T + d.copy.titleSuffix, description: C.d(y, rs.length, rs[0]?.model),
      h1: C.h(y), pageUrl: U, lead: C.i(y, rs.length, CUR),
      crumbs: [{ href: url('home', lang), label: u.home }, { href: url('years', lang), label: C.hub }, { label: y }],
      jsonld: { '@context': 'https://schema.org', '@graph': [{ '@type': 'ItemList', name: T, url: U, numberOfItems: rs.length, itemListElement: rs.slice(0, 30).map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + url('racket', lang, r.slug), name: r.model })) }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: u.home, item: SITE + url('home', lang) }, { '@type': 'ListItem', position: 2, name: C.hub, item: SITE + url('years', lang) }, { '@type': 'ListItem', position: 3, name: C.h(y), item: U }] }] },
      C, FC, rs, brands, newer, older, repl, years: YEARS,
    };
  }
  if (kind === 'player') {
    const C = d.copy.player, t = d.terms, rs = p.rackets, cur = rs[0];
    const U = SITE + url('player', lang, p.slug);
    const ys = [...new Set(rs.map(r => r.year).filter(Boolean))].sort();
    const w = rs.filter(r => r.weightMin);
    const x = { n: rs.length, brands: [...new Set(rs.map(r => r.brand))], y0: ys[0], y1: ys.at(-1), shapes: cnt(rs, 'shape'), cores: cnt(rs, 'coreHardness'), w: w.length ? `${Math.min(...w.map(r => r.weightMin))}–${Math.max(...w.map(r => r.weightMax || r.weightMin))} g` : null, cur: cur.model, year: cur.year, price: P(cur, lang), list: rs.map(r => r.model).join(', ') };
    const summary = C.summary(p.name, x, t);
    const faq = C.faq(p.name, x);
    return {
      locale: d.locale, title: C.title(p.name, rs.length) + d.copy.titleSuffix, description: summary.slice(0, 158).replace(/\s\S*$/, ''),
      h1: C.h1(p.name), pageUrl: U, lead: summary,
      crumbs: [{ href: url('home', lang), label: u.home }, { href: url('players', lang), label: u.players }, { label: p.name }],
      jsonld: { '@context': 'https://schema.org', '@graph': [{ '@type': 'ItemList', name: C.h1(p.name), url: U, numberOfItems: rs.length, itemListElement: rs.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + url('racket', lang, r.slug), name: r.model })) }, { '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: u.home, item: SITE + url('home', lang) }, { '@type': 'ListItem', position: 2, name: u.players, item: SITE + url('players', lang) }, { '@type': 'ListItem', position: 3, name: p.name, item: U }] }] },
      C, rs, faq, name: p.name, note: C.note,
      photo: existsSync(new URL(`../../public/players/${p.slug}.webp`, import.meta.url)) ? { src: `/players/${p.slug}.webp`, alt: p.name } : null,
    };
  }
  if (kind === 'shoe') {
    const T = SHOE[lang];
    const list = k === 'brand' ? rankShoes(shoes.filter(s => s.brand === b.name), lang) : SHOE_LISTS[k](lang);
    const amt = UNDER[k] ? bud(UNDER[k], listCur(lang)) : null;
    const L = T.lists[k];
    const h1 = k === 'brand' ? L[0](b.name) : amt ? L[0](amt) : L[0];
    const intro = k === 'brand' ? L[1](b.name, list.length) : amt ? L[1](amt) : L[1];
    const U = SITE + (k === 'brand' ? url('shoeBrand', lang, b.slug) : url('shoeList', lang, k));
    return {
      locale: d.locale, title: T.t(h1, list.length), description: intro, h1, pageUrl: U, lead: intro,
      crumbs: [{ href: url('home', lang), label: u.home }, { href: url('shoes', lang), label: T.crumb }, { label: h1 }],
      jsonld: { '@context': 'https://schema.org', '@graph': [{ '@type': 'ItemList', name: h1, url: U, numberOfItems: list.length, itemListElement: list.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + url('shoe', lang, s.slug), name: s.name })) }, { '@type': 'FAQPage', mainEntity: T.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: u.home, item: SITE + url('home', lang) }, { '@type': 'ListItem', position: 2, name: T.crumb, item: SITE + url('shoes', lang) }, { '@type': 'ListItem', position: 3, name: h1, item: U }] }] },
      T, list, faq: T.faq, method: T.method, others: SHOE_LIST_KEYS.filter(x => x !== k && !x.startsWith('u')),
    };
  }
  const Pge = US_PAGES[k];
  const list = Pge.list();
  const n = list.length;
  const isS = Pge.kind === 's';
  const C = {
    'best-padel-rackets': [`Best padel rackets in the USA`, `The ${n} best padel rackets (paddles) you can buy from US shops today, ranked by our ratings, with recent prices in US dollars.`],
    'padel-rackets-for-beginners': [`Best padel rackets for beginners in the USA`, `${n} forgiving, easy-to-play padel rackets for new players, all sold by shops that deliver in the US, priced in dollars.`],
    'padel-shoes': [`Padel shoes in the USA`, `${n} padel shoes in stock at shops that deliver in the US, with recent prices in dollars. Padel shoes have a padel or clay outsole built for sideways movement on sand-filled turf.`],
  };
  const [h1, intro] = C[k] || (isS ? [`Padel shoes under $${Pge.cap} in the USA`, `${n} padel shoes at $${Pge.cap} or less from shops that deliver in the US, ranked by availability and season.`] : [`Best padel rackets under $${Pge.cap} in the USA`, `${n} padel rackets at $${Pge.cap} or less from US-delivering shops, ranked by power, control and comfort.`]);
  const head = `${h1} (2026)`;
  const U = SITE + url('us', 'en', k);
  const faq = [
    ['Is a padel racket the same as a padel paddle?', 'Yes. In the US many players say padel paddle; in Europe it is a padel racket. Both mean the same solid, stringless, perforated racket with a wrist strap. A padel racket is not a pickleball paddle.'],
    ['Which shops are included?', 'Only shops that deliver in the US and charge in US dollars. Each card shows the lowest current dollar price; open a racket to compare every US shop.'],
    ['How fresh are the prices?', 'We recheck each price about every 8 hours and hide any offer that has not been confirmed in the last 48 hours. Prices can change at any time, so check the shop before you buy.'],
    ...(isS ? [['How do padel shoe sizes convert to US sizes?', "As a guide, men's US size = UK size + 1 and women's US size = UK size + 2. Fit varies by brand, so check the shop's size chart."]] : []),
  ];
  const label = x => C[x]?.[0] || (US_PAGES[x].kind === 's' ? `Padel shoes under $${US_PAGES[x].cap}` : `Padel rackets under $${US_PAGES[x].cap}`);
  return {
    locale: 'en-US', region: 'US', usPage: true,
    title: `${h1} (2026): ${n} picks, $ prices | WhichPadel`, description: `${intro.split('. ')[0]}.`.slice(0, 158),
    h1: head, pageUrl: U, lead: intro, crumbLabel: 'Breadcrumb',
    crumbs: [{ href: '/', label: 'Home' }, { label: h1 }],
    jsonld: { '@context': 'https://schema.org', '@graph': [{ '@type': 'ItemList', name: h1, url: U, numberOfItems: n, itemListElement: list.map((x, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + url(isS ? 'shoe' : 'racket', 'en', x.slug), name: x.model || x.name })) }, { '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: h1, item: U }] }] },
    list, n, isS, faq, others: US_KEYS.filter(x => x !== k).map(x => ({ href: url('us', 'en', x), label: label(x) })),
  };
})();
---
<Base lang={page.locale} title={page.title} description={page.description} jsonld={page.jsonld} region={page.region} usPage={page.usPage}>
<PageHero slot="hero" lang={lang} label={page.crumbLabel || u.breadcrumb} crumbs={page.crumbs} h1={page.h1} pageUrl={page.pageUrl} lead={page.lead} eyebrow={page.eyebrow} photo={page.photo}/>
{kind === 'best' && <>
<div class="best-split">
<div class="best-main">
<div class="rulebox"><b>{u.howBuilt}</b> {page.rule} {u.topShown(page.top.length)}</div>
<div class="hub cat rk-rows rk-best rk-nocmp" data-rk><ul class="hub-grid" id="best">{page.top.map((r, i) => <RkCard r={r} rank={i + 1} lang={lang} eager={i === 0} keys={page.KS} compare why={whyText(r.why, lang)}/>)}</ul></div>
{page.method && <section class="panel" id="methodology"><h2>{u.methodology}</h2><p>{page.B.valueFormula}</p><p class="muted small">{page.B.valueNote}</p></section>}
</div>
<aside class="best-side">
<FinderCard fc={page.FC} href={finderHref}/>
<section class="panel vs"><h2>{u.otherLists}</h2>{page.others.map(o => <a href={url('best', lang, o)}><span>{page.B.titles[o][0]}</span><span>→</span></a>)}<p><a href={url('guide', lang)}>{u.howToChoose}</a> · <a href={url('brands', lang)}>{u.byBrand}</a></p></section>
</aside>
</div>
<FaqList heading={u.faq} items={page.faq}/>
</>}
{kind === 'year' && <>
<nav class="ynav" aria-label={page.C.hub}>{page.newer && <a class="btn btn-sm" href={url('year', lang, page.newer)}>← {page.C.newer(page.newer)}</a>}{page.older && <a class="btn btn-sm" href={url('year', lang, page.older)}>{page.C.older(page.older)} →</a>}{y === 2026 && <a class="btn btn-sm" href={url('best', lang, 'best-padel-racket-2026')}>{page.C.best26} →</a>}</nav>
{page.repl.length > 0 && <section class="panel vs"><h2>{page.C.repl}</h2>{page.repl.map(([a, successorR]) => <a href={url('racket', lang, successorR.slug)}><span>{page.C.replTo(a.model, successorR.model)}</span><span>→</span></a>)}</section>}
<div class="rulebox"><b>{u.howBuilt}</b> {page.C.rule}</div>
{page.brands.length > 1 && <div class="yfil" role="group" aria-label={u.byBrand}><button type="button" class="on" data-b="" aria-pressed="true">{page.C.all}</button>{page.brands.map(brand => <button type="button" data-b={brand} aria-pressed="false">{brand}</button>)}</div>}
<div class="hub cat rk-rows rk-best rk-nocmp" data-rk><ul class="hub-grid" id="yl">{page.rs.map((r, i) => <RkCard r={r} rank={i + 1} lang={lang} eager={i === 0} keys={['power','control','forgiveness']} compare dataBrand={r.brand}/>)}</ul></div>
<FinderCard fc={page.FC} href={finderHref}/>
<section class="panel vs"><h2>{page.C.hub}</h2>{page.years.filter(x => x !== y).map(x => <a href={url('year', lang, x)}><span>{page.C.h(x)}</span><span>{page.C.count(ofYear(x).length)} →</span></a>)}</section>
<style is:global>.ynav{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 24px}.ynav .btn,.yfil button{min-height:44px;display:inline-flex;align-items:center}.yfil{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}.yfil button{padding:0 16px;border:1px solid var(--line,#dde3e6);border-radius:99px;background:#fff;font:inherit;font-size:.875rem;cursor:pointer}.yfil button.on{background:var(--green,#0f6b4f);color:#fff;border-color:transparent}</style>
<script is:inline>document.querySelectorAll('.yfil button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.yfil button').forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b)});document.querySelectorAll('#yl>[data-brand]').forEach(c=>c.hidden=!!b.dataset.b&&c.dataset.brand!==b.dataset.b)});</script>
</>}
{kind === 'player' && <>
{page.rs.length > 1 && <p><a class="btn" href={url('rackets', lang) + `?r=${page.rs.slice(0, 3).map(r => r.slug).join(',')}`}>{page.C.compare(page.name)}</a></p>}
<div class="hub cat rk-rows rk-best rk-nocmp" data-rk><ul class="hub-grid">{page.rs.map((r, i) => <RkCard r={r} lang={lang} eager={i < 2} keys={['power','control','forgiveness']} compare/>)}</ul></div>
<FaqList heading={u.faq} items={page.faq}/>
<p class="muted small">{page.note}</p>
</>}
{kind === 'shoe' && <>
<p class="rulebox"><b>{u.howBuilt}</b> {page.method}</p>
<HubCss>
<div class="hub">
<div class="hub cat rk-rows rk-nocmp" data-rk><ul class="hub-grid">{page.list.map((s, i) => <ShoeCard s={s} lang={lang} rank={i + 1} eager={i < 4} compare/>)}</ul></div>
<p><a class="btn btn-line" href={url('shoes', lang)}>{page.T.hubLink}</a></p>
<FaqList heading={u.faq} items={page.faq}/>
<section class="hub-pre"><h2 class="h3">{page.T.guides}</h2><p>{page.others.map(x => <a href={url('shoeList', lang, x)}>{page.T.lists[x][0]}</a>)}</p><p><b>{page.T.byBrand}</b>{shoeBrands.map(x => { const t = shoeBrandTarget(x.slug); return <a href={url(t.type, lang, t.id) + (t.hash ? '#' + t.hash : '')}>{x.name}</a>; })}</p></section>
</div>
</HubCss>
</>}
{kind === 'us' && <>
<p class="rulebox"><b>{u.howBuilt}</b> only {page.isS ? 'shoes' : 'rackets'} with a live US-dollar price from a shop that delivers in the US. Checked {US_CHECKED}; prices refresh every 8 hours.</p>
<HubCss>
<div class="hub us">
{page.isS ? <div class="hub cat rk-rows rk-nocmp" data-rk><ul class="hub-grid">{page.list.map((s, i) => <ShoeCard s={s} lang="en" rank={i + 1} eager={i < 4} region="US" compare/>)}</ul></div>
 : <div class="hub cat rk-rows rk-best rk-nocmp" data-rk><ul class="hub-grid">{page.list.map((r, i) => <RkCard r={r} rank={i + 1} lang="en" eager={i === 0} region="US" keys={['power','control','forgiveness']} compare/>)}</ul></div>}
<p><a class="btn btn-line" href={page.isS ? url('shoes', 'en') : url('rackets', 'en', 1)}>{page.isS ? 'Compare all padel shoes →' : 'Compare all padel rackets →'}</a></p>
<FaqList heading={u.faq} items={page.faq}/>
{page.others.length > 0 && <section class="hub-pre"><h2 class="h3">More for US players</h2><p>{page.others.map(x => <a href={x.href}>{x.label}</a>)}</p></section>}
</div>
</HubCss>
</>}
</Base>
