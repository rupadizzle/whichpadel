---
// Shoe detail page: racket page v2 template (title + chips above the gallery, price card alone in the right column, mobile "Show prices" sheet).
import NewsL from '../components/NewsL.astro'; import Base from '../layouts/Base.astro'; import Price from '../components/Price.astro';
import { SHOPS, FX } from '../lib/price.js'; import { RP } from '../lib/rp2.js';
import { shoes, shoeGallery, shoeImg, rankShoes, shoeBrands, SHOE_CHECKED, SHOE_LIST_KEYS } from '../lib/shoes.js'; import { slugify } from '../lib/data.js';
import { SHOE } from '../i18n/shoes.js'; import { D, url, SITE } from '../i18n/index.js';
const SN=Object.fromEntries(Object.entries(SHOPS).map(([k,v])=>[k,[v.name&&v.name!==k?v.name:k.replace(/\.(com|net|co\.uk|de|es)$/,''),typeof v.affiliate==='string'&&v.affiliate.startsWith('https://')?v.affiliate:'']]));
const { s, lang } = Astro.props; const d=D(lang), u=d.ui, T=SHOE[lang], R2=RP(lang);
const G=shoeGallery(s); const alt=T.alt(s.name); const bs=slugify(s.brand); const hasB=shoeBrands.some(b=>b.slug===bs);
const soleT=s.sole.map(k=>T.soles[k]); const sz=a=>a.map(x=>String(x).replace('.',lang==='en'?'.':',')).join(' · ');
const fmtD=n=>String(n).replace('.',lang==='en'?'.':',')+' mm';
const rows=[[T.spec.brand,s.brand],[T.spec.year,s.year],[T.spec.gender,T.genders[s.gender]],[T.spec.sole,soleT.join(', ')||null],[T.spec.outsole,s.vibram?T.vibram:null],[T.spec.cushion,s.cushion.length?s.cushion.map(c=>c.toUpperCase()).join(', '):null],[T.spec.weight,s.weight?s.weight+' g':null],[T.spec.drop,s.drop!=null?fmtD(s.drop):null],[T.spec.width,s.wide?T.wide:null],[T.spec.sizesEU,s.sizesEU.length?sz(s.sizesEU):null],[T.spec.sizesUK,s.sizesUK.length?sz(s.sizesUK):null],[T.spec.cols,s.colours],[T.spec.shops,s.shops]].filter(([,v])=>v!=null&&v!=='');
const miss=[!s.weight&&T.mk.weight,s.drop==null&&T.mk.drop].filter(Boolean);
const kchips=[T.genders[s.gender],...soleT,s.wide&&T.wide,s.vibram&&T.vibram,s.weight&&s.weight+' g',T.cols(s.colours)].filter(Boolean);
const intro=T.introS({name:s.name,g:T.gl[s.gender],sole:soleT.length?soleT.join('/').toLowerCase():'',cush:s.cushion.length?s.cushion.map(c=>c.toUpperCase()).join(' + '):'',n:s.shops,cols:s.colours});
const similar=rankShoes(shoes.filter(x=>x.slug!==s.slug&&x.gender===s.gender&&(x.sole.some(k=>s.sole.includes(k))||!s.sole.length)),lang).slice(0,4);
const sameBrand=rankShoes(shoes.filter(x=>x.brand===s.brand&&x.slug!==s.slug),lang).slice(0,6);
const best0=[...s.offs].sort((a,b)=>b.s-a.s||a.p-b.p)[0]; const BN=(SN[best0.d]||[best0.d])[0];
const oj=JSON.stringify(s.offs.filter(o=>o.s||!s.offs.some(x=>x.s)).map(o=>({d:o.d,p:o.p,c:o.c,u:o.u})));
const U=SITE+url('shoe',lang,s.slug); const lk={m:'mens',w:'womens',k:'junior'}[s.gender];
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'Product','name':s.name,'url':U,'brand':{'@type':'Brand','name':s.brand},...(G[0]?{'image':SITE+G[0].l}:{}),'description':intro,'category':T.crumb,'offers':{'@type':'AggregateOffer','lowPrice':String(Math.min(...s.offs.map(o=>o.p))),'highPrice':String(Math.max(...s.offs.map(o=>o.p))),'priceCurrency':best0.c,'offerCount':s.offs.length}},
 {'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':T.crumb,'item':SITE+url('shoes',lang)},{'@type':'ListItem','position':3,'name':s.name,'item':U}]}]};
---
<Base lang={d.locale} title={`${s.name} | ${T.crumb} | WhichPadel`} description={intro} jsonld={jsonld} ogImage={G[0]?SITE+G[0].l:undefined}>
<Fragment slot="head">{G[0]&&<link rel="preload" as="image" href={G[0].l} imagesrcset={`${G[0].s} 400w, ${G[0].l} 800w`} imagesizes="(max-width: 899px) 100vw, 480px" fetchpriority="high"/>}</Fragment>
<nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <a href={url('shoes',lang)}>{T.crumb}</a> › {hasB?<><a href={url('shoeBrand',lang,bs)}>{s.brand}</a> › </>:null}<span>{s.model}</span></nav>
<div class="detail rp2 shoe">
<header class="rph">
<p class="brand">{hasB?<a href={url('shoeBrand',lang,bs)}>{s.brand}</a>:s.brand}{s.year&&<> · {s.year}</>}</p><h1>{s.name}</h1>
{kchips.length>0&&<ul class="kchips">{kchips.map(c=><li>{c}</li>)}</ul>}
</header>
<section class="rpg" aria-label={alt} data-n={G.length}>
<div class="gtrack" tabindex="0">{G.map((g,i)=><button type="button" class="gslide" data-i={i} aria-label={`${R2.zoom}: ${R2.photo(i+1,G.length)}`}><img src={g.l} srcset={`${g.s} 400w, ${g.l} 800w`} sizes="(max-width: 899px) 100vw, 480px" alt={i===0?alt:`${alt} – ${R2.photo(i+1,G.length)}`} width="480" height="480" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':undefined} decoding={i===0?'sync':'async'}/></button>)}</div>
{G.length>1&&<><span class="gcount" aria-live="polite"><b>1</b> / {G.length}</span>
<button type="button" class="garr gprev" aria-label={R2.prev}>‹</button><button type="button" class="garr gnext" aria-label={R2.next}>›</button>
<div class="gdots" aria-hidden="true">{G.map((_,i)=><i class={i===0?'on':''}></i>)}</div>
<div class="gthumbs">{G.map((g,i)=><button type="button" data-i={i} aria-label={R2.photo(i+1,G.length)} aria-current={i===0?'true':undefined}><img src={g.s} alt="" width="64" height="64" loading="lazy" decoding="async"/></button>)}</div></>}
<dialog class="gzoom" aria-label={alt}><button type="button" class="gzx" aria-label={R2.close}>✕</button><div class="gztrack">{G.map(g=><img data-src={g.l} alt="" width="960" height="960"/>)}</div></dialog>
</section>
<aside class="panel buybox" id="buybox"><p class="price-big" id="pxbig"><Price r={s} lang={lang}/> <span class="pxdrop" id="pxdrop" hidden></span></p><p class="muted small" id="pxstatic">{u.checkedOn(SHOE_CHECKED)}</p><ul class="pxlive muted small" id="pxlive" hidden></ul>
<div class="pxcmp" id="pxcmp" hidden></div><div class="pxhist" id="pxhist" hidden></div>
<a class="btn aff btn-lg" id="buymain" href={best0.u} rel="sponsored nofollow" data-affiliate="PLACEHOLDER" data-o={oj}>{u.px.cmp.buy.replace('{s}',BN)} →</a> <span class="disc">{u.ad}: {u.adNote} <a href={url('affiliate',lang)}>{u.disclosure}</a></span>
<p class="muted small" style="margin:8px 0 0">{T.sizeNote}</p></aside>
<div class="rpbody">
<section class="panel"><h2>{T.overview}</h2><p class="intro">{intro}</p>
{s.sole.length>0&&<ul class="suits">{s.sole.filter((k,i,a)=>!(k==='herringbone'&&a.includes('clay'))).map(k=><li>{T.soleTip[k]}</li>)}</ul>}
{lk&&SHOE_LIST_KEYS.includes(lk)&&<p class="small rpguide"><a href={url('shoeList',lang,lk)}>{T.lists[lk][0]}</a> · <a href={url('shoeList',lang,'best')}>{T.lists.best[0]}</a></p>}</section>
<details class="panel rpspec" id="rpspec" open><summary><h2>{T.specs}</h2></summary><div class="tscroll"><table class="spec"><tbody>{rows.map(([k,v])=><tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table></div>
{miss.length>0&&<p class="muted small" style="margin-top:12px">{T.missing(miss.join(', '))}</p>}</details>
{similar.length>0&&<section class="panel"><h2>{T.similar}</h2><div class="rpsim">{similar.map(x=><a href={url('shoe',lang,x.slug)}><span class="rpsi">{shoeImg(x)&&<img src={shoeImg(x)} alt="" width="72" height="72" loading="lazy" decoding="async"/>}</span><span><b>{x.name}</b><small>{x.sole.map(k=>T.soles[k]).join(', ')}{x.sole.length>0&&' · '}<Price r={x} lang={lang}/></small></span></a>)}</div></section>}
{sameBrand.length>0&&<section class="panel vs"><h2>{T.moreFrom(s.brand)}</h2>{sameBrand.map(x=><a href={url('shoe',lang,x.slug)}><span>{x.name}</span><span>→</span></a>)}{hasB&&<p style="margin:12px 0 0"><a href={url('shoeBrand',lang,bs)}>{T.allFrom(s.brand)}</a></p>}</section>}
</div>
</div>
<section class="nudge" id="rv-wrap" hidden><h2>{u.recent}</h2><div class="rv" id="rv"></div></section>
<NewsL lang={lang} src="shoe"/>
<div class="stickycta" id="stickycta" aria-hidden="true"><button type="button" class="sp" id="stickyopen" tabindex="-1" aria-haspopup="dialog" aria-label={u.px.cmp.openS}><b><Price r={s} lang={lang}/><svg class="spchev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></b><span>{BN}</span></button><button type="button" class="btn" id="stickybuy" tabindex="-1" aria-haspopup="dialog">{u.px.cmp.showP}</button></div>
<script is:inline define:vars={{PS:s.slug,PX:u.px,SN,RATES:FX.rates,LG:lang,RM:s.name}}>
// live prices from the price engine (/api/prices). Compare list: one row per shop (e.o), filtered to the visitor's country, cheapest in-stock first.
const okHost=location.hostname==='whichpadel.com'||/\.whichpadel\.pages\.dev$/.test(location.hostname)||/[?&]px=1/.test(location.search);
if(okHost) fetch('/api/shoe-prices',{signal:AbortSignal.timeout?AbortSignal.timeout(5000):undefined}).then(x=>x.ok?x.json():null).then(j=>{const e=j&&j.r&&j.r[PS]; if(!e) return;
 const os=(Array.isArray(e.o)&&e.o.length?e.o:[e]).filter(o=>o.p>0&&/^https:\/\//.test(o.u));
 const oj=JSON.stringify(os.map(o=>({d:o.d,p:o.p,c:o.c,u:o.u}))); document.querySelectorAll('.pz[data-o],a.aff[data-o]').forEach(n=>n.dataset.o=oj);
 const L=document.getElementById('pxlive'); const C=PX.cmp, esc=s=>String(s).replace(/[<>&"]/g,c=>'&#'+c.charCodeAt(0)+';');
 const today=Date.parse(new Date().toISOString().slice(0,10));
 function render(){const W=window.WP||{region:'GB',currency:'GBP'}, reg=W.region, cur=W.currency;
  const cv=(n,c)=>c===cur?n:n/RATES[c]*RATES[cur]; const f=n=>{const v=Math.round(n); return cur==='SEK'?v+' kr':LG!=='en'?v+' '+{GBP:'£',EUR:'€',USD:'$'}[cur]:{GBP:'£',EUR:'€',USD:'$'}[cur]+v;};
  // exact shop price in the shop's own currency (what the visitor will see on the shop), e.g. €64.95
  const fn=(n,c)=>{const v=Number.isInteger(n)?String(n):n.toFixed(2); const sy={GBP:'£',EUR:'€',USD:'$'}[c]; return c==='SEK'?v+' kr':LG!=='en'?v.replace('.',',')+' '+sy:sy+v;};
  const AX=(window.WP&&WP.approx)||'approx.'; const fb=o=>o.c===cur?fn(o.p,o.c):AX+' '+f(o.v);
  const rows=os.map(o=>{const s=window.WP&&WP.shop?WP.shop(o.d):null; const st=s?s:'u'; return {...o,v:cv(o.p,o.c),st};}).filter(o=>o.st!=='n')
   .sort((a,b)=>((a.s===0)-(b.s===0))||a.v-b.v);
  const low=Math.min(...os.map(o=>cv(o.min30||o.p,o.c)));
  L.innerHTML=`<li>${PX.low30}: <b>${f(low)}</b></li>`; L.hidden=false; const sp=document.getElementById('pxstatic'); if(sp) sp.hidden=true;
  const P=document.getElementById('pxcmp'), M=document.getElementById('buymain');
  if(!rows.length){P.hidden=true;P.innerHTML='';M.hidden=false;return;}
  const age=t=>{const n=Math.max(0,Math.round((today-Date.parse(t))/864e5)); return n===0?C.today:n===1?C.ago1:C.ago.replace('{n}',n);};
  const href=o=>{const a=(SN[o.d]||[])[1]; return a?a.replace('{url}',encodeURIComponent(o.u)):o.u;};
  const sn=o=>esc((SN[o.d]||[o.n||o.d])[0]);
  const ag=t=>{const n=Math.max(0,Math.round((today-Date.parse(t))/864e5)); return n===0?C.tdy:C.agoS.replace('{n}',n);};
  const row=(o,best)=>`<li class="pxr${best?' best':''}${o.s===0?' oos':''}${o.st!=='y'?' nc':''}"><span class="pxs"><b>${sn(o)}</b><small class="pxm">${best?`<span class="pxbd">${C.bestDeal}</span>`:''}<i class="dot${o.s===0?' no':''}" aria-label="${o.s===0?PX.oos:C.inStock}"></i>${o.s===0?PX.oos+' · ':''}<span class="pxag">${o.st!=='y'?`<span class="pxnc" title="${C.nc}" aria-label="${C.nc}">${C.ncS}</span>`:ag(o.t)}</span></small></span><span class="pxp">${fn(o.p,o.c)}${o.c!==cur?`<small class="pxcv">${AX} ${f(o.v)}</small>`:''}</span><a class="btn pxb${best?' pri':''}" href="${esc(href(o))}" rel="sponsored nofollow" target="_blank" aria-label="${C.buy.replace('{s}',sn(o))}">${C.buyS}</a></li>`;
  const conf=rows.filter(o=>o.st==='y'), unc=rows.filter(o=>o.st!=='y'), all=[...conf,...unc], top=all.slice(0,4);
  const b=all[0], bi=b.s!==0; const ul=(L,o0)=>`<ul class="pxl">${L.map((o,i)=>row(o,o0&&i===0&&bi)).join('')}</ul>`;
  let h=`<p class="pxsub pxcnt">${(rows.length===1?C.n1:C.nN.replace('{n}',rows.length))}</p>`+ul(top,true);
  if(all.length>4) h+=`<button type="button" class="pxall" id="pxall" aria-haspopup="dialog">${C.allN.replace('{n}',all.length)}</button>`;
  P.innerHTML=h; P.hidden=false; M.hidden=true; const PB=document.getElementById('pxbig'); if(PB) PB.hidden=true; L.hidden=true;
  const S=document.getElementById('stickybuy'); if(S){const SP=document.querySelector('#stickycta .sp'); const FR={en:'from',es:'desde',fr:'dès',de:'ab',it:'da',pt:'desde'}[LG]||'from'; if(SP) SP.innerHTML=`<b><small>${FR}</small> ${fb(b)}<svg class="spchev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></b><span>${sn(b)}</span>`;}
  // bottom sheet
  let D=document.getElementById('pxsheet'); if(!D){D=document.createElement('div'); D.id='pxsheet'; D.className='pxsheet'; D.hidden=true; document.body.appendChild(D);}
  D.innerHTML=`<div class="pxsb" data-x></div><div class="pxsp" role="dialog" aria-modal="true" aria-labelledby="pxst" tabindex="-1"><div class="pxsg" aria-hidden="true"></div><div class="pxsh"><h2 id="pxst">${esc(RM)}</h2><button type="button" class="pxsx" data-x aria-label="${C.close}">✕</button></div><div class="pxsc">${ul(top,true)}${all.length>4?`<div class="pxsmore" hidden>${ul(all.slice(4),false)}</div><button type="button" class="pxall pxsall">${C.showAll.replace('{n}',all.length)}</button>`:''}</div></div>`;
  sheetWire(D);
  hist(cv,f);}
 let opener=null;
 function sheetOpen(full){const D=document.getElementById('pxsheet'); if(!D) return; opener=document.activeElement; D.classList.toggle('full',!!full); const m=D.querySelector('.pxsmore'), sa=D.querySelector('.pxsall'); if(m){m.hidden=!full; sa.hidden=!!full;}
  D.hidden=false; document.documentElement.classList.add('pxlock'); requestAnimationFrame(()=>requestAnimationFrame(()=>D.classList.add('open'))); setTimeout(()=>D.querySelector('.pxsp').focus(),30);}
 function sheetClose(){const D=document.getElementById('pxsheet'); if(!D||D.hidden) return; D.classList.remove('open'); const p=D.querySelector('.pxsp'); p.style.transform=''; document.documentElement.classList.remove('pxlock');
  const rm=matchMedia('(prefers-reduced-motion: reduce)').matches; setTimeout(()=>{D.hidden=true;},rm?0:250); if(opener&&opener.focus) opener.focus();}
 function sheetWire(D){D.querySelectorAll('[data-x]').forEach(x=>x.onclick=sheetClose);
  const sa=D.querySelector('.pxsall'); if(sa) sa.onclick=()=>{D.querySelector('.pxsmore').hidden=false; sa.hidden=true; D.classList.add('full'); const f=D.querySelector('.pxsmore a'); if(f) f.focus();};
  const p=D.querySelector('.pxsp'), sc=D.querySelector('.pxsc'); let y0=null, dy=0;
  p.addEventListener('touchstart',e=>{if(sc.scrollTop>0&&sc.contains(e.target)) {y0=null;return;} y0=e.touches[0].clientY; dy=0; p.style.transition='none';},{passive:true});
  p.addEventListener('touchmove',e=>{if(y0==null) return; dy=Math.max(0,e.touches[0].clientY-y0); p.style.transform=`translateY(${dy}px)`;},{passive:true});
  p.addEventListener('touchend',()=>{if(y0==null) return; p.style.transition=''; if(dy>80) sheetClose(); else p.style.transform=''; y0=null;});
  const pa=document.getElementById('pxall'); if(pa) pa.onclick=()=>sheetOpen(true);}
 document.addEventListener('keydown',e=>{const D=document.getElementById('pxsheet'); if(!D||D.hidden) return; if(e.key==='Escape'){e.preventDefault(); sheetClose(); return;}
  if(e.key==='Tab'){const F=[...D.querySelectorAll('a[href],button:not([hidden])')].filter(x=>x.offsetParent!==null); if(!F.length) return; const a=F[0], z=F[F.length-1];
   if(e.shiftKey&&(document.activeElement===a||document.activeElement===D.querySelector('.pxsp'))){e.preventDefault(); z.focus();} else if(!e.shiftKey&&document.activeElement===z){e.preventDefault(); a.focus();}}});
 const SC=document.getElementById('stickycta'); if(SC) SC.addEventListener('click',()=>sheetOpen(false));
 let HD=90; const H=Array.isArray(e.h)?e.h.filter(x=>x&&x[1]>0):[];
 function hist(cv,f){const B=document.getElementById('pxhist'); if(!B||!H.length) return; const W=window.WP||{currency:'GBP'};
  const dd=new Set(H.map(x=>x[0])).size; if(dd<3){const L=document.documentElement.lang||'en'; let d=H[0][0]; try{d=new Date(d+'T12:00:00Z').toLocaleDateString(L,{day:'numeric',month:'short'});}catch(_){} B.innerHTML=`<p class="pxsince">${C.since.replace('{d}',d)}</p>`; B.hidden=false; return;}
  const cut=new Date(Date.now()-HD*864e5).toISOString().slice(0,10); const pts=H.filter(x=>x[0]>=cut).map(x=>[x[0],cv(x[1],e.c)]); if(!pts.length) return;
  const vs=pts.map(p=>p[1]), lo=Math.min(...vs), hi=Math.max(...vs), rg=(hi-lo)||1, n=pts.length;
  const xy=pts.map((p,i)=>[(n===1?150:i/(n-1)*300).toFixed(1),(58-(p[1]-lo)/rg*52).toFixed(1)]);
  const svg=`<svg viewBox="0 0 300 64" preserveAspectRatio="none" role="img" aria-label="${C.hist}"><polyline fill="none" stroke="#13795c" stroke-width="2" vector-effect="non-scaling-stroke" points="${xy.map(p=>p.join(',')).join(' ')}"/>${n<4?xy.map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="3" fill="#13795c"/>`).join(''):''}</svg>`;
  const note=H.length<7&&HD===90?C.since.replace('{d}',H[0][0]):C.lowN.replace('{n}',HD).replace('{p}',f(lo));
  B.innerHTML=`${svg}<p class="muted small">${note}</p>`; B.hidden=false;
  B.querySelectorAll('[data-d]').forEach(x=>x.onclick=()=>{HD=+x.dataset.d; hist(cv,f);});}
 render(); document.addEventListener('wp:region',render);
 if(e.drop>0){const b=document.getElementById('pxdrop'); b.textContent=PX.drop.replace('{n}',e.drop); b.hidden=false;}
 window.wpApply&&window.wpApply();}).catch(()=>{});
</script>
<script is:inline define:vars={{cur:{s:s.slug,m:s.name,i:shoeImg(s)||''},RK:url('shoe',lang,'X').replace(/X\/$/,''),CMP:url('shoes',lang),CW:'§'}}>
document.body.classList.add('has-sticky');
const sc=document.getElementById('stickycta'),bb=document.getElementById('buybox');
new IntersectionObserver(([e])=>{const show=!e.isIntersecting;sc.classList.toggle('show',show);sc.setAttribute('aria-hidden',!show);}).observe(bb);
try{const K='rv_'+RK.split('/')[1]; let rv=JSON.parse(localStorage[K]||'[]').filter(x=>x.s!==cur.s);const w=document.getElementById('rv');const e=s=>s.replace(/[<>&]/g,'');
if(rv.length){w.innerHTML=rv.slice(0,8).map(x=>`<a href="${RK}${x.s}/">${x.i?`<img src="${x.i}" alt="" width="60" height="72" loading="lazy">`:''}<span>${e(x.m)}</span></a>`).join('');document.getElementById('rv-wrap').hidden=false;}
localStorage[K]=JSON.stringify([cur,...rv].slice(0,10));}catch(e){}
</script>
<script is:inline>
(()=>{const g=document.querySelector('.rpg'); if(!g) return; const sp=document.getElementById('rpspec'); if(sp&&matchMedia('(max-width:899px)').matches) sp.open=false;
const tr=g.querySelector('.gtrack'), n=+g.dataset.n; if(!n||!tr.querySelector('.gslide')) return; const cnt=g.querySelector('.gcount b'), dots=[...g.querySelectorAll('.gdots i')], th=[...g.querySelectorAll('.gthumbs button')]; let cur=0;
const go=i=>{i=(i+n)%n; tr.scrollTo({left:i*tr.clientWidth,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});};
const set=i=>{if(i===cur) return; cur=i; if(cnt) cnt.textContent=i+1; dots.forEach((d,k)=>d.classList.toggle('on',k===i)); th.forEach((b,k)=>b.toggleAttribute('aria-current',k===i));};
tr.addEventListener('scroll',()=>set(Math.round(tr.scrollLeft/tr.clientWidth)),{passive:true});
th.forEach(b=>b.onclick=()=>go(+b.dataset.i)); const P=g.querySelector('.gprev'),N=g.querySelector('.gnext'); if(P){P.onclick=()=>go(cur-1); N.onclick=()=>go(cur+1);}
tr.addEventListener('keydown',e=>{if(e.key==='ArrowRight'){e.preventDefault();go(cur+1);} if(e.key==='ArrowLeft'){e.preventDefault();go(cur-1);}});
const z=g.querySelector('.gzoom'); if(!z||!z.showModal) return; const zt=z.querySelector('.gztrack');
tr.querySelectorAll('.gslide').forEach(b=>b.onclick=()=>{zt.querySelectorAll('img[data-src]').forEach(im=>{im.src=im.dataset.src; im.removeAttribute('data-src');}); z.showModal(); document.documentElement.classList.add('pxlock'); requestAnimationFrame(()=>{zt.scrollLeft=(+b.dataset.i)*zt.clientWidth;});});
const zc=()=>{z.close();}; z.querySelector('.gzx').onclick=zc; z.addEventListener('close',()=>document.documentElement.classList.remove('pxlock')); z.addEventListener('click',e=>{if(e.target===z||e.target===zt) zc();});})();
</script>
