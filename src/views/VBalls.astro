---
// /balls/ hub: every ball rendered statically (crawlable). Same catalog shell as /shoes/ and /rackets/: search, filter sidebar, sort. Filter state stays in the URL.
import Base from '../layouts/Base.astro'; import '../styles/hub.css'; import SaveHeart from '../components/SaveHeart.astro';
import { balls, rankBalls, ballImg, ballPrice } from '../lib/balls.js'; import { BALL } from '../i18n/balls.js'; import { D, url, SITE } from '../i18n/index.js'; import { pick, fmt, DEFAULT_REGION } from '../lib/price.js';
const { lang } = Astro.props; const d=D(lang), u=d.ui, T=BALL[lang]; const N=balls.length;
const list=rankBalls(balls,lang); const brands=[...new Set(balls.map(b=>b.brand))].sort();
const brandPick=brands.map(b=>({name:b,n:balls.filter(x=>x.brand===b).length})).sort((a,b)=>b.n-a.n||a.name.localeCompare(b.name));
const SPEEDS=['fast','medium'];
const pv=Object.fromEntries(balls.map(b=>[b.slug,ballPrice(b,lang)]));
const pr=b=>{const q=pick(b,DEFAULT_REGION(lang)); return q.none?u.checkPrice:`${fmt(q.v,q.cur,lang)} · ${fmt(Math.round(q.v/b.balls*100)/100,q.cur,lang)} ${T.perBall}`;};
const spec=b=>[T.speeds[b.speed],b.tour&&T.tours[b.tour],b.eco&&T.eco].filter(Boolean).join(' · ');
const U=SITE+url('balls',lang);
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'CollectionPage','name':T.h1(N),'url':U,'description':T.desc(N)},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':T.crumb,'item':U}]}]};
---
<Base lang={d.locale} title={T.title(N)} description={T.desc(N)} jsonld={jsonld}>
<nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <span>{T.crumb}</span></nav>
<div class="hub cat balls" id="hub">
<header class="hub-hd"><h1>{T.h1(N)}</h1><p>{T.intro}</p></header>
<div class="hub-bar">
<div class="hub-tb">
 <label class="hub-q"><span class="sr">{T.search}</span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="h-q" type="search" placeholder={T.searchPh} autocomplete="off"/></label>
 <button type="button" class="hub-fo" id="h-open" aria-controls="h-f" aria-expanded="false"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M7 12h10M10 18h4"/></svg>{T.filters}<span id="h-fn" class="hub-n"></span></button>
 <label class="hub-so"><span class="sr">{T.sort}</span><select id="h-sort2">{['rec','price','hi','shops'].map((k,i)=><option value={k}>{T.sorts[i]}</option>)}</select></label>
</div></div>
<div class="hub-l">
<div class="hub-shade" id="h-shade" hidden></div>
<aside class="hub-f" id="h-f" aria-label={T.filters}>
 <div class="hub-fh"><h2 class="h3">{T.filters}</h2><button type="button" class="x" id="h-x" aria-label={T.close}>✕</button></div>
 <div class="hub-fb">
  <label class="hub-bq hub-mq"><span class="sr">{T.search}</span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="h-q2" type="search" placeholder={T.searchPh} autocomplete="off"/></label>
  <fieldset class="hub-g"><legend>{T.speed}</legend><div class="hub-chips">{SPEEDS.map(k=><label><input type="checkbox" name="h-sp" value={k}/><span>{T.speeds[k]}</span></label>)}</div></fieldset>
  <fieldset class="hub-g hub-brands"><legend>{T.brand}</legend><div class="hub-chips">{brandPick.map((b,i)=><label hidden={i>=8}><input type="checkbox" name="h-brand" value={b.name}/><span>{b.name}</span></label>)}</div>{brandPick.length>8&&<button type="button" class="hub-bmore" id="h-bmore" data-t={T.moreB} data-less={T.lessB}>{T.moreB.replace('§',String(brandPick.length-8))}</button>}</fieldset>
  <fieldset class="hub-g"><legend>{T.tourF}</legend><div class="hub-chips">{Object.entries(T.tours).map(([k,v])=><label><input type="checkbox" name="h-tour" value={k}/><span>{v}</span></label>)}</div></fieldset>
  <fieldset class="hub-g"><legend>{T.price}</legend><div class="hub-pr"><label><span class="sr">{T.min}</span><input id="h-min" type="number" min="0" inputmode="numeric" placeholder={T.min}/></label><span aria-hidden="true">–</span><label><span class="sr">{T.max}</span><input id="h-max" type="number" min="0" inputmode="numeric" placeholder={T.max}/></label></div></fieldset>
  <label class="hub-tg"><input type="checkbox" id="h-eco"/><span><b>{T.ecoF}</b><small>{T.ecoS}</small></span></label>
  <label class="hub-tg"><input type="checkbox" id="h-stock"/><span><b>{T.stock}</b><small>{T.stockS}</small></span></label>
 </div>
 <div class="hub-ff"><button type="button" class="btn btn-line" id="h-clear">{T.clear}</button><button type="button" class="btn btn-accent" id="h-apply">{T.apply.replace('§',String(N))}</button></div>
</aside>
<section class="hub-main">
 <div class="hub-head"><p class="hub-cnt"><b id="h-count" aria-live="polite">{T.results.replace('§',String(N))}</b></p><label class="hub-sort"><span class="sr">{T.sort}</span><select id="h-sort">{['rec','price','hi','shops'].map((k,i)=><option value={k}>{T.sorts[i]}</option>)}</select></label></div>
 <ul class="hub-grid" id="h-grid">{list.map((b,i)=><li class="rk" data-s={b.slug} data-b={b.brand} data-sp={b.speed} data-tour={b.tour||''} data-eco={b.eco?'1':'0'} data-n={b.inStock}><a class="rk-a" href={url('ball',lang,b.slug)}><span class="rk-i">{ballImg(b)&&<img src={ballImg(b)} alt={T.alt(b.name)} width="96" height="96" loading={i<4?'eager':'lazy'} decoding="async"/>}</span><span class="rk-t"><span class="rk-b"><span>{b.brand}</span><SaveHeart slug={b.slug} kind="b" off={u.save} on={u.saved}/></span><span class="rk-m">{b.model}</span><span class="rk-c">{spec(b)}</span><span class="rk-p"><span class="pz rk-pv">{pr(b)}</span></span></span></a></li>)}</ul>
 <p class="hub-empty" id="h-empty" hidden>{T.empty} <button type="button" class="btn btn-sm btn-line" id="h-clear2">{T.clear}</button></p>
</section>
</div>
</div>
<script type="application/json" id="h-data" set:html={JSON.stringify({pv,T:{results:T.results,apply:T.apply}}).replace(/</g,'\\u003c')}></script>
<script is:inline>
(()=>{const {pv,T}=JSON.parse(document.getElementById('h-data').textContent); const $=id=>document.getElementById(id), grid=$('h-grid'); const items=[...grid.children]; items.forEach((li,i)=>li.dataset.o=i);
const parts=v=>String(v||'').split(',').map(s=>s.trim()).filter(Boolean);
const rv=n=>[...document.querySelectorAll(`input[name="h-${n}"]:checked`)].map(i=>i.value).filter(Boolean).join(',');
const setR=(n,v)=>{const want=new Set(parts(v)); const boxes=[...document.querySelectorAll(`input[name="h-${n}"]`)]; boxes.forEach(i=>{if(i.value) i.checked=want.has(i.value);}); const all=boxes.find(i=>!i.value); if(all) all.checked=!boxes.some(i=>i.value&&i.checked);};
function paintBrands(){const box=document.querySelector('.hub-brands .hub-chips'); if(!box) return; const open=box.dataset.open==='1', labs=[...box.querySelectorAll('label')]; let hide=0; labs.forEach((lab,i)=>{const on=lab.querySelector('input').checked, keep=on||open||i<8; lab.hidden=!keep; if(!keep) hide++;}); const more=$('h-bmore'); if(more){more.hidden=!open&&!hide; if(!more.hidden) more.textContent=open?more.dataset.less:more.dataset.t.replace('§',hide);}}
const syncAll=box=>{const seg=box.closest('.hub-seg')||box.closest('.hub-g'); if(!seg) return; const boxes=[...seg.querySelectorAll('input[type="checkbox"]')]; const all=boxes.find(i=>!i.value); const rest=boxes.filter(i=>i.value); if(!all) return; if(!box.value){rest.forEach(i=>i.checked=false); all.checked=true;} else all.checked=!rest.some(i=>i.checked);};
const KEYS=['q','brand','sp','tour','eco','stock','min','max','sort'];
let qv='';
const setQ=v=>{qv=v; if($('h-q').value!==v)$('h-q').value=v; if($('h-q2').value!==v)$('h-q2').value=v;};
const get=()=>({q:qv.trim(),brand:rv('brand'),sp:rv('sp'),tour:rv('tour'),eco:$('h-eco').checked?'1':'',stock:$('h-stock').checked?'1':'',min:$('h-min').value,max:$('h-max').value,sort:$('h-sort').value==='rec'?'':$('h-sort').value});
const put=s=>{setQ((s.q||'').trim());setR('brand',s.brand||'');setR('sp',s.sp||'');setR('tour',s.tour||'');$('h-eco').checked=s.eco==='1';$('h-stock').checked=s.stock==='1';$('h-min').value=s.min||'';$('h-max').value=s.max||'';$('h-sort').value=s.sort||'rec';$('h-sort2').value=s.sort||'rec'; paintBrands();};
function apply(){const s=get(), q=s.q.toLowerCase(), mn=parseFloat(s.min), mx=parseFloat(s.max), bn=parts(s.brand), sp=parts(s.sp), tour=parts(s.tour); let n=0;
 const ok=li=>{const d=li.dataset, v=pv[d.s]; return (!q||li.textContent.toLowerCase().includes(q))&&(!bn.length||bn.includes(d.b))&&(!sp.length||sp.includes(d.sp))&&(!tour.length||tour.includes(d.tour))&&(!s.eco||d.eco==='1')&&(!s.stock||+d.n>0)&&((isNaN(mn)&&isNaN(mx))||(v!=null&&(isNaN(mn)||v>=mn)&&(isNaN(mx)||v<=mx)));};
 const P=li=>pv[li.dataset.s]??1e9; const map={'':(a,b)=>a.dataset.o-b.dataset.o,price:(a,b)=>P(a)-P(b),hi:(a,b)=>(P(b)===1e9)-(P(a)===1e9)||P(b)-P(a),shops:(a,b)=>b.dataset.n-a.dataset.n||P(a)-P(b)}; const f=map[s.sort]||map[''];
 [...items].sort(f).forEach(li=>{const on=ok(li); li.hidden=!on; if(on) n++; grid.appendChild(li);});
 $('h-count').textContent=T.results.replace('§',n); $('h-apply').textContent=T.apply.replace('§',n); $('h-empty').hidden=n>0;
 const c=(s.q?1:0)+sp.length+bn.length+tour.length+(s.eco?1:0)+(s.stock?1:0)+((s.min||s.max)?1:0); $('h-fn').textContent=c?String(c):'';
 const qs=new URLSearchParams(); KEYS.forEach(k=>{if(s[k]) qs.set(k,s[k]);}); history.replaceState(null,'',location.pathname+(qs.toString()?'?'+qs:''));}
const sheet=o=>{$('h-f').classList.toggle('open',o); $('h-shade').hidden=!o; $('h-open').setAttribute('aria-expanded',o); document.body.style.overflow=o?'hidden':'';};
$('h-open').onclick=()=>sheet(true); $('h-x').onclick=$('h-shade').onclick=()=>sheet(false); $('h-apply').onclick=()=>{sheet(false); $('hub').scrollIntoView({block:'start'});};
document.addEventListener('keydown',e=>{if(e.key==='Escape') sheet(false);});
let tm; ['h-q','h-q2'].forEach(i=>$(i).addEventListener('input',()=>{setQ($(i).value);clearTimeout(tm); tm=setTimeout(apply,200);})); ['h-min','h-max'].forEach(i=>$(i).addEventListener('input',()=>{clearTimeout(tm); tm=setTimeout(apply,200);}));
['h-sort','h-eco','h-stock'].forEach(i=>$(i).addEventListener('change',()=>{$('h-sort2').value=$('h-sort').value;apply();}));
$('h-sort2').addEventListener('change',()=>{$('h-sort').value=$('h-sort2').value;apply();});
document.querySelectorAll('.hub-seg input,.hub-chips input').forEach(i=>i.addEventListener('change',e=>{syncAll(e.target); if(e.target.name==='h-brand') paintBrands(); apply();}));
const bmore=$('h-bmore'); if(bmore) bmore.addEventListener('click',()=>{const box=document.querySelector('.hub-brands .hub-chips'); if(box.dataset.open==='1') delete box.dataset.open; else box.dataset.open='1'; paintBrands();});
const clear=()=>{const box=document.querySelector('.hub-brands .hub-chips'); if(box) delete box.dataset.open; put({}); apply();}; $('h-clear').onclick=clear; $('h-clear2').onclick=clear;
const qs=new URLSearchParams(location.search); const s0={}; KEYS.forEach(k=>s0[k]=qs.get(k)||''); if(KEYS.some(k=>s0[k])){put(s0); apply();}
})();
</script>
</Base>
