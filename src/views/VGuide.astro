---
import Base from '../layouts/Base.astro'; import CardL from '../components/CardL.astro'; import { D, url, SITE } from '../i18n/index.js'; import { guideData } from '../i18n/guide-data.js'; import { pickL } from '../i18n/lists.js';
import gES from '../i18n/guide-es.js'; import gFR from '../i18n/guide-fr.js';
const { lang } = Astro.props; const d=D(lang), u=d.ui; const G=({es:gES,fr:gFR})[lang](guideData(lang),d.terms); const U=SITE+url('guide',lang);
const picks=['best-padel-rackets-for-beginners','best-intermediate-padel-rackets','best-advanced-padel-rackets'].map(k=>pickL(k,lang)[0]).filter(Boolean);
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'Article','headline':G.h1,'inLanguage':lang,'url':U,'datePublished':'2026-10-20','dateModified':'2026-10-20','author':{'@type':'Organization','name':'WhichPadel'}},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':u.guide,'item':U}]},{'@type':'FAQPage','mainEntity':G.faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))}]};
---
<Base lang={d.locale} title={G.title+d.copy.titleSuffix} description={G.desc} jsonld={jsonld}>
<section class="phero" slot="hero"><div class="wrap"><nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)} style="color:#9fb6c0">{u.home}</a> › <span>{u.guide}</span></nav><span class="eyebrow">{G.eyebrow}</span><h1>{G.h1}</h1><p>{G.lead}</p></div></section>
<article class="prose pg">
<div class="tldr"><h2>{G.tldrH}</h2><ul>{G.tldr.map(x=><li set:html={x}/>)}</ul></div>
{G.sections.map(([id,h,html])=><><h2 id={id}>{h}</h2><Fragment set:html={html}/></>)}
<h2 id="faq">{G.faqH}</h2>{G.faq.map(([q,a])=><div class="faq"><h3>{q}</h3><p>{a}</p></div>)}
</article>
<div class="grid">{picks.map(r=><CardL r={r} lang={lang}/>)}</div>
</Base>
