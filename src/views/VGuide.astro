---
// Buying guide: one component for every language. Copy lives in src/i18n/guide-<lang>.js.
import Base from '../layouts/Base.astro'; import Byline from '../components/Byline.astro'; import RkCard from '../components/RkCard.astro'; import { D, url, SITE } from '../i18n/index.js'; import { guideData } from '../i18n/guide-data.js'; import { pickL } from '../i18n/lists.js';
import gEN from '../i18n/guide-en.js'; import gES from '../i18n/guide-es.js'; import gFR from '../i18n/guide-fr.js'; import gPT from '../i18n/guide-pt.js'; import gDE from '../i18n/guide-de.js'; import gIT from '../i18n/guide-it.js';
const { lang } = Astro.props; const d=D(lang), u=d.ui, t=d.terms; const g=guideData(lang); const G=({en:gEN,es:gES,fr:gFR,pt:gPT,it:gIT,de:gDE})[lang](g,t); const U=SITE+url('guide',lang);
const picks=['best-padel-rackets-for-beginners','best-intermediate-padel-rackets','best-advanced-padel-rackets'].map(k=>pickL(k,lang)[0]).filter(Boolean);
const cap=s=>s[0].toUpperCase()+s.slice(1); const c=G.col; const S=G.sec;
const jsonld={'@context':'https://schema.org','@graph':[{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':u.home,'item':SITE+url('home',lang)},{'@type':'ListItem','position':2,'name':G.crumb,'item':U}]},{'@type':'FAQPage','mainEntity':G.faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))}]};
---
<Base lang={d.locale} title={G.title+d.copy.titleSuffix} description={G.desc} jsonld={jsonld}>
<section class="phero" slot="hero"><div class="wrap"><nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <span>{G.crumb}</span></nav><span class="eyebrow">{G.eyebrow}</span><h1>{G.h1}</h1><Byline lang={lang} headline={G.h1} pageUrl={U}/><div class="seo"><p>{G.lead} <a href={url('finder',lang)}>{G.quiz}</a>.</p></div></div></section>
<article class="prose pg">
<div class="tldr"><h2>{G.tldrH}</h2><ul>{G.tldr.map(x=><li set:html={x}/>)}</ul></div>
<nav class="toc" aria-label={G.tocH}><b>{G.tocH}</b><ol>{Object.entries(G.toc).map(([id,l])=><li><a href={'#'+id}>{l}</a></li>)}</ol></nav>
<h2 id="what">{S.what[0]}</h2><Fragment set:html={S.what[1]}/>
<h2 id="shape">{S.shape[0]}</h2><Fragment set:html={S.shape[1]}/>
<div class="tw"><table><thead><tr><th>{c.shape}</th><th>{c.rackets}</th><th>{c.power}</th><th>{c.control}</th><th>{c.forgiveness}</th><th>{c.comfort}</th><th>{c.median}</th></tr></thead><tbody>{g.shapeStats.filter(s=>s.n).map(s=><tr><td><b><a href={url('best',lang,`best-${s.shape}-padel-rackets`)}>{t.shapeCap[s.shape]}</a></b></td><td>{s.n}</td><td>{s.power}</td><td>{s.control}</td><td>{s.forgiveness}</td><td>{s.comfort}</td><td>{g.S[s.shape].price}</td></tr>)}</tbody></table></div>
<Fragment set:html={S.shape[2]}/>
<h2 id="balance">{S.balance[0]}</h2><Fragment set:html={S.balance[1]}/>
<div class="tw"><table><thead><tr><th>{c.balance}</th><th>{c.rackets}</th><th>{c.power}</th><th>{c.control}</th><th>{c.forgiveness}</th></tr></thead><tbody>{g.balanceStats.filter(s=>s.n).map(s=><tr><td><b>{cap(t.bal[s.balance])}</b></td><td>{s.n}</td><td>{s.power}</td><td>{s.control}</td><td>{s.forgiveness}</td></tr>)}</tbody></table></div>
<Fragment set:html={S.balance[2]}/>
<h2 id="weight">{S.weight[0]}</h2><Fragment set:html={S.weight[1]}/>
<h2 id="core">{S.core[0]}</h2><Fragment set:html={S.core[1]}/>
<div class="tw"><table><thead><tr><th>{c.core}</th><th>{c.rackets}</th><th>{c.power}</th><th>{c.control}</th><th>{c.comfort}</th><th>{c.forgiveness}</th></tr></thead><tbody>{g.coreStats.filter(s=>s.n).map(s=><tr><td><b>{cap(t.core[s.core])}</b></td><td>{s.n}</td><td>{s.power}</td><td>{s.control}</td><td>{s.comfort}</td><td>{s.forgiveness}</td></tr>)}</tbody></table></div>
<Fragment set:html={S.core[2]}/>
<h2 id="face">{S.face[0]}</h2><Fragment set:html={S.face[1]}/>
<h2 id="level">{S.level[0]}</h2>
<div class="tw"><table><thead><tr><th>{c.level}</th><th>{c.shape}</th><th>{c.balance}</th><th>{c.core}</th><th>{c.weight}</th><th>{c.list}</th></tr></thead><tbody>{G.levels.map(([l,a,b,co,w,k,lab])=><tr><td><b>{l}</b></td><td>{a}</td><td>{b}</td><td>{co}</td><td>{w}</td><td><a href={url('best',lang,k)}>{lab}</a></td></tr>)}</tbody></table></div>
<Fragment set:html={S.level[1]}/>
<div class="hub cat rk-rows rk-best"><ul class="hub-grid">{picks.map((r,i)=><RkCard r={r} lang={lang} eager={i===0} keys={['power','control','forgiveness']}/>)}</ul></div>
<h2 id="price">{S.price[0]}</h2><Fragment set:html={S.price[1]}/>
<div class="tw"><table><thead><tr><th>{c.band}</th><th>{c.rackets}</th><th>{c.typical}</th></tr></thead><tbody>{g.P.tiers.map((x,i)=><tr><td>{G.tierLabel(x.a,x.b)}</td><td>{x.n}</td><td set:html={G.tiers[i]}/></tr>)}</tbody></table></div>
<Fragment set:html={S.price[2]}/>
<h2 id="injury">{S.injury[0]}</h2><Fragment set:html={S.injury[1]}/>
<h2 id="brands">{S.brands[0]}</h2><Fragment set:html={S.brands[1]}/>
<ul class="bl">{g.brands.map(b=><li><a href={url('brand',lang,b.slug)}>{G.brandLine(b.name)}</a> ({G.models(b.count)})</li>)}</ul>
<p><a href={url('brands',lang)}>{G.allBrands(g.B)}</a></p>
<h2 id="how">{S.how[0]}</h2><Fragment set:html={S.how[1]}/>
<h2 id="faq">{G.faqH}</h2>
{G.faq.map(([q,a])=><div class="faq"><h3>{q}</h3><p>{a}</p></div>)}
<p set:html={G.toolLine}/></article>
</Base>
