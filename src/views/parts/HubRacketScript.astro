---
const { HT } = Astro.props;
---
<script type="application/json" id="h-data" set:html={JSON.stringify(HT).replace(/</g,'\\u003c')}></script>
<script is:inline>
(()=>{const T=JSON.parse(document.getElementById('h-data').textContent);const $=id=>document.getElementById(id), hub=$('hub'), grid=$('h-grid'); let all=null, view=[], shown=0; const sel=[];
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const parts=v=>String(v||'').split(',').map(s=>s.trim()).filter(Boolean);
const rv=n=>[...document.querySelectorAll(`input[name="h-${n}"]:checked`)].map(i=>i.value).filter(Boolean).join(',');
const setR=(n,v)=>{const want=new Set(parts(v)); const boxes=[...document.querySelectorAll(`input[name="h-${n}"]`)]; boxes.forEach(i=>{if(i.value) i.checked=want.has(i.value);}); const all=boxes.find(i=>!i.value); if(all) all.checked=!boxes.some(i=>i.value&&i.checked);};
function paintBrands(){const box=document.querySelector('.hub-brands .hub-chips'); if(!box) return; const open=box.dataset.open==='1', labs=[...box.querySelectorAll('label')]; let hide=0; labs.forEach((lab,i)=>{const on=lab.querySelector('input').checked, keep=on||open||i<8; lab.hidden=!keep; if(!keep) hide++;}); const more=$('h-bmore'); if(more){more.hidden=!open&&!hide; if(!more.hidden) more.textContent=open?more.dataset.less:more.dataset.t.replace('§',hide);}}
const syncAll=box=>{const seg=box.closest('.hub-seg')||box.closest('.hub-g'); if(!seg) return; const boxes=[...seg.querySelectorAll('input[type="checkbox"]')]; const all=boxes.find(i=>!i.value); const rest=boxes.filter(i=>i.value); if(!all) return; if(!box.value){rest.forEach(i=>i.checked=false); all.checked=true;} else all.checked=!rest.some(i=>i.checked);};
const KEYS=['q','aud','brand','year','shape','bal','wt','hard','ck','level','min','max','stock','sort'];
let qv='';
const setQ=v=>{qv=v; if($('h-q').value!==v)$('h-q').value=v; if($('h-q2').value!==v)$('h-q2').value=v;};
const get=()=>({q:qv.trim(),aud:rv('aud'),brand:rv('brand'),year:rv('year'),shape:rv('shape'),bal:rv('bal'),wt:rv('wt'),hard:rv('hard'),ck:rv('ck'),level:rv('level'),min:$('h-min').value,max:$('h-max').value,stock:$('h-stock').checked?'1':'',sort:$('h-sort').value==='pop'?'':$('h-sort').value});
const paintNotes=()=>{const s=get(); document.querySelectorAll('.hub-note[data-k]').forEach(p=>{const k=p.dataset.k; p.hidden=k==='price'?!s.min&&!s.max:!s[k];});};
const put=s=>{setQ((s.q||'').trim());setR('brand',parts(s.brand).filter(v=>T.brands[v]).join(','));setR('year',s.year||'');['aud','shape','bal','wt','hard','ck','level'].forEach(k=>setR(k,s[k]||''));$('h-sort2').value=s.sort||'pop';$('h-min').value=s.min||'';$('h-max').value=s.max||'';$('h-stock').checked=s.stock==='1';$('h-sort').value=s.sort||'pop'; paintBrands(); paintNotes();};
const active=s=>KEYS.some(k=>s[k]);
const nf=s=>['aud','brand','year','shape','bal','wt','hard','ck','level'].reduce((n,k)=>n+parts(s[k]).length,0)+(s.q?1:0)+(s.stock?1:0)+((s.min||s.max)?1:0);
const hit=(sel,v)=>!sel.length||sel.includes(String(v??''));
// offers: static card offer, replaced by the live price engine when it answers
const offers=r=>(r.live||r.o||[]).filter(o=>o.p>0);
const reach=r=>offers(r).filter(o=>!window.WP||WP.shop(o.d,o.c)!=='n');
const best=r=>window.WP?WP.best(offers(r)):null;
const priceV=r=>{const q=best(r); return q&&q.v!=null?q.v:null;};
const near=r=>window.WP?offers(r).some(o=>WP.shop(o.d,o.c)==='y'&&o.s!==0):offers(r).length>0;
const saving=r=>{const os=reach(r); if(os.length<2) return (r.drop||0); const v=os.map(o=>o.p); return Math.max(r.drop||0,(Math.max(...v)-Math.min(...v))/Math.max(...v));};
const ptxt=r=>{const q=best(r); return (!q||q.v==null)?T.none:T.fromP.replace('{p}',q.txt);};
const shortM=r=>{let s=r.m||''; if(r.b) s=s.replace(new RegExp('^'+r.b.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\s+','i'),''); if(r.y) s=s.replace(new RegExp('\\s+'+r.y+'\\s*$'),''); return s.trim()||r.m;};
const spec=r=>[r.a&&r.a!=='unisex'&&T.auds[['men','women','junior'].indexOf(r.a)],r.sh&&T.shapeCap[r.sh],r.w0&&`${r.w0}${r.w1&&r.w1!==r.w0?'–'+r.w1:''}\u00a0g`,r.ck&&r.ck!=='none'?r.ck:T.ckT[0]+': '+T.ckT[1].toLowerCase()].filter(Boolean).join(' · ');
const card=(r,i)=>{const li=document.getElementById('rk-card').content.firstElementChild.cloneNode(true); const on=sel.includes(r.s); const id='hk-'+r.s;
 li.dataset.s=r.s; li.classList.toggle('sel',on);
 const a=li.querySelector('.rk-a'); a.href=T.rk+r.s+'/'; a.setAttribute('aria-labelledby',id);
 const ph=li.querySelector('.rk-ph');
 if(r.i){const img=document.createElement('img'); img.src=r.i; img.alt=r.m+' '+T.alt; img.width=96; img.height=112; img.loading=i<4?'eager':'lazy'; img.decoding='async'; ph.replaceChildren(img);}
 else ph.innerHTML=($('hic-'+(r.sh||'hybrid'))||$('hic-hybrid')).innerHTML;
 li.querySelector('.rk-b span').textContent=[r.b,r.y].filter(Boolean).join(' · ');
 const name=li.querySelector('.rk-m'); name.id=id; name.textContent=shortM(r);
 const bell=li.querySelector('.rk-bell'); if(bell) bell.setAttribute('aria-label', bell.getAttribute('aria-label').replace(/:\s*$/, ': '+name.textContent));
 const specEl=li.querySelector('.rk-c'); const sp=spec(r); if(sp) specEl.textContent=sp; else specEl.remove();
 li.querySelector('.rk-pv').textContent=ptxt(r);
 const heart=li.querySelector('.save-heart'); heart.dataset.save=r.s; heart.dataset.off=T.save; heart.dataset.on=T.saved; heart.setAttribute('aria-pressed','false'); heart.setAttribute('aria-label',T.save);
 const cb=li.querySelector('.rk-cb'); cb.value=r.s; cb.checked=on;
 const lab=li.querySelector('.rk-x'); if(lab) lab.title=T.compare; const sr=li.querySelector('.rk-x .sr'); if(sr) sr.textContent=T.compare+': '+r.m;
 return li;};
const OI=Object.fromEntries(T.order.map((s,i)=>[s,i])); const pop=r=>-(OI[r.s]??1e6);
function filt(s){const q=s.q.toLowerCase(), bn=parts(s.brand).map(sl=>T.brands[sl]).filter(Boolean), mn=parseFloat(s.min), mx=parseFloat(s.max);
 return all.filter(r=>(!q||(r.m+' '+r.b).toLowerCase().includes(q))&&hit(bn,r.b)&&hit(parts(s.year),r.y)&&hit(parts(s.aud),r.a)&&hit(parts(s.shape),r.sh)&&hit(parts(s.bal),r.bn)&&hit(parts(s.wt),r.wn)&&hit(parts(s.hard),r.cn)&&hit(parts(s.ck),r.ck||'none')&&hit(parts(s.level),r.lv)&&(!s.stock||near(r))&&((isNaN(mn)&&isNaN(mx))||((v=>v!=null&&(isNaN(mn)||v>=mn)&&(isNaN(mx)||v<=mx))(priceV(r)))));}
function sortv(v,k){const P=r=>{const x=priceV(r); return x==null?Infinity:x;};
 const map={best:(a,b)=>(P(a)===Infinity)-(P(b)===Infinity)||saving(b)-saving(a)||P(a)-P(b),price:(a,b)=>P(a)-P(b),hi:(a,b)=>(P(b)===Infinity)-(P(a)===Infinity)||P(b)-P(a),new:(a,b)=>(b.y||0)-(a.y||0)||P(a)-P(b),old:(a,b)=>(a.y||9999)-(b.y||9999)||P(a)-P(b),pop:(a,b)=>pop(b)-pop(a)}; const f=map[k]||map.pop;
 return [...v].sort(f);}
const syncURL=s=>{const qs=new URLSearchParams(); KEYS.forEach(k=>{if(s[k]) qs.set(k,s[k]);}); const q=qs.toString(); history.replaceState(null,'',(q?T.base:location.pathname)+(q?'?'+q:'')+location.hash);};
const money=n=>{const c=(window.WP&&WP.currency)||T.cur; const v=Math.round(+n); if(c==='SEK') return v+' kr'; return T.lang!=='en'?v+' '+(T.sym[c]||''):(T.sym[c]||'')+v;};
const paintCur=()=>{const c=(window.WP&&WP.currency)||T.cur; const el=$('h-sym'); if(el) el.textContent=T.sym[c]||'';};
const setCount=n=>{chips(); paintNotes(); $('h-count').textContent=T.results.replace('§',n); $('h-apply').textContent=T.apply.replace('§',n);};
function render(reset){ if(reset) shown=T.PER; grid.replaceChildren(...view.slice(0,shown).map(card)); $('h-empty').hidden=view.length>0; const m=$('h-more'); if(m) m.hidden=shown>=view.length; window.wpSaved&&wpSaved.paint(); }
async function apply(push=true){ await load(); const s=get(); const act=active(s); hub.classList.toggle('js-f',act); $('h-fn').textContent=nf(s)?String(nf(s)):'';
 view=sortv(filt(s),s.sort); setCount(view.length); if(push) syncURL(s);
 if(!act&&!hub.dataset.dirty){ shown=T.PER*T.p; refreshPrices(); const m=$('h-more'); if(m) m.hidden=shown>=view.length; return; }
 hub.dataset.dirty=1; if(!act) shown=T.PER; render(true); }
function refreshPrices(){ grid.querySelectorAll('.rk').forEach(li=>{const r=all&&all.find(x=>x.s===li.dataset.s); if(r) li.querySelector('.rk-pv').textContent=ptxt(r);}); }
let prom=null; const load=()=>prom||(prom=Promise.all([fetch('/cards.json').then(r=>r.json()),fetch('/api/all-prices').then(r=>r.ok?r.json():null).catch(()=>null)]).then(([a,p])=>{const L=p&&p.r||{}; a.forEach(r=>{const e=L[r.s]; if(e){const os=(Array.isArray(e.o)&&e.o.length?e.o:[e]).filter(o=>o.p>0).map(o=>({d:o.d,p:o.p,c:o.c,u:o.u,s:o.s})); if(os.length) r.live=os; r.drop=e.drop||0;}}); all=a; return a;}));
// active filter chips
const LBL=k=>({aud:T.aud,shape:T.shape,bal:T.balance,wt:T.weight,hard:T.hard,ck:T.ckT[0],level:T.level,brand:T.brand,year:T.year})[k];
function chips(){const s=get(); const out=[]; const lab=(n,v)=>{const i=[...document.querySelectorAll(`input[name="h-${n}"]`)].find(el=>el.value===v); const t=i&&i.nextElementSibling; return t?(t.childNodes[0].textContent||'').trim():v;};
 parts(s.brand).forEach(v=>out.push(['brand',v,T.brands[v]||v])); ['shape','bal','wt','hard','ck','level','year','aud'].forEach(k=>parts(s[k]).forEach(v=>out.push([k,v,lab(k,v)])));
 if(s.min||s.max){const a=s.min?money(s.min):'', b=s.max?money(s.max):''; out.push(['price','',!s.max?T.fromP.replace('{p}',a):!s.min?T.toP.replace('{p}',b):T.fromP.replace('{p}',a)+' – '+b]);} if(s.stock) out.push(['stock','',T.stock]); if(s.q) out.push(['q','','“'+s.q+'”']);
 const ac=$('h-ac'); ac.hidden=!out.length; ac.innerHTML=out.map(([k,v,label])=>`<button type="button" class="hub-chip" data-k="${esc(k)}" data-v="${esc(v)}">${esc(label)}<span aria-hidden="true">✕</span></button>`).join('')+(out.length>1?`<button type="button" class="hub-chip hub-chip-x" data-k="*">${esc(T.clr)}</button>`:'');}
$('h-ac').addEventListener('click',e=>{const b=e.target.closest('[data-k]'); if(!b) return; const k=b.dataset.k; if(k==='*') return clear(); const s=get(); if(k==='price'){s.min='';s.max='';} else if(b.dataset.v) s[k]=parts(s[k]).filter(v=>v!==b.dataset.v).join(','); else s[k]=''; put(s); hub.dataset.dirty=1; apply();});
// sheet (mobile)
const sheet=o=>{$('h-f').classList.toggle('open',o); $('h-shade').hidden=!o; $('h-open').setAttribute('aria-expanded',o); document.body.style.overflow=o?'hidden':''; if(o) load();};
// The column starts below the title, so a viewport max-height runs off the bottom until it sticks. Size it to the space actually on screen.
let fitRaf=0; const fitF=()=>{const f=$('h-f'); if(innerWidth<861){f.style.removeProperty('--f-max'); return;} const top=Math.max(72,f.getBoundingClientRect().top); f.style.setProperty('--f-max',Math.max(160,Math.round(innerHeight-top-12))+'px');};
const fitSoon=()=>{cancelAnimationFrame(fitRaf); fitRaf=requestAnimationFrame(fitF);};
addEventListener('scroll',fitSoon,{passive:true}); addEventListener('resize',fitSoon); fitF();
$('h-open').onclick=()=>sheet(true); $('h-x').onclick=$('h-shade').onclick=()=>sheet(false); $('h-apply').onclick=()=>{sheet(false); hub.scrollIntoView({block:'start'});};
document.addEventListener('keydown',e=>{if(e.key==='Escape') sheet(false);});
let tm; ['h-q','h-q2'].forEach(i=>$(i).addEventListener('input',()=>{setQ($(i).value);clearTimeout(tm); tm=setTimeout(apply,200);})); ['h-min','h-max'].forEach(i=>$(i).addEventListener('input',()=>{clearTimeout(tm); tm=setTimeout(apply,200);}));
['h-sort','h-stock'].forEach(i=>$(i).addEventListener('change',()=>{$('h-sort2').value=$('h-sort').value;apply();}));
$('h-sort2').addEventListener('change',()=>{$('h-sort').value=$('h-sort2').value;apply();});
document.querySelectorAll('.hub-seg input,.hub-chips input').forEach(i=>i.addEventListener('change',e=>{syncAll(e.target); if(e.target.name==='h-brand') paintBrands(); apply();}));
const bmore=$('h-bmore'); if(bmore) bmore.addEventListener('click',()=>{const box=document.querySelector('.hub-brands .hub-chips'); if(box.dataset.open==='1') delete box.dataset.open; else box.dataset.open='1'; paintBrands();});
const clear=()=>{const box=document.querySelector('.hub-brands .hub-chips'); if(box) delete box.dataset.open; put({}); hub.dataset.dirty=1; apply();}; $('h-clear').onclick=clear; $('h-clear2').onclick=clear;
// load more: crawlable link to the next static page, enhanced to append in place
const more=$('h-more'); if(more) more.addEventListener('click',async e=>{e.preventDefault(); if(!all) await apply(false);
 view.slice(shown,shown+T.PER).forEach((r,j)=>grid.appendChild(card(r,shown+j))); shown+=T.PER; more.hidden=shown>=view.length; window.wpSaved&&wpSaved.paint();
 const np=Math.floor(shown/T.PER)+1; if(np<=T.P) more.href=T.pfx+np+'/'; });
// compare tray: 3 on a wide screen, 2 on a phone
const maxN=()=>matchMedia('(min-width:900px)').matches?3:2;
function tray(){ $('h-tray').hidden=!sel.length; const slots=sel.map(s=>{const r=all&&all.find(x=>x.s===s); const m=r?r.m:s; const t=m.length>22?m.slice(0,21)+'…':m; return `<li><span>${esc(t)}</span><button type="button" data-rm="${s}" aria-label="${esc(T.remove)}: ${esc(m)}">✕</button></li>`;});
 for(let i=sel.length;i<maxN();i++) slots.push(sel.length<2&&i===sel.length?`<li class="hub-slot hub-slot-ask">${esc(T.cmpPick)}</li>`:`<li class="hub-slot" aria-hidden="true">+</li>`);
 $('h-sel').innerHTML=slots.join(''); const go=$('h-go'), ready=sel.length>=2; go.hidden=!ready; go.disabled=!ready; go.textContent=ready?`${T.compare} ${sel.length}`:T.compare;
 grid.querySelectorAll('.rk').forEach(li=>{const on=sel.includes(li.dataset.s); li.classList.toggle('sel',on); const c=li.querySelector(".rk-cb"); if(c) c.checked=on;}); try{sessionStorage.wp_hub_cmp=sel.join(',')}catch(e){} }
grid.addEventListener('change',e=>{const c=e.target.closest(".rk-cb"); if(!c) return; const i=sel.indexOf(c.value); if(c.checked){ if(sel.length>=maxN()){c.checked=false; alert(T.max3.replace('3',String(maxN()))); return;} if(i<0) sel.push(c.value);} else if(i>=0) sel.splice(i,1); load().then(tray); tray();});
$('h-sel').addEventListener('click',e=>{const b=e.target.closest('[data-rm]'); if(!b) return; sel.splice(sel.indexOf(b.dataset.rm),1); tray();});
$('h-tray-x').onclick=()=>{sel.splice(0,sel.length); tray();};
function openTake(fromHist){const dlg=$('cmp-take'); if(!dlg.open) dlg.showModal(); const sc=dlg.querySelector('.cmp-take-body'); if(sc) sc.scrollTop=0; window.wpCompare&&window.wpCompare.set(sel.slice()); if(!fromHist&&!(history.state&&history.state.wpCmp)) history.pushState({wpCmp:1},'');}
let skipPop=false;
$('cmp-take').addEventListener('close',()=>{const next=window.wpCompare?window.wpCompare.get():sel.slice(); if(next.join()!==sel.join()){sel.splice(0,sel.length,...next); tray();} if(skipPop){skipPop=false; return;} if(history.state&&history.state.wpCmp) history.back();});
function shutTake(){const back=!!(history.state&&history.state.wpCmp); if($('cmp-take').open){skipPop=true; $('cmp-take').close();} if(back) history.back();}
$('cmp-take-x').onclick=shutTake;
document.addEventListener('keydown',e=>{if(e.key!=='Escape'||!$('cmp-take').open||$('sheet').open) return; e.preventDefault(); shutTake();});
addEventListener('popstate',()=>{const dlg=$('cmp-take'); if(history.state&&history.state.wpCmp){ if(!dlg.open&&sel.length>=2) openTake(true); } else if(dlg.open){ skipPop=true; dlg.close(); }});
document.addEventListener('wp:cmp',e=>{const next=e.detail||[]; if(next.join()===sel.join()) return; sel.splice(0,sel.length,...next); tray();});
$('h-go').onclick=()=>{ if(sel.length>=2) openTake(); };
try{(sessionStorage.wp_hub_cmp||'').split(',').filter(Boolean).slice(0,maxN()).forEach(s=>sel.push(s));}catch(e){}
matchMedia('(min-width:900px)').addEventListener('change',()=>{const m=maxN(); if(sel.length>m) sel.splice(m); if(sel.length) tray();});
// A shared or "compare this" link arrives as ?r=a,b. Open that comparison here, then drop r from the address.
const qs=new URLSearchParams(location.search);
const linked=(qs.get('r')||'').split(',').map(s=>s.trim()).filter(Boolean).slice(0,maxN());
if(linked.length>=2){sel.splice(0,sel.length,...linked); qs.delete('r'); const q=qs.toString(); history.replaceState(history.state,'',location.pathname+(q?'?'+q:'')+location.hash);}
const s0={}; KEYS.forEach(k=>s0[k]=qs.get(k)||''); put(s0); paintCur();
document.addEventListener('wp:region',()=>{ paintCur(); if(all){ view=sortv(filt(get()),get().sort); setCount(view.length); if(hub.dataset.dirty) render(false); else refreshPrices(); } });
if(sel.length) load().then(tray);
if(active(s0)) apply(false); else load().then(()=>apply(false));
if(linked.length>=2) openTake();
else if(history.state&&history.state.wpCmp&&sel.length>=2) openTake(true);
})();
</script>
