---
const { pv, T, C } = Astro.props;
---
<script type="application/json" id="h-data" set:html={JSON.stringify({pv,T:{results:T.results,apply:T.apply,max3:C.max3,remove:C.remove,compare:C.compare,cmpPick:C.cmpPick}}).replace(/</g,'\\u003c')}></script>
<script is:inline>
(()=>{const {pv,T}=JSON.parse(document.getElementById('h-data').textContent); const $=id=>document.getElementById(id), grid=$('h-grid'); const items=[...grid.children]; items.forEach((li,i)=>li.dataset.o=i);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const parts=v=>String(v||'').split(',').map(s=>s.trim()).filter(Boolean);
const rv=n=>[...document.querySelectorAll(`input[name="h-${n}"]:checked`)].map(i=>i.value).filter(Boolean).join(',');
const setR=(n,v)=>{const want=new Set(parts(v)); const boxes=[...document.querySelectorAll(`input[name="h-${n}"]`)]; boxes.forEach(i=>{if(i.value) i.checked=want.has(i.value);}); const all=boxes.find(i=>!i.value); if(all) all.checked=!boxes.some(i=>i.value&&i.checked);};
function paintBrands(){const box=document.querySelector('.hub-brands .hub-chips'); if(!box) return; const open=box.dataset.open==='1', labs=[...box.querySelectorAll('label')]; let hide=0; labs.forEach((lab,i)=>{const on=lab.querySelector('input').checked, keep=on||open||i<8; lab.hidden=!keep; if(!keep) hide++;}); const more=$('h-bmore'); if(more){more.hidden=!open&&!hide; if(!more.hidden) more.textContent=open?more.dataset.less:more.dataset.t.replace('§',hide);}}
const syncAll=box=>{const seg=box.closest('.hub-seg')||box.closest('.hub-g'); if(!seg) return; const boxes=[...seg.querySelectorAll('input[type="checkbox"]')]; const all=boxes.find(i=>!i.value); const rest=boxes.filter(i=>i.value); if(!all) return; if(!box.value){rest.forEach(i=>i.checked=false); all.checked=true;} else all.checked=!rest.some(i=>i.checked);};
const KEYS=['q','brand','g','so','sz','min','max','sort'];
let qv='';
const setQ=v=>{qv=v; if($('h-q').value!==v)$('h-q').value=v; if($('h-q2').value!==v)$('h-q2').value=v;};
const get=()=>({q:qv.trim(),brand:rv('brand'),g:rv('g'),so:rv('so'),sz:rv('sz'),min:$('h-min').value,max:$('h-max').value,sort:$('h-sort').value==='rec'?'':$('h-sort').value});
const put=s=>{setQ((s.q||'').trim());setR('brand',s.brand||'');setR('g',s.g||'');setR('so',s.so||'');setR('sz',s.sz||'');$('h-min').value=s.min||'';$('h-max').value=s.max||'';$('h-sort').value=s.sort||'rec';$('h-sort2').value=s.sort||'rec'; paintBrands();};
function apply(){const s=get(), q=s.q.toLowerCase(), mn=parseFloat(s.min), mx=parseFloat(s.max), bn=parts(s.brand), g=parts(s.g), so=parts(s.so), sz=parts(s.sz).map(Number); let n=0;
 const ok=li=>{const d=li.dataset, v=pv[d.s]; return (!q||li.textContent.toLowerCase().includes(q))&&(!bn.length||bn.includes(d.b))&&(!g.length||g.includes(d.g))&&(!so.length||so.some(x=>(d.so||'').split(' ').includes(x)))&&(!sz.length||(d.sz||'').split(' ').some(x=>sz.includes(Math.floor(+x))))&&((isNaN(mn)&&isNaN(mx))||(v!=null&&(isNaN(mn)||v>=mn)&&(isNaN(mx)||v<=mx)));};
 const P=li=>pv[li.dataset.s]??1e9; const map={'':(a,b)=>a.dataset.o-b.dataset.o,price:(a,b)=>P(a)-P(b),hi:(a,b)=>(P(b)===1e9)-(P(a)===1e9)||P(b)-P(a),new:(a,b)=>b.dataset.y-a.dataset.y||a.dataset.o-b.dataset.o,old:(a,b)=>(+a.dataset.y||9999)-(+b.dataset.y||9999)||a.dataset.o-b.dataset.o,shops:(a,b)=>b.dataset.n-a.dataset.n||P(a)-P(b)}; const f=map[s.sort]||map[''];
 [...items].sort(f).forEach(li=>{const on=ok(li); li.hidden=!on; if(on) n++; grid.appendChild(li);});
 $('h-count').textContent=T.results.replace('§',n); $('h-apply').textContent=T.apply.replace('§',n); $('h-empty').hidden=n>0;
 const c=(s.q?1:0)+g.length+bn.length+so.length+sz.length+((s.min||s.max)?1:0); $('h-fn').textContent=c?`(${c})`:'';
 const qs=new URLSearchParams(); KEYS.forEach(k=>{if(s[k]) qs.set(k,s[k]);}); history.replaceState(null,'',location.pathname+(qs.toString()?'?'+qs:''));}
const sheet=o=>{$('h-f').classList.toggle('open',o); $('h-shade').hidden=!o; $('h-open').setAttribute('aria-expanded',o); document.body.style.overflow=o?'hidden':'';};
$('h-open').onclick=()=>sheet(true); $('h-x').onclick=$('h-shade').onclick=()=>sheet(false); $('h-apply').onclick=()=>{sheet(false); $('hub').scrollIntoView({block:'start'});};
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('cmp-take').open) sheet(false);});
let tm; ['h-q','h-q2'].forEach(i=>$(i).addEventListener('input',()=>{setQ($(i).value);clearTimeout(tm); tm=setTimeout(apply,200);})); ['h-min','h-max'].forEach(i=>$(i).addEventListener('input',()=>{clearTimeout(tm); tm=setTimeout(apply,200);}));
['h-sort'].forEach(i=>$(i).addEventListener('change',()=>{$('h-sort2').value=$('h-sort').value;apply();})); $('h-sort2').addEventListener('change',()=>{$('h-sort').value=$('h-sort2').value;apply();}); document.querySelectorAll('.hub-seg input,.hub-chips input').forEach(i=>i.addEventListener('change',e=>{syncAll(e.target); if(e.target.name==='h-brand') paintBrands(); apply();}));
const bmore=$('h-bmore'); if(bmore) bmore.addEventListener('click',()=>{const box=document.querySelector('.hub-brands .hub-chips'); if(box.dataset.open==='1') delete box.dataset.open; else box.dataset.open='1'; paintBrands();});
const clear=()=>{const box=document.querySelector('.hub-brands .hub-chips'); if(box) delete box.dataset.open; put({}); apply();}; $('h-clear').onclick=clear; $('h-clear2').onclick=clear;
const sel=[];
const maxN=()=>matchMedia('(min-width:900px)').matches?3:2;
function tray(){ $('h-tray').hidden=!sel.length; document.body.classList.toggle('has-tray',sel.length>0); const slots=sel.map(s=>{const li=grid.querySelector('.rk[data-s="'+s.replace(/"/g,'')+'"]'); const m=li&&li.dataset.m||s; const t=m.length>22?m.slice(0,21)+'…':m; return `<li><span>${esc(t)}</span><button type="button" data-rm="${esc(s)}" aria-label="${esc(T.remove)}: ${esc(m)}">✕</button></li>`;});
 for(let i=sel.length;i<maxN();i++) slots.push(sel.length<2&&i===sel.length?`<li class="hub-slot hub-slot-ask">${esc(T.cmpPick)}</li>`:`<li class="hub-slot" aria-hidden="true">+</li>`);
 $('h-sel').innerHTML=slots.join(''); const go=$('h-go'), ready=sel.length>=2; go.hidden=!ready; go.disabled=!ready; go.textContent=ready?`${T.compare} ${sel.length}`:T.compare; document.body.classList.toggle('has-tray-go',ready);
 grid.querySelectorAll('.rk').forEach(li=>{const on=sel.includes(li.dataset.s); li.classList.toggle('sel',on); const c=li.querySelector('.rk-cb'); if(c) c.checked=on;}); try{sessionStorage.wp_shoe_cmp=sel.join(',')}catch(e){} }
grid.addEventListener('change',e=>{const c=e.target.closest('.rk-cb'); if(!c) return; const i=sel.indexOf(c.value); if(c.checked){ if(sel.length>=maxN()){c.checked=false; alert(T.max3.replace('3',String(maxN()))); return;} if(i<0) sel.push(c.value);} else if(i>=0) sel.splice(i,1); tray();});
$('h-sel').addEventListener('click',e=>{const b=e.target.closest('[data-rm]'); if(!b) return; sel.splice(sel.indexOf(b.dataset.rm),1); tray();});
$('h-tray-x').onclick=()=>{sel.splice(0,sel.length); tray();};
function openTake(fromHist){const dlg=$('cmp-take'); if(!dlg.open) dlg.showModal(); const sc=dlg.querySelector('.cmp-take-body'); if(sc) sc.scrollTop=0; window.wpCompare&&window.wpCompare.set(sel.slice()); if(!fromHist&&!(history.state&&history.state.wpCmp)) history.pushState({wpCmp:1},'');}
let skipPop=false;
$('cmp-take').addEventListener('close',()=>{const next=window.wpCompare?window.wpCompare.get():sel.slice(); if(next.join()!==sel.join()){sel.splice(0,sel.length,...next); tray();} if(skipPop){skipPop=false; return;} if(history.state&&history.state.wpCmp) history.back();});
function shutTake(){const back=!!(history.state&&history.state.wpCmp); if($('cmp-take').open){skipPop=true; $('cmp-take').close();} if(back) history.back();}
$('cmp-take-x').onclick=shutTake;
document.addEventListener('keydown',e=>{if(e.key!=='Escape'||!$('cmp-take').open||($('sheet')&&$('sheet').open)) return; e.preventDefault(); shutTake();});
addEventListener('popstate',()=>{const dlg=$('cmp-take'); if(history.state&&history.state.wpCmp){ if(!dlg.open&&sel.length>=2) openTake(true); } else if(dlg.open){ skipPop=true; dlg.close(); }});
document.addEventListener('wp:cmp',e=>{const next=e.detail||[]; if(next.join()===sel.join()) return; sel.splice(0,sel.length,...next); tray();});
$('h-go').onclick=()=>{ if(sel.length>=2) openTake(); };
try{(sessionStorage.wp_shoe_cmp||'').split(',').filter(Boolean).slice(0,maxN()).forEach(s=>{if(grid.querySelector('.rk[data-s="'+s.replace(/"/g,'')+'"]')) sel.push(s);});}catch(e){}
matchMedia('(min-width:900px)').addEventListener('change',()=>{const m=maxN(); if(sel.length>m) sel.splice(m); if(sel.length) tray();});
if(sel.length) tray();
const qs=new URLSearchParams(location.search); const s0={}; KEYS.forEach(k=>s0[k]=qs.get(k)||''); if(KEYS.some(k=>s0[k])){put(s0); apply();}
})();
</script>
