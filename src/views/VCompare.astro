---
import Base from '../layouts/Base.astro'; import CompareBoard from '../components/CompareBoard.astro'; import { rackets } from '../lib/data.js'; import { D, url } from '../i18n/index.js'; import { HUB } from '../i18n/hub.js';
const { lang } = Astro.props; const d=D(lang), u=d.ui, c=u.cmp;
---
<Base lang={d.locale} preload="/compare-data.json" title={d.copy.cmpTitle(rackets.length)+d.copy.titleSuffix} description={d.copy.cmpDesc(rackets.length)}>
<nav class="crumbs" aria-label={u.breadcrumb}><a href={url('home',lang)}>{u.home}</a> › <a href={url('rackets',lang)}>{HUB[lang].nav}</a> › <span>{u.compare}</span></nav>
<div class="cmp-intro"><h1>{c.h1}</h1><p class="muted">{c.lead}</p></div>
<CompareBoard lang={lang}/>
<script is:inline>
if(location.search){const m=document.createElement('meta');m.name='robots';m.content='noindex,follow';document.head.appendChild(m);}
</script>
</Base>
