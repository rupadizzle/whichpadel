{"extends":"stylelint-config-standard",
 "rules":{
  "declaration-property-unit-disallowed-list":{"/^(margin|padding|gap|row-gap|column-gap)/":["px"]},
  "declaration-no-important":true,
  "max-nesting-depth":2,
  "declaration-property-value-disallowed-list":{"/^margin/":["/(^|\\s)-/","/calc\\(-/"]},
  "selector-class-pattern":null,"declaration-block-single-line-max-declarations":null,"rule-empty-line-before":null,"color-hex-length":null,"alpha-value-notation":null,"color-function-notation":null,"media-feature-range-notation":null,"declaration-empty-line-before":null,"font-family-name-quotes":null,"selector-not-notation":null,"comment-empty-line-before":null,"value-keyword-case":null,"shorthand-property-no-redundant-values":null,"no-descending-specificity":null,"declaration-block-no-redundant-longhand-properties":null,"selector-id-pattern":null,"keyframes-name-pattern":null,"number-max-precision":null,"import-notation":null,"property-no-vendor-prefix":null,"no-duplicate-selectors":null,"declaration-block-no-duplicate-properties":null,"length-zero-no-unit":null,"selector-pseudo-element-colon-notation":null,"custom-property-empty-line-before":null}}
