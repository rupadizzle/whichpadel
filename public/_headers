# HTML and other static pages: short browser cache, 1h edge cache.
# Pages Functions no longer run on these routes (see public/_routes.json), so CF can cache them.
# A new deploy purges the Pages cache.
/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/rackets/*.webp
  Cache-Control: public, max-age=604800
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
