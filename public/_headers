/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://classic.avantlink.com https://*.avantlink.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com https://*.avantlink.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), payment=()

/rackets/*.webp
  Cache-Control: public, max-age=604800
/rackets/g/*
  Cache-Control: public, max-age=604800
/shoes/g/*
  Cache-Control: public, max-age=604800
/balls/g/*
  Cache-Control: public, max-age=604800
/bags/*.webp
  Cache-Control: public, max-age=604800
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/deals-cat.json
  Cache-Control: public, max-age=3600, s-maxage=86400
